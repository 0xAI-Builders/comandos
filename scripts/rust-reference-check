#!/bin/sh
# Optional reference dependencies are mounted read-only into synthetic homes.
# Run scripts/rust-check first to build the native binaries and examples.
set -eu
if [ "$#" -ne 2 ]; then
  echo 'Usage: rust-reference-check VENV_DIRECTORY TOKEN_CACHE_DIRECTORY' >&2
  exit 2
fi
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
task_runner="$task_root/scripts/rust-python-oracle"
"$task_runner" "$1" "$2" /venv/bin/python /work/crates/comandos-extensions/tests/catalog_oracle.py
for task_zone in UTC America/New_York Australia/Lord_Howe Pacific/Apia; do
  "$task_runner" "$1" "$2" /venv/bin/python /work/tests/rust_credential_import_parity.py "$task_zone"
done
