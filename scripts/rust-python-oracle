#!/bin/sh
# Test-only reference runtime; read-only dependencies, synthetic home/network.
# Usage: rust-python-oracle VENV_DIRECTORY TOKEN_CACHE_DIRECTORY COMMAND [ARG...]
set -eu
if [ "$#" -lt 3 ]; then
  echo 'Usage: rust-python-oracle VENV_DIRECTORY TOKEN_CACHE_DIRECTORY COMMAND [ARG...]' >&2
  exit 2
fi
task_venv=$1
task_tokens=$2
shift 2
test -x "$task_venv/bin/python"
test -d "$task_tokens"
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test -f "$task_root/.git"
task_cache="$task_root/.migration-build"
mkdir -p "$task_cache"
printf 'fixture:x:%s:%s:isolated fixture:/home/fixture:/bin/sh\n' "$(id -u)" "$(id -g)" > "$task_cache/fixture-passwd"
ulimit -v 3145728
exec systemd-run --user --scope --quiet --collect --unit="comandos-python-oracle-$$" \
  --property=MemoryHigh=2G --property=MemoryMax=3G --property=MemorySwapMax=512M \
  nice -n 10 bwrap --die-with-parent --new-session --unshare-all --clearenv \
  --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /lib /lib --ro-bind /lib64 /lib64 \
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run --tmpfs /home \
  --dir /home/fixture --ro-bind "$task_cache/fixture-passwd" /etc/passwd \
  --ro-bind /etc/ssl/certs /etc/ssl/certs \
  --ro-bind "$task_venv" /venv --ro-bind "$task_tokens" /tokens \
  --bind "$task_root" /work --chdir /work \
  --setenv PATH /venv/bin:/usr/bin:/bin \
  --setenv PYTHONPATH /work/.migration-build/python:/work/lib \
  --setenv TIKTOKEN_CACHE_DIR /tokens --setenv PYTHONDONTWRITEBYTECODE 1 \
  --setenv XDG_STATE_HOME /tmp/state --setenv COMANDOS_STATE_DB /tmp/unused.sqlite3 \
  --setenv LANG C.UTF-8 "$@"
