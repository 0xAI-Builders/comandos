#!/bin/sh
# Development only. No application services, host sockets or home are mounted.
set -eu
task_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -f "$task_root/.git" ]; then
  echo 'Use a dedicated Git worktree for migration development.' >&2
  exit 1
fi
task_toolchain=$(dirname "$(dirname "$(rustup which cargo)")")
task_cache="$task_root/.migration-build"
mkdir -p "$task_cache/cargo" "$task_cache/target"
printf 'fixture:x:%s:%s:isolated fixture:/home/fixture:/bin/sh\n' "$(id -u)" "$(id -g)" > "$task_cache/fixture-passwd"
# This machine has the SQLite runtime but no development linker alias.
# Use an alias inside the disposable build cache, never install into the host.
if [ ! -e /usr/lib/x86_64-linux-gnu/libsqlite3.so ] && [ -e /usr/lib/x86_64-linux-gnu/libsqlite3.so.0 ]; then
  mkdir -p "$task_cache/native"
  ln -sf /usr/lib/x86_64-linux-gnu/libsqlite3.so.0 "$task_cache/native/libsqlite3.so"
fi
test -d "$task_cache/cargo/registry"
ulimit -v 3145728
exec systemd-run --user --scope --quiet --collect --unit="comandos-rust-check-$$" \
  --property=MemoryHigh=2G --property=MemoryMax=3G --property=MemorySwapMax=512M \
  nice -n 10 bwrap --die-with-parent --new-session --unshare-all --clearenv \
  --ro-bind /usr /usr --ro-bind /bin /bin \
  --ro-bind /lib /lib --ro-bind /lib64 /lib64 \
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run --tmpfs /home \
  --dir /home/fixture --ro-bind "$task_cache/fixture-passwd" /etc/passwd \
  --ro-bind /etc/ssl/certs /etc/ssl/certs \
  --ro-bind "$task_toolchain" /opt/rust \
  --bind "$task_root" /work \
  --setenv PATH /opt/rust/bin:/usr/bin:/bin \
  --setenv CARGO_HOME /work/.migration-build/cargo \
  --setenv CARGO_TARGET_DIR /work/.migration-build/target \
  --setenv CARGO_BUILD_JOBS 1 --setenv CARGO_NET_OFFLINE true \
  --setenv CC /usr/bin/gcc --setenv CXX /usr/bin/g++ \
  --setenv CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER /usr/bin/gcc \
  --setenv LIBRARY_PATH /work/.migration-build/native \
  --setenv XDG_STATE_HOME /tmp/state \
  --setenv COMANDOS_STATE_DB /tmp/comandos-test.sqlite3 \
  --setenv PYTHONDONTWRITEBYTECODE 1 --setenv LANG C.UTF-8 \
  --setenv PYTHONPATH /work/.migration-build/python \
  --chdir /work "$@"
