#!/usr/bin/env python3
"""Development-only cache maintenance; the application does not depend on Python.

Invoked before builds. Only old, superseded Cargo dependency artifacts qualify;
sources, complete profiles, final binaries, releases and user state never do.
"""
import argparse
import collections
import fcntl
import os
from pathlib import Path
import re
import stat
import subprocess
import time


MAX_KIB = 16 * 1024 * 1024
MIN_FREE_KIB = 16 * 1024 * 1024
MIN_AGE = 7 * 86400
KEEP_VARIANTS = 2
PROC_ROOT = Path("/proc")
ARTIFACT = re.compile(r"^(?:lib)?([A-Za-z0-9_]+)-([0-9a-f]{16})\.(?:rlib|rmeta|d)$")


def allocated(path):
    return int(subprocess.check_output(["du", "-sk", "--", str(path)], text=True).split()[0])


def inside(path, root):
    return path == root or root in path.parents


def process_references(root, repository):
    """Fail closed for unreadable same-user processes or a mounted cache alias."""
    references = set()
    namespaces = set()
    for proc in PROC_ROOT.iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            status = dict(line.split(":", 1) for line in (proc / "status").read_text().splitlines() if ":" in line)
            if status["State"].strip().startswith("Z"):
                continue  # Zombies have already closed their files and mappings.
            comm = (proc / "comm").read_text().strip()
            # systemd's privileged PAM session keeper is deliberately not
            # inspectable by its user. It cannot be a Cargo worker; distinguish
            # it by both its name and its systemd parent, never ignore arbitrary
            # inaccessible same-user processes.
            if comm == "(sd-pam)":
                parent = PROC_ROOT / status["PPid"].strip()
                if os.readlink(parent / "exe") in ("/usr/lib/systemd/systemd", "/lib/systemd/systemd"):
                    continue
            if comm == "ssh-agent":
                parent = PROC_ROOT / status["PPid"].strip()
                if os.readlink(parent / "exe") == "/usr/bin/gnome-keyring-daemon":
                    continue
            if comm in ("cargo", "rustc"):
                cwd = Path(os.readlink(proc / "cwd"))
                environment = dict(entry.split(b"=", 1) for entry in (proc / "environ").read_bytes().split(b"\0") if b"=" in entry)
                cargo_target = Path(os.fsdecode(environment.get(b"CARGO_TARGET_DIR", b"/")))
                if not cargo_target.is_absolute():
                    cargo_target = cwd / cargo_target
                arguments = [os.fsdecode(value) for value in (proc / "cmdline").read_bytes().split(b"\0") if value]
                explicit_paths = []
                for index, argument in enumerate(arguments):
                    for option in ("--target-dir", "--manifest-path", "--out-dir"):
                        value = argument[len(option) + 1:] if argument.startswith(option + "=") else arguments[index + 1] if argument == option and index + 1 < len(arguments) else None
                        if value is not None:
                            path = Path(value)
                            explicit_paths.append((path if path.is_absolute() else cwd / path).resolve())
                if inside(cwd, repository) or inside(cargo_target.resolve(), root) or any(inside(path, repository) or inside(path, root) for path in explicit_paths):
                    raise RuntimeError("a compiler is using this repository")
            links = [proc / "cwd", proc / "exe", *list((proc / "fd").iterdir())]
            for link in links:
                try:
                    value = Path(os.readlink(link).removesuffix(" (deleted)"))
                except FileNotFoundError:
                    continue
                if inside(value, root):
                    references.add(value)
            for line in (proc / "maps").read_text().splitlines():
                fields = line.split(maxsplit=5)
                if len(fields) == 6 and fields[5].startswith("/"):
                    value = Path(fields[5].removesuffix(" (deleted)"))
                    if inside(value, root):
                        references.add(value)
            namespace = os.readlink(proc / "ns/mnt")
            if namespace not in namespaces:
                namespaces.add(namespace)
                for line in (proc / "mountinfo").read_text().splitlines():
                    fields = line.split()
                    value, destination = [Path(re.sub(r"\\([0-7]{3})", lambda match: chr(int(match[1], 8)), field)) for field in fields[3:5]]
                    if destination != value and (inside(value, root) or (value != Path("/") and inside(root, value))):
                        raise RuntimeError("cache artifacts are mounted in a process namespace")
        except FileNotFoundError:
            continue  # A process or descriptor exited during the snapshot.
        except (OSError, ValueError) as error:
            raise RuntimeError("cannot inspect all live cache references") from error
    return references


def candidates(root):
    profiles = [root / name for name in ("debug", "release", "release-wasm")]
    profiles += [child / name for child in root.iterdir() if child.is_dir() and not child.is_symlink()
                 for name in ("debug", "release", "release-wasm")]
    found = []
    for profile in profiles:
        deps = profile / "deps"
        if not deps.is_dir() or deps.resolve() != deps:
            continue
        groups = collections.defaultdict(lambda: collections.defaultdict(list))
        for artifact in deps.iterdir():
            match = ARTIFACT.fullmatch(artifact.name)
            if match:
                groups[match[1]][match[2]].append(artifact)
        for variants in groups.values():
            ordered = sorted(variants.values(), key=lambda paths: max(path.lstat().st_mtime for path in paths), reverse=True)
            for paths in ordered[KEEP_VARIANTS:]:
                newest = max(path.lstat().st_mtime for path in paths)
                if newest < time.time() - MIN_AGE:
                    found.append((newest, paths))
    return sorted(found, key=lambda entry: entry[0])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--workspace", required=True)
    parser.add_argument("--max-kib", type=int, default=MAX_KIB)
    parser.add_argument("--min-free-kib", type=int, default=MIN_FREE_KIB)
    args = parser.parse_args()
    if not 0 < args.max_kib <= MAX_KIB or args.min_free_kib < MIN_FREE_KIB:
        parser.error("budgets can only tighten the 16 GiB cache / 16 GiB free defaults")
    common = subprocess.check_output(["git", "-C", args.workspace, "rev-parse", "--path-format=absolute", "--git-common-dir"], text=True).strip()
    repository = Path(common).parent.resolve()
    root = repository / ".build/target-integration-acp"
    if root.resolve() != root or not root.is_dir():
        parser.error("shared target must be a real directory")
    lock_path = root.parent / "rust-build-cache.lock"
    fd = os.open(lock_path, os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        used = allocated(root)
        fs = os.statvfs(root)
        free = fs.f_bavail * fs.f_frsize // 1024
        if used <= args.max_kib and free >= args.min_free_kib:
            return
        try:
            references = process_references(root, repository)
            removed = 0
            # Aim below the admission boundary so maintenance is not repeated on
            # every build. Recent or referenced files always win over this target.
            for _, paths in candidates(root):
                snapshots = [(path, path.lstat()) for path in paths]
                if any(not stat.S_ISREG(meta.st_mode) or meta.st_mode & 0o111 or meta.st_nlink != 1 or
                       any(inside(path, reference) for reference in references)
                       for path, meta in snapshots):
                    continue
                for path, meta in snapshots:
                    current = path.lstat()
                    if (current.st_dev, current.st_ino, current.st_mtime_ns, current.st_nlink) != (meta.st_dev, meta.st_ino, meta.st_mtime_ns, 1):
                        raise RuntimeError("an artifact changed while inspecting the cache")
                for path, meta in snapshots:
                    path.unlink()
                    removed += meta.st_blocks // 2
                if used - removed <= args.max_kib * 4 // 5 and free + removed >= args.min_free_kib:
                    break
            if removed:
                print(f"Shared build cache: recycled {removed} KiB of old superseded dependency artifacts.")
        except (OSError, RuntimeError) as error:
            print(f"Shared build cache: maintenance skipped ({error}); admission limits still apply.")


if __name__ == "__main__":
    main()
