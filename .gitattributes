* text=auto

# Shell scripts always use LF, even when checked out on Windows.
# Prevents "set: pipefail: invalid option name" when run under bash on Linux/WSL.
*.sh    text eol=lf
install.sh text eol=lf
bin/*   text eol=lf
hooks/*.sh text eol=lf

# Python and configuration files also LF (used by tools that dislike CRLF).
*.py    text eol=lf
*.service text eol=lf
*.desktop.in text eol=lf

# Binary assets — never touch line endings.
*.ttf   binary
*.otf   binary
*.ico   binary
*.png   binary
*.svg   text eol=lf
