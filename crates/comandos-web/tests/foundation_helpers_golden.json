[
  {
    "name": "mdHtml",
    "args": [
      "**bold** <script>x</script> [safe](javascript:bad)"
    ],
    "expected": "<b>bold</b> &lt;script&gt;x&lt;/script&gt; <u>safe</u><br>"
  },
  {
    "name": "mdHtml",
    "args": [
      "# h\n- bullet\n---\n```rs\nlet a=1;\n```"
    ],
    "expected": "<b class=\"mdh\">h</b>• bullet<br><hr><pre>let a=1;\n</pre>"
  },
  {
    "name": "mdHtml",
    "args": [
      "|A|B|\n|--|--|\n|x|y|"
    ],
    "expected": "<table><tr><th>A</th><th>B</th></tr><tr><td>x</td><td>y</td></tr></table>"
  },
  {
    "name": "mdHtml",
    "args": [
      "/tmp/a.rs:12 ~/codebase/X/file.md"
    ],
    "expected": "<a href=\"#\" class=\"pathlink\" data-path=\"/tmp/a.rs\" title=\"Abrir con la app default\">/tmp/a.rs:12</a> <a href=\"#\" class=\"pathlink\" data-path=\"~/codebase/X/file.md\" title=\"Abrir con la app default\">~/codebase/X/file.md</a><br>"
  },
  {
    "name": "mdHtml",
    "args": [
      "*italic* ( *yes* ) x*no*"
    ],
    "expected": "<i>italic</i> ( <i>yes</i> ) x*no*<br>"
  },
  {
    "name": "mdHtml",
    "args": [
      "[label](https://a) **multi\nline**"
    ],
    "expected": "<u>label</u> **multi<br>line**<br>"
  },
  {
    "name": "mdHtml",
    "args": [
      "/tmp/a/ /one <a href=\"/tmp/a\">/tmp/b</a>"
    ],
    "expected": "<a href=\"#\" class=\"pathlink\" data-path=\"/tmp/a\" title=\"Abrir con la app default\">/tmp/a</a>/ /one &lt;a href=\"<a href=\"#\" class=\"pathlink\" data-path=\"/tmp/a\" title=\"Abrir con la app default\">/tmp/a</a>\"&gt;<a href=\"#\" class=\"pathlink\" data-path=\"/tmp/b\" title=\"Abrir con la app default\">/tmp/b</a>&lt;/a&gt;<br>"
  },
  {
    "name": "mdInline",
    "args": [
      "**b** *i* `c` [a](url)"
    ],
    "expected": "<b>b</b> <i>i</i> <code>c</code> <u>a</u>"
  },
  {
    "name": "mdInline",
    "args": [
      "***nested***"
    ],
    "expected": "<b>*nested</b>*"
  },
  {
    "name": "mdInline",
    "args": [
      "*one* *two*"
    ],
    "expected": "<i>one</i> <i>two</i>"
  },
  {
