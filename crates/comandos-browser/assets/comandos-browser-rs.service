[Unit]
Description=ComandOS remote browser broker (Rust)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/comandos-browser/bin/comandos-broker-mac serve --config %h/.config/comandos-browser/config-rs.json
WorkingDirectory=%h/.local/share/comandos-browser
Environment=TMPDIR=/tmp
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
MemoryHigh=4G
MemoryMax=6G
CPUQuota=200%
TasksMax=512
NoNewPrivileges=true

[Install]
WantedBy=default.target
