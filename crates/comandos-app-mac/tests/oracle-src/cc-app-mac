    @objc.python_method
    def _mi(self, title, action, key):
        it = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            title, action, key)
        it.setTarget_(None)  # first responder chain -> este controlador
        return it

    # -- acciones del menu --------------------------------------------------
    def reloadDashboard_(self, _s):
        self.dash_web.reload()

    def toggleTermPane_(self, _s):
        self.term_visible = not self.term_visible
        cw = self.window.contentView().frame().size.width
        pos = int(cw) if not self.term_visible else int(cw * 0.52)
        self.split.setPosition_ofDividerAtIndex_(pos, 0)

    def zoomIn_(self, _s):
        self._zoom_active(1.1)

    def zoomOut_(self, _s):
        self._zoom_active(1 / 1.1)

    def zoomReset_(self, _s):
        tab = self._tab_for_key(self.active_key)
        if tab is not None:
            try:
                tab["webview"].setMagnification_(1.0)
            except Exception:
                pass

    @objc.python_method
    def _zoom_active(self, factor):
        tab = self._tab_for_key(self.active_key)
        if tab is None:
            return
        wv = tab["webview"]
        try:
            wv.setAllowsMagnification_(True)
            cur = wv.magnification() or 1.0
            wv.setMagnification_(max(0.5, min(3.0, cur * factor)))
        except Exception:
            pass

    def newLocalTab_(self, _s):
        if self._defer_terminal_action(self.newLocalTab_, None):
            return
        cwd = self._current_cwd()
        sess = f"term-{os.getpid() % 10000}-{int(time.time()) % 100000}"
        # tmux plano (sin systemd-run): sesion scratch en el cwd actual.
        tmuxc("new-session", "-d", "-s", sess, "-c", cwd)
        label = os.path.basename(cwd) or "term"
        tab = self._add_tab(sess, label, sess, kind="scratch", cwd=cwd)
        self._select_tab(tab)
        self._save_tabs()

    def closeCurrentTab_(self, _s):
        tab = self._tab_for_key(self.active_key)
        if tab is not None and not tab["is_hub"]:
            self._close_tab(tab, confirm=True)

    def nextTab_(self, _s):
        self._cycle_tab(1)

    def prevTab_(self, _s):
        self._cycle_tab(-1)

    @objc.python_method
    def _cycle_tab(self, delta):
        if not self.tabs:
            return
        idx = next((i for i, t in enumerate(self.tabs)
                    if t["key"] == self.active_key), 0)
        self._select_tab(self.tabs[(idx + delta) % len(self.tabs)])

    # -- operaciones de pestana --------------------------------------------
    @objc.python_method
    def _current_cwd(self):
        tab = self._tab_for_key(self.active_key)
        if tab is not None and not tab["is_hub"]:
            r = tmuxc("display-message", "-p", "-t", f"={tab['key']}:",
                      "#{pane_current_path}")
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
        return os.path.expanduser("~")

    @objc.python_method
    def _select_win(self, sess, winname):
        """Replica select_win() de bin/cc-app con tmux plano: intenta la ventana
        pedida; si 'claude' se renombro, busca donde corre claude de verdad."""
        if tmuxc("select-window", "-t", f"={sess}:{winname}").returncode == 0:
            return
        if winname != "claude":
            return
        r = tmuxc("list-panes", "-s", "-t", "=" + sess,
                  "-F", "#{window_index}|#{pane_current_command}")
        for line in r.stdout.splitlines():
            idx, _, cmd = line.partition("|")
            if cmd == "claude":
                tmuxc("select-window", "-t", f"={sess}:{idx}")
                return
        tmuxc("select-window", "-t", f"={sess}:^")

    def openOrFocus_win_label_(self, sess, winname, label):
        """Abre (o enfoca) LA pestana de una sesion. Antes de abrir, POST /ensure
        (get-or-create) y selecciona la ventana pedida — equivalente a open_tab()
        de bin/cc-app pero delegando la creacion tmux a cc-dash."""
        if not sess or sess in ("local", "hub", "control"):
            return
        if self._defer_terminal_action(
                self.openOrFocus_win_label_, sess, winname, label):
            return
        existing = self._tab_for_key(sess)
        if existing is not None:
            self._select_win(sess, winname or "claude")
            self._select_tab(existing)
            self._raise()
            return
        http_post("/ensure", {"session": sess, "win": winname or "claude"})
        self._select_win(sess, winname or "claude")
        lbl = label or saved_tab_label(sess) or sess
        tab = self._add_tab(sess, lbl, sess)
        self._select_tab(tab)
        self._save_tabs()
        self._raise()

    def renameTab_to_(self, sess, label):
        tab = self._tab_for_key(sess)
        if tab is not None:
            tab["label"] = label
            self._set_tab_title(tab)
            self._relayout_strip()
            self._save_tabs()

    @objc.python_method
    def _prompt_rename(self, tab):
        alert = NSAlert.alloc().init()
        alert.setMessageText_(
            "Renombrar pestana" if ES else "Rename tab")
        tf = NSTextField.alloc().initWithFrame_(NSMakeRect(0, 0, 260, 24))
        tf.setStringValue_(tab["label"])
        alert.setAccessoryView_(tf)
        alert.addButtonWithTitle_("OK")
        alert.addButtonWithTitle_("Cancelar" if ES else "Cancel")
        if alert.runModal() == NSAlertFirstButtonReturn:
            new = str(tf.stringValue()).strip()
            if new:
                tab["label"] = new
                self._set_tab_title(tab)
                self._relayout_strip()
                # Persistir en el tablero tambien (mismo canal que el remoto).
                http_post("/rename", {"session": tab["key"], "label": new})
                self._save_tabs()

    @objc.python_method
    def _close_tab(self, tab, confirm=True):
        if tab["is_hub"]:
            return
        key, label = tab["key"], tab["label"]
        if confirm:
            alert = NSAlert.alloc().init()
            alert.setMessageText_(
                f"¿Cerrar la pestana «{label}»?" if ES
                else f"Close tab “{label}”?")
            alert.setInformativeText_(
                "La sesion tmux sigue viva; puedes recuperarla en Recientes del tablero."
                if ES else
                "The tmux session stays alive; recover it from the dashboard's Recents.")
            alert.addButtonWithTitle_("Cerrar" if ES else "Close")
            alert.addButtonWithTitle_("Cancelar" if ES else "Cancel")
            if alert.runModal() != NSAlertFirstButtonReturn:
                return
        archive_tab(key, label, reason="closed")
        self._cancel_pending_terminal_actions(key)
        self._cancel_pending_restore(key)
        tab["webview"].removeFromSuperview()
        tab["button"].removeFromSuperview()
        self.tabs = [t for t in self.tabs if t is not tab]
        self._relayout_strip()
        self._save_tabs()
        http_post("/tab-metadata-remove", {"session": key}, timeout=3)
        # Scratch con puro shell ocioso: al cerrar, matamos la sesion
        # (adios fantasmas). Si algo corre dentro, sobrevive (replica close_tab).
        if tab.get("kind") == "scratch":
            r = tmuxc("list-panes", "-s", "-t", "=" + key,
                      "-F", "#{pane_current_command}")
            cmds = set(r.stdout.split())
            if r.returncode == 0 and cmds and cmds <= {"zsh", "bash", "sh", "fish"}:
                tmuxc("kill-session", "-t", "=" + key)
        # Selecciona una pestana vecina.
        if self.tabs:
            self._select_tab(self.tabs[-1])

    @objc.python_method
    def _save_tabs(self):
        """Persist ordered tab labels, excluding the internal hub."""
        try:
            current = {}
            for t in self.tabs:
                if t["is_hub"]:
                    continue
                current[t["key"]] = t["label"]
            data = merge_tab_labels(self._restore_snapshot, current)
            os.makedirs(os.path.dirname(TABS_FILE), exist_ok=True)
            with open(TABS_FILE, "w") as f:
                json.dump(data, f)
        except Exception:
            pass

    # -- arranque de terminales / restauracion -----------------------------
    @objc.python_method
    def _boot_terminals(self):
        ensure_webterm()
        self.webterm_token = webterm_access_token()
        if not self.webterm_token:
            print("terminal token unavailable; tab opens remain queued", file=sys.stderr)
            return
        AppHelper.callAfter(self._create_hub_and_restore)

    @objc.python_method
    def _defer_terminal_action(self, callback, *args):
        if self.terminals_ready and self.webterm_token:
            return False
        self._pending_terminal_actions.append(
            (callback, args, terminal_action_session(args)))
        return True

    @objc.python_method
    def _drain_pending_terminal_actions(self):
        pending = self._pending_terminal_actions
        self._pending_terminal_actions = []
        for callback, args, _sess in pending:
            try:
                callback(*args)
            except Exception as exc:
                print(f"queued terminal action failed: {exc}", file=sys.stderr)

    @objc.python_method
    def _cancel_pending_terminal_actions(self, sess):
        remaining = [
            action for action in self._pending_terminal_actions
            if action[2] != sess
        ]
        removed = len(remaining) != len(self._pending_terminal_actions)
        self._pending_terminal_actions = remaining
        return removed

    @objc.python_method
    def _record_restore_alias(self, original, current):
        if not original or not current or original == current:
            return
        with self._restore_lock:
            self._restore_original_by_current[current] = original
            self._restore_current_by_original[original] = current

    @objc.python_method
    def _restore_current_session(self, sess):
        with self._restore_lock:
            original = self._restore_original_by_current.get(sess, sess)
            return self._restore_current_by_original.get(original, sess)

    @objc.python_method
    def _cancel_pending_restore(self, sess):
        with self._restore_lock:
            original = self._restore_original_by_current.get(sess, sess)
            current = self._restore_current_by_original.get(original, sess)
            remaining, removed = cancel_restore_snapshot(
                self._restore_snapshot, original)
            if not removed and original == sess and current == sess:
                return False
            self._restore_snapshot = remaining
            self._restore_cancelled.update((original, current, sess))
            return True

    @objc.python_method
    def _restore_is_cancelled(self, sess):
        with self._restore_lock:
            return sess in self._restore_cancelled

    @objc.python_method
    def _create_hub_and_restore(self):
        # Igual que Linux: el hub mantiene un cliente tmux en =local. cc-dash
        # usa ese cliente para detectar la app y entregar app-focus.json.
        if tmuxc("has-session", "-t", "=local").returncode != 0:
            tmuxc("new-session", "-d", "-s", "local", "-c",
                  os.path.expanduser("~"))
        hub = self._add_tab(HUB_KEY, "local", "local", is_hub=True)
        self._select_tab(hub)
        saved_tabs = load_saved_tabs()
        metadata = load_tab_metadata()
        self._restore_snapshot = saved_tabs
        with self._restore_lock:
            self._restore_cancelled.clear()
            self._restore_original_by_current.clear()
            self._restore_current_by_original.clear()
        self.terminals_ready = True
        threading.Thread(
            target=self._restore_saved, args=(saved_tabs, metadata),
            daemon=True).start()
        self._drain_pending_terminal_actions()

    @objc.python_method
    def _restore_saved(self, saved_tabs=None, metadata=None):
        seen = set()
        saved_tabs = load_saved_tabs() if saved_tabs is None else saved_tabs
        metadata = load_tab_metadata() if metadata is None else metadata
        for key, label in saved_tabs:
            if not isinstance(key, str) or not key:
                continue
            raw_sess = key.partition(":")[0]
            project = "" if raw_sess in metadata else find_project_dir(raw_sess)
            spec = restore_tab_spec(key, metadata, project)
            sess = spec["session"]
            restore_sess = sess
            kind = spec["kind"]
            host = spec["host"]
            cwd = spec["cwd"]
            if kind == "xterm" or sess in seen:
                continue  # pestanas experimentales de Linux: no aplican en Mac
            seen.add(sess)
            if self._restore_is_cancelled(restore_sess):
                continue
            if tmuxc("has-session", "-t", "=" + sess).returncode != 0:
                error = None
                if kind in ("scratch", "shell"):
                    result = tmuxc("new-session", "-d", "-s", sess, "-c",
                                   cwd if cwd and os.path.isdir(cwd)
                                   else os.path.expanduser("~"))
                    if result.returncode != 0:
                        error = result.stderr.strip() or "tmux fallo"
                elif kind == "ssh" and host:
                    response, error = http_post(
                        "/ssh-connect", {"host": host}, timeout=20)
                    if isinstance(response, dict) and response.get("session"):
                        sess = response["session"]
                        self._record_restore_alias(restore_sess, sess)
                elif kind == "ssh-tab" and host:
                    response, error = http_post(
                        "/ssh-new-tab", {"host": host}, timeout=20)
                    if isinstance(response, dict) and response.get("session"):
                        sess = response["session"]
                        self._record_restore_alias(restore_sess, sess)
                        label = response.get("label") or label
                else:
                    response, error = http_post(
                        "/ensure", {"session": sess, "cwd": cwd,
                                    "win": "claude"})
                    if isinstance(response, dict) and response.get("session"):
                        sess = response["session"]
                        self._record_restore_alias(restore_sess, sess)
                if error or tmuxc("has-session", "-t", "=" + sess).returncode != 0:
                    print(f"no pude restaurar {key}: {error or 'sesion no creada'}",
                          file=sys.stderr)
                    continue
            if (self._restore_is_cancelled(restore_sess)
                    or self._restore_is_cancelled(sess)):
                continue
            AppHelper.callAfter(
                self._restore_one, sess,
                label if isinstance(label, str) and label else None,
                kind, host, cwd, restore_sess)
        AppHelper.callAfter(self._finish_restore)

    @objc.python_method
    def _finish_restore(self):
        self._restore_snapshot = []
        self._save_tabs()
        with self._restore_lock:
            self._restore_cancelled.clear()
            self._restore_original_by_current.clear()
            self._restore_current_by_original.clear()

    @objc.python_method
    def _restore_one(self, sess, label, kind, host, cwd, restore_sess=None):
        if (self._restore_is_cancelled(restore_sess or sess)
                or self._restore_is_cancelled(sess)):
            return
        if self._tab_for_key(sess) is not None:
            return
        self._select_win(sess, "claude")
        lbl = label or sess
        self._add_tab(sess, lbl, sess, kind=kind, host=host, cwd=cwd)
        self._save_tabs()

    @objc.python_method
    def _raise(self):
        self.window.makeKeyAndOrderFront_(None)
        NSApp.activateIgnoringOtherApps_(True)

    # -- polling de estado (hilo de fondo) ---------------------------------
    @objc.python_method
    def _state_poll_loop(self):
        while True:
            items = http_get_json("/state")
            if isinstance(items, list):
                states = {it["session"]: it.get("status", "idle")
                          for it in items if it.get("session")}
                AppHelper.callAfter(self._update_dots, states)
            time.sleep(3)

    @objc.python_method
    def _update_dots(self, states):
        self._states = states
        for t in self.tabs:
            if not t["is_hub"]:
                self._set_tab_title(t)

    # -- IPC por archivos (NSTimer 500ms; mismo patron que poll_state_loop) --
    @objc.python_method
    def _start_ipc_timer(self):
        # Semilla: registra los mtimes actuales para NO disparar acciones con
        # archivos preexistentes al arrancar.
        for p in (FOCUS_FILE, OPEN_FILE, CLOSE_FILE):
            self._ipc_mtimes[p] = self._mtime(p)
        self._ipc_timer = NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(
            0.5, self, "checkIPC:", None, True)

    @objc.python_method
    def _mtime(self, path):
        try:
            return os.path.getmtime(path)
        except Exception:
            return 0

    def checkIPC_(self, _timer):
        for path, handler in ((FOCUS_FILE, self._on_focus),
                              (OPEN_FILE, self._on_open),
                              (CLOSE_FILE, self._on_close)):
            m = self._mtime(path)
            if m and m != self._ipc_mtimes.get(path):
                self._ipc_mtimes[path] = m
                try:
                    with open(path) as f:
                        handler(json.load(f))
                except Exception:
                    pass

    @objc.python_method
    def _on_focus(self, d):
        # Super+N y popups: enfoca (o abre) la pestana y sube la app al frente.
        sess = d.get("session", "")
        if sess and sess not in ("local", "hub", "control"):
            self.openOrFocus_win_label_(
                sess, d.get("win", "claude"), d.get("label") or None)
            self._raise()

    @objc.python_method
    def _on_open(self, d):
        # El remoto abrio una tab: la abrimos en segundo plano SIN robar foco.
        if self._defer_terminal_action(self._on_open, dict(d)):
            return
        sess = d.get("session", "")
        if not sess or self._tab_for_key(sess) is not None:
            return
        prev = self.active_key
        http_post("/ensure", {"session": sess, "win": "claude"})
        self._select_win(sess, "claude")
        lbl = d.get("label") or saved_tab_label(sess) or sess
        self._add_tab(sess, lbl, sess)
        self._save_tabs()
        prev_tab = self._tab_for_key(prev)
        if prev_tab is not None:
            self._select_tab(prev_tab)

    @objc.python_method
    def _on_close(self, d):
        # cc-dash ya confirmo con el usuario: cerramos sin re-preguntar.
        sess = d.get("session", "")
        queued = self._cancel_pending_terminal_actions(sess) if sess else False
        restoring = self._cancel_pending_restore(sess) if sess else False
        current_sess = self._restore_current_session(sess) if sess else sess
        tab = self._tab_for_key(sess) or self._tab_for_key(current_sess)
        if tab is not None:
            self._close_tab(tab, confirm=False)
        elif restoring:
            self._save_tabs()
            http_post("/tab-metadata-remove", {"session": sess}, timeout=3)
        elif queued:
            http_post("/tab-metadata-remove", {"session": sess}, timeout=3)

    # -- tema ---------------------------------------------------------------
    def applyTheme_(self, name):
        if name not in VALID_THEMES:
            return
        self.theme = name
        # term.html escucha postMessage({source:'comandos',type:'theme',...}).
        # En un WKWebView top-level, window === parent, asi que el check
        # event.source !== parent pasa. Lo entregamos por evaluateJavaScript.
        js = ("window.postMessage({source:'comandos',type:'theme',theme:"
              + json.dumps(name) + "},'*');")
        for t in self.tabs:
            try:
                t["webview"].evaluateJavaScript_completionHandler_(js, None)
            except Exception:
                pass

    # -- WKUIDelegate: target=_blank sale al navegador predeterminado -------
    def webView_createWebViewWithConfiguration_forNavigationAction_windowFeatures_(
            self, _webview, _configuration, navigation_action, _features):
        try:
            url = navigation_action.request().URL()
            scheme = str(url.scheme() or "").lower() if url is not None else ""
            if scheme in ("http", "https", "mailto"):
                NSWorkspace.sharedWorkspace().openURL_(url)
        except Exception as exc:
            print(f"no pude abrir enlace externo: {exc}", file=sys.stderr)
        return None

    # -- WKNavigationDelegate: reintento de carga del tablero --------------
    def webView_didFailProvisionalNavigation_withError_(self, wv, _nav, _err):
        if wv is self.dash_web:
            NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(
                2.0, self, "retryDash:", None, False)

    def retryDash_(self, _timer):
        self.dash_web.loadRequest_(_request(DASH_URL))


def _nscolor(hex_str):
    h = hex_str.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))
    return NSColor.colorWithSRGBRed_green_blue_alpha_(r, g, b, 1.0)


def _request(url):
    from Foundation import NSURLRequest
    return NSURLRequest.requestWithURL_(NSURL.URLWithString_(url))


def main():
    app = NSApplication.sharedApplication()
    controller = AppController.alloc().init()
    app.setDelegate_(controller)
    AppHelper.runEventLoop()


if __name__ == "__main__":
    main()
