# ---------------------------------------------------------------------------
def http_get_json(path, timeout=3):
    try:
        with urllib.request.urlopen(DASH_URL + path, timeout=timeout) as r:
            return json.loads(r.read().decode())
    except Exception:
        return None


def http_post(path, payload, timeout=15):
    """POST JSON a cc-dash. Devuelve (data|None, error|None)."""
    body = json.dumps(payload).encode()
    req = urllib.request.Request(DASH_URL + path, data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read().decode()
            try:
                return json.loads(raw), None
            except Exception:
                return None, None
    except urllib.error.HTTPError as e:
        try:
            return None, json.loads(e.read().decode()).get("error", str(e))
        except Exception:
            return None, str(e)
    except Exception as e:
        return None, str(e)


def tmuxc(*args):
    """tmux plano (sin scope/systemd). Igual semantica que tmuxc de bin/cc-app
    pero sin el envoltorio de Linux."""
    try:
        return subprocess.run(["tmux", *args], capture_output=True,
                              text=True, timeout=10)
    except Exception:
        class _R:  # stub para que .returncode / .stdout no exploten
            returncode = 1
            stdout = ""
            stderr = ""
        return _R()


def initial_theme():
    """Tema actual (Ajustes de cc-dash). Cae a noche si no responde."""
    p = http_get_json("/prefs")
    if isinstance(p, dict) and p.get("theme") in VALID_THEMES:
        return p["theme"]
    return DEFAULT_THEME


def term_url(sess, theme, auth):
    """file:// a dash/term.html con arg/theme/ws. Construido por NSURLComponents
    para preservar el query (loadFileURL lo respeta en el WebKit de macOS
    moderno; lo verificamos en runtime leyendo location.search)."""
    q = {"theme": theme, "ws": WS_URL, "auth": auth}
    if sess:
        q["arg"] = sess
    comps = NSURLComponents.alloc().init()
    comps.setScheme_("file")
    comps.setPath_(TERM_HTML)
    comps.setPercentEncodedQuery_(urllib.parse.urlencode(q))
    return comps.URL()


def webterm_access_token():
    data = http_get_json("/webterm-token")
    if isinstance(data, dict) and data.get("token"):
        return str(data["token"])
    try:
        with open(DASH_TOKEN_FILE) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def ssh_host_from_session(sess):
    if not isinstance(sess, str):
        return None
    if sess.startswith("ssh-"):
        return sess[4:] or None
    if sess.startswith("sshtab-"):
        host, sep, index = sess[len("sshtab-"):].rpartition("-")
        if sep and index.isdigit() and host:
            return host
    return None


TAB_KINDS = {"project", "scratch", "shell", "ssh", "ssh-tab"}


def load_tab_metadata():
    try:
        with open(TABS_META_FILE) as f:
            data = json.load(f)
    except Exception:
        return {}
    if not isinstance(data, dict):
        return {}
    out = {}
    for sess, value in data.items():
        if not isinstance(sess, str) or not isinstance(value, dict):
            continue
        kind = value.get("kind")
        if kind not in TAB_KINDS:
            continue
        item = {"kind": kind}
        if isinstance(value.get("host"), str) and value["host"]:
            item["host"] = value["host"]
        if isinstance(value.get("cwd"), str) and value["cwd"].startswith("/"):
            item["cwd"] = value["cwd"]
        out[sess] = item
    return out


def find_project_dir(sess):
    """Find a project one or two levels below ~/codebase using ccx naming."""
    base = os.path.expanduser("~/codebase")
    try:
        first_level = [entry for entry in os.scandir(base) if entry.is_dir()]
    except OSError:
        return ""
    candidates = list(first_level)
    for parent in first_level:
        try:
            candidates.extend(
                entry for entry in os.scandir(parent.path)
                if entry.is_dir() and entry.name != "node_modules")
        except OSError:
            continue
    want = sess.lower()
    for entry in candidates:
        name = entry.name.replace(".", "-").replace(":", "-")[:80]
        if name.lower() == want:
            return entry.path
    return ""


def restore_tab_spec(key, metadata, project_dir=""):
    """Resolve restoration identity from persisted metadata, with legacy fallback."""
    sess = key.partition(":")[0]
    value = metadata.get(sess, {}) if isinstance(metadata, dict) else {}
    if isinstance(value, dict) and value.get("kind") in (
            "project", "scratch", "shell", "ssh", "ssh-tab"):
        host = value.get("host", "")
        cwd = value.get("cwd", "")
        return {
            "session": sess,
            "kind": value["kind"],
            "host": host if isinstance(host, str) else "",
            "cwd": cwd if isinstance(cwd, str) else "",
        }
    if project_dir:
        return {"session": sess, "kind": "project", "host": "",
                "cwd": project_dir}
    if sess.startswith("xterm-"):
        return {"session": sess, "kind": "xterm", "host": "", "cwd": ""}
    host = ssh_host_from_session(sess)
    if host and sess.startswith("ssh-"):
        kind = "ssh"
    elif host:
        kind = "ssh-tab"
    elif sess.startswith("term-"):
        kind = "scratch"
    else:
        kind = "project"
    return {"session": sess, "kind": kind, "host": host or "", "cwd": ""}


