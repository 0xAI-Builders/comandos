def _ui_lang():
    """Idioma resuelto por cc-dash (igual que bin/cc-app._ui_lang)."""
    try:
        with urllib.request.urlopen(DASH_URL + "/conf", timeout=2) as r:
            l = json.loads(r.read().decode()).get("_lang")
            if l in ("es", "en"):
                return l
    except Exception:
        pass
    return "es" if os.environ.get("LANG", "").lower().startswith("es") else "en"


