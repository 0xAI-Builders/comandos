def load_saved_tabs():
    """Lee app-tabs.json. Acepta el formato dict {clave: etiqueta} y el viejo
    formato lista de claves. Devuelve una lista ordenada de (clave, etiqueta)."""
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
    except Exception:
        return []
    if isinstance(data, list):
        return [(k, None) for k in data if isinstance(k, str) and k]
    if isinstance(data, dict):
        return [(k, v) for k, v in data.items() if isinstance(k, str) and k]
    return []


def merge_tab_labels(saved_tabs, current_labels):
    """Keep not-yet-restored startup tabs while early actions save state."""
    out = {}
    for key, label in saved_tabs or []:
        if isinstance(key, str) and key:
            out[key] = label if isinstance(label, str) and label else key
    out.update(current_labels)
    return out


def cancel_restore_snapshot(saved_tabs, sess):
    """Remove every legacy/current key that resolves to the cancelled session."""
    remaining = []
    removed = False
    for key, label in saved_tabs or []:
        if isinstance(key, str) and key.partition(":")[0] == sess:
            removed = True
            continue
        remaining.append((key, label))
    return remaining, removed


def terminal_action_session(args):
    if not args:
        return ""
    first = args[0]
    if isinstance(first, str):
        return first
    if isinstance(first, dict) and isinstance(first.get("session"), str):
        return first["session"]
    return ""


def saved_tab_label(key):
    for k, v in load_saved_tabs():
        if k == key and isinstance(v, str) and v:
            return v
    return None


def archive_tab(key, label, reason="closed"):
    """Anade la pestana a app-tabs-history.json (Recientes). Replica el item y
    la escritura atomica de archive_tab() de bin/cc-app."""
    if not key:
        return
    cwd = ""
    r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_path}")
    if r.returncode == 0:
        cwd = r.stdout.strip()
    agent = ""
    r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_command}")
    cmd = r.stdout.strip() if r.returncode == 0 else ""
    agent = ("codex" if cmd == "node"
             else cmd if cmd in {"claude", "grok", "opencode", "gemini", "agy", "aider"}
             else "claude")
    item = {"session": key, "label": label or key, "cwd": cwd, "agent": agent,
            "reason": reason, "ts": int(time.time())}
    try:
        with open(TAB_HISTORY_FILE) as f:
            hist = json.load(f)
        if not isinstance(hist, list):
            hist = []
    except Exception:
        hist = []
    hist = [h for h in hist if not isinstance(h, dict) or h.get("session") != key]
    tmp = TAB_HISTORY_FILE + ".tmp"
    try:
        os.makedirs(os.path.dirname(TAB_HISTORY_FILE), exist_ok=True)
        with open(tmp, "w") as f:
            json.dump([item] + hist[:79], f)
        os.replace(tmp, TAB_HISTORY_FILE)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# cc-webterm: asegurar el motor del terminal web antes de la primera pestana
# ---------------------------------------------------------------------------
def ensure_webterm():
    """Arranca cc-webterm si 127.0.0.1:4779 no responde, y espera <=5s a que
    levante. Si falta ttyd, cc-webterm muere con su propio mensaje y term.html
    muestra su error en la pestana — no montamos UI de error extra."""
    def probe():
        try:
            urllib.request.urlopen(WEBTERM_TOKEN_URL, timeout=1)
            return True
        except Exception:
            return False

    if probe():
        return True
    bin_path = CC_WEBTERM if os.path.exists(CC_WEBTERM) else "cc-webterm"
    try:
        subprocess.Popen([bin_path], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except Exception:
        return False
    for _ in range(25):  # ~5s
        if probe():
            return True
        time.sleep(0.2)
    return False


# ---------------------------------------------------------------------------
# Puente del tablero: WKScriptMessageHandler "centro"
# ---------------------------------------------------------------------------
class DashBridge(NSObject):
    """Recibe los mensajes JSON que dash/index.html postea a
    window.webkit.messageHandlers.centro (mismas 3 formas que on_msg de
    bin/cc-app). Cero cambios de JS: reusamos el canal existente."""

    def initWithController_(self, controller):
        self = objc.super(DashBridge, self).init()
        if self is None:
            return None
        self.controller = controller  # el AppController (delega la logica UI)
        return self

    def userContentController_didReceiveScriptMessage_(self, ucc, message):
        try:
            d = json.loads(str(message.body()))
        except Exception:
            # message.body() ya puede venir como dict si el JS mando objeto.
            body = message.body()
            d = dict(body) if hasattr(body, "keys") else None
        if not isinstance(d, dict):
            return
        try:
            if d.get("theme"):
                self.controller.applyTheme_(d["theme"])
                return
            if d.get("type") == "rename":
                sess = d.get("session", "")
                label = d.get("label", "")
                if sess and isinstance(label, str) and label.strip():
                    self.controller.renameTab_to_(sess, label.strip())
                return
            sess = d.get("session", "")
            if sess:
                win = d.get("win", "claude")
                label = d.get("label", None)
                self.controller.openOrFocus_win_label_(
                    sess, win, label if isinstance(label, str) and label else None)
        except Exception as e:
            print(f"mensaje invalido del tablero: {e}", file=sys.stderr)


# ---------------------------------------------------------------------------
# Controlador principal / delegado de la app
# ---------------------------------------------------------------------------
class AppController(NSObject):

    # -- ciclo de vida ------------------------------------------------------
    def applicationDidFinishLaunching_(self, _notification):
        self.theme = initial_theme()
        # Cada pestana: dict con key, label, webview, button, is_hub.
        self.tabs = []
        self.active_key = None
        self.term_visible = True
        self.webterm_token = ""
        self.terminals_ready = False
        self._pending_terminal_actions = []
        self._restore_snapshot = []
        self._restore_cancelled = set()
        self._restore_original_by_current = {}
        self._restore_current_by_original = {}
        self._restore_lock = threading.RLock()
        self._ipc_mtimes = {}

        self._build_window()
        self._build_menu()
        self._start_ipc_timer()
        threading.Thread(target=self._state_poll_loop, daemon=True).start()
        # cc-webterm puede tardar; lo levantamos fuera del hilo de UI y, cuando
        # esta listo, creamos el hub y restauramos las pestanas en el main thread.
        threading.Thread(target=self._boot_terminals, daemon=True).start()

    def applicationShouldTerminateAfterLastWindowClosed_(self, _sender):
        return True

    # -- construccion de la ventana ----------------------------------------
    @objc.python_method
    def _build_window(self):
        NSApp.setActivationPolicy_(NSApplicationActivationPolicyRegular)
        # Apariencia oscura global (equivalente a prefer-dark-theme de GTK). NO
        # portamos el chrome custom de la barra: en Mac es un anti-patron y la
        # barra nativa ya trae semaforo + arrastre + fullscreen.
        try:
            NSApp.setAppearance_(
                NSAppearance.appearanceNamed_(NSAppearanceNameDarkAqua))
        except Exception:
            pass

        style = (NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
                 | NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable)
        rect = NSMakeRect(0, 0, 1280, 800)
        self.window = NSWindow.alloc().initWithContentRect_styleMask_backing_defer_(
            rect, style, NSBackingStoreBuffered, False)
        self.window.setTitle_("ComandOS")
        self.window.setMinSize_((760, 480))
        self.window.center()

        content = self.window.contentView()
        cw, ch = content.frame().size.width, content.frame().size.height

        split = NSSplitView.alloc().initWithFrame_(NSMakeRect(0, 0, cw, ch))
        split.setVertical_(True)          # divisor vertical -> paneles L/R
        split.setDividerStyle_(1)         # thin
        split.setAutoresizingMask_(NSViewWidthSizable | NSViewHeightSizable)
        self.split = split

        # Izquierda: WKWebView del tablero con el handler "centro".
        ucc = WKUserContentController.alloc().init()
        cfg = WKWebViewConfiguration.alloc().init()
        cfg.setUserContentController_(ucc)
        self._enable_local_access(cfg)
        self.dash_web = WKWebView.alloc().initWithFrame_configuration_(
            NSMakeRect(0, 0, cw * 0.52, ch), cfg)
        self.dash_web.setAutoresizingMask_(
            NSViewWidthSizable | NSViewHeightSizable)
        self.dash_web.setNavigationDelegate_(self)
        self.dash_web.setUIDelegate_(self)
        self.bridge = DashBridge.alloc().initWithController_(self)
        ucc.addScriptMessageHandler_name_(self.bridge, "centro")
        self.dash_web.loadRequest_(_request(DASH_URL))

        # Derecha: contenedor con tira de pestanas (arriba) + area de contenido.
        right = NSView.alloc().initWithFrame_(
            NSMakeRect(0, 0, cw * 0.48, ch))
        right.setAutoresizingMask_(NSViewWidthSizable | NSViewHeightSizable)
        rw, rh = right.frame().size.width, right.frame().size.height

        self.tab_scroll = NSScrollView.alloc().initWithFrame_(
            NSMakeRect(0, rh - TAB_STRIP_H, rw, TAB_STRIP_H))
        self.tab_scroll.setAutoresizingMask_(
            NSViewWidthSizable | NSViewMinYMargin)
        self.tab_scroll.setDrawsBackground_(False)
        self.tab_scroll.setHasVerticalScroller_(False)
        self.tab_scroll.setHasHorizontalScroller_(True)
        self.tab_scroll.setAutohidesScrollers_(True)
        self.tab_strip = NSView.alloc().initWithFrame_(
            NSMakeRect(0, 0, rw, TAB_STRIP_H))
        self.tab_scroll.setDocumentView_(self.tab_strip)
        right.addSubview_(self.tab_scroll)

        # Boton "+" (nueva terminal local) fijado a la derecha de la tira.
        self.plus_btn = self._make_strip_button("＋")
        self.plus_btn.setTarget_(self)
        self.plus_btn.setAction_("newLocalTab:")
        self.plus_btn.setToolTip_(
            "Nueva terminal local" if ES else "New local tab")
        self.tab_strip.addSubview_(self.plus_btn)

        self.term_area = NSView.alloc().initWithFrame_(
            NSMakeRect(0, 0, rw, rh - TAB_STRIP_H))
        self.term_area.setAutoresizingMask_(
            NSViewWidthSizable | NSViewHeightSizable)
        right.addSubview_(self.term_area)
        self.right = right

        split.addSubview_(self.dash_web)
        split.addSubview_(right)
        content.addSubview_(split)
        split.setPosition_ofDividerAtIndex_(int(cw * 0.52), 0)

        self.window.makeKeyAndOrderFront_(None)
        NSApp.activateIgnoringOtherApps_(True)

    @objc.python_method
    def _enable_local_access(self, cfg):
        """file:// necesita permiso explicito para leer los .js/.ttf del repo
        (equivalente a allow-file-access-from-file-urls de WebKitGTK)."""
        prefs = cfg.preferences()
        for k in ("allowFileAccessFromFileURLs",
                  "allowUniversalAccessFromFileURLs"):
            try:
                prefs.setValue_forKey_(True, k)
            except Exception:
                pass
        try:
            cfg.setValue_forKey_(True, "allowUniversalAccessFromFileURLs")
        except Exception:
            pass

    # -- tira de pestanas ---------------------------------------------------
    @objc.python_method
    def _make_strip_button(self, title):
        b = NSButton.alloc().initWithFrame_(NSMakeRect(0, 3, 60, 24))
        b.setBezelStyle_(NSBezelStyleRecessed)
        b.setButtonType_(NSButtonTypePushOnPushOff)
        b.setBordered_(True)
        b.setFont_(NSFont.systemFontOfSize_(11))
        b.setTitle_(title)
        return b

    @objc.python_method
    def _relayout_strip(self):
        x = 6.0
        for t in self.tabs:
            btn = t["button"]
            btn.sizeToFit()
            w = max(64.0, btn.frame().size.width + 14.0)
            btn.setFrame_(NSMakeRect(x, 3, w, 24))
            x += w + 4
        # "+" al final.
        self.plus_btn.setFrame_(NSMakeRect(x, 3, 30, 24))
        viewport = self.tab_scroll.contentSize().width
        self.tab_strip.setFrame_(
            NSMakeRect(0, 0, max(viewport, x + 36.0), TAB_STRIP_H))

    @objc.python_method
    def _set_tab_title(self, tab):
        """Titulo con punto de estado coloreado como prefijo (● + etiqueta)."""
        status = getattr(self, "_states", {}).get(tab["key"], "")
        color_hex = DOT_COLORS.get(status, DOT_IDLE)
        att = NSMutableAttributedString.alloc().init()
        dot = NSAttributedString.alloc().initWithString_attributes_(
            "● ", {
                NSForegroundColorAttributeName: _nscolor(color_hex),
                NSFontAttributeName: NSFont.systemFontOfSize_(8),
            })
        label = NSAttributedString.alloc().initWithString_attributes_(
            tab["label"], {
                NSForegroundColorAttributeName: NSColor.labelColor(),
                NSFontAttributeName: NSFont.systemFontOfSize_(11),
            })
        att.appendAttributedString_(dot)
        att.appendAttributedString_(label)
        tab["button"].setAttributedTitle_(att)

    @objc.python_method
    def _add_tab(self, key, label, sess_for_url, is_hub=False,
                 kind=None, host="", cwd=""):
        """Crea el WKWebView de la pestana y su boton. Los webviews NO se quitan
        de la jerarquia al cambiar de pestana (evita recargas) — solo togglea
        isHidden."""
        if not self.webterm_token:
            raise RuntimeError("terminal token unavailable")
        if not is_hub:
            saved = load_tab_metadata().get(key, {})
            kind = kind if kind in TAB_KINDS else saved.get("kind", "shell")
            host = host or saved.get("host", "")
            cwd = cwd or saved.get("cwd", "")
            http_post("/tab-metadata", {
                "session": key, "kind": kind, "host": host, "cwd": cwd,
            }, timeout=3)

        cfg = WKWebViewConfiguration.alloc().init()
        self._enable_local_access(cfg)
        frame = self.term_area.bounds()
        wv = WKWebView.alloc().initWithFrame_configuration_(frame, cfg)
        wv.setAutoresizingMask_(NSViewWidthSizable | NSViewHeightSizable)
        wv.setUIDelegate_(self)
        wv.loadFileURL_allowingReadAccessToURL_(
            term_url(sess_for_url, self.theme, self.webterm_token),
            NSURL.fileURLWithPath_(CC_REPO))
        wv.setHidden_(True)
        self.term_area.addSubview_(wv)

        btn = self._make_strip_button(label)
        btn.setTarget_(self)
        btn.setAction_("tabClicked:")
        # Menu contextual (click derecho): renombrar / cerrar. Cada item lleva
        # la clave de SU pestana en representedObject, asi el handler sabe sobre
        # cual actuar sin depender de la seleccion.
        btn.setMenu_(self._tab_context_menu(key))
        self.tab_strip.addSubview_(btn)

        tab = {"key": key, "label": label, "webview": wv, "button": btn,
               "is_hub": is_hub, "kind": kind or "internal",
               "host": host, "cwd": cwd}
        self.tabs.append(tab)
        self._set_tab_title(tab)
        self._relayout_strip()
        return tab

    @objc.python_method
    def _tab_context_menu(self, key):
        menu = NSMenu.alloc().init()
        rename = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Renombrar pestana…" if ES else "Rename tab…",
            "renameTabFromMenu:", "")
        rename.setTarget_(self)
        rename.setRepresentedObject_(key)
        close = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_(
            "Cerrar pestana" if ES else "Close tab", "closeTabFromMenu:", "")
        close.setTarget_(self)
        close.setRepresentedObject_(key)
        menu.addItem_(rename)
        menu.addItem_(close)
        return menu

    @objc.python_method
    def _tab_for_button(self, btn):
        for t in self.tabs:
            if t["button"] is btn:
                return t
        return None

    @objc.python_method
    def _tab_for_key(self, key):
        for t in self.tabs:
            if t["key"] == key:
                return t
        return None

    @objc.python_method
    def _select_tab(self, tab):
        if tab is None:
            return
        for t in self.tabs:
            sel = t is tab
            t["webview"].setHidden_(not sel)
            t["button"].setState_(
                NSControlStateValueOn if sel else NSControlStateValueOff)
        self.active_key = tab["key"]
        self.tab_strip.scrollRectToVisible_(tab["button"].frame())
        self.window.makeFirstResponder_(tab["webview"])

    # -- acciones de la tira (target/action) --------------------------------
    def tabClicked_(self, sender):
        self._select_tab(self._tab_for_button(sender))

    def renameTabFromMenu_(self, item):
        tab = self._tab_for_key(item.representedObject())
        if tab is not None:
            self._prompt_rename(tab)

    def closeTabFromMenu_(self, item):
        tab = self._tab_for_key(item.representedObject())
        if tab is not None:
            self._close_tab(tab, confirm=True)

    # -- menu principal -----------------------------------------------------
    @objc.python_method
    def _build_menu(self):
