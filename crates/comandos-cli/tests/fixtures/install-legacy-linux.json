    ".claude/settings.json": {
      "kind": "file",
      "sha256": "a56b23cb7adcd997d7505ac7ab96eb3708aeb59e451a825deb2984623024da5a",
      "json": {
        "hooks": {
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "{{HOME}}/.claude/hooks/cc-notify.sh",
                  "timeout": 15
                }
              ]
            }
          ],
          "Stop": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "{{HOME}}/.claude/hooks/cc-notify.sh",
                  "timeout": 15
                }
              ]
            }
          ],
          "Notification": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "{{HOME}}/.claude/hooks/cc-notify.sh",
                  "timeout": 15
                }
              ]
            }
          ],
          "SessionEnd": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "{{HOME}}/.claude/hooks/cc-notify.sh",
                  "timeout": 15
                }
              ]
            }
          ],
          "PreToolUse": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "{{HOME}}/.claude/hooks/cc-usage-tool.sh",
                  "timeout": 5
                }
              ]
            }
          ],
          "PostToolUse": [
            {
              "hooks": [
                {
                  "type": "command",
                  "command": "{{HOME}}/.claude/hooks/cc-usage-tool.sh",
                  "timeout": 5
                }
              ]
            }
          ],
          "PostToolUseFailure": []
        }
      }
    },
