#!/usr/bin/env bash
# cc-doctor — diagnóstico de ComandOS. Chequea plataforma, deps, servicios y
# fixes con confirmación. Reemplaza al .wslg-check.sh artesanal.
#
# Uso:
#   cc-doctor            chequea, imprime tabla; exit != 0 si algo FAIL
#   cc-doctor --fix      ofrece arreglar cada FAIL con confirmación
#   cc-doctor --json     una línea JSON por check
#   cc-doctor <sección>  solo esa sección: core | desktop | audio | remote
set -uo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=../lib/platform.sh
. "$REPO/lib/platform.sh"

# Modes
MODE_FIX=0
MODE_JSON=0
SECTIONS=(core desktop audio remote)

_valid_section() {
  case "$1" in core|desktop|audio|remote) return 0 ;; *) return 1 ;; esac
}

while [ $# -gt 0 ]; do
  case "$1" in
    --fix)  MODE_FIX=1; shift ;;
    --json) MODE_JSON=1; shift ;;
    -h|--help)
      sed -n '2,10p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *)
      _valid_section "$1" || { echo "sección desconocida: $1" >&2; exit 2; }
      SECTIONS=("$1"); shift ;;
  esac
done

# Result storage: parallel arrays.
_R_SEC=(); _R_NAME=(); _R_STATUS=(); _R_DETAIL=(); _R_FIX=()

_check() {
  # $1 section  $2 name  $3 status(pass|warn|fail|skip)  $4 detail  $5 fix_hint(optional)
  _R_SEC+=("$1"); _R_NAME+=("$2"); _R_STATUS+=("$3")
  _R_DETAIL+=("${4:-}"); _R_FIX+=("${5:-}")
}

_symbol() {
  case "$1" in
    pass) printf '\033[32m✓\033[0m' ;;
    warn) printf '\033[33m!\033[0m' ;;
    fail) printf '\033[31m✗\033[0m' ;;
    skip) printf '\033[90m·\033[0m' ;;
  esac
}

_render_human() {
  local last_sec=""
  local n=${#_R_SEC[@]}
  [ "$n" -eq 0 ] && return
  for i in $(seq 0 $((n - 1))); do
    if [ "${_R_SEC[$i]}" != "$last_sec" ]; then
      printf '\n%s\n' "${_R_SEC[$i]}"
      last_sec="${_R_SEC[$i]}"
    fi
    printf '  %b %-36s %s\n' "$(_symbol "${_R_STATUS[$i]}")" "${_R_NAME[$i]}" "${_R_DETAIL[$i]}"
  done
}

_render_json() {
  local n=${#_R_SEC[@]}
  [ "$n" -eq 0 ] && return
  for i in $(seq 0 $((n - 1))); do
    printf '{"section":"%s","check":"%s","status":"%s","detail":"%s"}\n' \
      "${_R_SEC[$i]}" "${_R_NAME[$i]}" "${_R_STATUS[$i]}" "${_R_DETAIL[$i]}"
  done
}

_summary() {
  local ok=0 warn=0 fail=0 n=${#_R_STATUS[@]}
  [ "$n" -eq 0 ] && return
  for i in $(seq 0 $((n - 1))); do
    case "${_R_STATUS[$i]}" in
      pass) ok=$((ok + 1)) ;;
      warn) warn=$((warn + 1)) ;;
      fail) fail=$((fail + 1)) ;;
    esac
  done
  echo ""
  echo "Resumen: $ok OK · $warn WARN · $fail FAIL"
  [ $fail -gt 0 ] && echo "Corre \`cc-doctor --fix\` para arreglar lo bloqueante."
  return $fail
}

_run_fix() {
  local n=${#_R_STATUS[@]}
  local any=0
  [ "$n" -eq 0 ] && { echo ""; echo "Nada que chequear."; return 0; }
  for i in $(seq 0 $((n - 1))); do
    case "${_R_STATUS[$i]}" in fail|warn) ;; *) continue ;; esac
    [ -n "${_R_FIX[$i]}" ] || continue
    any=1
    echo ""
    echo "→ ${_R_NAME[$i]}: ${_R_DETAIL[$i]}"
    ask_yn "  ¿Arreglo con: ${_R_FIX[$i]}?" || { echo "  skip"; continue; }
    eval "${_R_FIX[$i]}"
  done
  [ $any = 0 ] && echo "" && echo "Nada que arreglar automáticamente."
}

# URLs y sha256 hardcodeados para las voces soportadas. Rotar cuando se
# actualicen upstream (huggingface.co/rhasspy/piper-voices). Para agregar
# una voz: descarga con curl, corre `sha256sum`, pega ambos aquí.
_piper_voice_url() {
  case "$1" in
    es_MX-ald-medium)
      echo "https://huggingface.co/rhasspy/piper-voices/resolve/main/es/es_MX/ald/medium/es_MX-ald-medium.onnx"
      ;;
    *) return 1 ;;
  esac
}
_piper_voice_sha256() {
  case "$1" in
    es_MX-ald-medium) echo "019b3803293c93e34a206dd2e53a3889209a514e786fd7144f7b70196c579b63" ;;
    *) return 1 ;;
  esac
}
_fix_piper_voice() {
  local voice="$1"
  local url expected dest tmp
  url=$(_piper_voice_url "$voice") || { echo "  voz '$voice' desconocida — descarga manual"; return 1; }
  expected=$(_piper_voice_sha256 "$voice")
  dest="$HOME/.local/share/piper-voices/${voice}.onnx"
  mkdir -p "$(dirname "$dest")"
  tmp="$(mktemp)"
  echo "  Descargando $voice desde HuggingFace (~60MB)..."
  if ! curl -fL --progress-bar "$url" -o "$tmp"; then
    rm -f "$tmp"; echo "  Descarga falló."; return 1
  fi
  local got
  got=$(sha256sum "$tmp" | awk '{print $1}')
  if [ "$got" != "$expected" ]; then
    rm -f "$tmp"
    echo "  ✗ Checksum mismatch (got $got, expected $expected). Abortado."
    echo "  Descarga manual: $url"
    return 1
  fi
  mv "$tmp" "$dest"
  chmod 0644 "$dest"
  echo "  ✓ Voz $voice instalada en $dest"
}

# Section runners (implemented in Tasks 13–16)
_section_core() {
  local sec="Núcleo"
  # tmux
  if command -v tmux >/dev/null; then
    _check "$sec" "tmux" pass "$(tmux -V 2>/dev/null)"
  else
    _check "$sec" "tmux" fail "no instalado" "apt_install_confirmed tmux"
  fi
  # jq
  if command -v jq >/dev/null; then
    _check "$sec" "jq" pass "$(jq --version 2>/dev/null)"
  else
    _check "$sec" "jq" fail "no instalado" "apt_install_confirmed jq"
  fi
  # python3
  if command -v python3 >/dev/null; then
    _check "$sec" "python3" pass "$(python3 --version 2>/dev/null)"
  else
    _check "$sec" "python3" fail "no instalado" "apt_install_confirmed python3"
  fi
  # systemd --user
  if cc_systemd_ok; then
    _check "$sec" "systemd --user" pass "running"
  else
    _check "$sec" "systemd --user" fail "no responde" ""
  fi
  # cc-dash
  if curl -s -m 2 http://127.0.0.1:4777/prefs >/dev/null 2>&1; then
    _check "$sec" "cc-dash" pass "responde en 127.0.0.1:4777"
  else
    _check "$sec" "cc-dash" fail "no responde" "systemctl --user start cc-dash"
  fi
  # cc-notifyd
  if ss -ltn 2>/dev/null | grep -q ':4778 '; then
    _check "$sec" "cc-notifyd" pass "escucha en 127.0.0.1:4778"
  else
    _check "$sec" "cc-notifyd" warn "no está escuchando" "systemctl --user start cc-notifyd"
  fi
  # hooks
  if [ -x "$HOME/.claude/hooks/cc-notify.sh" ]; then
    _check "$sec" "hooks" pass "instalados en ~/.claude/hooks"
  else
    _check "$sec" "hooks" fail "no instalados" "cd $REPO && ./install.sh"
  fi
}
_section_desktop() {
  local sec="App de escritorio (cc-app)"
  local plat; plat=$(cc_platform)
  if [ "$plat" = "darwin" ]; then
    _check "$sec" "cc-app GTK" skip "no aplica en macOS"
    return
  fi
  # GTK 3
  if python3 -c "import gi; gi.require_version('Gtk','3.0'); from gi.repository import Gtk" 2>/dev/null; then
    _check "$sec" "GTK 3" pass "import OK"
  else
    _check "$sec" "GTK 3" fail "import falla" "apt_install_confirmed python3-gi gir1.2-gtk-3.0"
  fi
  # VTE 2.91
  if python3 -c "import gi; gi.require_version('Vte','2.91'); from gi.repository import Vte" 2>/dev/null; then
    _check "$sec" "VTE 2.91" pass "import OK"
  else
    _check "$sec" "VTE 2.91" fail "import falla" "apt_install_confirmed gir1.2-vte-2.91"
  fi
  # WebKit2 — try 4.1 (noble) then 4.0 (jammy). Ambos son el mismo módulo, distinta versión.
  if python3 -c "import gi; gi.require_version('WebKit2','4.1'); from gi.repository import WebKit2" 2>/dev/null; then
    _check "$sec" "WebKit2" pass "4.1"
  elif python3 -c "import gi; gi.require_version('WebKit2','4.0'); from gi.repository import WebKit2" 2>/dev/null; then
    _check "$sec" "WebKit2" pass "4.0"
  else
    local wk_pkg codename; codename=$(cc_ubuntu_codename)
    case "$codename" in
      jammy) wk_pkg="gir1.2-webkit2-4.0" ;;
      noble) wk_pkg="gir1.2-webkit2-4.1" ;;
      *)     wk_pkg="gir1.2-webkit2-4.0" ;;
    esac
    _check "$sec" "WebKit2" fail "import falla" "apt_install_confirmed $wk_pkg"
  fi
  # WSLg display (solo en WSL)
  if [ "$plat" = "linux-wsl-ubuntu" ]; then
    if [ -n "${DISPLAY:-}" ] && [ -n "${WAYLAND_DISPLAY:-}" ]; then
      _check "$sec" "WSLg display" pass "DISPLAY=$DISPLAY · WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
    else
      _check "$sec" "WSLg display" fail "\$DISPLAY o \$WAYLAND_DISPLAY vacíos" ""
    fi
    if command -v wslview >/dev/null; then
      _check "$sec" "wslview" pass "installed"
    else
      _check "$sec" "wslview" fail "missing" "apt_install_confirmed wslu"
    fi
  fi
  # wmctrl
  if command -v wmctrl >/dev/null; then
    _check "$sec" "wmctrl" pass "installed"
  else
    _check "$sec" "wmctrl" warn "missing" "apt_install_confirmed wmctrl"
  fi
}
_section_audio() {
  local sec="Audio y voz"
  local plat; plat=$(cc_platform)
  if [ "$plat" = "linux-wsl-ubuntu" ]; then
    if [ -S /mnt/wslg/PulseServer ]; then
      _check "$sec" "WSLg PulseServer" pass "/mnt/wslg/PulseServer alive"
    else
      _check "$sec" "WSLg PulseServer" warn "/mnt/wslg/PulseServer missing — audio no funcionará"
    fi
  fi
  if command -v pw-play >/dev/null; then
    _check "$sec" "pw-play" pass "installed"
  elif command -v paplay >/dev/null; then
    _check "$sec" "paplay" pass "installed"
  else
    _check "$sec" "paplay" fail "sin reproductor" "apt_install_confirmed pulseaudio-utils"
  fi
  # piper
  if command -v piper >/dev/null; then
    _check "$sec" "piper" pass "installed"
    local voice="es_MX-ald-medium"
    if [ -f "$HOME/.claude/hooks/cc-notify.conf" ]; then
      local v
      v=$(awk -F= '/^PIPER_VOICE=/ { gsub(/["'"'"']/,"",$2); print $2; exit }' \
            "$HOME/.claude/hooks/cc-notify.conf")
      [ -n "$v" ] && voice="$v"
    fi
    local model="$HOME/.local/share/piper-voices/${voice}.onnx"
    if [ -f "$model" ]; then
      _check "$sec" "voz $voice" pass "descargada"
    else
      _check "$sec" "voz $voice" warn "no descargada — cc-doctor --fix la baja" "_fix_piper_voice $voice"
    fi
  else
    _check "$sec" "piper" warn "no instalado — voz deshabilitada (opcional)"
  fi
}
_section_remote() {
  local sec="Móvil y remoto (opcional)"
  if command -v tailscale >/dev/null; then
    if tailscale status >/dev/null 2>&1; then
      _check "$sec" "tailscale" pass "conectado"
    else
      _check "$sec" "tailscale" warn "instalado pero sin sesión — corre sudo tailscale up"
    fi
  else
    _check "$sec" "tailscale" skip "no instalado"
  fi
  if command -v ttyd >/dev/null; then
    _check "$sec" "ttyd" pass "installed"
    if pgrep -f "ttyd.*cc-webterm-attach" >/dev/null 2>&1; then
      _check "$sec" "cc-webterm" pass "corriendo"
    else
      _check "$sec" "cc-webterm" warn "apagado — cc-webterm para arrancar"
    fi
  else
    _check "$sec" "ttyd" skip "no instalado"
  fi
}

_ubu_codename_hint() {
  local c
  c=$(cc_ubuntu_codename 2>/dev/null)
  [ -n "$c" ] && printf ' (%s)' "$c"
}
echo "ComandOS doctor · plataforma: $(cc_platform)$(_ubu_codename_hint)"

for s in "${SECTIONS[@]}"; do
  "_section_$s"
done

if [ "$MODE_JSON" = "1" ]; then
  _render_json
else
  _render_human
  _summary
fi

if [ "$MODE_FIX" = "1" ]; then
  _run_fix
  echo ""
  echo "Vuelve a correr cc-doctor para verificar."
fi
