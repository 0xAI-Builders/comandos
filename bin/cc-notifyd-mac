#!/usr/bin/env python3
"""Popups accionables de ComandOS para macOS (puerto nativo de bin/cc-notifyd).

En Linux el popup es una Gtk.Window con markup de Pango. En Mac no hay GTK, y
rehacer el markdown (tablas incluidas) a mano con NSAttributedString seria mucho
codigo y se veria distinto. Asi que cada popup es un NSPanel flotante y
transparente que hospeda un WKWebView: el mismo design system, tablas de verdad,
y el input/los botones son HTML.

Anatomia (identica a Linux):
  - Franja de color a la izquierda (ambar = espera / verde = termino)
  - Punto de estado + NOMBRE DEL PROYECTO (click = Abrir) + etiqueta de estado
  - Boton de mute (sincronizado con SOUND_ENABLED de cc-notify.conf) y cerrar
  - Preview renderizado; "… Ver TODO" despliega el turno completo
  - Copiar al portapapeles
  - Botones [1][2][3][4] si el prompt es numerado; [Enter][Esc] en esperas
  - Input: escribe y Enter -> llega al Claude de esa sesion tmux
  - Boton [Abrir] -> enfoca la pestana/sesion via cc-dash

Protocolo IDENTICO al de Linux, para que hooks/cc-notify.sh no cambie:
  POST 127.0.0.1:4778/notify
  {title, body, session, kind, project, options, full}

Corre como servicio:  launchctl list | grep cc-notifyd
"""
import json
import os
import re
import subprocess
import threading
import urllib.request
import http.server
import socketserver

try:
    import objc  # noqa: F401
    from Foundation import NSObject, NSMakeRect, NSTimer, NSURL
    from AppKit import (
        NSApplication, NSApp, NSPanel, NSColor, NSScreen, NSPasteboard,
        NSPasteboardTypeString, NSApplicationActivationPolicyAccessory,
        NSWindowStyleMaskBorderless, NSWindowStyleMaskNonactivatingPanel,
        NSBackingStoreBuffered, NSWindowCollectionBehaviorCanJoinAllSpaces,
        NSWindowCollectionBehaviorFullScreenAuxiliary,
        NSWindowCollectionBehaviorStationary,
    )
    from WebKit import (
        WKWebView, WKWebViewConfiguration, WKUserContentController,
    )
    from PyObjCTools import AppHelper
except ImportError:
    _es = os.environ.get("LANG", "").lower().startswith("es")
    if _es:
        print("Falta PyObjC (motor de los popups nativos de macOS). Instalalo:")
    else:
        print("PyObjC is missing (engine for the native macOS popups). Install it:")
    print("  python3 -m pip install --user --break-system-packages "
          "pyobjc-framework-Cocoa pyobjc-framework-WebKit")
    raise SystemExit(1)

try:  # nivel de ventana: por encima de apps normales, debajo de alertas del SO
    from AppKit import NSFloatingWindowLevel as _WIN_LEVEL
except ImportError:  # pragma: no cover
    _WIN_LEVEL = 3

PORT = 4778
DASH = "http://127.0.0.1:4777"
CARD_W = 470.0          # ancho de la tarjeta (igual que WIDTH en Linux)
PAD = 10.0              # colchon transparente para la sombra CSS
PANEL_W = CARD_W + PAD * 2
MARGIN = 14.0
TOP = 48.0
GAP = 10.0
MAX_POPUPS = 8
DONE_TIMEOUT = 12.0
ALLOWED_KEYS = {"Enter", "Escape", "1", "2", "3"}
SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")


def _ui_lang():
    v = "auto"
    try:
        with open(os.path.expanduser("~/.claude/hooks/cc-notify.conf")) as f:
            for line in f:
                line = line.strip()
                if line.startswith("CC_LANG="):
                    v = line.split("=", 1)[1].strip().strip('"\'')
    except Exception:
        pass
    if v in ("es", "en"):
        return v
    return "es" if os.environ.get("LANG", "").lower().startswith("es") else "en"


UI_LANG = _ui_lang()
TR = {  # (es, en) — mismas cadenas que bin/cc-notifyd
    "waiting_tag": ("espera tu respuesta", "waiting for your answer"),
    "done_tag": ("listo", "done"),
    "see_all": ("… Ver TODO", "… View ALL"),
    "see_less": ("… Ver menos", "… View less"),
    "copy": ("Copiar", "Copy"),
    "copied": ("Copiado ✓", "Copied ✓"),
    "reply_wait": ("Responde aqui y Enter...", "Reply here and press Enter..."),
    "reply_next": ("Siguiente instruccion...", "Next instruction..."),
    "open": ("Abrir", "Open"),
    "mute_tip": ("Silenciar / activar el sonido de las notificaciones",
                 "Mute / unmute notification sounds"),
}


def tr(k):
    return TR[k][0 if UI_LANG == "es" else 1]


popups = []          # NSPanel en orden de apilado (arriba -> abajo)
by_session = {}      # sesion -> NSPanel (uno por sesion, como en Linux)


# ---------------------------------------------------------------------------
# Puente a tmux / cc-dash — identico a la version Linux
# ---------------------------------------------------------------------------
def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True,
                              text=True, timeout=5)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def alive(sess):
    return (SESSION_RE.match(sess)
            and tmux("has-session", "-t", f"={sess}").returncode == 0)


def dash(path, payload):
    """cc-dash sabe donde vive el claude de un proyecto (aunque este en una
    pestana term-* de la app) — por eso las teclas van via el, no directo a
    tmux. Lanza excepcion si cc-dash no responde."""
    req = urllib.request.Request(
        DASH + path, data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=5)


def dash_get(path, timeout=1.5):
    with urllib.request.urlopen(DASH + path, timeout=timeout) as r:
        return json.loads(r.read().decode())


def send_key(sess, key):
    if key not in ALLOWED_KEYS or not SESSION_RE.match(sess):
        return
    try:
        dash("/key", {"session": sess, "key": key})
    except Exception:
        if alive(sess):
            tmux("send-keys", "-t", f"={sess}:", key)


def choose(sess, digit):
    """Opcion N de un prompt numerado: el digito y, 250ms despues, el Enter."""
    send_key(sess, digit)

    def _confirm():
        send_key(sess, "Enter")
    threading.Timer(0.25, _confirm).start()


def send_text(sess, text):
    text = (text or "").strip()
    if not text or not SESSION_RE.match(sess):
        return
    try:
        dash("/send", {"session": sess, "text": text})
    except Exception:
        if alive(sess):
            tmux("send-keys", "-t", f"={sess}:", "-l", "--", text)
            tmux("send-keys", "-t", f"={sess}:", "Enter")


def open_session(sess):
    if not SESSION_RE.match(sess):
        return
    # Delegar en cc-dash: enfoca la pestana correcta de la app (o cambia el
    # cliente tmux / abre una terminal si la app no esta abierta).
    try:
        dash("/focus", {"session": sess})
    except Exception:
        tmux("switch-client", "-t", f"={sess}")
    # En Mac no hay wmctrl: traemos ComandOS al frente con open -a (no-op si
    # no esta instalada la app).
    try:
        subprocess.run(["open", "-a", "ComandOS"], capture_output=True,
                       timeout=2)
    except Exception:
        pass


def sound_enabled():
    try:
        return str(dash_get("/conf").get("SOUND_ENABLED", "1")) != "0"
    except Exception:
        return True


def set_sound_enabled(on):
    try:
        dash("/conf-set", {"key": "SOUND_ENABLED", "value": "1" if on else "0"})
    except Exception:
        pass


def copy_to_clipboard(text):
    pb = NSPasteboard.generalPasteboard()
    pb.clearContents()
    pb.setString_forType_(text or "", NSPasteboardTypeString)


# ---------------------------------------------------------------------------
# HTML del popup — el markdown se renderiza en JS (tablas de verdad)
# ---------------------------------------------------------------------------
CSS = """
