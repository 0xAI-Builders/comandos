def load_proxy_cfg():
    try:
        with open(PROXY_FILE) as f:
            return json.load(f)
    except Exception:
        return {"port": 18765, "codex": {"model": "gpt-5.6-sol"}, "claude": {"model": "claude-fable-5"}}


def proxy_settings_enabled():
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            st = json.load(f)
        return bool((st.get("env") or {}).get("ANTHROPIC_BASE_URL"))
    except Exception:
        return False


PROXY_ENV_SINCE = os.path.expanduser("~/.claude/hooks/proxy-env-since.json")


def _proxy_env_mark(cfg_dir, on):
    """Registra DESDE cuANDO el settings.json de ese config-dir tiene el env del
    proxy: los claude arrancados antes no lo traen (el env se lee al arrancar)."""
    try:
        try:
            with open(PROXY_ENV_SINCE) as f:
                d = json.load(f)
        except Exception:
            d = {}
        key = os.path.realpath(os.path.expanduser(cfg_dir))
        if on:
            d.setdefault(key, time.time())
        else:
            d.pop(key, None)
        os.makedirs(os.path.dirname(PROXY_ENV_SINCE), exist_ok=True)
        tmp = PROXY_ENV_SINCE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, PROXY_ENV_SINCE)
    except Exception:
        pass


def _proxied(pid, env):
    """True si ese claude vivo pasa por cc-proxy: lo trae en su entorno, o su
    config-dir ya tenia el env del proxy cuando arranco."""
    if env.get(b"ANTHROPIC_BASE_URL"):
        return True
    cfg = env.get(b"CLAUDE_CONFIG_DIR", b"").decode("utf-8", "replace") or "~/.claude"
    key = os.path.realpath(os.path.expanduser(cfg))
    try:
        with open(os.path.join(key, "settings.json")) as f:
            if not (json.load(f).get("env") or {}).get("ANTHROPIC_BASE_URL"):
                return False
    except Exception:
        return False
    try:
        with open(PROXY_ENV_SINCE) as f:
            since = json.load(f).get(key)
    except Exception:
        since = None
    if not since:
        return True   # env presente y sin marca: asumir de siempre
    try:
        started = os.stat(f"/proc/{int(pid)}").st_mtime
    except Exception:
        return False
    return started >= float(since)


def _proxy_env_write(path, on, port):
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {}
    env = st.get("env") or {}
    if on:
        env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
    else:
        env.pop("ANTHROPIC_BASE_URL", None)
    st["env"] = env
    if not env:
        st.pop("env", None)
    try:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        os.replace(tmp, path)
        _proxy_env_mark(os.path.dirname(path), on)
    except Exception:
        pass


def _resume_flags(argv):
    """Flags del claude vivo que vale la pena conservar al reanudar (sin --resume/-c)."""
    flags, skip = [], 0
    rest = argv[1:]
    for i, a in enumerate(rest):
        if skip:
            skip -= 1
            continue
        if a in ("--resume", "-r", "--continue", "-c", "--session-id"):
            if a in ("--resume", "-r", "--session-id"):
                skip = 1
            continue
        if a.startswith("-"):
            flags.append(a)
            if a in ("--model", "--effort", "--permission-mode", "--add-dir"):
                skip = 1
                flags.append(rest[i + 1] if i + 1 < len(rest) else "")
    return [f for f in flags if f]


def _claude_restart_resume(pane, pid, cmd, after_cmds=(), queued=False, sess=None, gen=None):
    """/exit + relanzar `cmd` (claude --resume …) en el MISMO pane; luego teclea after_cmds
    cuando el prompt vuelve. Si queued, espera primero a que termine el turno actual."""
    def _go():
        if queued:
            for _ in range(1350):
                time.sleep(2.0)
                if sess and gen and not motor_gen_ok(sess, gen):
                    return   # cancelado o superado por un click mas nuevo
                if not claude_pane_busy(pane):
                    break
            else:
                return
            time.sleep(1.0)
        if sess and gen and not motor_gen_ok(sess, gen):
            return
        tmux("send-keys", "-t", pane, "C-u")
        time.sleep(0.15)
        tmux("send-keys", "-t", pane, "-l", "--", "/exit")
        tmux("send-keys", "-t", pane, "Enter")
        for _ in range(40):          # esperar a que el proceso muera (max 20 s)
            time.sleep(0.5)
            try:
                os.kill(int(pid), 0)
            except Exception:
                break
        time.sleep(0.8)
        tmux("send-keys", "-t", pane, "-l", "--", cmd)
        tmux("send-keys", "-t", pane, "Enter")
        if after_cmds:
            for _ in range(60):      # esperar el prompt del claude nuevo (max 30 s)
                time.sleep(0.5)
                if not claude_pane_busy(pane):
                    break
            time.sleep(1.5)
            for c in after_cmds:
                tmux("send-keys", "-t", pane, "-l", "--", c)
                tmux("send-keys", "-t", pane, "Enter")
                time.sleep(3.0)
        if sess:
            motor_result_set(sess, True, cmd.split(" claude ")[-1][:120])
    threading.Thread(target=_go, daemon=True).start()


def proxy_set_enabled(on):
    """Motor Codex para TODAS las sesiones de Claude Code: ANTHROPIC_BASE_URL en
    ~/.claude/settings.json (el proxy rutea claude-* a Anthropic tal cual, y
    gpt-* a Codex) + servicio cc-proxy. Reversible con un click."""
    port = int(load_proxy_cfg().get("port") or 18765)
    if on:
        subprocess.run(["systemctl", "--user", "enable", "--now", "cc-proxy.service"], capture_output=True, timeout=15)
    else:
        subprocess.run(["systemctl", "--user", "disable", "--now", "cc-proxy.service"], capture_output=True, timeout=15)
    # Claude Code lee `env` del settings.json de SU config-dir: aplicar a todas las cuentas
    paths = [os.path.expanduser("~/.claude/settings.json")] + [
        os.path.join(a["dir"], "settings.json") for a in claude_accounts() if a["alias"] != "main"]
    for path in paths[1:]:
        _proxy_env_write(path, on, port)
    path = paths[0]
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {}
    env = st.get("env") or {}
    if on:
        env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
    else:
        env.pop("ANTHROPIC_BASE_URL", None)
    st["env"] = env
    if not env:
        st.pop("env", None)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def claude_pane_busy(pane):
    """'' si Claude Code esta en el prompt esperando; si no, el motivo. Un comando
    tecleado a mitad de turno se encola como MENSAJE, no como comando."""
    r = tmux("capture-pane", "-p", "-t", pane, "-S", "-14")
    if r.returncode != 0:
        return ""
    tail = r.stdout.rstrip("\n")
    if re.search(r"esc to interrupt|ctrl\+c to interrupt|esc para interrumpir", tail, re.I):
        return "La sesion esta trabajando: espera a que termine el turno"
    if re.search(r"^\s*(Do you want|Allow|¿Permitir|Yes, |No, )", tail, re.M) and re.search(r"❯\s*1\.|\(y\)|Enter to confirm", tail, re.I):
        return "La sesion tiene un permiso pendiente: respondelo primero"
    if "❯" not in tail and ">" not in tail:
        return "No veo el prompt de Claude Code en esa sesion"
    return ""


# Cambios de motor/cuenta EN COLA por sesion: generacion que invalida hilos viejos.
MOTOR_GEN = {}
_MOTOR_GEN_LOCK = threading.Lock()


def motor_gen_bump(sess):
    with _MOTOR_GEN_LOCK:
        MOTOR_GEN[sess] = MOTOR_GEN.get(sess, 0) + 1
        return MOTOR_GEN[sess]


def motor_gen_ok(sess, gen):
    with _MOTOR_GEN_LOCK:
        return MOTOR_GEN.get(sess, 0) == gen


MOTOR_RESULT = {}   # sess -> {"ok": bool, "detail": str, "ts": float}
MOTOR_QUEUE_FILE = os.path.expanduser("~/.claude/hooks/motor-queue.json")


def _motor_queue_write(d):
    try:
        os.makedirs(os.path.dirname(MOTOR_QUEUE_FILE), exist_ok=True)
        tmp = MOTOR_QUEUE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, MOTOR_QUEUE_FILE)
    except Exception:
        pass


def motor_queue_put(sess, payload):
    """Cola persistente: un cambio encolado sobrevive reinicios de cc-dash."""
    try:
        with open(MOTOR_QUEUE_FILE) as f:
            d = json.load(f)
    except Exception:
        d = {}
    d[sess] = payload
    _motor_queue_write(d)


def motor_queue_pop(sess, gen):
    try:
        with open(MOTOR_QUEUE_FILE) as f:
            d = json.load(f)
    except Exception:
        return
    if sess in d and d[sess].get("gen", gen) == gen:
        d.pop(sess, None)
        _motor_queue_write(d)


def motor_apply(payload):
    """Teclea /model y /effort en el pane con certeza: espera al prompt (anti-
    carrera con doble check), confirma en el pane y reintenta; restaura los
    defaults de settings.json; reporta a MOTOR_RESULT; limpia la cola."""
    pane, cmds, provider = payload["pane"], payload["cmds"], payload["provider"]
    saved, sess, effort = payload.get("saved"), payload["sess"], payload.get("effort")
    gen, interrupt = payload["gen"], payload.get("interrupt")
    try:
        if interrupt and provider == "claude" and claude_pane_busy(pane):
            motor_stage(sess, "interrumpiendo el turno (Escape)")
            tmux("send-keys", "-t", pane, "Escape")
            time.sleep(1.5)
        if provider == "claude":
            if claude_pane_busy(pane):
                motor_stage(sess, "esperando a que termine el turno")
            for _ in range(1350):
                if not motor_gen_ok(sess, gen):
                    return   # cancelado o superado por un click mas nuevo
                if not claude_pane_busy(pane):
                    time.sleep(0.7)
                    if not claude_pane_busy(pane):
                        break
                time.sleep(2.0)
            else:
                motor_result_set(sess, False, "la sesion nunca quedo libre (45 min)")
                return
            if not motor_gen_ok(sess, gen):
                return
        for i, c in enumerate(cmds):
            if i:
                time.sleep(3.0)
                for _ in range(12):
                    if not claude_pane_busy(pane):
                        break
                    time.sleep(0.5)
            marker = ("Set model to" if c.startswith("/model ") else
                      "Set effort level" if c.startswith("/effort ") else "")
            motor_stage(sess, f"tecleando {c}")
            sent = False
            for attempt in range(3):
                if not motor_gen_ok(sess, gen):
                    return
                if provider == "claude":
                    tmux("send-keys", "-t", pane, "C-u")   # limpiar texto a medio escribir sin interrumpir nada
                    time.sleep(0.15)
                r = tmux("send-keys", "-t", pane, "-l", "--", c)
                if r.returncode != 0:
                    motor_result_set(sess, False, f"tmux fallo con {c}")
                    return
                tmux("send-keys", "-t", pane, "Enter")
                if provider != "claude" or not marker:
                    sent = True
                    break
                motor_stage(sess, f"confirmando {c.split(chr(32))[0]} en el pane")
                if claude_pane_confirm(pane, marker, 10):
                    sent = True
                    break
                motor_stage(sess, f"no entro {c.split(chr(32))[0]}: reintento {attempt + 2}/3")
                for _ in range(60):
                    if not claude_pane_busy(pane):
                        break
                    time.sleep(2.0)
            if not sent:
                motor_result_set(sess, False, f"no se confirmo {c} en el pane")
                return
        motor_result_set(sess, True, " · ".join(cmds))
        if effort and provider == "claude":
            session_effort_set(sess, effort)
        if provider == "claude" and saved:
            time.sleep(4.0 + 3.5 * (len(cmds) - 1))
            path = os.path.expanduser("~/.claude/settings.json")
            try:
                with open(path) as f:
                    st = json.load(f)
                changed = False
                for k, v in saved.items():
                    if st.get(k) != v:
                        changed = True
                        if v is None:
                            st.pop(k, None)
                        else:
                            st[k] = v
                if changed:
                    tmp = path + ".tmp"
                    with open(tmp, "w") as f:
                        json.dump(st, f, indent=2, ensure_ascii=False)
                    os.replace(tmp, path)
            except Exception:
                pass
    finally:
        motor_queue_pop(sess, gen)


def motor_queue_resume():
    """Al arrancar cc-dash: relanzar los cambios encolados que un reinicio mato."""
    try:
        with open(MOTOR_QUEUE_FILE) as f:
            d = json.load(f)
    except Exception:
        return
    for sess, payload in d.items():
        if time.time() - (payload.get("ts") or 0) > 2700:
            continue
        payload = dict(payload)
        payload["gen"] = motor_gen_bump(sess)
        payload["sess"] = sess
        motor_queue_put(sess, payload)
        threading.Thread(target=motor_apply, args=(payload,), daemon=True).start()


def motor_result_set(sess, ok, detail):
    MOTOR_RESULT[sess] = {"ok": bool(ok), "detail": str(detail)[:200], "ts": time.time()}


def motor_stage(sess, stage):
    """Progreso visible del cambio (la UI lo muestra como loading con estados)."""
    MOTOR_RESULT[sess] = {"stage": str(stage)[:120], "ts": time.time()}


def claude_pane_confirm(pane, marker, secs):
    """True si el marcador aparece en el pane dentro de N segundos."""
    for _ in range(int(secs * 2)):
        r = tmux("capture-pane", "-p", "-t", pane, "-S", "-25")
        if r.returncode == 0 and marker in r.stdout:
            return True
        time.sleep(0.5)
    return False


SESSION_EFFORT = os.path.expanduser("~/.claude/hooks/session-effort.json")


def session_effort_all():
    try:
        with open(SESSION_EFFORT) as f:
            return json.load(f)
    except Exception:
        return {}


def session_effort_set(sess, effort):
    d = session_effort_all()
    d[sess] = effort
    try:
        os.makedirs(os.path.dirname(SESSION_EFFORT), exist_ok=True)
        tmp = SESSION_EFFORT + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, SESSION_EFFORT)
    except Exception:
        pass


def effort_defaults():
    """Default de esfuerzo de Claude Code: global y por modelo (settings.json)."""
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            st = json.load(f)
    except Exception:
        return {"effort": "", "perModel": {}}
    per = {k: (v or {}).get("effortLevel") for k, v in (st.get("modelSettings") or {}).items() if isinstance(v, dict)}
    return {"effort": st.get("effortLevel") or "", "perModel": {k: v for k, v in per.items() if v}}


def motor_global():
    """'codex' si el modelo por defecto de Claude Code es gpt-*, si no 'claude'."""
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            m = str(json.load(f).get("model") or "")
    except Exception:
        m = ""
    return ("codex" if re.match(r"^(gpt|o[0-9]|codex)", m, re.I) else "claude"), m


def motor_set_global(motor, model=None):
    cfg = load_proxy_cfg()
    prov = (cfg.get("codex") if motor == "codex" else cfg.get("claude")) or {}
    allowed = {m.get("id") for m in prov.get("menu") or []}
    model = (model or "").strip()
    if model not in allowed:
        model = prov.get("model") or ("gpt-5.6-sol[1m]" if motor == "codex" else "claude-fable-5[1m]")
    path = os.path.expanduser("~/.claude/settings.json")
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {}
    st["model"] = model
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)
    return model


def proxy_alive():
    import socket
    try:
        with socket.create_connection(("127.0.0.1", int(load_proxy_cfg().get("port") or 18765)), timeout=0.3):
            return True
    except OSError:
        return False
_model_tiers_cache = {"mtime": None, "data": {}}

# agente -> (variable de entorno del dir de config, dir por defecto)
AGENT_ACCOUNT_ENV = {
    "claude": ("CLAUDE_CONFIG_DIR", "~/.claude"),
    "codex": ("CODEX_HOME", "~/.codex"),
}


def load_model_tiers():
    try:
        mtime = os.path.getmtime(MODEL_TIERS_FILE)
    except OSError:
        return _model_tiers_cache["data"]
    if _model_tiers_cache["mtime"] != mtime:
        try:
            with open(MODEL_TIERS_FILE) as f:
                data = json.load(f)
            _model_tiers_cache.update(mtime=mtime,
                                      data=data if isinstance(data, dict) else {})
        except Exception:
            pass
    return _model_tiers_cache["data"]


def model_tier(model):
    if not model:
        return ""
    cfg = load_model_tiers()
    for pat in cfg.get("patterns") or []:
        try:
            if re.search(pat.get("match", ""), model, re.I):
                return pat.get("tier") or ""
        except re.error:
            continue
    return cfg.get("defaultTier") or ""


def tier_style(tier):
    st = (load_model_tiers().get("tiers") or {}).get(tier or "")
    return st if isinstance(st, dict) else {}


def _read_environ(pid):
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as f:
            raw = f.read()
        return dict(x.split(b"=", 1) for x in raw.split(b"\0") if b"=" in x)
    except Exception:
        return {}


_ACCOUNT_PID_CACHE = {}
_ACCOUNT_EMAIL_CACHE = {}


def account_email_for_dir(path, agent):
    """Email de la cuenta que vive en ese dir de config (cache 5 min)."""
    key = (path, agent)
    hit = _ACCOUNT_EMAIL_CACHE.get(key)
    if hit and time.time() - hit[1] < 300:
        return hit[0]
    email = ""
    try:
        if agent == "codex":
            with open(os.path.join(path, "auth.json")) as f:
                a = json.load(f)
            idt = (a.get("tokens") or {}).get("id_token", "")
            if idt.count(".") >= 2:
                part = idt.split(".")[1]
                part += "=" * (-len(part) % 4)
                email = json.loads(base64.urlsafe_b64decode(part)).get("email", "")
        else:
            cfg = os.path.join(path, ".claude.json")
            if not os.path.exists(cfg):
                # instalacion clasica: ~/.claude.json vive JUNTO a ~/.claude
                cfg = os.path.join(os.path.dirname(path.rstrip("/")), ".claude.json")
            with open(cfg) as f:
                d = json.load(f)
            email = ((d.get("oauthAccount") or {}).get("emailAddress")) or ""
    except Exception:
        pass
    _ACCOUNT_EMAIL_CACHE[key] = (email, time.time())
    return email


def account_for_pid(pid, agent):
    """{'account': alias, 'accountEmail': email} del proceso del agente.
    alias = 'main' para el dir por defecto; si no, el basename del dir."""
    spec = AGENT_ACCOUNT_ENV.get(agent or "")
    if not spec or not pid:
        return {}
    key = (int(pid), agent)
    hit = _ACCOUNT_PID_CACHE.get(key)
    if hit is not None:
        return hit
    env = _read_environ(pid)
    envvar, default = spec
    raw = env.get(envvar.encode())
    base = os.path.expanduser(default)
    path = raw.decode("utf-8", "replace") if raw else base
    try:
        is_main = os.path.realpath(path) == os.path.realpath(base)
    except OSError:
        is_main = path == base
    alias = "main" if is_main else (os.path.basename(path.rstrip("/")) or "main")
    info = {"account": alias, "accountEmail": account_email_for_dir(path, agent)}
    if len(_ACCOUNT_PID_CACHE) > 4096:
        _ACCOUNT_PID_CACHE.clear()
    _ACCOUNT_PID_CACHE[key] = info
    return info


TOOL_COSTS_FILE = os.path.join(REPO_ROOT, "config", "tool-costs.json")
_tool_costs_cache = {"mtime": None, "data": {}}


def load_tool_costs():
    try:
        mtime = os.path.getmtime(TOOL_COSTS_FILE)
    except OSError:
        return _tool_costs_cache["data"]
    if _tool_costs_cache["mtime"] != mtime:
        try:
            with open(TOOL_COSTS_FILE) as f:
                d = json.load(f)
            _tool_costs_cache.update(mtime=mtime, data=d if isinstance(d, dict) else {})
        except Exception:
            pass
    return _tool_costs_cache["data"]


def _mcp_est_tokens(name):
    cfg = load_tool_costs()
    known = cfg.get("mcpServers") or {}
    for key, val in known.items():
        if key in name:
            return int(val)
    return int(cfg.get("mcpServerDefault") or 1500)


def _read_json_quiet(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def session_mcps(cwd):
    """MCPs visibles para un cwd: globales (~/.claude.json) + del proyecto
    (.mcp.json), con su estado segun settings del proyecto."""
    out = []
    settings = {}
    for fn in ("settings.json", "settings.local.json"):
        settings.update(_read_json_quiet(os.path.join(cwd, ".claude", fn)) or {})
    disabled = set(settings.get("disabledMcpjsonServers") or [])
    glob_cfg = _read_json_quiet(os.path.expanduser("~/.claude.json"))
    for name in sorted((glob_cfg.get("mcpServers") or {}).keys()):
        out.append({"name": name, "scope": "user", "enabled": True,
                    "est_tokens": _mcp_est_tokens(name), "toggleable": False})
    proj = _read_json_quiet(os.path.join(cwd, ".mcp.json"))
    for name in sorted((proj.get("mcpServers") or {}).keys()):
        out.append({"name": name, "scope": "project",
                    "enabled": name not in disabled,
                    "est_tokens": _mcp_est_tokens(name), "toggleable": True})
    return out


def _skill_dirs(cwd):
    dirs = [(os.path.expanduser("~/.claude/skills"), "user")]
    if cwd:
        dirs.append((os.path.join(cwd, ".claude", "skills"), "project"))
    return dirs


def _parse_skill_md(path):
    """(name, description, disabled) del frontmatter de un SKILL.md."""
    try:
        with open(path) as f:
            txt = f.read(20000)
    except OSError:
        return None
    m = re.match(r"^---\n(.*?)\n---", txt, re.S)
    if not m:
        return None
    fm = m.group(1)
    def field(key):
        fm_m = re.search(rf"^{key}:\s*(.+)$", fm, re.M)
        return fm_m.group(1).strip().strip("\"'") if fm_m else ""
    disabled = bool(re.search(r"^disable-model-invocation:\s*true\s*$", fm, re.M))
    return {"name": field("name") or os.path.basename(os.path.dirname(path)),
            "description": field("description"), "disabled": disabled}


def session_skills(cwd):
    cfg = load_tool_costs()
    per_char = float(cfg.get("skillCharsPerToken") or 4)
    overhead = int(cfg.get("skillOverheadTokens") or 30)
    out = []
    for base, scope in _skill_dirs(cwd):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for n in names:
            md = os.path.join(base, n, "SKILL.md")
            info = _parse_skill_md(md)
            if not info:
                continue
            est = overhead + int(len(info["name"] + info["description"]) / per_char)
            out.append({"name": info["name"], "scope": scope, "path": md,
                        "enabled": not info["disabled"],
                        "est_tokens": 0 if info["disabled"] else est,
                        "est_full": est, "toggleable": True})
    return out


def toggle_skill(path, enable):
    """Prende/apaga una skill via disable-model-invocation en su frontmatter.
    Apagada = cero tokens hasta invocarla a mano (mecanismo documentado)."""
    real = os.path.realpath(path)
    allowed = [os.path.realpath(os.path.expanduser("~/.claude/skills"))]
    if not any(real.startswith(a + os.sep) for a in allowed) or             not real.endswith("SKILL.md"):
        # skills de proyecto: permitir si el md esta bajo <algo>/.claude/skills
        if "/.claude/skills/" not in real or not real.endswith("SKILL.md"):
            return "ruta fuera de los directorios de skills"
    try:
        with open(real) as f:
            txt = f.read()
    except OSError as e:
        return str(e)
    m = re.match(r"^(---\n)(.*?)(\n---)", txt, re.S)
    if not m:
        return "SKILL.md sin frontmatter"
    fm = m.group(2)
    fm = re.sub(r"\n?disable-model-invocation:.*", "", fm)
    if not enable:
        fm += "\ndisable-model-invocation: true"
    new = "---\n" + fm + "\n---" + txt[m.end(3):]
    tmp = real + ".tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.replace(tmp, real)
    return None


def toggle_project_mcp(cwd, name, enable):
    sdir = os.path.join(cwd, ".claude")
    os.makedirs(sdir, exist_ok=True)
    spath = os.path.join(sdir, "settings.local.json")
    data = _read_json_quiet(spath)
    dis = set(data.get("disabledMcpjsonServers") or [])
    if enable:
        dis.discard(name)
    else:
        dis.add(name)
    data["disabledMcpjsonServers"] = sorted(dis)
    tmp = spath + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, spath)
    return None


