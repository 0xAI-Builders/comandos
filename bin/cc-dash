OPTIMIZATION_STATE = os.path.join(HOOKS, "optimization-default.json")
_provider_registry_cache = {"mtime": None, "data": None}


def load_provider_registry():
    try:
        mtime = os.path.getmtime(PROVIDERS_FILE)
    except OSError:
        mtime = None
    if _provider_registry_cache["data"] is None or _provider_registry_cache["mtime"] != mtime:
        _provider_registry_cache["data"] = provider_registry.load_registry(PROVIDERS_FILE)
        _provider_registry_cache["mtime"] = mtime
    return _provider_registry_cache["data"]


def token_guard_with_forecast():
    report = cc_usage.token_guard_report(USAGE_DB)
    now = time.time()
    forecasts = []
    for limit in usage_provider_limits().get("limits") or []:
        if limit.get("provider") != "claude" or (limit.get("account") or "main") != "main" or limit.get("window") != "7d":
            continue
        percent = float(limit.get("percent") or 0)
        reset = float(limit.get("resets_at") or 0)
        start = reset - 7 * 86400
        elapsed = max(1.0, now - start)
        rate_per_second = percent / elapsed if percent > 0 else 0
        exhaustion = now + ((100 - percent) / rate_per_second if rate_per_second > 0 else 10 * 86400)
        downtime = max(0.0, reset - exhaustion)
        scope = str(limit.get("scope") or "General")
        forecasts.append({"scope": scope, "percent": percent, "resetAt": int(reset),
                          "projectedExhaustionAt": int(exhaustion), "downtimeHours": round(downtime / 3600, 1),
                          "level": "critical" if downtime >= 24 else "warning" if downtime > 0 else "normal",
                          "message": (f"Al ritmo promedio actual, {scope} se agotaría {round(downtime/3600)} h antes del reset."
                                      if downtime > 0 else f"{scope} llegaría al reset con margen.")})
    report["forecasts"] = forecasts
    report["forecastLevel"] = "critical" if any(x["level"] == "critical" for x in forecasts) else "warning" if any(x["level"] == "warning" for x in forecasts) else "normal"
    return report


def optimization_state():
    try:
        with open(OPTIMIZATION_STATE) as f:
            data = json.load(f)
            return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def optimization_plans():
    try:
        with open(OPTIMIZATION_FILE) as f:
            raw = json.load(f)
    except Exception:
        raw = {"plans": []}
    registry, matrix = load_provider_registry(), capability_matrix()
    plans = []
    for plan in raw.get("plans") or []:
        item = {key: plan.get(key) for key in ("id", "label", "icon", "intent")}
        item["variants"] = {}
        for harness, selection in (plan.get("variants") or {}).items():
            try:
                provider_registry.validate_selection(registry, matrix, selection, "session_model")
                cell = next(x for x in matrix if x.get("id") == selection.get("routeId"))
                item["variants"][harness] = {**selection, "selectable": bool(cell.get("selectable")),
                                             "reason": (cell.get("reason") or {}).get("message", "")}
            except Exception:
                item["variants"][harness] = {**selection, "selectable": False, "reason": "configuración no disponible"}
        plans.append(item)
    return {"plans": plans, "active": optimization_state().get("profile") or ""}


def optimization_set_default(profile):
    catalog = optimization_plans()
    if not any(plan.get("id") == profile for plan in catalog["plans"]):
        raise ValueError("perfil desconocido")
    os.makedirs(os.path.dirname(OPTIMIZATION_STATE), exist_ok=True)
    tmp = OPTIMIZATION_STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"profile": profile, "updatedAt": int(time.time())}, f)
    os.replace(tmp, OPTIMIZATION_STATE)
    return optimization_plans()


def grok_metadata_for_pid(pid):
    env = _read_environ(pid) if pid else {}
    raw = env.get(b"GROK_HOME", b"").decode("utf-8", "replace")
    home = os.path.realpath(os.path.expanduser(raw or "~/.grok"))
    return _GROK_METADATA.read(int(pid), home) if pid else {}


def agent_info_for_pane(pane):
    if not PANE_RE.match(str(pane or "")):
        return None
    _by_session, by_cwd = agent_pane_maps(agent_procs())
    for infos in by_cwd.values():
        for info in infos:
            if info.get("pane") == pane:
                return info
    return None


def grok_pane_busy(sess, pane):
    try:
        return any(i.get("session") == sess and i.get("pane") == pane and i.get("status") == "working"
                   for i in read_states_cached(ttl=0.2))
    except Exception:
        return False


def provider_runtime_facts(public=None):
    registry = load_provider_registry()
    public = public or provider_registry.public_state(registry)
    discovered = account_registry.public_accounts(registry)
    harnesses = {key: {"available": bool(value.get("available")),
                       "authenticated": (any(a.get("selectable") for a in discovered.get(key, []))
                                         if (value.get("capabilities") or {}).get("accounts")
                                         else value.get("authenticated") is not False)}
                 for key, value in (public.get("harnesses") or {}).items()}
    # shell/agents sin authFile devuelven None: disponibilidad basta.
    for key, value in harnesses.items():
        if (public.get("harnesses") or {}).get(key, {}).get("authenticated") is None:
            value["authenticated"] = value["available"]
    # Motores: los que tienen cuentas exigen login; los que no (opencode, agy)
    # cuentan como autenticados si su binario existe (login lo maneja el CLI).
    motors = {}
    for provider in (registry.get("motors") or {}):
        if provider in discovered:
            motors[provider] = {"authenticated": any(a.get("selectable") for a in discovered.get(provider, []))}
        else:
            motors[provider] = {"authenticated": bool(harnesses.get(provider, {}).get("available"))}
    return {
        "harnesses": harnesses,
        "motors": motors,
        "gateway": {"installed": bool(shutil.which("cc-model-proxy")), "alive": proxy_alive()},
    }


def capability_matrix():
    registry = load_provider_registry()
    public = provider_registry.public_state(registry)
    return provider_registry.evaluate_capability_matrix(registry, provider_runtime_facts(public))


def _pick_motor_account(motor, preferred="main"):
    """Alias de cuenta CON LOGIN para el motor. Prefiere `preferred`, luego
    'main', luego la primera cuenta con login. Evita heredar una cuenta que ese
    motor NO tiene — la causa de 'motor_account_login_required' al cambiar de
    motor (un pane Claude en cuenta X pasaba X a Codex/Grok, que solo tienen
    'main')."""
    try:
        accts = account_registry.list_accounts(load_provider_registry(), motor)
    except Exception:
        return preferred
    live = [a for a in accts if a.get("selectable")]
    for want in (preferred, "main"):
        if want and any(a.get("alias") == want for a in live):
            return want
    return live[0].get("alias") if live else preferred


def resolve_route_selection(data, scope, current_harness=None):
    registry = load_provider_registry()
    matrix = capability_matrix()
    route_id = str(data.get("routeId") or "")
    if not route_id:
        legacy = {"claude": "claude:claude", "claude-codex": "claude:codex",
                  "claude-grok": "claude:grok", "codex": "codex:codex", "grok": "grok:grok"}
        route_id = legacy.get(str(data.get("agent") or ""), "")
    selection = {"routeId": route_id, "model": str(data.get("model") or ""),
                 "effort": str(data.get("effort") or "")}
    route = next((r for r in matrix if r.get("id") == route_id), None)
    if not route:
        raise provider_registry.ProviderRegistryError("route_unknown")
    if current_harness and route.get("harness") != current_harness:
        raise provider_registry.ProviderRegistryError("route_harness_mismatch")
    # Fill defaults before strict model/effort validation.
    motor = route.get("motor")
    spec = (registry.get("motors") or {}).get(motor) or {}
    models = spec.get("models") or []
    if not selection["model"] and models:
        selection["model"] = models[0].get("id") or ""
    chosen = next((m for m in models if m.get("id") == selection["model"]), None)
    if not selection["effort"] and chosen:
        selection["effort"] = chosen.get("defaultEffort") or ((chosen.get("efforts") or [""])[0])
    provider_registry.validate_selection(registry, matrix, selection, scope)
    harness = route.get("harness")
    harness_alias = str(data.get("harnessAccount") or data.get("account") or "main")
    if route.get("motor") == harness:
        motor_alias = str(data.get("motorAccount") or harness_alias)
    else:
        motor_alias = str(data.get("motorAccount") or "main")
    harness_caps = ((registry.get("harnesses") or {}).get(harness) or {}).get("capabilities") or {}
    motor_caps = ((registry.get("harnesses") or {}).get(route.get("motor")) or {}).get("capabilities") or {}
    try:
        if harness_caps.get("accounts"):
            harness_accounts = account_registry.list_accounts(registry, harness)
            selected_harness = next((a for a in harness_accounts if a.get("alias") == harness_alias), None)
            if not selected_harness or not selected_harness.get("selectable"):
                raise provider_registry.ProviderRegistryError("harness_account_login_required")
        else:
            harness_alias = "main"   # acp/opencode/agy: el harness no tiene cuentas propias
        if route.get("motor") == harness:
            motor_alias = harness_alias
        elif "motor" in (route.get("accountScopes") or []) and motor_caps.get("accounts"):
            motor_accounts = account_registry.list_accounts(registry, route.get("motor"))
            selected_motor = next((a for a in motor_accounts if a.get("alias") == motor_alias), None)
            if not selected_motor or not selected_motor.get("selectable"):
                raise provider_registry.ProviderRegistryError("motor_account_login_required")
            # Solo el gateway (cc-proxy) esta limitado a la cuenta main del
            # motor; por ACP el agente corre con la suscripcion que se elija.
            if motor_alias != "main" and route.get("driver") != "acp":
                raise provider_registry.ProviderRegistryError("motor_account_gateway_not_ready")
        else:
            motor_alias = "main"
    except account_registry.AccountError as exc:
        raise provider_registry.ProviderRegistryError("account_invalid") from exc
    selection["harnessAccount"] = harness_alias
    selection["motorAccount"] = motor_alias
    return route, selection


def provider_public_state():
    registry = load_provider_registry()
    public = provider_registry.public_state(registry)
    discovered = account_registry.public_accounts(registry)
    for provider, accounts in discovered.items():
        item = (public.get("harnesses") or {}).get(provider)
        if item is not None:
            item["accounts"] = [dict(account, motorSelectable=bool(account.get("selectable") and account.get("alias") == "main"))
                                for account in accounts]
            item["authenticated"] = any(a.get("selectable") for a in accounts)
    grok = (public.get("harnesses") or {}).get("grok")
    if grok is not None:
        grok["models"] = grok_state.models() or grok.get("models") or []
    matrix = provider_registry.evaluate_capability_matrix(registry, provider_runtime_facts(public))
    public["matrix"] = matrix
    public["midSessionRoutes"] = session_change_support(registry)
    public["matrixSummary"] = {"selectable": sum(bool(x.get("selectable")) for x in matrix),
                               "unavailable": sum(not x.get("selectable") for x in matrix)}
    return public


MODEL_TIERS_FILE = os.path.join(REPO_ROOT, "config", "model-tiers.json")
PROXY_FILE = os.path.join(REPO_ROOT, "config", "proxy.json")


def load_proxy_cfg():
    try:
        with open(PROXY_FILE) as f:
            return json.load(f)
    except Exception:
        return {"port": 18765, "codex": {"model": "gpt-5.6-sol"}, "claude": {"model": "claude-fable-5"}}


def proxy_settings_enabled():
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            st = json.load(f)
        return bool((st.get("env") or {}).get("ANTHROPIC_BASE_URL"))
    except Exception:
        return False


PROXY_ENV_SINCE = os.path.expanduser("~/.claude/hooks/proxy-env-since.json")


def _proxy_env_mark(cfg_dir, on):
    """Registra DESDE cuANDO el settings.json de ese config-dir tiene el env del
    proxy: los claude arrancados antes no lo traen (el env se lee al arrancar)."""
    try:
        try:
            with open(PROXY_ENV_SINCE) as f:
                d = json.load(f)
        except Exception:
            d = {}
        key = os.path.realpath(os.path.expanduser(cfg_dir))
        if on:
            d.setdefault(key, time.time())
        else:
            d.pop(key, None)
        os.makedirs(os.path.dirname(PROXY_ENV_SINCE), exist_ok=True)
        tmp = PROXY_ENV_SINCE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, PROXY_ENV_SINCE)
    except Exception:
        pass


def _proxied(pid, env):
    """True si ese claude vivo pasa por cc-proxy: lo trae en su entorno, o su
    config-dir ya tenia el env del proxy cuando arranco."""
    if env.get(b"ANTHROPIC_BASE_URL"):
        return True
    cfg = env.get(b"CLAUDE_CONFIG_DIR", b"").decode("utf-8", "replace") or "~/.claude"
    key = os.path.realpath(os.path.expanduser(cfg))
    try:
        with open(os.path.join(key, "settings.json")) as f:
            if not (json.load(f).get("env") or {}).get("ANTHROPIC_BASE_URL"):
                return False
    except Exception:
        return False
    try:
        with open(PROXY_ENV_SINCE) as f:
            since = json.load(f).get(key)
    except Exception:
        since = None
    if not since:
        return True   # env presente y sin marca: asumir de siempre
    try:
        started = os.stat(f"/proc/{int(pid)}").st_mtime
    except Exception:
        return False
    return started >= float(since)


def _proxy_env_write(path, on, port):
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {}
    env = st.get("env") or {}
    if on:
        env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
    else:
        env.pop("ANTHROPIC_BASE_URL", None)
    st["env"] = env
    if not env:
        st.pop("env", None)
    try:
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f, indent=2, ensure_ascii=False)
        os.replace(tmp, path)
        _proxy_env_mark(os.path.dirname(path), on)
    except Exception:
        pass


def _resume_flags(argv):
    """Flags del claude vivo que vale la pena conservar al reanudar (sin --resume/-c)."""
    flags, skip = [], 0
    rest = argv[1:]
    for i, a in enumerate(rest):
        if skip:
            skip -= 1
            continue
        if a in ("--resume", "-r", "--continue", "-c", "--session-id"):
            if a in ("--resume", "-r", "--session-id"):
                skip = 1
            continue
        if a.startswith("-"):
            flags.append(a)
            if a in ("--model", "--effort", "--permission-mode", "--add-dir"):
                skip = 1
                flags.append(rest[i + 1] if i + 1 < len(rest) else "")
    return [f for f in flags if f]


def motor_lock_env(motor, model):
    """Pin every Claude Code slot/subagent to the selected subscription motor."""
    if motor not in ("codex", "grok") or not model:
        return {}
    return {
        "ANTHROPIC_DEFAULT_OPUS_MODEL": model,
        "ANTHROPIC_DEFAULT_SONNET_MODEL": model,
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": model,
        "CLAUDE_CODE_SUBAGENT_MODEL": model,
    }


def _restore_shell_tty(pane):
    tty = tmux("display-message", "-p", "-t", pane, "#{pane_tty}").stdout.strip()
    if tty.startswith("/dev/pts/"):
        subprocess.run(["stty", "sane", "-F", tty], capture_output=True, timeout=3)


def _send_shell_line(pane, command):
    """Teclea un comando de shell y Enter. NO usa paste-buffer -p: zsh imprime
    ^[[200~ (bracketed paste) y el usuario no puede usar el CLI."""
    r = tmux("send-keys", "-t", pane, "-l", "--", str(command or ""))
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "tmux send-keys fallo")
    tmux("send-keys", "-t", pane, "Enter")


def _paste_shell_command(pane, command):
    error = snippet_paste_to_pane(pane, command, tmux_stdin)
    if error:
        raise RuntimeError(error)
    tmux("send-keys", "-t", pane, "Enter")


def _claude_restart_resume(pane, pid, cmd, after_cmds=(), queued=False, sess=None, gen=None, config=None):
    """/exit + relanzar `cmd` (claude --resume …) en el MISMO pane; luego teclea after_cmds
    cuando el prompt vuelve. Si queued, espera primero a que termine el turno actual."""
    def _go():
        if queued:
            for _ in range(1350):
                time.sleep(2.0)
                if sess and gen and not motor_gen_ok(sess, gen):
                    return   # cancelado o superado por un click mas nuevo
                if not claude_pane_busy(pane):
                    break
            else:
                return
            time.sleep(1.0)
        if sess and gen and not motor_gen_ok(sess, gen):
            return
        tmux("send-keys", "-t", pane, "C-u")
        time.sleep(0.15)
        tmux("send-keys", "-t", pane, "-l", "--", "/exit")
        tmux("send-keys", "-t", pane, "Enter")
        for _ in range(40):          # esperar a que el proceso muera (max 20 s)
            time.sleep(0.5)
            try:
                os.kill(int(pid), 0)
            except Exception:
                break
        else:
            if sess:
                motor_result_set(sess, False, "Claude no cerró a tiempo; la conversación original sigue intacta")
            return
        time.sleep(0.4)
        try:
            _restore_shell_tty(pane)
            _send_shell_line(pane, cmd)
        except Exception as exc:
            if sess:
                motor_result_set(sess, False, f"no se pudo relanzar Claude: {exc}")
            return
        live = None
        for _ in range(80):
            time.sleep(0.5)
            candidate = agent_info_for_pane(pane)
            if candidate and candidate.get("agent") == "claude" and int(candidate.get("pid") or 0) != int(pid):
                live = candidate
                break
        if not live:
            if sess:
                motor_result_set(sess, False, "Claude salió, pero el resume no arrancó; usa Reintentar")
            return
        if after_cmds:
            time.sleep(0.8)
            for c in after_cmds:
                _send_shell_line(pane, c)
                time.sleep(0.5)
        if config:
            record_runtime_config(config["session"], pane, config["harness"], config["motor"],
                                  config["model"], config.get("effort", ""), config.get("harness_account", "unknown"),
                                  config.get("motor_account", "unknown"), config["route_id"], "switch-restart-confirmed")
        if sess:
            motor_result_set(sess, True, f"{config.get('model','')} · {config.get('effort','')}" if config else cmd.split(" claude ")[-1][:120],
                             harness=config.get("harness") if config else None, motor=config.get("motor") if config else None,
                             model=config.get("model") if config else None, effort=config.get("effort") if config else None)
        if sess and gen:
            motor_queue_pop(sess, gen)
    threading.Thread(target=_go, daemon=True).start()


def resume_restart_payload(payload):
    info = _claude_info_for(payload["sess"], payload.get("pane", "")) or {}
    pid = info.get("pid")
    if pid:
        _claude_restart_resume(payload["pane"], pid, payload["restart_cmd"],
                               after_cmds=payload.get("after_cmds") or (), queued=bool(payload.get("queued")),
                               sess=payload["key"], gen=payload["gen"], config=payload.get("config"))
        return
    # The old CLI may already have exited before cc-dash restarted.
    try:
        _restore_shell_tty(payload["pane"])
        _send_shell_line(payload["pane"], payload["restart_cmd"])
    except Exception as exc:
        motor_result_set(payload["key"], False, f"no se pudo recuperar el resume: {exc}")
        return
    motor_stage(payload["key"], "recuperando conversación y motor", "recover",
                model=(payload.get("config") or {}).get("model"))
    def verify():
        for _ in range(80):
            time.sleep(0.5)
            live = agent_info_for_pane(payload["pane"])
            if live and live.get("agent") == "claude":
                config = payload.get("config") or {}
                if config:
                    record_runtime_config(config["session"], payload["pane"], config["harness"], config["motor"],
                                          config["model"], config.get("effort", ""), config.get("harness_account", "unknown"),
                                          config.get("motor_account", "unknown"), config["route_id"], "switch-restart-recovered")
                motor_result_set(payload["key"], True, f"{config.get('model','')} · {config.get('effort','')}",
                                 harness=config.get("harness"), motor=config.get("motor"), model=config.get("model"), effort=config.get("effort"))
                motor_queue_pop(payload["key"], payload["gen"])
                return
        motor_result_set(payload["key"], False, "no se pudo recuperar Claude después del reinicio")
    threading.Thread(target=verify, daemon=True).start()


# ---------- HANDOFF entre harnesses (Claude Code ↔ Codex CLI ↔ Grok Build) ----------
# Cambiar el HARNESS (el CLI) de un pane vivo NO conserva la memoria interna del
# agente (cada CLI es un proceso distinto). Lo honesto: capturar un handoff con lo
# VISIBLE (objetivo, últimos pasos, git) — nunca secretos ni reasoning oculto —,
# salir del CLI actual, lanzar el nuevo en el MISMO pane e inyectarle ese contexto.

HANDOFF_FILE = ".comandos-handoff.md"
ACP_PANES_FILE = os.path.expanduser("~/.claude/hooks/acp-panes.json")
PANE_RESUME_FILE = os.path.join(HOOKS, "pane-resume.json")
_pane_resume_lock = threading.Lock()


def pane_resume_get(sess, pane, harness="claude"):
    """sessionId guardado al salir de un CLI, para --resume al volver."""
    try:
        with open(PANE_RESUME_FILE) as fh:
            data = json.load(fh) or {}
        row = data.get(f"{sess}|{pane}") or data.get(sess) or {}
        item = row.get(harness) if isinstance(row, dict) else None
        if isinstance(item, dict):
            return str(item.get("sid") or "")
        return str(item or "")
    except Exception:
        return ""


def pane_resume_set(sess, pane, harness, sid, account="main"):
    if not sid:
        return
    key = f"{sess}|{pane}" if pane else sess
    with _pane_resume_lock:
        try:
            with open(PANE_RESUME_FILE) as fh:
                data = json.load(fh) or {}
        except Exception:
            data = {}
        row = data.get(key) if isinstance(data.get(key), dict) else {}
        row[str(harness)] = {"sid": str(sid), "account": str(account or "main"),
                             "at": int(time.time())}
        data[key] = row
        tmp = PANE_RESUME_FILE + ".tmp"
        os.makedirs(os.path.dirname(PANE_RESUME_FILE), exist_ok=True)
        with open(tmp, "w") as fh:
            json.dump(data, fh)
        os.replace(tmp, PANE_RESUME_FILE)


def acp_state_for_pane(pane):
    """Estado que publica cc-acp (motor, modelo, cuenta, sessionId) por pane tmux."""
    try:
        with open(ACP_PANES_FILE) as f:
            data = json.load(f) or {}
        return data.get(str(pane or "")) or {}
    except Exception:
        return {}


def harness_pane_busy(sess, pane, harness):
    if harness in ("", "shell"):
        return False
    if harness == "claude":
        return claude_pane_busy(pane)
    return grok_pane_busy(sess, pane)


def capture_handoff(pane, from_harness, to_harness, cwd, sid="", transcript_path=""):
    """Texto de handoff efímero. Solo lo que YA se ve en el pane + estado git;
    cero prompts/secretos/tool payloads. Si hay transcript de Claude, se apunta
    al archivo (el contenido NO se copia: el sid sirve para --resume al volver)."""
    try:
        branch = subprocess.run(["git", "-C", cwd, "rev-parse", "--abbrev-ref", "HEAD"],
                                capture_output=True, text=True, timeout=5).stdout.strip()
        st = subprocess.run(["git", "-C", cwd, "status", "--short"],
                            capture_output=True, text=True, timeout=5).stdout.strip()
        diff = subprocess.run(["git", "-C", cwd, "diff", "--stat"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        branch = st = diff = ""
    raw = tmux("capture-pane", "-p", "-t", pane, "-S", "-90").stdout or ""
    keep = []
    for ln in raw.splitlines():
        s = ln.rstrip()
        if not s:
            continue
        if re.match(r"^[\s]*[─━=\-]{8,}", s):
            continue
        if any(m in s for m in ("auto mode on", "bypass permissions", "for agents",
                                "shift+tab to cycle", "esc to interrupt")):
            continue
        keep.append(s)
    tail = "\n".join(keep[-45:])
    transcript = ""
    if sid:
        path = transcript_path or _transcript_path(sid)
        if path:
            transcript = (f"\n## Transcript de {from_harness} (se conserva en disco)\n"
                          f"Archivo: `{path}`\n"
                          f"sessionId: `{sid}` — al VOLVER a {from_harness} ComandOS "
                          f"lanza `--resume` con este id. La memoria interna del TUI "
                          f"NO se copia a {to_harness}.\n")
    return (f"# Handoff de ComandOS — {from_harness} → {to_harness}\n\n"
            f"Vienes de una sesión de **{from_harness}** en `{cwd}`. Eres un CLI "
            f"distinto: NO tienes su memoria interna. Usa esto para continuar la MISMA tarea.\n\n"
            f"## Estado git (rama {branch or '?'})\n```\n{(st or '(sin cambios sin commitear)')}\n"
            f"{diff}\n```\n"
            f"{transcript}\n"
            f"## Últimos pasos visibles de la sesión anterior\n```\n{tail}\n```\n\n"
            f"Continúa desde aquí. Revisa archivos y git si necesitas más contexto. "
            f"Cuando termines de leer, puedes borrar este archivo.\n")


def _harness_bin(name):
    """Ruta absoluta del CLI: tmux hereda un PATH corto (sin ~/.opencode/bin)."""
    spec = (load_provider_registry().get("harnesses") or {}).get(name) or {}
    binary = spec.get("binary") or name
    return provider_registry.which(binary) or binary


def _native_launch_model(harness, model, effort):
    """Descarta modelo/esfuerzo que el CLI destino no entiende.

    OpenCode aborta con 'Invalid model format' si le pasas claude-fable-5.
    Un effort de Claude (xhigh) tampoco es válido en agy."""
    model, effort = str(model or ""), str(effort or "")
    try:
        registry = load_provider_registry()
    except Exception:
        return model, effort
    motor = (registry.get("motors") or {}).get(harness) or {}
    models = [m for m in (motor.get("models") or []) if isinstance(m, dict) and m.get("id")]
    ids = {m["id"] for m in models}
    harness_models = [m for m in ((registry.get("harnesses") or {}).get(harness) or {}).get("models") or []
                      if isinstance(m, dict) and m.get("id")]
    ids.update(m["id"] for m in harness_models)
    pat = str(motor.get("modelMatch") or "")
    fits = False
    if model:
        if model in ids:
            fits = True
        elif pat:
            try:
                fits = bool(re.search(pat, model, re.I))
            except re.error:
                fits = False
    if not fits:
        return "", ""
    spec = next((m for m in models + harness_models if m.get("id") == model), None)
    allowed = list(spec.get("efforts") or []) if spec else []
    if effort and allowed and effort not in allowed:
        effort = str(spec.get("defaultEffort") or "")
    if effort and spec is not None and not allowed:
        effort = ""
    return model, effort


def _harness_launch_cmd(to_harness, model, effort, account, resume=""):
    """Comando de shell para lanzar `to_harness` con su cuenta/modelo/effort —
    misma forma que /session-new. `resume` reanuda el transcript de Claude."""
    model, effort = _native_launch_model(to_harness, model, effort)
    binary = _harness_bin(to_harness)
    quoted = shlex.quote(binary) if binary else to_harness
    try:
        env = account_registry.account_environment(load_provider_registry(), to_harness, account)
        prefix = " ".join(f"{k}={shlex.quote(v)}" for k, v in env.items())
    except Exception:
        prefix = ""
    prefix = (prefix + " ") if prefix else ""
    if to_harness == "claude":
        cmd = prefix + quoted
        if resume:
            cmd += " --resume " + shlex.quote(resume)
        if model:
            cmd += " --model " + shlex.quote(model)
        if effort:
            cmd += " --effort " + shlex.quote(effort)
    elif to_harness == "codex":
        cmd = prefix + quoted
        if model:
            cmd += " -m " + shlex.quote(model)
        if effort:
            cmd += " -c " + shlex.quote(f'model_reasoning_effort="{effort}"')
    elif to_harness == "grok":
        cmd = prefix + quoted
        if model:
            cmd += " --model " + shlex.quote(model)
        if effort:
            cmd += " --effort " + shlex.quote(effort)
    elif to_harness == "opencode":
        cmd = quoted + (" --model " + shlex.quote(model) if model else "")
    elif to_harness == "agy":
        cmd = quoted + (" --model " + shlex.quote(model) if model else "") + (" --effort " + shlex.quote(effort) if effort else "")
    else:
        cmd = ""
    return cmd


def _acp_launch_cmd(motor, model, effort, account, danger=False, resume=""):
    """Comando del pane cliente ACP: `cc-acp --agent <motor> ...`. La cuenta
    es la del MOTOR (cc-acp resuelve el env de la suscripción por registro)."""
    model, effort = _native_launch_model(str(motor or "claude"), model, effort)
    cmd = "cc-acp --agent " + shlex.quote(str(motor or "claude"))
    if model:
        cmd += " --model " + shlex.quote(model)
    if effort:
        cmd += " --effort " + shlex.quote(effort)
    if account and account != "main":
        cmd += " --account " + shlex.quote(account)
    if resume:
        cmd += " --resume " + shlex.quote(resume)
    if danger:
        cmd += " --danger"
    return cmd


def _pane_exit_current(pane, pid, from_harness, expected_start=None):
    """Sale del CLI actual y espera a que muera. /exit primero; si no, Ctrl-C
    doble; en última instancia SIGTERM al pid (nunca a ciegas por patrón)."""
    if from_harness in ("", "shell"):
        return True
    started = _process_start(pid)
    if expected_start is not None and started != expected_start:
        return False
    if not started:
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            return True
        return False
    tmux("send-keys", "-t", pane, "Escape")
    time.sleep(0.12)
    tmux("send-keys", "-t", pane, "C-u")
    time.sleep(0.15)
    if from_harness in ("claude", "acp"):
        tmux("send-keys", "-t", pane, "Escape")
        time.sleep(0.1)
        tmux("send-keys", "-t", pane, "-l", "--", "/exit")
        tmux("send-keys", "-t", pane, "Enter")
    else:
        tmux("send-keys", "-t", pane, "C-c")
        time.sleep(0.3)
        tmux("send-keys", "-t", pane, "C-c")
    for _ in range(30):          # hasta 15 s
        time.sleep(0.5)
        if _process_start(pid) != started:
            return True
        try:
            os.kill(int(pid), 0)
        except Exception:
            return True
    if _process_start(pid) != started:
        return True
    try:
        os.kill(int(pid), 15)
        time.sleep(1.0)
    except Exception:
        pass
    try:
        os.kill(int(pid), 0)
        return False
    except Exception:
        return True


_SESSION_OPERATIONS = None
_SESSION_OPERATIONS_LOCK = threading.Lock()


def session_operation_store():
    global _SESSION_OPERATIONS
    with _SESSION_OPERATIONS_LOCK:
        if _SESSION_OPERATIONS is None:
            _SESSION_OPERATIONS = session_operations.OperationStore(os.path.join(HOOKS, 'session-operations.sqlite3'))
            _SESSION_OPERATIONS.recover_abandoned()
    return _SESSION_OPERATIONS


def _configuration_command(harness, motor, model, effort, account, resume='', flags=()):
    """Build one launch containing the complete draft. No fallback to latest."""
    binary = _harness_bin('acp' if harness == 'acp' else harness)
    if not provider_registry.which(binary):
        raise ValueError(f'no encuentro el ejecutable {binary}')
    registry = load_provider_registry()
    provider = motor if harness == 'acp' else harness
    caps = ((registry.get('harnesses') or {}).get(provider) or {}).get('capabilities') or {}
    environment = account_registry.account_environment(registry, provider, account) if caps.get('accounts') else {}
    if harness == 'claude' and motor != 'claude':
        if not proxy_alive():
            raise ValueError('el gateway local no responde')
        environment['ANTHROPIC_BASE_URL'] = f'http://127.0.0.1:{int(load_proxy_cfg().get("port") or 18765)}'
        environment.update(motor_lock_env(motor, model))
    clear = ('CLAUDE_CONFIG_DIR', 'CODEX_HOME', 'GROK_HOME', 'ANTHROPIC_BASE_URL',
             'ANTHROPIC_DEFAULT_OPUS_MODEL', 'ANTHROPIC_DEFAULT_SONNET_MODEL',
             'ANTHROPIC_DEFAULT_HAIKU_MODEL', 'ANTHROPIC_MODEL', 'CLAUDE_CODE_SUBAGENT_MODEL')
    argv = ['env']
    for name in clear:
        argv.extend(['-u', name])
    argv.extend(f'{key}={value}' for key, value in environment.items())
    argv.append(binary)
    if harness == 'acp':
        argv.extend(['--agent', motor])
        if account != 'main':
            argv.extend(['--account', account])
    if resume:
        argv.extend(['resume', resume] if harness == 'codex' else ['--resume', resume])
    if model:
        argv.extend(['-m' if harness == 'codex' else '--model', model])
    if effort:
        argv.extend(['-c', f'model_reasoning_effort="{effort}"'] if harness == 'codex' else ['--effort', effort])
    # Preserve explicit permissions only when resuming the same CLI. Model and
    # effort are supplied once, with the latest observed values.
    i = 0
    while i < len(flags):
        flag = flags[i]
        if flag in ('--model', '-m', '--effort'):
            i += 2
            continue
        if flag.split('=', 1)[0] in ('--model', '--effort'):
            i += 1
            continue
        if flag in ('-c', '--config') and i + 1 < len(flags):
            if flags[i + 1].split('=', 1)[0].strip() in ('model', 'model_reasoning_effort'):
                i += 2
                continue
            argv.extend([flag, flags[i + 1]])
            i += 2
            continue
        if flag.startswith('--config=') and flag.split('=', 2)[1].strip() in ('model', 'model_reasoning_effort'):
            i += 1
            continue
        argv.append(flag)
        i += 1
    return shlex.join(argv)


def _snapshot_transcript(origin):
    agent = origin.get('agent')
    if agent not in ('claude', 'codex', 'grok'):
        return ''
    sid = origin.get('resume_id') or ''
    if not sid or not re.fullmatch(r'[A-Za-z0-9_-]+', sid):
        raise ValueError('identificador de conversación inválido')
    root_key, default, pattern = {
        'claude': ('claude_config_dir', '~/.claude', f'projects/*/{sid}.jsonl'),
        'codex': ('codex_home', '~/.codex', f'sessions/**/rollout-*{sid}.jsonl'),
        'grok': ('grok_home', '~/.grok', f'sessions/**/{sid}/summary.json'),
    }[agent]
    root = origin.get(root_key) or os.path.expanduser(default)
    matches = glob.glob(os.path.join(root, pattern), recursive=True)
    if len(matches) != 1 or not os.path.isfile(matches[0]):
        raise ValueError('no se encontró un único historial para reanudar; el origen sigue abierto')
    return matches[0]


def _claude_config_dir(alias):
    """Config dir de una cuenta Claude; None para 'main' (que vive en HOME)."""
    if not alias or alias == "main":
        return None
    spec = (load_provider_registry().get("harnesses") or {}).get("claude") or {}
    root = os.path.expanduser(spec.get("accountsRoot") or "~/.claude-accounts")
    return os.path.join(root, alias)


def inherit_trust_for_switch(cwd, from_alias, to_alias, harness="claude"):
    """Copia la aceptación de la carpeta de la cuenta origen a la destino.

    Solo Claude, solo cuando la cuenta cambia de verdad, y solo si el origen ya
    la tenía aceptada: nunca inventa confianza que el usuario no diera antes.

    Heredar trust es un extra de conveniencia sobre un cambio de cuenta/sesión:
    nunca debe poder romper ese cambio. Cualquier excepción aquí dentro (o al
    escribir el ledger) se traga y se reporta como False/no-op.
    """
    if harness != "claude" or not cwd or (to_alias or "main") == (from_alias or "main"):
        return False
    try:
        dest = _claude_config_dir(to_alias)
        if not dest:
            return False
        ok = claude_trust.inherit_cwd_trust(cwd, source_config_dir=_claude_config_dir(from_alias),
                                            dest_config_dir=dest, home=os.path.expanduser("~"))
    except Exception:
        return False        # heredar el trust nunca puede impedir el cambio de sesión
    if ok:
        try:
            cc_usage.record_change(USAGE_DB, {
                "origin": "reparto", "kind": "trust_inherited",
                "note": f"trust heredado {from_alias or 'main'} -> {to_alias or 'main'} en {cwd}",
            })
        except Exception:
            pass
    return ok


# Un diálogo real ocupa su propia línea, como mucho tras el marco de la TUI; la
# misma frase dentro de una oración es prosa (un changelog, un README, un log de
# una librería de auth, una conversación en pantalla). Anclar a principio de línea
# Y exigir el contexto concreto cierra los dos lados: "note: authentication
# required for the admin api" no casa por ir a media línea, y "sign in before the
# deploy" no casa por no llevar el contexto, aunque empiece línea.
# Solo marco real de TUI. Se cayeron *, ·, •, | y -: son la viñeta, la celda de
# tabla y el guion de lista más comunes en prosa, así que "- Login required for
# admin API calls" (una línea de changelog o de un cuerpo de commit) pasaba las
# dos defensas a la vez. Se conserva ">" porque "> sign in required" es la única
# pantalla de login que el repo tiene atestiguada, en test_session_route_matrix.
_LOGIN_LINE = r"(^|\n)[\s│┃>]*"

# El detector de diálogos es una red de seguridad, no la única defensa: _verify
# exige además prompt de shell, modelo, effort, ambas cuentas y conversación antes
# de confirmar. Por eso los patrones se eligen ESPECÍFICOS y se aceptan falsos
# negativos: una frase genérica ("sign in" suelto, aunque vaya anclada) casa con
# prosa reflowed por el ancho del terminal o con el cuerpo indentado de un git log,
# y un falso positivo congela el sondeo hasta 90 s sin motivo.
_DEFAULT_DIALOGS = {"trust": [r"trust this folder", r"Do you trust", r"Accessing workspace"],
                    "login": [_LOGIN_LINE + r"(please\s+)?(sign in|log in)\s+to\s+(continue|use|proceed)",
                              _LOGIN_LINE + r"(sign in|log in|login|authentication)\s+required",
                              _LOGIN_LINE + r"(por favor,?\s+)?inicia(?:r)? sesi[oó]n para (continuar|usar)",
                              _LOGIN_LINE + r"se requiere inicia(?:r)? sesi[oó]n",
                              r"(^|\n)\s*/login\b"],
                    "onboarding": [r"Choose the text style", r"Elige el estilo de texto",
                                   r"Choose your theme", r"Elige tu tema"],
                    "error": [r"(^|\n)\s*error:", r"(^|\n)\s*fatal:"]}

def _detectors_cfg():
    try:
        with open(os.path.join(REPO_ROOT, "config", "detectors.json")) as f:
            return json.load(f) or {}
    except Exception:
        return {}


_DIALOG_CACHE = {"mtime": None, "value": None}
_DIALOG_CACHE_LOCK = threading.Lock()


def _clean_patterns(raw):
    """Solo cadenas que compilen como regex. Una config mal escrita no puede
    convertirse en un patrón que casa con todo ni tumbar el bucle de sondeo:
    un patrón suelto se envuelve en lista, lo que no sea texto se descarta."""
    out = {}
    for kind, value in (raw or {}).items():
        if isinstance(value, str):
            value = [value]
        elif not isinstance(value, (list, tuple)):
            continue
        good = []
        for pat in value:
            if not isinstance(pat, str) or not pat.strip():
                continue
            try:
                re.compile(pat)
            except re.error:
                continue
            good.append(pat)
        if not good and value:
            # Había patrones y no sobrevivió ninguno: eso es un error de escritura,
            # no la intención de apagar la categoría. Se omite la clave para que
            # el defecto la cubra; apagar una categoría se escribe con [] vacío.
            continue
        # Una categoría presente en la config es intención del operador, aunque
        # quede vacía: se conserva la clave para que el fallback no la resucite.
        out[kind] = good
    return out


def dialog_patterns():
    """Patrones de los diálogos de arranque, desde config (en/es).

    Se cachea por mtime: `screen_dialog` corre dentro del bucle de verificación,
    hasta 180 veces por cambio de sesión, y releer el JSON en cada vuelta era
    I/O de sobra en el camino caliente.
    """
    path = os.path.join(REPO_ROOT, "config", "detectors.json")
    with _DIALOG_CACHE_LOCK:
        try:
            mtime = os.stat(path).st_mtime
        except OSError:
            mtime = None
        if _DIALOG_CACHE["value"] is not None and _DIALOG_CACHE["mtime"] == mtime:
            return _DIALOG_CACHE["value"]
        clean = _clean_patterns(_detectors_cfg().get("dialogPatterns"))
        for kind, fallback in _DEFAULT_DIALOGS.items():
            clean.setdefault(kind, list(fallback))
        _DIALOG_CACHE.update(mtime=mtime, value=clean)
        return clean

def screen_dialog(screen):
    """Devuelve 'trust' | 'login' | 'onboarding' | 'error' | '' según la pantalla."""
    pats = dialog_patterns()
    for kind in ("trust", "login", "onboarding", "error"):
        for p in pats.get(kind) or []:
            if re.search(p, screen or "", re.I | re.M):
                return kind
    return ""

def verify_attempts(cwd, config_dir=None):
    """60 intentos (~30 s) normalmente; más cuando el destino carga MCPs."""
    with_mcp = int(_detectors_cfg().get("verifyAttemptsWithMcp") or 180)
    if cwd and os.path.exists(os.path.join(cwd, ".mcp.json")):
        return with_mcp
    try:
        with open(os.path.join(config_dir or os.path.expanduser("~"), ".claude.json")) as f:
            if (json.load(f) or {}).get("mcpServers"):
                return with_mcp
    except Exception:
        pass
    return 60


# ---------------------------------------------------------------- Reparto de cuota
ALLOCATION_PLANS = {}
_ALLOCATION_BATCHES = None
_EFFORT_ORDER = ["low", "medium", "high", "xhigh", "max"]


def _batches():
    global _ALLOCATION_BATCHES
    if _ALLOCATION_BATCHES is None:
        _ALLOCATION_BATCHES = allocation_batch.BatchStore(os.path.join(HOOKS, "allocation-batches.json"))
    return _ALLOCATION_BATCHES


def selectable_accounts_by_motor(registry):
    out = {}
    for motor in (registry.get("motors") or {}):
        try:
            aliases = [a["alias"] for a in account_registry.list_accounts(registry, motor) if a.get("selectable")]
        except Exception:
            aliases = []
        out[motor] = aliases or ["main"]
    return out


def enriched_limits(limits):
    return allocation.enrich_limits(limits or [], time.time(), ui_lang())


def _motor_options(registry):
    """Modelos y efforts válidos por motor, para que la ficha solo ofrezca lo real."""
    out = {}
    for motor, spec in (registry.get("motors") or {}).items():
        models = [m["id"] for m in (spec.get("models") or [])]
        efforts = sorted({e for m in (spec.get("models") or []) for e in (m.get("efforts") or [])},
                         key=lambda e: _EFFORT_ORDER.index(e) if e in _EFFORT_ORDER else 99)
        out[motor] = {"models": models, "efforts": efforts}
    return out


def allocation_inputs():
    registry = load_provider_registry()
    motors = registry.get("motors") or {}
    sessions = [dict(s, gitRoot=_git_root_cached(s.get("cwd") or ""))
                for s in read_states_cached()
                if s.get("alive") and (s.get("motor") or s.get("agent")) in motors]
    try:
        profiles = cc_usage.project_profiles(USAGE_DB)
        signals = cc_usage.project_signals(USAGE_DB)
    except Exception:
        profiles, signals = {}, {}
    return dict(sessions=sessions, limits=usage_provider_limits()["limits"], registry=registry,
                support=session_change_support(registry), accounts=selectable_accounts_by_motor(registry),
                tiers=load_model_tiers(), now=time.time(), profiles=profiles, signals=signals)


_GIT_ROOT_CACHE: dict = {}


def _git_root_cached(cwd):
    """git_root_for_path lanza un proceso; con 30 sesiones por propuesta se nota."""
    if not cwd:
        return ""
    hit = _GIT_ROOT_CACHE.get(cwd)
    if hit and time.time() - hit[1] < 600:
        return hit[0]
    try:
        root = cc_usage.git_root_for_path(cwd) or cwd
    except Exception:
        root = cwd
    _GIT_ROOT_CACHE[cwd] = (root, time.time())
    return root


def _build_plan(overrides):
    inp = allocation_inputs()
    plan = allocation.propose(inp["sessions"], inp["limits"], inp["registry"], inp["support"],
                              inp["accounts"], inp["tiers"], now=inp["now"], overrides=overrides,
                              lang=ui_lang(), profiles=inp["profiles"], signals=inp["signals"])
    plan["options"] = _motor_options(inp["registry"])
    estado = {allocation.session_key(s): (s.get("status") or "") for s in inp["sessions"]}
    # Cuando se vio por ultima vez: una sesion terminada hace 17 h se lee como
    # muerta en la ficha si no se dice cuanto lleva quieta.
    visto = {}
    for s in inp["sessions"]:
        try:
            visto[allocation.session_key(s)] = float(s.get("ts") or 0)
        except (TypeError, ValueError):
            visto[allocation.session_key(s)] = 0.0
    for item in plan["items"]:
        item["status"] = estado.get(item["key"], "")
        item["seenAt"] = visto.get(item["key"], 0.0) or None
    return plan, inp


def _valid_overrides(raw):
    """El cuerpo HTTP no puede reventar el motor: se acepta solo lo que entiende."""
    out = {}
    if raw is not None and not isinstance(raw, dict):
        return {}          # un cuerpo raro se ignora, no revienta ni miente con 400
    for key, value in (raw or {}).items():
        if not isinstance(key, str) or not isinstance(value, dict):
            continue
        clean = {}
        if "layer" in value:
            try:
                clean["layer"] = max(1, min(3, int(value["layer"])))
            except (TypeError, ValueError):
                return None
        if value.get("locked"):
            clean["locked"] = True
        if "to" in value:
            if not isinstance(value["to"], dict):
                return None
            clean["to"] = {k: str(v) for k, v in value["to"].items() if isinstance(k, str)}
        if clean:
            out[key] = clean
    return out


def project_profiles_view():
    """Perfil declarado + señales medidas de cada proyecto con sesiones vivas."""
    inp = allocation_inputs()
    roots = {}
    for sess in inp["sessions"]:
        root = sess.get("gitRoot") or sess.get("cwd") or ""
        if not root:
            continue
        r = roots.setdefault(root, {"gitRoot": root, "label": sess.get("project") or os.path.basename(root),
                                    "sessions": 0})
        r["sessions"] += 1
    out = []
    for root, r in sorted(roots.items()):
        r["profile"] = inp["profiles"].get(root) or None
        r["signal"] = inp["signals"].get(root) or None
        out.append(r)
    return 200, {"ok": True, "projects": out, "vocabulary": cc_usage.PROFILE_VALUES}


def project_profile_set(data):
    root = str(data.get("gitRoot") or "").strip()
    try:
        prof = cc_usage.set_project_profile(USAGE_DB, root, value=data.get("value"),
                                            complexity=data.get("complexity"), autonomy=data.get("autonomy"))
    except ValueError as e:
        return 400, {"ok": False, "error": str(e)}
    return 200, {"ok": True, "profile": prof}


def allocation_propose(data):
    overrides = _valid_overrides(data.get("overrides"))
    if overrides is None:
        return 400, {"ok": False, "error": "overrides invalidos"}
    plan, _ = _build_plan(overrides)
    plan["overrides"] = overrides
    ALLOCATION_PLANS[plan["planId"]] = plan
    while len(ALLOCATION_PLANS) > 20:
        ALLOCATION_PLANS.pop(next(iter(ALLOCATION_PLANS)))
    return 200, {"ok": True, "plan": plan}


def allocation_preview(data):
    plan = ALLOCATION_PLANS.get(str(data.get("planId") or ""))
    if not plan:
        return 404, {"ok": False, "error": "plan desconocido; vuelve a analizar"}
    extra = _valid_overrides({str(data.get("key") or ""): data.get("target") or {}})
    if extra is None:
        return 400, {"ok": False, "error": "destino invalido"}
    overrides = dict(plan.get("overrides") or {})
    overrides.update(extra)
    tmp, _ = _build_plan(overrides)
    return 200, {"ok": True, "impact": tmp["impact"], "items": tmp["items"]}


def _status_of(opkey, opid):
    try:
        return session_operation_status(opkey, opid)
    except TypeError:
        return session_operation_status(opkey)


def _run_batch_bg(batch_id, wait=False):
    def go():
        try:
            allocation_batch.run_batch(batch_id, _batches(), lambda d: session_configure(d), _status_of,
                                       concurrency=3)
        except Exception:
            pass   # el estado por pane ya queda en el lote; nunca tumbar el hilo
    if wait:
        go()
    else:
        threading.Thread(target=go, daemon=True).start()


_ALLOCATION_APPLY_LOCK = threading.Lock()


def _batch_for_plan(plan_id):
    """El lote más reciente de un plan (doble clic, reintento del navegador)."""
    for b in _batches().list():
        if b.get("planId") == plan_id:
            return b
    return None


def _reuse_or_refuse(plan_id):
    """Un plan en curso devuelve su lote; uno ya aplicado no se relanza."""
    prev = _batch_for_plan(plan_id)
    if not prev:
        return None
    view = allocation_batch.batch_view(prev)
    if view["state"] != "terminado":
        return 202, {"ok": True, "batchId": prev["batchId"], "total": view["total"], "reused": True}
    if any(i["state"] == "lista" for i in prev["items"]):
        return 409, {"ok": False, "error": "este plan ya se aplicó; vuelve a analizar", "batchId": prev["batchId"]}
    return None


def allocation_apply(data, wait=False):
    plan = ALLOCATION_PLANS.get(str(data.get("planId") or ""))
    if not plan:
        return 404, {"ok": False, "error": "plan desconocido; vuelve a analizar"}
    with _ALLOCATION_APPLY_LOCK:
        hit = _reuse_or_refuse(plan["planId"])
        if hit:
            return hit
        inp = allocation_inputs()
        if allocation.plan_hash(inp["sessions"]) != plan["stateHash"]:
            antes = {i["key"]: i["from"] for i in plan["items"]}
            vivas = {allocation.session_key(s) for s in inp["sessions"]}
            cambiadas = [allocation.session_key(s) for s in inp["sessions"]
                         if allocation.session_key(s) in antes
                         and any(str(s.get(f) or "") != str(antes[allocation.session_key(s)].get(g) or "")
                                 for f, g in (("model", "model"), ("effort", "effort"),
                                              ("harnessAccount", "account")))]
            nuevas = sorted(vivas - set(antes))
            idas = sorted(set(antes) - vivas)
            return 409, {"ok": False, "error": "plan_stale",
                         "changed": sorted(cambiadas) + nuevas + idas}
        panes = data.get("panes")
        batch = _batches().create(plan, panes=panes if isinstance(panes, list) else None)
    _run_batch_bg(batch["batchId"], wait)
    return 202, {"ok": True, "batchId": batch["batchId"], "total": len(batch["items"])}


def allocation_status(batch_id):
    b = _batches().get(str(batch_id or ""))
    if not b:
        return 404, {"ok": False, "error": "lote desconocido"}
    return 200, dict(ok=True, **allocation_batch.batch_view(b))


def allocation_retry(data, wait=False):
    bid, key = str(data.get("batchId") or ""), str(data.get("key") or "")
    if not _batches().get(bid):
        return 404, {"ok": False, "error": "lote desconocido"}
    def go():
        try:
            allocation_batch.retry_item(bid, key, _batches(), lambda d: session_configure(d), _status_of)
        except Exception:
            pass
    if wait:
        go()
    else:
        threading.Thread(target=go, daemon=True).start()
    return 202, {"ok": True, "batchId": bid, "key": key}


def _still_applied(live, to):
    """El pane sigue en el `to` que puso el lote? Un campo vivo vacío no cuenta
    como cambio (no todos los agentes reportan effort o cuenta)."""
    pares = ((live.get("motor") or live.get("agent"), to.get("motor")), (live.get("model"), to.get("model")),
             (live.get("effort"), to.get("effort")),
             (live.get("harnessAccount") or live.get("account"), to.get("harnessAccount")))
    return all(not v or str(v) == str(w or "") for v, w in pares)


def allocation_revert(data, wait=False):
    bid = str(data.get("batchId") or "")
    b = _batches().get(bid)
    if not b:
        return 404, {"ok": False, "error": "lote desconocido"}
    # Con items aún aplicando, lo que se confirme después quedaría sin revertir
    # (y dos interrupciones en el mismo pane).
    if allocation_batch.batch_view(b)["state"] != "terminado":
        return 409, {"ok": False, "error": "el lote sigue aplicando; espera a que termine para revertir"}
    with _ALLOCATION_APPLY_LOCK:
        hit = _reuse_or_refuse("rev-" + bid)
        if hit:
            return hit
        hechas = [i for i in b["items"] if i["state"] == "lista"]
        if not hechas:
            return 409, {"ok": False, "error": "no hay cambios confirmados que revertir"}
        # Se revierte desde el lote persistido (from/to), no desde el plan en RAM,
        # y solo los panes que siguen como los dejó el lote: un cambio manual
        # posterior no se pisa.
        inp = allocation_inputs()
        vivas = {allocation.session_key(s): s for s in inp["sessions"]}
        items, skipped = [], []
        for it in hechas:
            live = vivas.get(it["key"])
            if not live:
                skipped.append({"key": it["key"], "reason": "el pane ya no existe"})
            elif not _still_applied(live, it["to"]):
                skipped.append({"key": it["key"], "reason": "cambió después del reparto; no se pisa"})
            else:
                items.append(it)
        if not items:
            return 409, {"ok": False, "error": "nada que revertir: los panes cambiaron después del reparto",
                         "skipped": skipped}
        inv = allocation.invert({"planId": bid, "stateHash": allocation.plan_hash(inp["sessions"]), "items": items})
        inv["items"] = [dict(i, same=False, locked=False) for i in inv["items"]]
        batch = _batches().create(inv, panes=None)
    _run_batch_bg(batch["batchId"], wait)
    return 202, {"ok": True, "batchId": batch["batchId"], "total": len(batch["items"]), "skipped": skipped}


def session_change_support(registry=None, observed=None):
    """Mid-session adapter policy; new-session availability is separate."""
    registry = registry or load_provider_registry()
    observed = observed or {}
    result = {}
    for route in registry.get('routes') or []:
        harness, motor = route['harness'], route['motor']
        reason = None
        if route.get('experimental') and not route.get('liveVerified'):
            reason = {'code': 'route_not_live_verified', 'message': 'puente pendiente de verificación E2E'}
        elif harness not in ('claude', 'codex', 'grok', 'acp') or (harness == 'acp' and not
                ((registry.get('acpAgents') or {}).get(motor) or {}).get('resume')):
            reason = {'code': 'exact_resume_unavailable', 'message': 'este adaptador no ofrece recuperación exacta; crea una sesión nueva'}
        elif harness == 'acp' and not (observed.get('harness') == 'acp' and observed.get('motor') == motor
                                       and observed.get('effortSource') == 'acp-config-options'):
            reason = {'code': 'acp_effort_unobserved', 'message': 'se necesita una sesión ACP que publique esfuerzo mediante configOptions'}
        result[route['id']] = {'selectable': reason is None, 'reason': reason}
    return result


def _send_configuration_command(pane, command):
    # Clear only the visible screen after the shell echoed this command. Old
    # prompts remain in scrollback, outside the readiness check's capture.
    _send_shell_line(pane, "printf '\\033[2J\\033[H'; " + command)


def _stop_owned_startup(pid, started):
    """Recovery must not press Enter on an unaccepted trust/login dialog."""
    if _process_start(pid) != started:
        return False
    try:
        os.kill(int(pid), 15)
    except ProcessLookupError:
        return True
    for _ in range(30):
        if _process_start(pid) != started:
            return True
        time.sleep(0.1)
    return False


class SessionConfiguration:
    def __init__(self, data, identity):
        self.data, self.identity = data, identity
        self.sess, self.pane = data['session'], data['pane']
        self.original = agent_info_for_pane(self.pane) or {}
        self.original_start = _process_start(self.original['pid']) if self.original.get('pid') else ''
        # The live pane command wins over stale session hook state.
        pane_cmd = identity['pane_current_command']
        self.frm = self.original.get('agent') or ('shell' if pane_cmd in ('bash', 'zsh', 'sh', 'fish', 'dash') else '')
        self.plan = None
        self.screen_dialog_kind = ''

    def check_identity(self):
        if getattr(self, 'store', None):
            row = self.store.get(self.data['requestId'])
            if row and row['state'] == 'failed':
                raise RuntimeError('operación cancelada')
        current = _pane_identity(self.sess, self.pane)
        if _identity_key(current) != _identity_key(self.identity):
            raise RuntimeError('cambió la identidad del panel; no se enviaron comandos')
        live = agent_info_for_pane(self.pane) or {}
        if live.get('pid') != self.original.get('pid') or (live.get('pid') and _process_start(live['pid']) != self.original_start):
            raise RuntimeError('el proceso original cambió durante la espera')

    def prepare(self):
        if not self.frm:
            raise ValueError('no se reconoce el proceso del panel')
        if self.frm not in ('shell', 'claude', 'codex', 'grok', 'acp'):
            raise ValueError(f'{self.frm} no ofrece recuperación exacta; se conserva el agente actual')
        data = self.data
        current = observe_pane(self.sess, self.pane, self.original) if self.original else {}
        if data.get('profileId'):
            raise ValueError('los perfiles se aplican al crear una sesión; no se cambia el agente actual')
        if data.get('expectedIdentity') and data['expectedIdentity'] != _identity_key(self.identity):
            raise ValueError('cambió la identidad del panel desde que se abrió la configuración')
        if data.get('expectedConversationId') and data['expectedConversationId'] != current.get('conversationId'):
            raise ValueError('cambió la conversación desde que se abrió la configuración')
        if self.frm == 'acp' and not ((load_provider_registry().get('acpAgents') or {}).get(current.get('motor')) or {}).get('resume'):
            raise ValueError('este motor ACP no admite reanudación exacta; el agente sigue abierto')
        requested_route = provider_registry.route_for(load_provider_registry(), str(data.get('routeId') or '')) or {}
        if data.get('routeId') and not requested_route:
            raise ValueError('ruta desconocida')
        to = data.get('toHarness') or requested_route.get('harness') or self.frm
        if requested_route and (to != requested_route['harness'] or
                               data.get('motor') and data['motor'] != requested_route['motor']):
            raise ValueError('la ruta no coincide con el harness y motor solicitados')
        model_motor = provider_registry.engine_for_model(load_provider_registry(), str(data.get('model') or ''))
        motor = data.get('motor') or requested_route.get('motor') or (model_motor or current.get('motor') if to == self.frm else to)
        if to == 'acp' and motor in ('acp', 'shell', '', None):
            motor = 'claude'
        if to not in ('claude', 'codex', 'grok', 'acp', 'opencode', 'agy'):
            raise ValueError(f'harness desconocido: {to}')
        if to == motor and data.get('motorAccount') and data.get('harnessAccount') and data['motorAccount'] != data['harnessAccount']:
            raise ValueError('un CLI nativo necesita la misma cuenta de harness y motor')
        selection = dict(data, routeId=f'{to}:{motor}')
        if not selection.get('model') and motor == current.get('motor'):
            selection['model'] = current.get('model') or ''
        if 'effort' not in selection and motor == current.get('motor'):
            selection['effort'] = current.get('effort') or ''
        selection.setdefault('harnessAccount', current.get('harnessAccount') if to == self.frm else 'main')
        selection.setdefault('motorAccount', current.get('motorAccount') if motor == current.get('motor') else
                             selection.get('harnessAccount') if motor == to else 'main')
        scope = 'new_session' if to != self.frm else 'session_model' if motor == current.get('motor') else 'session_motor'
        route, selected = resolve_route_selection(selection, scope)
        for account_key in ('harnessAccount', 'motorAccount'):
            if data.get(account_key) and selected[account_key] != data[account_key]:
                raise ValueError(f'{account_key}: esa cuenta no es compatible con el destino')
        if to in ('opencode', 'agy') or (to == 'acp' and not
                ((load_provider_registry().get('acpAgents') or {}).get(motor) or {}).get('resume')):
            raise ValueError(f'{to}:{motor} no ofrece recuperación exacta en este adaptador; crea una sesión nueva')
        support = session_change_support(load_provider_registry(), current).get(route['id'])
        if support and not support['selectable']:
            raise ValueError(support['reason']['message'])
        model, effort = selected['model'], selected['effort']
        account = selected['motorAccount'] if to == 'acp' else selected['harnessAccount']
        same_conversation = self.frm == to and (to != 'acp' or motor == current.get('motor'))
        saved_origin = self.store.saved_origin(_identity_key(self.identity), to) if not same_conversation else None
        if saved_origin and to == 'acp' and (saved_origin.get('observed') or {}).get('motor') != motor:
            saved_origin = None
        if saved_origin:
            _snapshot_transcript(saved_origin)
        sid = ((saved_origin.get('observed') or {}).get('conversationId') if saved_origin else current.get('conversationId')) or ''
        # Validate the target command now, before a snapshot or any terminal input.
        cmd = _configuration_command(to, motor, model, effort, account,
                                     resume=sid if same_conversation or saved_origin else '',
                                     flags=(saved_origin or {}).get('flags') or ())
        if not os.path.isdir(self.identity['pane_current_path']):
            raise ValueError('la carpeta del panel ya no existe')
        self.plan = dict(to=to, motor=motor, model=model, effort=effort,
                         harnessAccount=selected['harnessAccount'], motorAccount=selected['motorAccount'],
                         command=cmd, previous=current, routeId=route['id'], returnOrigin=saved_origin,
                         expectedSid=sid if same_conversation or saved_origin else '', sameConversation=same_conversation)
        self.plan['unchanged'] = to == self.frm and all(self.plan.get(k) == current.get(k) for k in
            ('motor', 'model', 'effort', 'harnessAccount', 'motorAccount'))
        self.plan['continuity'] = {'continuity': 'resumed' if same_conversation or saved_origin else 'new-conversation',
                                   'handoffRequired': self.frm != 'shell' and not same_conversation and not saved_origin}
        return self.plan

    def wait_idle(self):
        if self.data.get('interrupt') or self.frm == 'shell':
            return
        for _ in range(1350):
            self.check_identity()
            if not harness_pane_busy(self.sess, self.pane, self.frm):
                return
            time.sleep(2)
        raise RuntimeError('el agente no quedó libre en 45 minutos')

    def snapshot(self, plan):
        inspector = pane_snapshot.PaneInspector()
        layout = tmux_snapshot.capture_session(tmux, self.sess, inspector)
        origin = next(p for window in layout['windows'] for p in window['panes'] if p['id'] == self.pane)
        observed = observe_pane(self.sess, self.pane, self.original, inspector) if self.original else {}
        if self.frm != 'shell':
            fields = ('harness', 'motor', 'model', 'effort', 'harnessAccount', 'motorAccount', 'conversationId')
            if any(observed.get(key) != plan['previous'].get(key) for key in fields):
                raise ValueError('cambió la conversación o configuración durante la espera; vuelve a revisar el cambio')
            if not observed.get('confirmed') or not observed.get('model'):
                raise ValueError('no se observó la configuración original; el agente sigue abierto')
            original_model = provider_registry.model_spec(load_provider_registry(), observed.get('motor'),
                                                         observed['model'], section='motors') or {}
            if original_model.get('efforts') and not observed.get('effort'):
                raise ValueError('no se observó el esfuerzo original; no se puede asegurar su recuperación')
            if any(not observed.get(key) or observed[key] == 'unknown' for key in ('harnessAccount', 'motorAccount')):
                raise ValueError('no se identificaron las cuentas originales; el agente sigue abierto')
            if origin.get('agent') != self.frm:
                raise ValueError('cambió el agente durante el snapshot')
        sid = origin.get('resume_id') or (origin.get('acp') or {}).get('sessionId') or ''
        if self.frm != 'shell' and not sid:
            raise ValueError('no se encontró la conversación exacta; el agente sigue abierto')
        if self.frm != 'shell' and sid != observed.get('conversationId'):
            raise ValueError('la conversación cambió durante el snapshot')
        origin['transcriptPath'] = _snapshot_transcript(origin)
        origin['observed'] = observed
        origin['agent_pid'] = self.original.get('pid')
        origin['agent_start'] = self.original_start
        origin['identity'] = self.identity
        if plan.get('returnOrigin'):
            prior = plan['returnOrigin']
            account = plan['motorAccount'] if plan['to'] == 'acp' else plan['harnessAccount']
            prior_account = (prior.get('observed') or {}).get('motorAccount' if plan['to'] == 'acp' else 'harnessAccount')
            if account != prior_account:
                self._copy_conversation(prior, account)
        # Pin the complete snapshot in SQLite; periodic app snapshots never replace it.
        if self.frm != 'shell':
            account = observed.get('motorAccount') if self.frm == 'acp' else observed.get('harnessAccount')
            if not account or account == 'unknown':
                raise ValueError('no se pudo identificar la cuenta original')
            origin['resume_command'] = _configuration_command(self.frm, observed.get('motor') or self.frm,
                observed.get('model') or '', observed.get('effort') or '', account, sid, origin.get('flags') or [])
            if plan.get('sameConversation'):
                target_account = plan['motorAccount'] if self.frm == 'acp' else plan['harnessAccount']
                if target_account != account:
                    self._copy_conversation(origin, target_account)
                plan['command'] = _configuration_command(plan['to'], plan['motor'], plan['model'], plan['effort'],
                    target_account, sid, origin.get('flags') or [])
                plan['expectedSid'] = sid
            handoff_dir = os.path.join(HOOKS, 'session-handoffs')
            os.makedirs(handoff_dir, mode=0o700, exist_ok=True)
            path = os.path.join(handoff_dir, self.data['requestId'] + '.md')
            with open(path, 'x') as fh:
                os.chmod(path, 0o600)
                fh.write(capture_handoff(self.pane, self.frm, plan['to'], origin['cwd'], sid if self.frm == 'claude' else '',
                                         transcript_path=origin['transcriptPath'] if self.frm == 'claude' else ''))
            origin['handoffPath'] = path
            if plan['continuity']['handoffRequired']:
                plan['continuity']['handoffPath'] = path
        return {'session': self.sess, 'layout': layout, 'origin': origin, 'destination': dict(plan)}

    def _copy_conversation(self, origin, account):
        # Account switches preserve the exact transcript and supporting directory.
        # Copying happens again after waiting, immediately before closing source.
        agent = origin.get('agent') or self.frm
        if agent == 'acp':
            raise ValueError('cambiar cuenta ACP requiere exportación de conversación; se conserva el origen')
        sid = origin.get('resume_id') or ''
        env_key, default = {'claude': ('CLAUDE_CONFIG_DIR', '~/.claude'),
                            'codex': ('CODEX_HOME', '~/.codex'), 'grok': ('GROK_HOME', '~/.grok')}[agent]
        source_root = origin.get({'claude': 'claude_config_dir', 'codex': 'codex_home', 'grok': 'grok_home'}[agent]) or os.path.expanduser(default)
        env = account_registry.account_environment(load_provider_registry(), agent, account)
        target_root = env.get(env_key) or os.path.expanduser(default)
        pattern = {'claude': f'projects/*/{sid}.jsonl', 'codex': f'sessions/**/rollout-*{sid}.jsonl',
                   'grok': f'sessions/**/{sid}/summary.json'}[agent]
        paths = glob.glob(os.path.join(source_root, pattern), recursive=True)
        if len(paths) != 1:
            raise ValueError('no se encontró un único historial de origen')
        source = paths[0]
        if agent == 'grok':
            source = os.path.dirname(source)
        target = os.path.join(target_root, os.path.relpath(source, source_root))
        copies = [(source, target)]
        extra = os.path.join(os.path.dirname(source), sid)
        if agent == 'claude' and os.path.isdir(extra):
            copies.append((extra, os.path.join(os.path.dirname(target), sid)))
        # Validate the complete transcript and all subagent/sidecar files before
        # changing any destination file. Divergent histories remain untouched.
        for source_item, target_item in copies:
            for item, root in ((source_item, source_root), (target_item, target_root)):
                relative = os.path.relpath(item, root)
                current = root
                for part in relative.split(os.sep):
                    current = os.path.join(current, part)
                    if part == '..' or os.path.islink(current):
                        raise ValueError('el historial contiene un enlace o sale de la cuenta; no se copia')
                if os.path.isdir(item):
                    for directory, subdirs, files in os.walk(item):
                        if any(os.path.islink(os.path.join(directory, name)) for name in subdirs + files):
                            raise ValueError('el historial contiene un enlace; no se copia')
            existing_files = glob.glob(os.path.join(target_item, '**', '*'), recursive=True) if os.path.isdir(source_item) else [target_item]
            for existing in existing_files:
                if not os.path.exists(existing):
                    continue
                if os.path.islink(existing):
                    raise ValueError('el historial destino contiene un enlace; no se sobrescribe')
                if os.path.isdir(existing):
                    continue
                original = os.path.join(source_item, os.path.relpath(existing, target_item)) if os.path.isdir(source_item) else source_item
                if not os.path.isfile(original) or not self._compatible_copy(original, existing):
                    raise ValueError('el historial destino contiene cambios propios; no se sobrescribe')
        def atomic_copy(source_file, target_file):
            fd, temporary = tempfile.mkstemp(prefix='.comandos-copy-', dir=os.path.dirname(target_file))
            os.close(fd)
            try:
                shutil.copy2(source_file, temporary)
                with open(temporary, 'rb') as fh:
                    os.fsync(fh.fileno())
                os.replace(temporary, target_file)
            finally:
                if os.path.exists(temporary):
                    os.unlink(temporary)
            return target_file
        for source_item, target_item in copies:
            os.makedirs(os.path.dirname(target_item), exist_ok=True)
            if os.path.isdir(source_item):
                shutil.copytree(source_item, target_item, dirs_exist_ok=True, copy_function=atomic_copy)
            else:
                atomic_copy(source_item, target_item)

    @staticmethod
    def _compatible_copy(source, target):
        with open(source, 'rb') as src, open(target, 'rb') as dst:
            while True:
                chunk = dst.read(65536)
                if not chunk:
                    return True
                if src.read(len(chunk)) != chunk:
                    return False

    def apply(self, plan, snapshot):
        if self.frm != 'shell' and not _pane_exit_current(self.pane, self.original['pid'], self.frm, self.original_start):
            raise RuntimeError('el agente original no cerró')
        current = _pane_identity(self.sess, self.pane)
        if _identity_key(current) != _identity_key(self.identity):
            raise RuntimeError('el panel cambió después de cerrar el origen')
        if current['pane_current_command'] not in ('bash', 'zsh', 'sh', 'fish', 'dash') or agent_info_for_pane(self.pane):
            raise RuntimeError('hay otro proceso en el panel; no se envía el comando destino')
        if self.frm == plan['to'] and self.frm != 'shell':
            origin = snapshot['origin']
            previous = origin.get('observed') or {}
            account_key = 'motorAccount' if self.frm == 'acp' else 'harnessAccount'
            if plan[account_key] != previous.get(account_key):
                self._copy_conversation(origin, plan[account_key])
        self.snapshot_record = snapshot
        _restore_shell_tty(self.pane)
        inherit_trust_for_switch(current['pane_current_path'],
                                 ((snapshot.get('origin') or {}).get('observed') or {}).get('harnessAccount'),
                                 plan.get('harnessAccount'),
                                 harness=plan.get('to') or self.frm)
        _send_configuration_command(self.pane, 'env ' + shlex.quote('COMANDOS_OPERATION_ID=' + self.data['requestId']) + ' ' + plan['command'])

    def _verify(self, expected, sid='', attempts=60):
        for _ in range(attempts):
            if attempts > 1:
                time.sleep(0.5)
            identity = _pane_identity(self.sess, self.pane)
            if _identity_key(identity) != _identity_key(self.identity):
                raise RuntimeError('el panel cambió durante la verificación')
            info = agent_info_for_pane(self.pane) or {}
            if info.get('agent') != expected['to']:
                continue
            if not getattr(self, 'in_recovery', False) and not expected.get('unchanged'):
                marker = _read_environ(info['pid']).get(b'COMANDOS_OPERATION_ID', b'').decode('utf-8', 'replace')
                if marker != self.data['requestId']:
                    continue
            observed = observe_pane(self.sess, self.pane, info)
            if getattr(self, 'snapshot_record', None) and not getattr(self, 'in_recovery', False):
                pin = {'pid': info['pid'], 'start': _process_start(info['pid']),
                       'conversationId': observed.get('conversationId') or ''}
                previous_pin = self.snapshot_record.get('destinationProcess')
                if previous_pin and previous_pin.get('conversationId') and pin != previous_pin:
                    raise RuntimeError('cambió la conversación destino durante la verificación')
                if pin != previous_pin:
                    self.snapshot_record['destinationProcess'] = pin
                    if not getattr(self, 'refreshing', False):
                        self.store.stage(self.data['requestId'], 'verifying', snapshot=self.snapshot_record)
            if sid and observed.get('conversationId') != sid:
                continue
            if not observed.get('confirmed') or observed.get('motor') != expected.get('motor'):
                continue
            if expected['to'] in ('claude', 'codex', 'grok', 'acp') and not observed.get('conversationId'):
                continue
            if expected.get('model') and observed.get('model') != expected['model']:
                registry = load_provider_registry()
                wanted = provider_registry.model_spec(registry, expected.get('motor'), expected['model'], section='motors')
                actual = provider_registry.model_spec(registry, expected.get('motor'), observed.get('model'), section='motors')
                if not wanted or not actual or wanted['id'] != actual['id']:
                    continue
            if expected.get('effort') and observed.get('effort') != expected['effort']:
                continue
            if expected.get('harnessAccount') and observed.get('harnessAccount') != expected['harnessAccount']:
                continue
            if expected.get('motorAccount') and observed.get('motorAccount') != expected['motorAccount']:
                continue
            screen = tmux('capture-pane', '-p', '-t', self.pane).stdout or ''
            if screen_dialog(screen):
                continue
            if not re.search(r'(^|\n)\s*[❯›>]|esc to interrupt|ctrl\+c to interrupt', screen, re.I):
                continue
            return observed
        return None

    def verify(self, plan, snapshot):
        cwd = _pane_identity(self.sess, self.pane).get('pane_current_path') or ''
        return self._verify(plan, plan.get('expectedSid', ''),
                            attempts=verify_attempts(cwd, _claude_config_dir(plan.get('harnessAccount'))))

    def pending_confirmation(self, plan, snapshot):
        if _identity_key(_pane_identity(self.sess, self.pane)) != _identity_key(self.identity):
            return None
        info = agent_info_for_pane(self.pane) or {}
        pin = snapshot.get('destinationProcess') or {}
        if (info.get('agent') != plan['to'] or not pin or info.get('pid') != pin.get('pid') or
                _process_start(info['pid']) != pin.get('start') or
                _read_environ(info['pid']).get(b'COMANDOS_OPERATION_ID', b'').decode() != self.data['requestId']):
            return None
        screen = tmux('capture-pane', '-p', '-t', self.pane).stdout or ''
        kind = screen_dialog(screen)
        self.screen_dialog_kind = kind
        if kind == 'error':
            return None
        # Un diálogo de arranque (trust/login/bienvenida) no invalida la observación,
        # pero sí explica por qué el destino no confirma: queda anotado arriba.
        return observe_pane(self.sess, self.pane, info)

    def rollback(self, snapshot):
        self.in_recovery = True
        origin = snapshot['origin']
        current = _pane_identity(self.sess, self.pane)
        if _identity_key(current) != _identity_key(self.identity):
            raise RuntimeError('el panel cambió; el snapshot conserva la recuperación exacta')
        live = agent_info_for_pane(self.pane) or {}
        original_observed = origin.get('observed') or {}
        expected = dict(original_observed, to=self.frm)
        sid = original_observed.get('conversationId') or ''
        if live.get('pid') == self.original.get('pid') and self.frm != 'shell' and _process_start(live['pid']) == origin.get('agent_start', ''):
            observed = self._verify(expected, sid)
            if observed:
                return observed
            raise RuntimeError('el proceso de origen sigue vivo pero no confirmó su estado')
        if live:
            marker = _read_environ(live['pid']).get(b'COMANDOS_OPERATION_ID', b'').decode('utf-8', 'replace')
            if live.get('agent') != self.plan['to'] or marker != self.data['requestId']:
                raise RuntimeError('hay otro proceso en el panel; no se interrumpe')
            pin = snapshot.get('destinationProcess') or {}
            if pin and (live['pid'] != pin.get('pid') or _process_start(live['pid']) != pin.get('start')):
                raise RuntimeError('el proceso destino fue sustituido; no se interrumpe')
            expected_sid = pin.get('conversationId') or self.plan.get('expectedSid')
            if not expected_sid and not (getattr(self, 'allow_pending_recovery', False) and pin):
                raise RuntimeError('no se guardó la conversación destino; cierra ese CLI manualmente antes de recuperar el origen')
            if expected_sid and observe_pane(self.sess, self.pane, live).get('conversationId') != expected_sid:
                raise RuntimeError('la conversación destino cambió; no se interrumpe')
            started = pin.get('start') or _process_start(live['pid'])
            stopped = (_stop_owned_startup(live['pid'], started) if getattr(self, 'allow_pending_recovery', False)
                       else _pane_exit_current(self.pane, live['pid'], live['agent'], started))
            if not stopped:
                raise RuntimeError('no se pudo cerrar el destino fallido')
        if not live and current['pane_current_command'] not in ('bash', 'zsh', 'sh', 'fish', 'dash'):
            raise RuntimeError('hay un proceso sin identificar en el panel; no se envía la recuperación')
        if self.frm == 'shell':
            return {'harness': 'shell', 'motor': 'shell', 'source': 'pane-process', 'confirmed': True}
        _restore_shell_tty(self.pane)
        _send_configuration_command(self.pane, origin['resume_command'])
        observed = self._verify(expected, sid)
        if not observed:
            raise RuntimeError('no se confirmó la reanudación de la conversación original')
        return observed


def refresh_session_confirmation(store, row):
    """One read of an owned pending target; never send terminal input on polling."""
    if not row or row['state'] != 'awaiting_confirmation' or not row.get('snapshot'):
        return row
    snapshot = row['snapshot']
    before_snapshot = json.dumps(snapshot, sort_keys=True)
    try:
        adapter = SessionConfiguration(row['request'], snapshot['origin']['identity'])
        adapter.store, adapter.plan = store, snapshot['destination']
        adapter.snapshot_record, adapter.refreshing = snapshot, True
        # Validate the pinned process before observing any post-startup session.
        if not adapter.pending_confirmation(adapter.plan, snapshot):
            return row
        observed = adapter._verify(adapter.plan, adapter.plan.get('expectedSid', ''), attempts=1)
        if not observed and json.dumps(snapshot, sort_keys=True) == before_snapshot:
            return row
        result = {'ok': True, 'pending': not bool(observed), 'confirmed': bool(observed),
                  'recoveryAllowed': not bool(observed), 'observed': observed or row['result'].get('observed', {}),
                  **(adapter.plan.get('continuity') or {})}
        with store.connect() as db:
            changed = db.execute("UPDATE session_operations SET state=?,snapshot=?,result=?,updated=? "
                                 "WHERE id=? AND state='awaiting_confirmation'", (
                'confirmed' if observed else 'awaiting_confirmation', json.dumps(snapshot), json.dumps(result),
                time.time(), row['id'])).rowcount
        if changed and observed:
            try:
                record_runtime_config(adapter.sess, adapter.pane, observed['harness'], observed['motor'],
                    observed['model'], observed.get('effort', ''), observed.get('harnessAccount', 'unknown'),
                    observed.get('motorAccount', 'unknown'), adapter.plan['routeId'], 'switch-observed')
            except Exception:
                pass  # Analytics cannot undo durable, observed confirmation.
        return store.get(row['id']) if changed else store.get(row['id']) or row
    except (ValueError, RuntimeError, OSError):
        return row


def session_configure(data):
    data = dict(data)
    sess, pane = str(data.get('session') or ''), str(data.get('pane') or '')
    if not SESSION_RE.fullmatch(sess) or not PANE_RE.fullmatch(pane):
        return 400, {'ok': False, 'error': 'sesión y panel exactos requeridos'}
    request_id = str(data.get('requestId') or secrets.token_hex(16))
    if not re.fullmatch(r'[A-Za-z0-9_-]{8,100}', request_id):
        return 400, {'ok': False, 'error': 'requestId inválido'}
    data['requestId'] = request_id
    store = session_operation_store()
    opkey = f'{sess}|{pane}'
    try:
        # Retry lookup precedes live identity resolution: a completed request is
        # still idempotent after its pane or tmux server has disappeared.
        previous = store.get(request_id)
        if previous:
            store.claim(request_id, previous['pane_key'], data)
            result = previous.get('result') or {}
            return (200 if previous['state'] in ('confirmed', 'failed', 'rolled_back', 'recovery_required') else 202), {
                **result, 'ok': result.get('ok', True), 'pending': previous['state'] not in ('confirmed', 'failed', 'rolled_back', 'recovery_required'),
                'operationKey': opkey, 'operationId': request_id, 'state': previous['state']}
        identity = _pane_identity(sess, pane)
        adapter = SessionConfiguration(data, identity)
        adapter.store = store
        if not store.claim(request_id, _identity_key(identity), data):
            return 202, {'ok': True, 'pending': True, 'operationKey': opkey, 'operationId': request_id}
    except (ValueError, RuntimeError) as exc:
        return 409, {'ok': False, 'error': str(exc), 'operationKey': opkey}
    def notify(stage, result):
        if stage in ('confirmed', 'failed', 'rolled_back', 'recovery_required'):
            result = result or {}
            observed = result.get('observed') or {}
            motor_result_set(opkey, bool(result.get('ok')), result.get('error') or 'configuración confirmada',
                             operationId=request_id, state=stage, **{k: observed.get(k) for k in ('harness', 'motor', 'model', 'effort')},
                             rolledBack=result.get('rolledBack', False), recoveryRequired=result.get('recoveryRequired', False))
            if result.get('ok'):
                record_runtime_config(sess, pane, observed['harness'], observed['motor'], observed['model'],
                    observed.get('effort', ''), observed.get('harnessAccount', 'unknown'), observed.get('motorAccount', 'unknown'),
                    adapter.plan['routeId'], 'switch-observed')
        else:
            motor_stage(opkey, stage, stage, operationId=request_id)
    motor_stage(opkey, 'validando configuración', 'validating', operationId=request_id)
    threading.Thread(target=session_operations.run_operation, args=(store, request_id, adapter, notify), daemon=True).start()
    return 202, {'ok': True, 'pending': True, 'queued': True, 'operationKey': opkey, 'operationId': request_id}


def session_recover(data):
    operation_id = str(data.get('operationId') or '')
    store = session_operation_store()
    store.recover_abandoned()
    row = store.get(operation_id)
    if not row or row['state'] not in ('recovery_required', 'awaiting_confirmation') or not row.get('snapshot'):
        return 409, {'ok': False, 'error': 'la operación no tiene una recuperación pendiente'}
    snapshot = row['snapshot']
    origin = snapshot['origin']
    identity = origin['identity']
    request = row['request']
    opkey = f"{request['session']}|{request['pane']}"
    try:
        if _identity_key(_pane_identity(request['session'], request['pane'])) != _identity_key(identity):
            raise ValueError('el panel original cambió; el snapshot se conserva para recuperación manual')
        if not store.claim_recovery(operation_id):
            raise ValueError('la recuperación ya está en curso')
    except (ValueError, RuntimeError) as exc:
        return 409, {'ok': False, 'error': str(exc)}
    def recover():
        try:
            adapter = SessionConfiguration(request, identity)
            adapter.original = {'pid': origin.get('agent_pid'), 'agent': origin.get('agent') or 'shell'}
            adapter.frm = origin.get('agent') or 'shell'
            adapter.plan = snapshot['destination']
            adapter.allow_pending_recovery = row['state'] == 'awaiting_confirmation'
            adapter.store = store
            observed = adapter.rollback(snapshot)
            result = {'ok': False, 'rolledBack': True, 'recoveryRequired': False,
                      'observed': observed,
                      'error': 'conversación original recuperada; no se aplicó el destino'}
            store.stage(operation_id, 'rolled_back', result=result)
        except Exception as exc:
            result = {'ok': False, 'recoveryRequired': True, 'error': str(exc)}
            store.stage(operation_id, 'recovery_required', result=result)
        motor_result_set(opkey, False, result['error'], operationId=operation_id,
                         rolledBack=result.get('rolledBack', False), recoveryRequired=result.get('recoveryRequired', False))
    motor_stage(opkey, 'recuperando conversación original', 'recovering', operationId=operation_id)
    threading.Thread(target=recover, daemon=True).start()
    return 202, {'ok': True, 'pending': True, 'operationKey': opkey, 'operationId': operation_id}


def harness_switch_apply(payload):
    """Compatibility entry point; the coordinator owns the complete operation."""
    return session_configure({"session": payload["sess"], "pane": payload["pane"],
        "toHarness": payload["to"], "motor": payload.get("motor") or payload["to"],
        "model": payload.get("model") or "", "effort": payload.get("effort") or "",
        "harnessAccount": "main" if payload["to"] == "acp" else payload.get("account") or "main",
        "motorAccount": payload.get("account") or "main", "interrupt": bool(payload.get("interrupt")),
        **({"requestId": payload["requestId"]} if payload.get("requestId") else {})})


def proxy_set_enabled(on):
    """Motor Codex para TODAS las sesiones de Claude Code: ANTHROPIC_BASE_URL en
    ~/.claude/settings.json (el proxy rutea claude-* a Anthropic tal cual, y
    gpt-* a Codex) + servicio cc-proxy. Reversible con un click."""
    port = int(load_proxy_cfg().get("port") or 18765)
    if on:
        subprocess.run(["systemctl", "--user", "enable", "--now", "cc-proxy.service"], capture_output=True, timeout=15)
    else:
        subprocess.run(["systemctl", "--user", "disable", "--now", "cc-proxy.service"], capture_output=True, timeout=15)
    # Claude Code lee `env` del settings.json de SU config-dir: aplicar a todas las cuentas
    paths = [os.path.expanduser("~/.claude/settings.json")] + [
        os.path.join(a["dir"], "settings.json") for a in claude_accounts() if a["alias"] != "main"]
    for path in paths[1:]:
        _proxy_env_write(path, on, port)
    path = paths[0]
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {}
    env = st.get("env") or {}
    if on:
        env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
    else:
        env.pop("ANTHROPIC_BASE_URL", None)
    st["env"] = env
    if not env:
        st.pop("env", None)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)


def claude_pane_busy(pane):
    """'' si Claude Code esta en el prompt esperando; si no, el motivo. Un comando
    tecleado a mitad de turno se encola como MENSAJE, no como comando."""
    r = tmux("capture-pane", "-p", "-t", pane, "-S", "-14")
    if r.returncode != 0:
        return ""
    tail = r.stdout.rstrip("\n")
    if re.search(r"esc to interrupt|ctrl\+c to interrupt|esc para interrumpir", tail, re.I):
        return "La sesion esta trabajando: espera a que termine el turno"
    if re.search(r"^\s*(Do you want|Allow|¿Permitir|Yes, |No, )", tail, re.M) and re.search(r"❯\s*1\.|\(y\)|Enter to confirm", tail, re.I):
        return "La sesion tiene un permiso pendiente: respondelo primero"
    if "❯" not in tail and ">" not in tail:
        return "No veo el prompt de Claude Code en esa sesion"
    return ""


# Cambios de motor/cuenta EN COLA por sesion: generacion que invalida hilos viejos.
MOTOR_GEN = {}
_MOTOR_GEN_LOCK = threading.Lock()


def motor_gen_bump(sess):
    with _MOTOR_GEN_LOCK:
        MOTOR_GEN[sess] = MOTOR_GEN.get(sess, 0) + 1
        return MOTOR_GEN[sess]


def model_switch_cancel(sess, pane):
    opkey = f"{sess}|{pane}" if PANE_RE.match(str(pane or "")) else sess
    store = session_operation_store()
    row = store.latest_for_target(sess, pane)
    if row and row['state'] not in ('confirmed', 'failed', 'rolled_back'):
        if not store.cancel_waiting(row['id']):
            raise ValueError('el cambio ya empezó; espera la verificación o recuperación')
        motor_result_set(opkey, False, 'operación cancelada antes de cerrar el origen', cancelled=True)
    motor_gen_bump(opkey)
    return None


def motor_gen_ok(sess, gen):
    with _MOTOR_GEN_LOCK:
        return MOTOR_GEN.get(sess, 0) == gen


MOTOR_QUEUE_FILE = os.path.expanduser("~/.claude/hooks/motor-queue.json")
MOTOR_RESULT_FILE = os.path.expanduser("~/.claude/hooks/motor-results.json")
_MOTOR_RESULT_LOCK = threading.Lock()


def _motor_result_load():
    try:
        with open(MOTOR_RESULT_FILE) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _motor_result_write():
    try:
        os.makedirs(os.path.dirname(MOTOR_RESULT_FILE), exist_ok=True)
        tmp = MOTOR_RESULT_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(MOTOR_RESULT, f)
        os.replace(tmp, MOTOR_RESULT_FILE)
    except Exception:
        pass


MOTOR_RESULT = _motor_result_load()   # operationKey -> durable stage/result


def _motor_queue_write(d):
    try:
        os.makedirs(os.path.dirname(MOTOR_QUEUE_FILE), exist_ok=True)
        tmp = MOTOR_QUEUE_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, MOTOR_QUEUE_FILE)
    except Exception:
        pass


def motor_queue_put(sess, payload):
    """Cola persistente: un cambio encolado sobrevive reinicios de cc-dash."""
    try:
        with open(MOTOR_QUEUE_FILE) as f:
            d = json.load(f)
    except Exception:
        d = {}
    d[sess] = payload
    _motor_queue_write(d)


def motor_queue_pop(sess, gen):
    try:
        with open(MOTOR_QUEUE_FILE) as f:
            d = json.load(f)
    except Exception:
        return
    if sess in d and d[sess].get("gen", gen) == gen:
        d.pop(sess, None)
        _motor_queue_write(d)


def grok_motor_apply(payload):
    pane, sess = payload["pane"], payload["sess"]
    opkey = payload.get("key") or f"{sess}|{pane}"
    gen = payload["gen"]
    model, effort = payload.get("model") or "", payload.get("effort") or ""
    try:
        if payload.get("interrupt") and grok_pane_busy(sess, pane):
            motor_stage(opkey, "interrumpiendo el turno Grok (Escape)")
            tmux("send-keys", "-t", pane, "Escape")
            time.sleep(1.2)
        if grok_pane_busy(sess, pane):
            motor_stage(opkey, "esperando a que Grok termine el turno")
        for _ in range(1350):
            if not motor_gen_ok(opkey, gen):
                return
            if not grok_pane_busy(sess, pane):
                time.sleep(0.5)
                if not grok_pane_busy(sess, pane):
                    break
            time.sleep(2.0)
        else:
            motor_result_set(opkey, False, "Grok nunca quedo libre (45 min)")
            return
        info = agent_info_for_pane(pane)
        if not info or info.get("agent") != "grok":
            motor_result_set(opkey, False, "el pane ya no contiene Grok")
            return
        current = grok_metadata_for_pid(info.get("pid"))
        if model:
            command = "/model " + model + ((" " + effort) if effort else "")
        elif effort:
            command = "/effort " + effort
        else:
            motor_result_set(opkey, False, "modelo o esfuerzo requeridos")
            return
        motor_stage(opkey, f"tecleando {command}")
        tmux("send-keys", "-t", pane, "C-u")
        time.sleep(0.15)
        r = tmux("send-keys", "-t", pane, "-l", "--", command)
        if r.returncode != 0:
            motor_result_set(opkey, False, r.stderr.strip() or "tmux fallo")
            return
        tmux("send-keys", "-t", pane, "Enter")
        confirm_started = time.time()
        motor_stage(opkey, "confirmando modelo y esfuerzo en summary.json", "confirm", model=model, effort=effort)
        for attempt in range(80):
            if not motor_gen_ok(opkey, gen):
                return
            time.sleep(0.12 if attempt < 40 else 0.4)
            now = grok_metadata_for_pid(info.get("pid"))
            if (not model or now.get("model") == model) and (not effort or now.get("effort") == effort):
                motor_result_set(opkey, True, f"{now.get('model','')} · {now.get('effort','')}",
                                 harness="grok", motor="grok", model=now.get("model", ""), effort=now.get("effort", ""),
                                 confirmMs=int((time.time() - confirm_started) * 1000))
                record_runtime_config(sess, pane, "grok", "grok", now.get("model", ""), now.get("effort", ""),
                                      payload.get("harness_account", "unknown"), payload.get("motor_account", payload.get("harness_account", "unknown")), payload.get("route_id", "grok:grok"), "switch-confirmed")
                if now.get("effort"):
                    session_effort_set(opkey, now.get("effort"))
                return
        motor_result_set(opkey, False,
                         f"Grok no confirmo el cambio; sigue {current.get('model','?')} · {current.get('effort','?')}")
    finally:
        motor_queue_pop(opkey, gen)


def _native_slash_motor_apply(payload, harness, slash_cmds):
    """Cambio de modelo/esfuerzo en un CLI nativo (agy/opencode): espera idle,
    teclea slash commands, registra el resultado. Sin fingir que es Claude."""
    pane, sess = payload["pane"], payload["sess"]
    opkey = payload.get("key") or f"{sess}|{pane}"
    gen = payload["gen"]
    model, effort = payload.get("model") or "", payload.get("effort") or ""
    try:
        if payload.get("interrupt") and harness_pane_busy(sess, pane, harness):
            motor_stage(opkey, f"interrumpiendo el turno {harness} (Escape)")
            tmux("send-keys", "-t", pane, "Escape")
            time.sleep(1.0)
        if harness_pane_busy(sess, pane, harness):
            motor_stage(opkey, f"esperando a que {harness} quede libre", "wait_idle")
        for _ in range(1350):
            if not motor_gen_ok(opkey, gen):
                return
            if not harness_pane_busy(sess, pane, harness):
                time.sleep(0.4)
                if not harness_pane_busy(sess, pane, harness):
                    break
            time.sleep(2.0)
        else:
            motor_result_set(opkey, False, f"{harness} nunca quedó libre (45 min)")
            return
        info = agent_info_for_pane(pane)
        if not info or info.get("agent") != harness:
            motor_result_set(opkey, False, f"el pane ya no contiene {harness}")
            return
        for command in slash_cmds:
            motor_stage(opkey, f"tecleando {command}", "apply")
            err = _tmux_slash(pane, command)
            if err:
                motor_result_set(opkey, False, err)
                return
            time.sleep(0.6)
        record_runtime_config(sess, pane, "agy" if harness == "agy" else harness,
                              "agy" if harness == "agy" else harness, model, effort,
                              payload.get("harness_account", "main"),
                              payload.get("motor_account", "main"),
                              payload.get("route_id", f"{harness}:{harness}"),
                              "switch-confirmed")
        if effort:
            session_effort_set(opkey, effort)
        motor_result_set(opkey, True, f"{harness} · {model} · {effort}".strip(" ·"),
                         harness=harness, motor=harness, model=model, effort=effort)
    finally:
        motor_queue_pop(opkey, gen)


def agy_motor_apply(payload):
    model, effort = payload.get("model") or "", payload.get("effort") or ""
    cmds = []
    if model:
        cmds.append("/model " + model)
    if effort:
        cmds.append("/effort " + effort)
    if not cmds:
        motor_result_set(payload.get("key") or payload["sess"], False, "modelo o esfuerzo requeridos")
        return
    _native_slash_motor_apply(payload, "agy", cmds)


def opencode_motor_apply(payload):
    """OpenCode busca por NOMBRE en /models; luego registra el modelo elegido."""
    pane, sess = payload["pane"], payload["sess"]
    opkey = payload.get("key") or f"{sess}|{pane}"
    gen = payload["gen"]
    model = payload.get("model") or ""
    query = payload.get("query") or ""
    try:
        if payload.get("interrupt") and harness_pane_busy(sess, pane, "opencode"):
            motor_stage(opkey, "interrumpiendo OpenCode (Escape)")
            tmux("send-keys", "-t", pane, "Escape")
            time.sleep(0.8)
        if harness_pane_busy(sess, pane, "opencode"):
            motor_stage(opkey, "esperando a que OpenCode quede libre", "wait_idle")
        for _ in range(1350):
            if not motor_gen_ok(opkey, gen):
                return
            if not harness_pane_busy(sess, pane, "opencode"):
                time.sleep(0.4)
                if not harness_pane_busy(sess, pane, "opencode"):
                    break
            time.sleep(2.0)
        else:
            motor_result_set(opkey, False, "OpenCode nunca quedó libre (45 min)")
            return
        info = agent_info_for_pane(pane)
        if not info or info.get("agent") != "opencode":
            motor_result_set(opkey, False, "el pane ya no contiene OpenCode")
            return
        motor_stage(opkey, f"tecleando /models → {query or model}", "apply")
        for keys, pause in (
            (("Escape",), 0.35), (("C-u",), 0.25),
            (("-l", "--", "/models"), 0.5), (("Enter",), 1.0),
            (("-l", "--", query or model), 0.8), (("Enter",), 0),
        ):
            r = tmux("send-keys", "-t", pane, *keys)
            if r.returncode != 0:
                motor_result_set(opkey, False, r.stderr.strip() or "tmux fallo")
                return
            if pause:
                time.sleep(pause)
        record_runtime_config(sess, pane, "opencode", "opencode", model, "",
                              payload.get("harness_account", "main"),
                              payload.get("motor_account", "main"),
                              payload.get("route_id", "opencode:opencode"),
                              "switch-confirmed")
        motor_result_set(opkey, True, f"opencode · {model}",
                         harness="opencode", motor="opencode", model=model, effort="")
    finally:
        motor_queue_pop(opkey, gen)


def _tmux_slash(pane, command):
    tmux("send-keys", "-t", pane, "C-u")
    time.sleep(0.12)
    r = tmux("send-keys", "-t", pane, "-l", "--", command)
    if r.returncode != 0:
        return r.stderr.strip() or "tmux fallo"
    tmux("send-keys", "-t", pane, "Enter")
    return None


def acp_motor_apply(payload):
    """Cambio de motor/modelo/esfuerzo/cuenta DENTRO de cc-acp: slash commands,
    no relanzar el pane. /agent relanza el subproceso ACP; el pane sigue vivo."""
    pane, sess = payload["pane"], payload["sess"]
    opkey = payload.get("key") or f"{sess}|{pane}"
    gen = payload["gen"]
    want_motor = str(payload.get("motor") or "")
    want_model = str(payload.get("model") or "")
    want_effort = str(payload.get("effort") or "")
    want_account = str(payload.get("motor_account") or payload.get("account") or "")
    try:
        if payload.get("interrupt") and harness_pane_busy(sess, pane, "acp"):
            motor_stage(opkey, "interrumpiendo el turno ACP (Escape)")
            tmux("send-keys", "-t", pane, "Escape")
            time.sleep(1.0)
        if harness_pane_busy(sess, pane, "acp"):
            motor_stage(opkey, "esperando a que ACP quede libre", "wait_idle")
        for _ in range(1350):
            if not motor_gen_ok(opkey, gen):
                return
            if not harness_pane_busy(sess, pane, "acp"):
                time.sleep(0.4)
                if not harness_pane_busy(sess, pane, "acp"):
                    break
            time.sleep(2.0)
        else:
            motor_result_set(opkey, False, "ACP nunca quedó libre (45 min)")
            return
        info = agent_info_for_pane(pane)
        if not info or info.get("agent") != "acp":
            motor_result_set(opkey, False, "el pane ya no contiene ACP")
            return
        current = acp_state_for_pane(pane)
        cmds = list(payload.get("cmds") or [])
        if not cmds:
            if want_motor and want_motor != current.get("agent"):
                cmds.append("/agent " + want_motor)
            if want_model and want_model != current.get("model"):
                cmds.append("/model " + want_model)
            if want_effort and want_effort != current.get("effort"):
                cmds.append("/effort " + want_effort)
            if want_account and want_account != (current.get("account") or "main"):
                cmds.append("/account " + want_account)
        if not cmds:
            motor_result_set(opkey, True, "ACP ya está en ese setup",
                             harness="acp", motor=current.get("agent") or want_motor,
                             model=current.get("model") or want_model, effort=current.get("effort") or want_effort)
            return
        for command in cmds:
            if not motor_gen_ok(opkey, gen):
                return
            motor_stage(opkey, f"tecleando {command}", "apply")
            err = _tmux_slash(pane, command)
            if err:
                motor_result_set(opkey, False, err)
                return
            if command.startswith("/agent "):
                dest = command.split(None, 1)[1]
                for _ in range(50):
                    time.sleep(0.3)
                    if acp_state_for_pane(pane).get("agent") == dest:
                        break
            else:
                time.sleep(0.8)
        confirm_started = time.time()
        motor_stage(opkey, "confirmando en acp-panes.json", "confirm",
                    model=want_model, effort=want_effort)
        for attempt in range(80):
            if not motor_gen_ok(opkey, gen):
                return
            time.sleep(0.15 if attempt < 40 else 0.4)
            now = acp_state_for_pane(pane)
            motor_ok = (not want_motor) or now.get("agent") == want_motor
            model_ok = (not want_model) or now.get("model") == want_model
            effort_ok = (not want_effort) or now.get("effort") == want_effort
            account_ok = (not want_account) or now.get("account") == want_account
            if motor_ok and model_ok and effort_ok and account_ok:
                motor_result_set(opkey, True, f"acp:{now.get('agent','')} · {now.get('model','')} · {now.get('effort','')}",
                                 harness="acp", motor=now.get("agent") or want_motor,
                                 model=now.get("model") or want_model, effort=now.get("effort") or want_effort,
                                 confirmMs=int((time.time() - confirm_started) * 1000))
                record_runtime_config(sess, pane, "acp", now.get("agent") or want_motor,
                                      now.get("model") or want_model, now.get("effort") or want_effort,
                                      payload.get("harness_account", "main"),
                                      now.get("account") or want_account or "main",
                                      payload.get("route_id") or f"acp:{now.get('agent') or want_motor}",
                                      "switch-confirmed")
                if now.get("effort") or want_effort:
                    session_effort_set(opkey, now.get("effort") or want_effort)
                return
        motor_result_set(opkey, False, "ACP no confirmó el cambio; reintenta")
    finally:
        motor_queue_pop(opkey, gen)


def motor_apply(payload):
    """Teclea /model y /effort en el pane con certeza: espera al prompt (anti-
    carrera con doble check), confirma en el pane y reintenta; restaura los
    defaults de settings.json; reporta a MOTOR_RESULT; limpia la cola."""
    pane, cmds, provider = payload["pane"], payload["cmds"], payload["provider"]
    saved, sess, effort = payload.get("saved"), payload["sess"], payload.get("effort")
    gen, interrupt = payload["gen"], payload.get("interrupt")
    opkey = payload.get("key") or sess
    if provider == "grok":
        return grok_motor_apply(payload)
    if provider == "acp":
        return acp_motor_apply(payload)
    if provider == "agy":
        return agy_motor_apply(payload)
    if provider == "opencode":
        return opencode_motor_apply(payload)
    op_started = time.time()
    apply_started = op_started
    try:
        if interrupt and provider == "claude" and claude_pane_busy(pane):
            motor_stage(opkey, "interrumpiendo el turno (Escape)")
            tmux("send-keys", "-t", pane, "Escape")
            time.sleep(1.5)
        if provider == "claude":
            if claude_pane_busy(pane):
                motor_stage(opkey, "esperando a que termine el turno", "wait_idle")
            deadline = time.monotonic() + 2700
            while time.monotonic() < deadline:
                if not motor_gen_ok(opkey, gen):
                    return   # cancelado o superado por un click mas nuevo
                if not claude_pane_busy(pane):
                    time.sleep(0.18)
                    if not claude_pane_busy(pane):
                        break
                time.sleep(0.4)
            else:
                motor_result_set(opkey, False, "la sesion nunca quedo libre (45 min)")
                return
            if not motor_gen_ok(opkey, gen):
                return
        apply_started = time.time()
        for i, c in enumerate(cmds):
            if i:
                motor_stage(opkey, "esperando el prompt para el siguiente ajuste", "wait_prompt")
                for attempt in range(60):
                    if not claude_pane_busy(pane):
                        break
                    time.sleep(0.1 if attempt < 30 else 0.3)
            marker = ("Set model to" if c.startswith("/model ") else
                      "Set effort level" if c.startswith("/effort ") else "")
            motor_stage(opkey, f"tecleando {c}", "apply", command=c.split()[0])
            sent = False
            for attempt in range(3):
                if not motor_gen_ok(opkey, gen):
                    return
                if provider == "claude":
                    tmux("send-keys", "-t", pane, "C-u")   # limpiar texto a medio escribir sin interrumpir nada
                    time.sleep(0.15)
                before = tmux("capture-pane", "-p", "-t", pane, "-S", "-220").stdout
                r = tmux("send-keys", "-t", pane, "-l", "--", c)
                if r.returncode != 0:
                    motor_result_set(opkey, False, f"tmux fallo con {c}")
                    return
                tmux("send-keys", "-t", pane, "Enter")
                if provider != "claude" or not marker:
                    sent = True
                    break
                motor_stage(opkey, f"confirmando {c.split(chr(32))[0]} en el pane", "confirm", model=payload.get("model"), effort=effort)
                confirmed, failure = claude_command_confirm(pane, c, before, 15)
                if confirmed:
                    sent = True
                    break
                if failure:
                    motor_result_set(opkey, False, failure)
                    return
                motor_stage(opkey, f"no entro {c.split(chr(32))[0]}: reintento {attempt + 2}/3")
                for _ in range(60):
                    if not claude_pane_busy(pane):
                        break
                    time.sleep(2.0)
            if not sent:
                motor_result_set(opkey, False, f"no se confirmo {c} en el pane")
                return
        motor_result_set(opkey, True, " · ".join(cmds),
                         harness=payload.get("harness", "claude"), motor=payload.get("motor", "claude"),
                         model=payload.get("model", ""), effort=effort or "",
                         queuedMs=max(0, int((apply_started - op_started) * 1000)),
                         applyMs=max(0, int((time.time() - apply_started) * 1000)))
        if payload.get("route_id"):
            record_runtime_config(sess, pane, payload.get("harness", "claude"), payload.get("motor", "claude"),
                                  payload.get("model", ""), effort or "", payload.get("harness_account", "unknown"),
                                  payload.get("motor_account", "unknown"), payload["route_id"], "switch-confirmed")
        if effort and provider == "claude":
            session_effort_set(opkey, effort)
        if provider == "claude" and saved:
            time.sleep(4.0 + 3.5 * (len(cmds) - 1))
            path = os.path.expanduser("~/.claude/settings.json")
            try:
                with open(path) as f:
                    st = json.load(f)
                changed = False
                for k, v in saved.items():
                    if st.get(k) != v:
                        changed = True
                        if v is None:
                            st.pop(k, None)
                        else:
                            st[k] = v
                if changed:
                    tmp = path + ".tmp"
                    with open(tmp, "w") as f:
                        json.dump(st, f, indent=2, ensure_ascii=False)
                    os.replace(tmp, path)
            except Exception:
                pass
    finally:
        motor_queue_pop(opkey, gen)


def motor_queue_resume():
    """Retain legacy queue records for inspection, without replaying terminal IO."""
    session_operation_store().recover_abandoned()
    try:
        with open(MOTOR_QUEUE_FILE) as fh:
            queued = json.load(fh)
    except (OSError, ValueError):
        return
    for opkey in queued:
        motor_result_set(opkey, False, "cambio antiguo sin snapshot verificable; vuelve a solicitarlo")


def _set_motor_result(key, result):
    with _MOTOR_RESULT_LOCK:
        MOTOR_RESULT[key] = result
        if len(MOTOR_RESULT) > 300:
            oldest = sorted(MOTOR_RESULT.items(), key=lambda pair: float(pair[1].get("ts") or 0))[:-200]
            for old_key, _value in oldest:
                MOTOR_RESULT.pop(old_key, None)
        _motor_result_write()


def motor_result_set(sess, ok, detail, **fields):
    result = {"ok": bool(ok), "detail": str(detail)[:200], "ts": time.time()}
    result.update({key: value for key, value in fields.items() if value is not None})
    _set_motor_result(sess, result)


def motor_stage(sess, stage, code="", **fields):
    """Progreso pane-aware; the UI polls only this operation while active."""
    result = {"stage": str(stage)[:120], "ts": time.time()}
    if code:
        result["stageCode"] = str(code)[:40]
    result.update({key: value for key, value in fields.items() if value is not None})
    _set_motor_result(sess, result)


def claude_command_confirm(pane, command, baseline, secs):
    """Confirm a NEW result for this command and handle provider-switch UI."""
    marker = ("Set model to" if command.startswith("/model ") else
              "Set effort level" if command.startswith("/effort ") else "")
    target = command.split(None, 1)[1].split()[0] if " " in command else ""
    dialog_answered = False
    deadline = time.monotonic() + secs
    attempt = 0
    while time.monotonic() < deadline:
        r = tmux("capture-pane", "-p", "-t", pane, "-S", "-220")
        text = r.stdout if r.returncode == 0 else ""
        command_pos = text.rfind(command)
        tail = text[command_pos:] if command_pos >= 0 else ""
        if (command.startswith("/model ") and not dialog_answered and
                "Switch model?" in tail and target.lower() in tail.lower()):
            tmux("send-keys", "-t", pane, "1")
            tmux("send-keys", "-t", pane, "Enter")
            dialog_answered = True
            time.sleep(0.8)
            continue
        if marker and tail.rfind(marker) >= 0:
            return True, ""
        errors = [line.strip() for line in tail.splitlines()
                  if "API Error:" in line or ("Model '" in line and "not found" in line)]
        if errors:
            return False, errors[-1][:200]
        attempt += 1
        time.sleep(0.12 if attempt < 30 else 0.35)
    return False, ""


def claude_model_for_pid(pid):
    args = _proc_cmdline(pid) if pid else []
    for index, value in enumerate(args[:-1]):
        if value == "--model":
            candidate = str(args[index + 1])[:120]
            # un proceso lanzado con `--model --effort` (flags sin valor de un
            # snapshot roto) NO tiene modelo: jamas reportar un flag como modelo
            return "" if candidate.startswith("-") else candidate
    return ""


def pane_visible_config(pane, harness):
    if not pane:
        return {}
    result = tmux("capture-pane", "-p", "-t", pane, "-S", "-45")
    return tui_state.screen_state(harness, result.stdout) if result.returncode == 0 else {}


def claude_pane_model(pane):
    return pane_visible_config(pane, 'claude').get('model', '')


def codex_pane_model(pane):
    observed = pane_visible_config(pane, 'codex')
    return observed.get('model', ''), observed.get('effort', '')


def confirm_codex_native(opkey, sess, pane, model, effort, route_id="codex:codex", account="main", motor_account=""):
    started = time.time()
    motor_stage(opkey, "confirmando modelo y esfuerzo en Codex CLI", "confirm", model=model, effort=effort)
    for attempt in range(60):
        time.sleep(0.15 if attempt < 30 else 0.4)
        got_model, got_effort = codex_pane_model(pane)
        if got_model == model and (not effort or got_effort == effort):
            motor_result_set(opkey, True, f"{got_model} · {got_effort}",
                             harness="codex", motor="codex", model=got_model, effort=got_effort,
                             confirmMs=int((time.time() - started) * 1000))
            record_runtime_config(sess, pane, "codex", "codex", got_model, got_effort,
                                  account, motor_account or account, route_id, "switch-confirmed")
            if got_effort:
                session_effort_set(opkey, got_effort)
            return
    motor_result_set(opkey, False, "Codex CLI no confirmó el cambio")


SESSION_EFFORT = os.path.expanduser("~/.claude/hooks/session-effort.json")


def session_effort_all():
    try:
        with open(SESSION_EFFORT) as f:
            return json.load(f)
    except Exception:
        return {}


def session_effort_set(sess, effort):
    d = session_effort_all()
    d[sess] = effort
    # Si escribimos una clave pane-level (sess|pane), la clave de SESIÓN suelta
    # queda como basura que desincroniza la card (un pane en low mientras la
    # clave de sesión dice high). La eliminamos: con pane presente, la verdad
    # es por pane.
    if "|" in sess:
        d.pop(sess.split("|", 1)[0], None)
    try:
        os.makedirs(os.path.dirname(SESSION_EFFORT), exist_ok=True)
        tmp = SESSION_EFFORT + ".tmp"
        with open(tmp, "w") as f:
            json.dump(d, f)
        os.replace(tmp, SESSION_EFFORT)
    except Exception:
        pass


def effort_defaults():
    """Default de esfuerzo de Claude Code: global y por modelo (settings.json)."""
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            st = json.load(f)
    except Exception:
        return {"effort": "", "perModel": {}}
    per = {k: (v or {}).get("effortLevel") for k, v in (st.get("modelSettings") or {}).items() if isinstance(v, dict)}
    return {"effort": st.get("effortLevel") or "", "perModel": {k: v for k, v in per.items() if v}}


def motor_global():
    """'codex' si el modelo por defecto de Claude Code es gpt-*, si no 'claude'."""
    try:
        with open(os.path.expanduser("~/.claude/settings.json")) as f:
            m = str(json.load(f).get("model") or "")
    except Exception:
        m = ""
    return (provider_registry.engine_for_model(load_provider_registry(), m) or "claude"), m


def motor_set_global(motor, model=None):
    cfg = load_proxy_cfg()
    if motor not in (load_provider_registry().get("claudeEngines") or {}):
        raise ValueError(f"motor desconocido: {motor}")
    prov = cfg.get(motor) or {}
    allowed = {m.get("id") for m in prov.get("menu") or []}
    model = (model or "").strip()
    defaults = {"claude": "claude-fable-5[1m]", "codex": "gpt-5.6-sol[1m]", "grok": "grok-4.6"}
    if model not in allowed:
        model = prov.get("model") or defaults.get(motor, "")
    path = os.path.expanduser("~/.claude/settings.json")
    try:
        with open(path) as f:
            st = json.load(f)
    except Exception:
        st = {}
    st["model"] = model
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(st, f, indent=2, ensure_ascii=False)
    os.replace(tmp, path)
    return model


def proxy_alive():
    import socket
    try:
        with socket.create_connection(("127.0.0.1", int(load_proxy_cfg().get("port") or 18765)), timeout=0.3):
            return True
    except OSError:
        return False
_model_tiers_cache = {"mtime": None, "data": {}}

# agente -> (variable de entorno del dir de config, dir por defecto)
AGENT_ACCOUNT_ENV = {
    "claude": ("CLAUDE_CONFIG_DIR", "~/.claude"),
    "codex": ("CODEX_HOME", "~/.codex"),
    "grok": ("GROK_HOME", "~/.grok"),
}


def load_model_tiers():
    try:
        mtime = os.path.getmtime(MODEL_TIERS_FILE)
    except OSError:
        return _model_tiers_cache["data"]
    if _model_tiers_cache["mtime"] != mtime:
        try:
            with open(MODEL_TIERS_FILE) as f:
                data = json.load(f)
            _model_tiers_cache.update(mtime=mtime,
                                      data=data if isinstance(data, dict) else {})
        except Exception:
            pass
    return _model_tiers_cache["data"]


def model_tier(model):
    if not model:
        return ""
    cfg = load_model_tiers()
    for pat in cfg.get("patterns") or []:
        try:
            if re.search(pat.get("match", ""), model, re.I):
                return pat.get("tier") or ""
        except re.error:
            continue
    return cfg.get("defaultTier") or ""


def tier_style(tier):
    st = (load_model_tiers().get("tiers") or {}).get(tier or "")
    return st if isinstance(st, dict) else {}


def _read_environ(pid):
    try:
        with open(f"/proc/{int(pid)}/environ", "rb") as f:
            raw = f.read()
        return dict(x.split(b"=", 1) for x in raw.split(b"\0") if b"=" in x)
    except Exception:
        return {}


_ACCOUNT_PID_CACHE = {}
_ACCOUNT_EMAIL_CACHE = {}


def account_email_for_dir(path, agent):
    """Read public identity only when its source file changes (login/logout)."""
    cfg = os.path.join(path, 'auth.json' if agent in ('codex', 'grok') else '.claude.json')
    if agent == 'claude' and not os.path.exists(cfg):
        cfg = os.path.join(os.path.dirname(path.rstrip('/')), '.claude.json')
    try:
        st = os.stat(cfg)
        signature = (st.st_dev, st.st_ino, st.st_mtime_ns, st.st_size)
    except OSError:
        signature = None
    key = (path, agent)
    hit = _ACCOUNT_EMAIL_CACHE.get(key)
    if hit and hit[1] == signature:
        return hit[0]
    email = ''
    try:
        with open(cfg) as f:
            data = json.load(f)
        if agent == 'codex':
            token = (data.get('tokens') or {}).get('id_token', '')
            if token.count('.') >= 2:
                part = token.split('.')[1]
                part += '=' * (-len(part) % 4)
                email = json.loads(base64.urlsafe_b64decode(part)).get('email', '')
        elif agent == 'grok':
            rec = next((v for v in data.values() if isinstance(v, dict)), {})
            email = rec.get('email') or rec.get('user_id') or rec.get('principal_id') or ''
        else:
            email = (data.get('oauthAccount') or {}).get('emailAddress') or ''
    except Exception:
        pass
    if len(_ACCOUNT_EMAIL_CACHE) > 4096:
        _ACCOUNT_EMAIL_CACHE.clear()
    _ACCOUNT_EMAIL_CACHE[key] = (email, signature)
    return email


def _process_start(pid):
    try:
        with open(f'/proc/{int(pid)}/stat') as fh:
            return fh.read().rsplit(')', 1)[1].split()[19]
    except (OSError, ValueError, IndexError):
        return ''


def account_for_pid(pid, agent):
    """The process fixes its account directory; native login can change identity."""
    spec = AGENT_ACCOUNT_ENV.get(agent or '')
    if not spec or not pid:
        return {}
    key = (int(pid), _process_start(pid), agent)
    hit = _ACCOUNT_PID_CACHE.get(key)
    if hit is None:
        env = _read_environ(pid)
        envvar, default = spec
        raw = env.get(envvar.encode())
        base = os.path.expanduser(default)
        path = raw.decode('utf-8', 'replace') if raw else base
        is_main = os.path.realpath(path) == os.path.realpath(base)
        alias = 'main' if is_main else (os.path.basename(path.rstrip('/')) or 'main')
        hit = (alias, path)
        if len(_ACCOUNT_PID_CACHE) > 4096:
            _ACCOUNT_PID_CACHE.clear()
        _ACCOUNT_PID_CACHE[key] = hit
    alias, path = hit
    return {'account': alias, 'accountEmail': account_email_for_dir(path, agent)}


TOOL_COSTS_FILE = os.path.join(REPO_ROOT, "config", "tool-costs.json")
_tool_costs_cache = {"mtime": None, "data": {}}


def load_tool_costs():
    try:
        mtime = os.path.getmtime(TOOL_COSTS_FILE)
    except OSError:
        return _tool_costs_cache["data"]
    if _tool_costs_cache["mtime"] != mtime:
        try:
            with open(TOOL_COSTS_FILE) as f:
                d = json.load(f)
            _tool_costs_cache.update(mtime=mtime, data=d if isinstance(d, dict) else {})
        except Exception:
            pass
    return _tool_costs_cache["data"]


def _mcp_est_tokens(name):
    cfg = load_tool_costs()
    known = cfg.get("mcpServers") or {}
    for key, val in known.items():
        if key in name:
            return int(val)
    return int(cfg.get("mcpServerDefault") or 1500)


def _read_json_quiet(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}


def session_mcps(cwd):
    """MCPs visibles para un cwd: globales (~/.claude.json) + del proyecto
    (.mcp.json), con su estado segun settings del proyecto."""
    out = []
    settings = {}
    for fn in ("settings.json", "settings.local.json"):
        settings.update(_read_json_quiet(os.path.join(cwd, ".claude", fn)) or {})
    disabled = set(settings.get("disabledMcpjsonServers") or [])
    glob_cfg = _read_json_quiet(os.path.expanduser("~/.claude.json"))
    for name in sorted((glob_cfg.get("mcpServers") or {}).keys()):
        out.append({"name": name, "scope": "user", "enabled": True,
                    "est_tokens": _mcp_est_tokens(name), "toggleable": False})
    proj = _read_json_quiet(os.path.join(cwd, ".mcp.json"))
    for name in sorted((proj.get("mcpServers") or {}).keys()):
        out.append({"name": name, "scope": "project",
                    "enabled": name not in disabled,
                    "est_tokens": _mcp_est_tokens(name), "toggleable": True})
    return out


def _skill_dirs(cwd):
    dirs = [(os.path.expanduser("~/.claude/skills"), "user")]
    if cwd:
        dirs.append((os.path.join(cwd, ".claude", "skills"), "project"))
    return dirs


def _parse_skill_md(path):
    """(name, description, disabled) del frontmatter de un SKILL.md."""
    try:
        with open(path) as f:
            txt = f.read(20000)
    except OSError:
        return None
    m = re.match(r"^---\n(.*?)\n---", txt, re.S)
    if not m:
        return None
    fm = m.group(1)
    def field(key):
        fm_m = re.search(rf"^{key}:\s*(.+)$", fm, re.M)
        return fm_m.group(1).strip().strip("\"'") if fm_m else ""
    disabled = bool(re.search(r"^disable-model-invocation:\s*true\s*$", fm, re.M))
    return {"name": field("name") or os.path.basename(os.path.dirname(path)),
            "description": field("description"), "disabled": disabled}


def session_skills(cwd):
    cfg = load_tool_costs()
    per_char = float(cfg.get("skillCharsPerToken") or 4)
    overhead = int(cfg.get("skillOverheadTokens") or 30)
    out = []
    for base, scope in _skill_dirs(cwd):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for n in names:
            md = os.path.join(base, n, "SKILL.md")
            info = _parse_skill_md(md)
            if not info:
                continue
            est = overhead + int(len(info["name"] + info["description"]) / per_char)
            out.append({"name": info["name"], "scope": scope, "path": md,
                        "enabled": not info["disabled"],
                        "est_tokens": 0 if info["disabled"] else est,
                        "est_full": est, "toggleable": True})
    return out


def toggle_skill(path, enable):
    """Prende/apaga una skill via disable-model-invocation en su frontmatter.
    Apagada = cero tokens hasta invocarla a mano (mecanismo documentado)."""
    real = os.path.realpath(path)
    allowed = [os.path.realpath(os.path.expanduser("~/.claude/skills"))]
    if not any(real.startswith(a + os.sep) for a in allowed) or             not real.endswith("SKILL.md"):
        # skills de proyecto: permitir si el md esta bajo <algo>/.claude/skills
        if "/.claude/skills/" not in real or not real.endswith("SKILL.md"):
            return "ruta fuera de los directorios de skills"
    try:
        with open(real) as f:
            txt = f.read()
    except OSError as e:
        return str(e)
    m = re.match(r"^(---\n)(.*?)(\n---)", txt, re.S)
    if not m:
        return "SKILL.md sin frontmatter"
    fm = m.group(2)
    fm = re.sub(r"\n?disable-model-invocation:.*", "", fm)
    if not enable:
        fm += "\ndisable-model-invocation: true"
    new = "---\n" + fm + "\n---" + txt[m.end(3):]
    tmp = real + ".tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.replace(tmp, real)
    return None


def toggle_project_mcp(cwd, name, enable):
    sdir = os.path.join(cwd, ".claude")
    os.makedirs(sdir, exist_ok=True)
    spath = os.path.join(sdir, "settings.local.json")
    data = _read_json_quiet(spath)
    dis = set(data.get("disabledMcpjsonServers") or [])
    if enable:
        dis.discard(name)
    else:
        dis.add(name)
    data["disabledMcpjsonServers"] = sorted(dis)
    tmp = spath + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, spath)
    return None


