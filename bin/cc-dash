            # La app solo escribe la sesión de la pestaña. Tmux sí conoce el
            # PANE activo: al clickar un split, enriquecer la señal con %pane.
            sess_a = str(active.get("session") or "")
            if SESSION_RE.match(sess_a) and tmux("has-session", "-t", "=" + sess_a).returncode == 0:
                rp = tmux("display-message", "-p", "-t", "=" + sess_a + ":", "#{pane_id}")
                pane_a = rp.stdout.strip() if rp.returncode == 0 else ""
                if PANE_RE.match(pane_a):
                    active["pane"] = pane_a
            return self._json(200, active)
        if self.path.startswith("/dedication"):
            return self._json(200, dedication_stats())
        if self.path == "/pomodoro":
            return self._json(200, {"focus": focus_state(), "queue": focus_queue(),
                                    "analytics": cc_usage.focus_analytics(USAGE_DB, 7),
                                    "settings": cc_usage.read_focus_settings(USAGE_DB)})
        if self.path == "/sovereignty":
            return self._json(200, sovereignty_report())
        if self.path.startswith("/model/status"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            operation = str((query.get("operationKey") or [""])[0])[:120]
            session_part, _, pane_part = operation.partition("|")
            if not SESSION_RE.fullmatch(session_part) or (pane_part and not PANE_RE.fullmatch(pane_part)):
                return self._json(400, {"error": "operationKey invalido"})
            result = dict(MOTOR_RESULT.get(operation) or {})
            if not result:
                result = {"stage": "preparando cambio", "stageCode": "prepare", "ts": time.time()}
            result["operationKey"] = operation
            return self._json(200, result)
        if self.path == "/proxy":
            cfg = load_proxy_cfg()
            mg, mm = motor_global()
