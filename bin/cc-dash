                row["est_tokens"] = _mcp_est_tokens(row["name"]) if row.get("enabled") else 0
                row["toggleable"] = harness == "claude" and row.get("source") == "mcp-json" and row.get("scope") == "project"
                mcps.append(row)
            accounts = account_registry.list_accounts(load_provider_registry(), harness)
            md_name, md_lines = _claude_md_lines(cwd) if harness == "claude" else ("", [])
            return self._json(200, {"harness": harness, "account": alias,
                                    "mcps": mcps, "mcpDetection": {"status": inventory.get("status"), "confidence": inventory.get("confidence")},
                                    "skills": session_skills(cwd) if harness == "claude" else [],
                                    "accounts": accounts,
                                    "claudeMd": {"name": md_name, "lines": md_lines}})

        if self.path.startswith("/usage/guard"):
            return self._json(200, token_guard_with_forecast())
        if self.path.startswith("/usage/changes"):
            return self._json(200, {"changes": cc_usage.change_ledger(USAGE_DB)})
        if self.path.startswith("/notifs/count"):
            # cuenta lo IMPORTANTE con las mismas llaves del panel v2, y
            # respeta la limpieza compartida (prefs.nfDismiss/nfSnooze).
            prefs = read_prefs()
            dis = set((prefs.get("nfDismiss") or {}).keys())
            snz = prefs.get("nfSnooze") or {}
            nowt = time.time()
            keys = []
            try:
                g = token_guard_with_forecast()
                for f in g.get("forecasts") or []:
                    if f.get("level") != "normal":
                        keys.append(f"fc|{f.get('scope')}|{round(float(f.get('percent') or 0)/5)}")
                for p in g.get("projects") or []:
                    if p.get("level") == "critical":
                        keys.append(f"gp|{p.get('project')}|{round(float(p.get('tokensHour') or 0)/2e7)}")
            except Exception:
                pass
            try:
                for it in read_states_cached():
                    s2 = it.get("suggestion")
                    if s2 and it.get("alive"):
                        keys.append(f"sg|{it.get('session')}|{it.get('pane') or ''}|{s2.get('kind')}|{s2.get('model') or s2.get('key') or s2.get('command') or ''}")
            except Exception:
                pass
            mw = _read_json_quiet(MODEL_WATCH_FILE) or {}
            for prov, info in (mw.get("newSince") or {}).items():
                keys.append(f"mn|{prov}|{','.join(info.get('models') or [])}")
            nw = _read_json_quiet(os.path.join(HOOKS, "news-watch.json")) or {}
            for n in (nw.get("recent") or [])[:8]:
                keys.append(f"nw|{n.get('url')}")
            live = [k for k in keys if k not in dis and float(snz.get(k) or 0) <= nowt]
            return self._json(200, {"count": len(live)})

        if self.path.startswith("/news/latest"):
            return self._json(200, _read_json_quiet(os.path.join(HOOKS, "news-watch.json")) or {})
        if self.path.startswith("/models/latest"):
            data = _read_json_quiet(MODEL_WATCH_FILE) or {}
            return self._json(200, data)
        if self.path.startswith("/fs/dirs"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            return self._json(200, fs_dirs((query.get("path") or ["~"])[0][:512]))
        if self.path.startswith("/usage/provider-compare"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
