def usage_alert_send(message, title=None, kind="waiting", project=None):
    """Entrega una alerta de uso por los MISMOS canales que las notificaciones
    normales: el popup PROPIO de ComandOS (cc-notifyd; jamas el popup plano
    de GNOME) y/o Telegram, segun lo que este prendido."""
    conf = read_conf()
    if conf.get("DESKTOP_NOTIFY", "1") == "1":
        try:
            payload = json.dumps({
                "title": title or "Límite de uso", "body": message, "session": "",
                "kind": kind, "project": project or "Uso", "options": "",
                "full": message,
            }).encode()
            urllib.request.urlopen(urllib.request.Request(
                "http://127.0.0.1:4778/notify", data=payload,
                headers={"Content-Type": "application/json"}), timeout=2)
        except Exception:
            pass
    if conf.get("TELEGRAM_ENABLED") == "1":
        tg = cc_usage.load_usage_config([os.path.join(HOOKS, "telegram.env")])
        token = tg.get("CC_TELEGRAM_BOT_TOKEN") or tg.get("TELEGRAM_BOT_TOKEN")
        chat = tg.get("TELEGRAM_CHAT_ID")
        if token and chat:
            try:
                body = urllib.parse.urlencode({
                    "chat_id": chat, "parse_mode": "HTML",
                    "text": f"<b>ComandOS — Límite de uso</b>\n{message}",
                }).encode()
                urllib.request.urlopen(urllib.request.Request(
                    f"https://api.telegram.org/bot{token}/sendMessage",
                    data=body), timeout=5)
            except Exception:
                pass


def alert_thresholds():
    return cc_usage.parse_alert_thresholds(
        usage_runtime_env().get("COMANDOS_ALERT_THRESHOLDS"))


def _check_limit_alerts(limits):
    for alert in cc_usage.limit_threshold_alerts(limits, thresholds=alert_thresholds()):
        try:
            if cc_usage.record_alert_once(USAGE_DB, alert):
                usage_alert_send(alert["message"])
        except Exception:
            pass


def _claude_account_creds():
    """[(alias, creds_path)]: main (~/.claude) + cada ~/.claude-accounts/<alias>.
    Descubrimiento por convencion de directorios — nada hardcodeado."""
    out = [("main", os.path.expanduser("~/.claude/.credentials.json"))]
    base = os.path.expanduser("~/.claude-accounts")
    try:
        for name in sorted(os.listdir(base)):
            path = os.path.join(base, name, ".credentials.json")
            if os.path.isfile(path):
                out.append((name, path))
    except OSError:
        pass
    return out


def claude_accounts():
    """[{alias, dir, email, loggedIn}] — main (~/.claude) + ~/.claude-accounts/<alias>
    (tambien las recien creadas sin login, para que se vean como 'pendiente')."""
    out = [{"alias": "main", "dir": os.path.expanduser("~/.claude")}]
    base = os.path.expanduser("~/.claude-accounts")
    try:
        for name in sorted(os.listdir(base)):
            d = os.path.join(base, name)
            if name.startswith(("-", ".")) or not os.path.isdir(d):
                continue
            out.append({"alias": name, "dir": d})
    except OSError:
        pass
    for a in out:
        a["loggedIn"] = os.path.isfile(os.path.join(a["dir"], ".credentials.json"))
        a["email"] = account_email_for_dir(a["dir"], "claude") if a["loggedIn"] else ""
    return out


def _proc_cmdline(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            return [x.decode("utf-8", "replace") for x in f.read().split(b"\0") if x]
    except Exception:
        return []


# Cuotas declaradas por el USUARIO para providers sin API de limites (Grok).
# Solo numeros de tokens; nada sensible. Editable desde la UI (definir limite).
QUOTAS_FILE = os.path.join(HOOKS, "provider-quotas.json")
_quotas_lock = threading.Lock()


def user_quotas():
    try:
        with open(QUOTAS_FILE) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


# Lo que el USUARIO paga de suscripcion por proveedor (para ROI) + moneda de
# despliegue. Solo montos declarados; nada de datos de tarjetas ni cuentas.
SUBS_FILE = os.path.join(HOOKS, "provider-subs.json")
SUB_CURRENCIES = ("USD", "MXN", "EUR")


def user_subs():
    try:
        with open(SUBS_FILE) as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def set_user_sub(provider, monthly, currency, display=None):
    if provider and provider not in ("claude", "codex", "grok"):
        raise ValueError("provider desconocido")
    with _quotas_lock:
        data = user_subs()
        subs = data.setdefault("subs", {})
        if provider:
            amount = round(max(0.0, float(monthly or 0)), 2)
            cur = str(currency or "USD").upper()
            if cur not in SUB_CURRENCIES:
                raise ValueError("moneda no soportada")
            if amount:
                subs[provider] = {"monthly": amount, "currency": cur}
            else:
                subs.pop(provider, None)
        if display:
            cur = str(display.get("currency") or "USD").upper()
            if cur not in SUB_CURRENCIES:
                raise ValueError("moneda no soportada")
            rate = float(display.get("usdRate") or 0)
            data["display"] = {"currency": cur,
                               "usdRate": round(rate, 4) if rate > 0 else None}
        tmp = SUBS_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=1)
        os.replace(tmp, SUBS_FILE)
        return data


def set_user_quota(provider, tokens_7d):
    if provider not in ("grok",):
        raise ValueError("provider sin cuota configurable")
    tokens = max(0, int(tokens_7d or 0))
    with _quotas_lock:
        data = user_quotas()
        if tokens:
            data[provider] = {"tokens_7d": tokens, "set_at": int(time.time())}
        else:
            data.pop(provider, None)
        tmp = QUOTAS_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(data, fh, indent=1)
        os.replace(tmp, QUOTAS_FILE)
    return data.get(provider)


# ---- Navegador de carpetas del wizard: SOLO lectura de nombres de
# directorios bajo $HOME, y mkdir confinado a $HOME. Nada de archivos.
FS_HOME = os.path.realpath(os.path.expanduser("~"))


def _fs_safe(path):
    """Path absoluto real, o None si sale de $HOME."""
    try:
        real = os.path.realpath(os.path.expanduser(str(path or "~")))
    except Exception:
        return None
    if real != FS_HOME and not real.startswith(FS_HOME + os.sep):
        return None
    return real


def fs_dirs(path):
    """Estado del path + subcarpetas del ancestro existente mas cercano.
    Si el path no existe, dice exactamente que parte falta (para crearla)."""
    raw = str(path or "~")
    real = _fs_safe(raw)
    if real is None:
        return {"error": "fuera de tu carpeta de usuario"}
    exists = os.path.isdir(real)
    base = real
    missing = ""
    while base and not os.path.isdir(base):
        base, tail = os.path.split(base)
        missing = tail + (os.sep + missing if missing else "")
    frag = "" if exists else missing.split(os.sep)[0].lower()
    dirs = []
    try:
        with os.scandir(base) as it:
            for e in it:
                try:
                    if not e.is_dir(follow_symlinks=False):
                        continue
                except OSError:
                    continue
                if e.name.startswith(".") and not frag.startswith("."):
                    continue
                if frag and not e.name.lower().startswith(frag):
                    continue
                dirs.append(e.name)
    except OSError:
        pass
    dirs.sort(key=str.lower)
    return {"path": real, "exists": exists, "base": base,
            "parent": os.path.dirname(base) if base != FS_HOME else "",
            "missing": missing,
            "home": FS_HOME,
            "dirs": [{"name": n, "path": os.path.join(base, n)} for n in dirs[:150]]}


def fs_mkdir(path):
    real = _fs_safe(path)
    if real is None:
        raise ValueError("solo puedo crear carpetas dentro de tu carpeta de usuario")
    if os.path.isdir(real):
        return real
    if os.path.exists(real):
        raise ValueError("ya existe un ARCHIVO con ese nombre")
    os.makedirs(real, exist_ok=False)
    return real


# ---- Watcher de modelos: siempre saber lo MAS RECIENTE de cada CLI ----
MODEL_WATCH_FILE = os.path.join(HOOKS, "model-watch.json")
_model_watch_state = {"versions": {}, "last_full": 0.0}


def _model_watch_notify(news, versions):
    for prov, models in news.items():
        body = ", ".join(models[:4]) + ("…" if len(models) > 4 else "")
        try:
            urllib.request.urlopen(urllib.request.Request(
                "http://127.0.0.1:4778/notify",
                data=json.dumps({"title": f"Modelos nuevos de {prov} detectados",
                                 "kind": "waiting", "project": "modelos",
                                 "body": f"{body} (CLI {versions.get(prov, '?')}) — pide agregarlos al registry"}).encode(),
                headers={"Content-Type": "application/json"}), timeout=3)
        except Exception:
            pass


def _model_watch_cycle(force=False):
    """Chequeo barato de versiones cada vuelta; escaneo COMPLETO de binarios
    solo si cambio una version o pasaron 6 h. Novedades -> popup."""
    try:
        versions = model_watch_lib.installed_versions()
        changed = versions != _model_watch_state["versions"]
        due = time.time() - _model_watch_state["last_full"] > 6 * 3600
        if force or changed or due:
            result = model_watch_lib.watch_models(
                HOOKS, PROVIDERS_FILE, grok_home=os.path.expanduser("~/.grok"))
            _model_watch_state["last_full"] = time.time()
            if result.get("news"):
                _model_watch_notify(result["news"], versions)
            # noticias de skills/MCPs (patrón Radar): mismas vueltas de 6h
            try:
                nres = news_watch_lib.watch_news(HOOKS)
                fresh = nres.get("news") or []
                if fresh:
                    top = fresh[0]
                    urllib.request.urlopen(urllib.request.Request(
                        "http://127.0.0.1:4778/notify",
                        data=json.dumps({"title": f"Noticias de skills/MCPs ({len(fresh)})",
                                         "kind": "waiting", "project": "noticias",
                                         "body": top.get("title", "")[:140]}).encode(),
                        headers={"Content-Type": "application/json"}), timeout=3)
            except Exception:
                pass
            _model_watch_state["versions"] = versions
            try:
                snap = _read_json_quiet(MODEL_WATCH_FILE) or {}
                snap["heartbeatAt"] = int(time.time())
                tmp = MODEL_WATCH_FILE + ".tmp"
                with open(tmp, "w") as fh:
                    json.dump(snap, fh, indent=1)
                os.replace(tmp, MODEL_WATCH_FILE)
            except Exception:
                pass
            return result
        _model_watch_state["versions"] = versions
        # latido: aunque el ciclo sea el barato (solo versiones), deja
        # constancia de que el watcher VIVE — visible en /models/latest
        try:
            snap = _read_json_quiet(MODEL_WATCH_FILE) or {}
            snap["heartbeatAt"] = int(time.time())
            snap.setdefault("versions", versions)
            tmp = MODEL_WATCH_FILE + ".tmp"
            with open(tmp, "w") as fh:
                json.dump(snap, fh, indent=1)
            os.replace(tmp, MODEL_WATCH_FILE)
        except Exception:
            pass
    except Exception:
        pass
    return None


def _model_watch_loop():
    time.sleep(90)          # no competir con el arranque
    while True:
        _model_watch_cycle()
        time.sleep(1800)    # versiones cada 30 min; binarios al cambiar o 6h


threading.Thread(target=_model_watch_loop, daemon=True).start()


def _refresh_provider_limits():
    global _limits_refreshing
    try:
        codex_rows = cc_usage.read_codex_rate_limits()
        claude_rows, healths = [], {}
        for alias, path in _claude_account_creds():
            rows, health = cc_usage.fetch_claude_oauth_limits(creds_path=path)
            email = account_email_for_dir(os.path.dirname(path), "claude")
            for r in rows:
                r["account"] = alias
                if email:
                    r["accountEmail"] = email
                if alias != "main":
                    r["id"] = f"{alias}:{r.get('id', '')}"
            if not rows and health.get("status") == "error":
                # Fetch fallido (p.ej. 429): conservar el ultimo dato bueno DE
                # ESA cuenta. captured_at delata su edad y la UI la muestra.
                with _limits_lock:
                    rows = [r for r in _limits_cache["limits"]
                            if r.get("provider") == "claude"
                            and (r.get("account") or "main") == alias]
                health["stale"] = bool(rows)
            key = "claude_oauth" if alias == "main" else f"claude_oauth:{alias}"
            health["account"] = alias
            healths[key] = health
            claude_rows += rows
        # Grok: xAI no expone limites por API — mostramos consumo MEDIDO local
        # (usage_turns provider='grok'). Si el usuario configuro su cuota
        # semanal (provider-quotas.json), calculamos % usado y cuanto queda.
        grok_rows = []
        try:
            gm = cc_usage.grok_measured_usage(USAGE_DB)
        except Exception:
            gm = None
        # Limite OFICIAL: el CLI de grok escribe creditUsagePercent + periodo
        # semanal + tier en su log local. Si esta vigente, ese % manda; la
        # cuota declarada por el usuario queda como respaldo.
        official = None
        try:
            official = cc_usage.read_grok_credit_limits(
                [str(home) for _alias, home in grok_state.account_homes()] or None)
        except Exception:
            official = None
        if official and official.get("stale_period"):
            official = None
        if gm or official:
            gm = gm or {"tokens_today": 0, "turns_today": 0, "tokens_7d": 0,
                        "turns_7d": 0, "daily": []}
            quota = int((user_quotas().get("grok") or {}).get("tokens_7d") or 0)
            if official:
                pct = round(float(official["percent"]), 1)
                resets = official["resets_at"]
                conf, label = "exact", "Semana"
                plan = official.get("tier") or ""
                captured = official["captured_at"]
                note = "creditUsagePercent oficial del CLI de grok (log local)"
            else:
                pct = round(gm["tokens_7d"] / quota * 100, 1) if quota > 0 else None
                resets, conf, label, plan = 0, "measured", "Consumo medido", ""
                captured = int(time.time())
                note = "sin dato oficial reciente — abre grok para refrescarlo"
            grok_rows.append({
                "id": "grok_measured", "provider": "grok",
                "kind": "window" if official else "measured",
                "label": label, "scope": "", "percent": pct,
                "resets_at": resets, "severity": "info", "is_active": True,
                "window": "7d", "source": "grok_cli_log" if official else "local",
                "confidence": conf, "captured_at": captured, "account": "main",
                "plan_type": plan or None,
                "tokens_today": gm["tokens_today"], "turns_today": gm["turns_today"],
                "tokens_7d": gm["tokens_7d"], "turns_7d": gm["turns_7d"],
                "daily": gm.get("daily") or [], "quota_7d": quota or None,
                "note": note,
            })
        _check_limit_alerts(claude_rows + codex_rows)
        with _limits_lock:
            _limits_cache["at"] = int(time.time())
            _limits_cache["limits"] = claude_rows + codex_rows + grok_rows
            _limits_cache["health"] = healths
    finally:
        with _limits_lock:
            _limits_refreshing = False


def usage_provider_limits(force=False):
    global _limits_refreshing
    if force:
        with _limits_lock:
            _limits_refreshing = True
        _refresh_provider_limits()
    else:
        with _limits_lock:
            health = _limits_cache["health"].get("claude_oauth") or {}
            ttl = LIMITS_TTL * 3 if health.get("status") == "error" else LIMITS_TTL
            stale = time.time() - _limits_cache["at"] > ttl
            start = stale and not _limits_refreshing
            if start:
                _limits_refreshing = True
        if start:
            threading.Thread(target=_refresh_provider_limits, daemon=True).start()
    with _limits_lock:
        return {"limits": list(_limits_cache["limits"]),
                "health": dict(_limits_cache["health"])}


