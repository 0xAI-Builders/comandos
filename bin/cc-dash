                                    "motor": mg, "defaultModel": mm, "effortDefaults": effort_defaults(),
                                    "sessionEffort": session_effort_all(),
                                    "switchResult": MOTOR_RESULT,
                                    "accounts": [{k: v for k, v in a.items() if k != "dir"} for a in claude_accounts()],
                                    "codex": cfg.get("codex"), "claude": cfg.get("claude"), "grok": cfg.get("grok"),
                                    "engines": provider_public_state().get("claudeEngines", {}),
                                    "installed": bool(shutil.which("cc-model-proxy") or os.path.exists(os.path.expanduser("~/.cargo/bin/claude-codex"))),
                                    "codexLogin": os.path.exists(os.path.expanduser("~/.codex/auth.json")),
                                    "grokLogin": grok_state.auth_identity(os.path.expanduser("~/.grok")).get("authenticated", False)})
        if self.path.startswith("/ui-log/summary"):
            return self._json(200, ui_log_summary())
        if self.path.startswith("/session-brain"):
            q = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            cwd = (q.get("cwd") or [""])[0]
            if not cwd.startswith("/") or not os.path.isdir(cwd):
                return self._json(400, {"error": "cwd invalido"})
            pane = (q.get("pane") or [""])[0]
            harness = (q.get("harness") or [""])[0]
            alias = (q.get("account") or [""])[0]
            info = agent_info_for_pane(pane) if PANE_RE.match(pane) else None
            if info:
                harness = str(info.get("agent") or harness or "claude")
