#!/usr/bin/env python3
"""Centro Claude: dashboard local para monitorear y operar sesiones de Claude Code.

Uso:
  cc-dash            arranca en http://127.0.0.1:4777 y abre el navegador
  cc-dash --no-open  no abre el navegador
  cc-dash 5000       otro puerto

Endpoints:
  GET  /state   estados por proyecto (de ~/.claude/hooks/state/) + sesiones tmux vivas
  GET  /events  ultimos eventos (~/.claude/hooks/events.jsonl)
  POST /send    {session, text}  escribe el texto en el prompt de esa sesion y da Enter
  POST /key     {session, key}   manda una tecla (1-9, Enter, Escape, y, n, Up, Down, Tab)
  POST /focus   {session}        cambia el cliente tmux a esa sesion (+ wmctrl si existe)
  POST /up      {session, cwd}   levanta la sesion con claude --continue

Solo escucha en 127.0.0.1. Todas las llamadas a tmux van sin shell (sin inyeccion).
"""
import base64
import shlex
import html as html_mod
import hmac, secrets
import ipaddress
import json, os, glob, re, shlex, shutil, sys, subprocess, threading, time, webbrowser
import urllib.parse, urllib.request
import http.server, socketserver
import tempfile
import cc_usage


def _open_url(url, env=None):
    """Abre una URL/archivo en el navegador o handler default.
    En WSL prefiere `wslview` (rutea al navegador de Windows via wslu);
    en macOS usa `open`; en Linux nativo usa `xdg-open`."""
    is_wsl = False
    try:
        with open("/proc/sys/kernel/osrelease") as f:
            is_wsl = "microsoft" in f.read().lower()
    except Exception:
        pass
    if sys.platform == "darwin":
        opener = "open"
    elif is_wsl and shutil.which("wslview"):
        opener = "wslview"
    else:
        opener = "xdg-open"
    try:
        subprocess.Popen([opener, url], env=env, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

HOOKS = os.path.expanduser("~/.claude/hooks")
STATE = os.path.join(HOOKS, "state")
UI_LOG = os.path.join(HOOKS, "ui-events.jsonl")     # registro LOCAL de uso de la interfaz (clicks, pantallas, tiempos)
FOCUS_FILE = os.path.join(HOOKS, "focus.json")          # pomodoro en curso: {project, session, until}
FOCUS_QUEUE = os.path.join(HOOKS, "focus-queue.jsonl")  # avisos encolados por cc-notifyd mientras te enfocas


def ui_log_append(events):
    """Anexa eventos de uso (lista de dicts) y rota a 30 días / 2 MB."""
    now = time.time()
    keep = []
    for e in events[:200]:
        if not isinstance(e, dict):
            continue
        keep.append({"ts": float(e.get("ts") or now), "k": str(e.get("k") or "")[:24], "n": str(e.get("n") or "")[:80],
                     "c": str(e.get("c") or "")[:80], "d": int(e.get("d") or 0), "s": str(e.get("s") or "")[:80]})
    if not keep:
        return 0
    with open(UI_LOG, "a") as f:
        for e in keep:
            f.write(json.dumps(e, ensure_ascii=False) + "\n")
    try:
        if os.path.getsize(UI_LOG) > 2_000_000:
            cutoff = now - 30 * 86400
            with open(UI_LOG) as f:
                lines = [ln for ln in f if ln.strip()]
            fresh = [ln for ln in lines[-20000:] if json.loads(ln).get("ts", 0) >= cutoff]
            with open(UI_LOG, "w") as f:
                f.writelines(fresh)
    except Exception:
        pass
    return len(keep)


def ui_log_summary(days=7):
    """Top de acciones, caminos repetidos (pares consecutivos) y tiempo por pantalla."""
    since = time.time() - days * 86400
    evs = []
    try:
        with open(UI_LOG) as f:
            for ln in f:
                try:
                    e = json.loads(ln)
                except Exception:
                    continue
                if e.get("ts", 0) >= since:
                    evs.append(e)
    except OSError:
        pass
    clicks = [e for e in evs if e.get("k") == "click"]
    top, pairs, screens, sessions = {}, {}, {}, {}
    prev = None
    for e in clicks:
        top[e["n"]] = top.get(e["n"], 0) + 1
        if prev and e["ts"] - prev["ts"] < 30:
            key = prev["n"] + " → " + e["n"]
            pairs[key] = pairs.get(key, 0) + 1
        prev = e
        if e.get("s"):
            sessions[e["s"]] = sessions.get(e["s"], 0) + 1
    for e in evs:
        if e.get("k") == "screen" and e.get("d"):
            screens[e["n"]] = screens.get(e["n"], 0) + e["d"]
    fmt = lambda d: sorted(d.items(), key=lambda kv: -kv[1])
    return {"days": days, "events": len(evs), "clicks": len(clicks),
            "top": [{"name": k, "n": v} for k, v in fmt(top)[:25]],
            "paths": [{"path": k, "n": v} for k, v in fmt(pairs)[:15] if v >= 2],
            "screens": [{"name": k, "seconds": v} for k, v in fmt(screens)[:15]],
            "sessions": [{"name": k, "n": v} for k, v in fmt(sessions)[:10]]}


def focus_state():
    try:
        with open(FOCUS_FILE) as f:
            d = json.load(f)
        if float(d.get("until") or 0) > time.time():
            return d
    except Exception:
        pass
    return None


def focus_queue():
    out = []
    try:
        with open(FOCUS_QUEUE) as f:
            for ln in f:
                try:
                    out.append(json.loads(ln))
                except Exception:
                    continue
    except OSError:
        pass
    return out[-50:]
