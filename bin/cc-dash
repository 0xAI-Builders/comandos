def usage_runtime_env():
    env = cc_usage.load_usage_config([CONF_PATH, USAGE_ENV_FILE], os.environ)
    env.update(cc_usage.read_usage_settings(USAGE_DB))
    return env


def record_runtime_config(session, pane, harness, motor, model, effort="", harness_account="unknown", motor_account="unknown", route_id="", source="runtime"):
    try:
        # Ledger: si esto es un switch confirmado, capturar el ANTES para poder
        # mostrar "qué se remedió" y ofrecer Deshacer.
        if source.startswith("switch"):
            try:
                prev = cc_usage.latest_session_config(USAGE_DB, session, pane)
                if prev and (prev.get("model") != model or prev.get("route_id") != route_id or prev.get("effort") != effort):
                    cc_usage.record_change(USAGE_DB, {
                        "origin": source, "kind": "switch",
                        "tmux_session": session, "tmux_pane": pane,
                        "project": next((i.get("project") for i in read_states_cached()
                                         if i.get("session") == session), "") or "",
                        "before_model": prev.get("model") or "", "before_effort": prev.get("effort") or "",
                        "before_route": prev.get("route_id") or "",
                        "after_model": model, "after_effort": effort, "after_route": route_id,
                    })
            except Exception:
                pass
        return cc_usage.record_session_config(USAGE_DB, {
            "tmux_session": session, "tmux_pane": pane, "harness": harness,
            "motor": motor, "model": model, "effort": effort,
            "harness_account": harness_account or "unknown",
            "motor_account": motor_account or "unknown",
            "route_id": route_id or f"{harness}:{motor}",
            "effective_at": int(time.time()), "source": source, "confidence": "exact",
        })
    except Exception:
        return None


def usage_credential_health(env):
    env = env or {}
    return {
        "openai": {
            "provider": "openai",
            "configured": bool(env.get("OPENAI_ADMIN_KEY")),
            "status": "configured" if env.get("OPENAI_ADMIN_KEY") else "missing",
        },
        "anthropic": {
            "provider": "anthropic",
            "configured": bool(env.get("ANTHROPIC_ADMIN_KEY")),
            "status": "configured" if env.get("ANTHROPIC_ADMIN_KEY") else "missing",
        },
    }


_local_usage_refreshing = False


def refresh_local_usage(force=False):
    """Reimporta turnos locales (jsonl de Claude, sqlite de Codex/OpenCode).
    Es CARO (~3s: camina cientos de archivos), asi que corre en un HILO y
    NUNCA bloquea /usage/state. La UI ve los datos del ciclo anterior hasta
    que el hilo termina (a lo sumo ~60s de rezago, imperceptible)."""
    global LOCAL_USAGE_REFRESH_AT, _local_usage_refreshing
    now = int(time.time())
    if not force and (now - LOCAL_USAGE_REFRESH_AT < 60 or _local_usage_refreshing):
        return {}
    if not force:
        _local_usage_refreshing = True
        LOCAL_USAGE_REFRESH_AT = now
        def _bg():
            global _local_usage_refreshing
            try:
                _do_refresh_local_usage()
            finally:
                _local_usage_refreshing = False
        threading.Thread(target=_bg, daemon=True).start()
        return {}
    LOCAL_USAGE_REFRESH_AT = now
    return _do_refresh_local_usage()


# Memo de build_usage_state: procesa decenas de miles de turnos (~1.5s). Su
# salida solo cambia cuando (a) el import de turnos corre (cada 60s) o (b)
# cambian los panes vivos. Reusamos el resultado mientras la firma no cambie,
# asi la mayoria de los polls devuelven al instante. Los limites del plan
# (que si cambian aparte) se adjuntan DESPUES: son baratos.
_usage_state_cache = {"key": None, "state": None}
_usage_state_lock = threading.Lock()
_usage_state_generation = 0


def cached_usage_state(panes, env, limits):
    pane_sig = tuple(sorted(
        (p.get("tmux_session"), p.get("tmux_pane"), p.get("pane_pwd"), p.get("agent"))
        for p in panes))
    # Several browser polls can arrive together after an import. Only one may
    # allocate the historical summary; waiting requests reuse that result.
    with _usage_state_lock:
        key = (_usage_state_generation, pane_sig)
        if _usage_state_cache["key"] != key:
            _usage_state_cache["state"] = cc_usage.build_usage_state(
                USAGE_DB, panes, settings=env)
            _usage_state_cache["key"] = key
        state = dict(_usage_state_cache["state"])   # copia superficial: no mutar el memo
    state["limits"] = list(limits or [])
    return state


def _pane_models_for_live_state(live_panes, state):
    """Keep cached model enrichment, but never reconcile historical panes.

    El modelo del borde tmux sale de la MISMA reconciliación que las cards
    (proceso vivo → switch confirmado → transcript), no del último import."""
    live_ids = {
        pane.get("tmux_pane") for pane in live_panes
        if (pane.get("tmux_pane") or "").startswith("%")
    }
    try:
        reconciled = {i.get("pane"): i for i in read_states_cached() if i.get("pane")}
    except Exception:
        reconciled = {}
    out = []
    for pane in (state.get("panes") or []):
        if pane.get("tmux_pane") not in live_ids:
            continue
        row = dict(pane)
        card = reconciled.get(row.get("tmux_pane"))
        if card and card.get("model"):
            row["model"] = card["model"]
            row["agent"] = card.get("agent") or row.get("agent")
            row["provider"] = row["agent"]
            if card.get("effort"):
                row["reasoning_effort"] = card["effort"]
        out.append(row)
    return out


def ensure_observed_configs():
    """Registra la configuracion observada de cada pane vivo que no la tenga.

    record_runtime_config solo corre cuando el tablero lanza o cambia una sesion,
    asi que un pane arrancado desde la terminal nunca recibia fila y todos sus
    turnos quedaban sin atribuir. El estado ya conoce modelo, effort y ruta de
    cada pane: basta con volcarlo cuando falta o cuando cambio.
    """
    n = 0
    for s in read_states_cached():
        if not s.get("alive") or not s.get("model"):
            continue
        sess, pane = s.get("session") or "", s.get("pane") or ""
        if not sess or not pane:
            continue
        harness = s.get("harness") or s.get("agent") or ""
        motor = s.get("motor") or s.get("agent") or ""
        if not harness or not motor:
            continue
        model, effort = s.get("model") or "", s.get("effort") or ""
        route = s.get("routeId") or f"{harness}:{motor}"
        prev = cc_usage.latest_session_config(USAGE_DB, sess, pane)
        if prev and prev.get("model") == model and (prev.get("effort") or "") == effort \
                and (prev.get("route_id") or "") == route:
            continue
        record_runtime_config(sess, pane, harness, motor, model, effort,
                              s.get("harnessAccount") or s.get("account") or "unknown",
                              s.get("motorAccount") or "unknown", route, source="observed")
        n += 1
    return n


def _do_refresh_local_usage():
    global _usage_state_generation
    now = int(time.time())
    env = usage_runtime_env()
    # Atribucion: primero que cada pane vivo tenga su config, luego recuperar las
    # interacciones que quedaron huerfanas (carreras, panes arrancados por fuera).
    try:
        ensure_observed_configs()
        cc_usage.reconcile_orphan_interactions(USAGE_DB, now=now)
    except Exception:
        pass
    # Poda: turnos fuera de la ventana de retencion (14d) — sin esto la tabla
    # crece sin fin (import es insert-or-replace, nunca borra) y ademas los
    # totales "en 14 dias" quedaban inflados con datos viejos.
    max_age = int(env.get("COMANDOS_USAGE_LOCAL_DAYS") or 14)
    try:
        cc_usage.prune_old_turns(USAGE_DB, max_age_days=max_age, now=now)
    except Exception:
        pass
    max_claude_files = int(env.get("COMANDOS_USAGE_CLAUDE_MAX_FILES") or 120)
    counts = {
        "codex_local": cc_usage.record_local_codex_threads(
            USAGE_DB,
            env.get("COMANDOS_CODEX_STATE_DB") or os.path.expanduser("~/.codex/state_5.sqlite"),
            now=now,
            max_age_days=max_age,
        ),
        "grok_local": cc_usage.record_local_grok_updates(
            USAGE_DB,
            [str(home) for _alias, home in grok_state.account_homes()],
            now=now,
            max_age_days=max_age,
        ),
        "claude_local": cc_usage.record_local_claude_jsonl(
            USAGE_DB,
            env.get("COMANDOS_CLAUDE_PROJECTS_DIR") or os.path.expanduser("~/.claude/projects"),
            now=now,
            max_age_days=max_age,
            max_files=max_claude_files,
        ),
        "opencode_local": cc_usage.record_local_opencode_db(
            USAGE_DB,
            env.get("COMANDOS_OPENCODE_DB") or os.path.expanduser("~/.local/share/opencode/opencode.db"),
            now=now,
            max_age_days=max_age,
        ),
    }
    # Keep the previous summary available during the import. Invalidate only
    # after its writes finish so the next poll includes the completed import.
    with _usage_state_lock:
        _usage_state_generation += 1
    return counts


