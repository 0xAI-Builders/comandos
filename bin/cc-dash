def _dashboard_directory():
    installed = os.path.join(HOOKS, "dash")
    override = os.environ.get("COMANDOS_DASH_DIR")
    if not override:
        return installed
    candidate = os.path.abspath(os.path.expanduser(override))
    if not os.path.isdir(candidate) or not os.access(candidate, os.R_OK | os.X_OK):
        raise SystemExit(
            f"COMANDOS_DASH_DIR no es un directorio legible: {candidate}")
    return candidate


