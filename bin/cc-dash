                alias = str(detected.get("account") or alias or "main")
            if harness not in ("claude", "codex", "grok"):
                harness = "claude"
            alias = alias or "main"
            inventory = capability_inventory.session_capabilities(
                load_provider_registry(), harness, alias, cwd)
            mcps = []
            for item in inventory.get("mcps") or []:
