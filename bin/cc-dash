            data = cc_usage.provider_comparison(
                USAGE_DB, os.path.join(REPO_ROOT, "config", "api-prices.json"),
                days=days)
            data["subs"] = user_subs()
            return self._json(200, data)
        if self.path.startswith("/usage/experiments"):
            return self._json(200, {"experiments": cc_usage.list_experiments(USAGE_DB)})
        if self.path.startswith("/usage/analytics"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                days = int((query.get("days") or [14])[0])
                task_type = str((query.get("taskType") or [""])[0])[:32]
                return self._json(200, cc_usage.experiment_analytics(USAGE_DB, days, task_type))
            except ValueError as e:
                return self._json(400, {"error": str(e)})
        if self.path.startswith("/usage/interactions"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                limit = int((query.get("limit") or [20])[0])
            except ValueError:
                return self._json(400, {"error": "limit invalido"})
            return self._json(200, {"interactions": cc_usage.recent_interactions(USAGE_DB, limit)})
        if self.path.startswith("/usage/state"):
            refresh_local_usage(False)
            panes = usage_live_panes()
            env = usage_runtime_env()
            prov = usage_provider_limits()
            state = cached_usage_state(panes, env, prov["limits"])
            state["credential_health"] = usage_credential_health(env)
            state["credential_health"].update(prov["health"])
            state["alert_thresholds"] = list(alert_thresholds())
            rules = cc_usage.rule_current_values(
                USAGE_DB, cc_usage.list_alert_rules(USAGE_DB),
                state.get("panes") or [], limits=prov["limits"])
            state["alert_rules"] = rules
            for alert in cc_usage.rule_alerts(rules):
                try:
                    if cc_usage.record_alert_once(USAGE_DB, alert):
                        usage_alert_send(alert["message"])
                except Exception:
                    pass
            state["alerts"] = cc_usage.list_alerts(USAGE_DB)
            recent = cc_usage.recent_interactions(USAGE_DB, 1)
            state["lastInteraction"] = recent[0] if recent else None
            # Conserva el modelo enriquecido del memo en cache hits, filtrando
            # por IDs vivos para que el fallback historico SQLite nunca vuelva
            # a conducir opciones fisicas de tmux.
            write_pane_models(_pane_models_for_live_state(panes, state))
            return self._json(200, state)
        if self.path.startswith("/ssh"):
            return self._json(200, parse_ssh_config())
        if self.path.startswith("/conf"):
            conf = read_conf()
            out = {k: conf.get(k, CONF_DEFAULTS.get(k, "1")) for k in sorted(CONF_KEYS)}
            out["_lang"] = ui_lang(conf)   # idioma RESUELTO para las UIs
            return self._json(200, out)
        if self.path.startswith("/prefs"):
            return self._json(200, read_prefs())
        if self.path == "/tmux-mouse" or self.path.startswith("/tmux-mouse?"):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            sess = (query.get("session") or [""])[0]
            if not SESSION_RE.fullmatch(sess):
                return self._json(400, {"error": "Nombre de sesion invalido"})
            enabled, err = get_tmux_mouse(sess)
            if err:
                code = 404 if err.startswith("No hay sesion") else 500
                return self._json(code, {"error": err})
            return self._json(200, {"mouse": "on" if enabled else "off"})
        if self.path.startswith("/tabs"):
            # Las MISMAS pestanas abiertas en la app de escritorio (app-tabs.json)
            # para que el movil muestre exactamente lo mismo. Solo sesiones vivas.
            live = tmux_sessions()
            out = []
            for sess, label in tab_labels().items():
                if sess in live and sess not in HIDDEN_SESSIONS:
                    out.append({"session": sess, "label": label or sess})
            return self._json(200, out)
        if self.path.startswith("/tab-history"):
            labels = tab_labels()
            live = tmux_sessions()
            out = []
            for it in read_tab_history():
                if it["session"] in labels:
                    continue
                it["alive"] = it["session"] in live
                out.append(it)
            return self._json(200, out[:40])
        if self.path.startswith("/remote-state"):
            return self._json(200, remote_state())
        if self.path.startswith("/remote-qr.png"):
            st = remote_state()
            url = st.get("urls", {}).get("dashboard", "")
            if not url:
                return self._json(400, {"error": "No pude leer el host de Tailscale"})
            if not shutil.which("qrencode"):
                return self._json(404, {"error": "qrencode no esta instalado"})
            try:
                with tempfile.NamedTemporaryFile(suffix=".png") as f:
                    r = run_quiet(["qrencode", "-o", f.name, "-s", "8", "-m", "2", url], timeout=5)
                    if r.returncode != 0:
                        return self._json(500, {"error": r.stderr.strip() or "qrencode fallo"})
                    f.seek(0)
                    return self._bytes(200, "image/png", f.read())
            except Exception as e:
                return self._json(500, {"error": str(e)})
        if self.path.startswith("/events"):
            evs = []
            try:
                with open(EVENTS) as fh:
                    for line in fh.readlines()[-80:]:
                        try:
                            evs.append(json.loads(line))
                        except Exception:
                            pass
            except FileNotFoundError:
                pass
            return self._json(200, evs)
        if self.path == "/snippets":
            return self._json(200, read_snippets())
        return super().do_GET()

    def do_POST(self):
        gate = self._security_gate()
        if gate:
            return self._json(*gate)
        try:
            n = int(self.headers.get("Content-Length", 0))
            if n > 20_000_000:
                return self._json(413, {"error": "Payload demasiado grande"})
            data = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            return self._json(400, {"error": "JSON invalido"})

        if self.path == "/open-path":
            # Abrir una ruta LOCAL con la app default (xdg-open). Solo abre,
            # jamás ejecuta; exige que exista y que sea absoluta/expandible.
            raw = str(data.get("path") or "")[:1024]
            if "\x00" in raw or raw[:1] not in ("/", "~"):
                return self._json(400, {"error": "ruta invalida"})
            target_path = os.path.expanduser(re.sub(r":\d+$", "", raw.strip()))
            if not os.path.exists(target_path):
                return self._json(404, {"error": "esa ruta ya no existe"})
            _open_url(target_path, env=gui_env())
            return self._json(200, {"ok": True})

        if self.path == "/optimization/default":
            try:
                return self._json(200, {"ok": True, **optimization_set_default(str(data.get("profile") or ""))})
            except ValueError as e:
                return self._json(400, {"error": str(e)})

        if self.path == "/proxy":
            try:
                if data.get("motor") in ("claude", "codex", "grok"):
                    if data["motor"] in ("codex", "grok") and not proxy_settings_enabled():
                        proxy_set_enabled(True)
                    model = motor_set_global(data["motor"], data.get("model"))
                    mg, mm = motor_global()
                    return self._json(200, {"ok": True, "motor": mg, "defaultModel": mm, "alive": proxy_alive(), "enabled": proxy_settings_enabled()})
                proxy_set_enabled(bool(data.get("enable")))
            except Exception as e:
                return self._json(500, {"error": str(e)})
            time.sleep(1.0)
            return self._json(200, {"ok": True, "alive": proxy_alive(), "enabled": proxy_settings_enabled()})
        if self.path == "/ui-log":
            return self._json(200, {"ok": True, "n": ui_log_append(data.get("events") or [])})
        if self.path == "/pomodoro":
            if data.get("settings") is not None:
                settings = cc_usage.set_focus_settings(USAGE_DB, data.get("settings") or {})
                return self._json(200, {"ok": True, "settings": settings})
            if data.get("stop"):
                current = focus_state() or {}
                status = str(data.get("status") or "cancelled")
                if current.get("blockId"):
                    try: cc_usage.focus_block_finish(USAGE_DB, current["blockId"], status)
                    except ValueError as e: return self._json(400, {"error": str(e)})
                try: os.remove(FOCUS_FILE)
                except OSError: pass
                return self._json(200, {"ok": True, "queue": focus_queue(),
                                        "analytics": cc_usage.focus_analytics(USAGE_DB, 7)})
            if data.get("ack"):
                try: os.remove(FOCUS_QUEUE)
                except OSError: pass
                return self._json(200, {"ok": True})
            mins = max(1, min(180, int(data.get("mins") or 25)))
            mode = str(data.get("mode") or "focus")
            block = cc_usage.focus_block_start(USAGE_DB, {
                "mode": mode, "project": data.get("project"),
                "tmux_session": data.get("session"), "tmux_pane": data.get("pane"),
                "planned_minutes": mins, "cycle_index": data.get("cycleIndex"),
                "cycle_total": data.get("cycleTotal"),
            })
            st = {"blockId": block["id"], "mode": mode,
                  "project": str(data.get("project") or "")[:120], "session": str(data.get("session") or "")[:120],
                  "pane": str(data.get("pane") or "")[:32], "until": time.time() + mins * 60,
                  "startedAt": time.time(), "mins": mins,
                  "cycleIndex": max(1, int(data.get("cycleIndex") or 1)),
                  "cycleTotal": max(1, int(data.get("cycleTotal") or 1))}
            if mode == "focus":
                try: os.remove(FOCUS_QUEUE)
                except OSError: pass
            with open(FOCUS_FILE, "w") as f:
                json.dump(st, f)
            return self._json(200, {"ok": True, "focus": st,
                                    "analytics": cc_usage.focus_analytics(USAGE_DB, 7)})
        if self.path == "/conf-set":
            key, val = data.get("key", ""), str(data.get("value", ""))
            ok = (key == "VOLUME" and val.isdigit() and 0 <= int(val) <= 100) or \
                 (key == "CC_LANG" and val in ("auto", "es", "en")) or \
                 (key in CONF_KEYS and key not in ("VOLUME", "CC_LANG") and val in ("0", "1"))
            if not ok:
                return self._json(400, {"error": "Clave o valor invalido"})
            write_conf_key(key, val)
            return self._json(200, {"ok": True})

        if self.path == "/skill-toggle":
            err = toggle_skill(str(data.get("path", "")), bool(data.get("on")))
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True,
                "note": "aplica al reciclar las sesiones"})

        if self.path == "/mcp-toggle":
            cwd, name = str(data.get("cwd", "")), str(data.get("name", ""))[:80]
            if not cwd.startswith("/") or not os.path.isdir(cwd) or not name:
                return self._json(400, {"error": "cwd o name invalido"})
            err = toggle_project_mcp(cwd, name, bool(data.get("on")))
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True,
                "note": "aplica al reciclar la sesion"})

        if self.path == "/pause":
            sess = str(data.get("session", ""))[:80]
            on = bool(data.get("on"))
            by_session, _ = agent_pane_maps(agent_procs())
            info = by_session.get(sess)
            if not info or not info.get("pid"):
                return self._json(404, {"error": "sin agente vivo en esa sesion"})
            import signal as _sig
            try:
                os.kill(int(info["pid"]), _sig.SIGSTOP if on else _sig.SIGCONT)
            except OSError as e:
                return self._json(500, {"error": str(e)})
            return self._json(200, {"ok": True, "paused": on})

        if self.path == "/event":
            # Puerta universal de agentes: cualquier CLI/plugin (opencode,
            # scripts propios...) reporta eventos y dispara el MISMO pipeline
            # (estado + popup + voz + telegram) via cc-notify.sh --agent.
            agent = str(data.get("agent", ""))[:16]
            ev = str(data.get("event", ""))
            cwd = str(data.get("cwd", ""))[:300]
            if not re.match(r"^[a-z][a-z0-9_-]{1,15}$", agent):
                return self._json(400, {"error": "agent invalido"})
            if ev not in ("working", "waiting", "done", "end"):
                return self._json(400, {"error": "event debe ser working|waiting|done|end"})
            if not cwd.startswith("/"):
                return self._json(400, {"error": "cwd debe ser ruta absoluta"})
            args = [os.path.join(HOOKS, "cc-notify.sh"), "--agent", agent,
                    "--event", ev, "--cwd", cwd]
            for k in ("msg", "full", "options"):
                v = str(data.get(k, "") or "")[:60000]
                if v:
                    args += ["--" + k, v]
            subprocess.Popen(args, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return self._json(200, {"ok": True})

        if self.path == "/test":
            kind = data.get("kind", "")
            if kind not in ("voice", "chime", "done"):
                return self._json(400, {"error": "kind debe ser voice, chime o done"})
            err = play_test(kind)
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/remote-on":
            err = remote_dashboard_on()
            if err:
                return self._json(400, {"error": err})
            health = webterm_health()
            if health["primaryHealthy"] or health["fallbackHealthy"]:
                serve_path("/term", "http://127.0.0.1:4780/term")
                serve_path("/", "http://127.0.0.1:4779", https_port="8443")
            return self._json(200, remote_state())

        if self.path == "/remote-off":
            err = remote_dashboard_off()
            if err:
                return self._json(400, {"error": err})
            return self._json(200, remote_state())

        if self.path == "/remote-webterm-on":
            err = remote_dashboard_on()
            if err:
                return self._json(400, {"error": err})
            err = webterm_on()
            if err:
                return self._json(400, {"error": err})
            return self._json(200, remote_state())

        if self.path == "/remote-webterm-off":
            err = webterm_off()
            if err:
                return self._json(400, {"error": err})
            return self._json(200, remote_state())

        if self.path == "/ssh-add":
            err = ssh_add(data)
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/ssh-del":
            err = ssh_remove(data.get("host", ""))
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/ssh-update":
            orig = data.get("orig", "")
            err = ssh_remove(orig)
            if err:
                return self._json(400, {"error": err})
            err = ssh_add(data)
            if err:
                return self._json(400, {"error": f"Se quito '{orig}' pero fallo el alta: {err}"})
            return self._json(200, {"ok": True})

        if self.path == "/prefs-set":
            prefs = read_prefs()
            # limpieza de notificaciones COMPARTIDA (dashboard + badge del app)
            if isinstance(data.get("nfDismiss"), dict):
                prefs["nfDismiss"] = {str(k)[:160]: 1 for k in list(data["nfDismiss"])[:600]}
            if isinstance(data.get("nfSnooze"), dict):
                prefs["nfSnooze"] = {str(k)[:160]: float(v) for k, v in list(data["nfSnooze"].items())[:200]
                                     if isinstance(v, (int, float))}
            if "favorites" in data and isinstance(data["favorites"], list):
                prefs["favorites"] = [str(x)[:80] for x in data["favorites"]][:200]
            if data.get("theme") in ("noche", "dia", "calido", "termius", "bruno", "superglass", "neon", "contraste"):
                prefs["theme"] = data["theme"]
            # Tipografía y estilo de terminal — cada campo se valida por su tipo.
            if isinstance(data.get("font_family"), str):
                prefs["font_family"] = data["font_family"][:120].strip() or PREFS_DEFAULTS["font_family"]
            if isinstance(data.get("font_size"), (int, float)):
                prefs["font_size"] = max(8, min(28, int(data["font_size"])))
            if data.get("cursor_shape") in _CURSOR_SHAPES:
                prefs["cursor_shape"] = data["cursor_shape"]
            if isinstance(data.get("cursor_blink"), bool):
                prefs["cursor_blink"] = data["cursor_blink"]
            if isinstance(data.get("terminal_padding"), (int, float)):
                prefs["terminal_padding"] = max(0, min(40, int(data["terminal_padding"])))
            if isinstance(data.get("terminal_opacity"), (int, float)):
                prefs["terminal_opacity"] = max(30, min(100, int(data["terminal_opacity"])))
            if isinstance(data.get("ligatures"), bool):
                prefs["ligatures"] = data["ligatures"]
            if data.get("notif_pos") in ("tl", "tr", "bl", "br", "free"):
                prefs["notif_pos"] = data["notif_pos"]   # esquina de los popups (free = donde los arrastres)
            with open(PREFS_PATH, "w") as f:
                json.dump(prefs, f)
            return self._json(200, {"ok": True})

        if self.path == "/usage/experiment":
            action = str(data.get("action") or "create")
            try:
                if action == "pair":
                    result = cc_usage.create_experiment_pair(USAGE_DB, str(data.get("experimentId") or "")[:128],
                                                             str(data.get("label") or "")[:80])
                elif action == "create":
                    variants = []
                    for raw in data.get("variants") or []:
                        route, selected = resolve_route_selection(raw, "new_session")
                        variants.append({
                            "label": str(raw.get("label") or "")[:80], "harness": route["harness"],
                            "motor": route["motor"], "model": selected["model"], "effort": selected["effort"],
                            "route_id": route["id"], "harness_account": selected["harnessAccount"],
                            "motor_account": selected["motorAccount"],
                        })
                    result = cc_usage.create_experiment(USAGE_DB, str(data.get("label") or "A/B")[:120],
                                                        str(data.get("taskType") or "unclassified")[:32], variants,
                                                        str(data.get("projectId") or "")[:80], data.get("minPairs") or 10)
                else:
                    return self._json(400, {"error": "action debe ser create|pair"})
            except (ValueError, TypeError, provider_registry.ProviderRegistryError) as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, {"ok": True, **result})

        if self.path == "/usage/rating":
            interaction_id = str(data.get("interactionId") or "")[:128]
            try:
                result = cc_usage.set_interaction_feedback(
                    USAGE_DB, interaction_id, str(data.get("outcome") or "unknown")[:16],
                    data.get("rating"), str(data.get("note") or "")[:240])
                if data.get("taskType"):
                    result["task"] = cc_usage.set_interaction_task(
                        USAGE_DB, interaction_id, str(data.get("taskType"))[:32],
                        str(data.get("taskLabel") or "")[:80])
            except (ValueError, TypeError) as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, {"ok": True, **result})

        if self.path == "/usage/capture":
            try:
                event = cc_usage.record_turn(USAGE_DB, data)
            except Exception as e:
                return self._json(500, {"error": str(e)})
            return self._json(200, {"ok": True, "event": event})

        if self.path == "/usage/refresh":
            health, counts = [], {}
            counts.update(refresh_local_usage(True))
            env = usage_runtime_env()
            for provider, fetcher in (
                ("openai", cc_usage.fetch_openai_usage),
                ("anthropic", cc_usage.fetch_anthropic_usage),
            ):
                usage_rows, cost_rows, h = fetcher(env)
                health.append(h)
                counts[provider] = {"usage": len(usage_rows), "costs": len(cost_rows)}
                if usage_rows:
                    cc_usage.record_provider_usage(USAGE_DB, provider, usage_rows)
                if cost_rows:
                    cc_usage.record_provider_costs(USAGE_DB, provider, cost_rows)
            panes = usage_live_panes()
            prov = usage_provider_limits(force=True)
            state = cc_usage.build_usage_state(USAGE_DB, panes, settings=env,
                                               limits=prov["limits"])
            state["credential_health"] = {h["provider"]: h for h in health}
            state["credential_health"].update(prov["health"])
            return self._json(200, {"ok": True, "counts": counts, "state": state})

        if self.path == "/news/refresh":
            try:
                r = news_watch_lib.watch_news(HOOKS)
                return self._json(200, {"ok": True, "news": r.get("news") or [],
                                        "recent": (r.get("snapshot") or {}).get("recent") or []})
            except Exception as err:
                return self._json(500, {"error": str(err)})

        if self.path == "/open-url":
            # abrir un link EXTERNO de una noticia en el navegador del sistema
            u = str(data.get("url") or "")
            if not re.match(r"^https?://", u):
                return self._json(400, {"error": "solo http(s)"})
            _open_url(u)
            return self._json(200, {"ok": True})

        if self.path == "/models/refresh":
            result = _model_watch_cycle(force=True) or {}
            return self._json(200, {"ok": True, "news": result.get("news") or {},
                                    "snapshot": result.get("snapshot") or {}})

        if self.path == "/fs/mkdir":
            try:
                created = fs_mkdir(str(data.get("path") or "")[:512])
            except (ValueError, OSError) as err:
                return self._json(400, {"error": str(err)})
            return self._json(200, {"ok": True, "path": created})

        if self.path == "/usage/quota":
            # El usuario declara su cuota (tokens/7d) para providers sin API
            # de limites. tokens=0 la borra. Refresca limits al instante.
            try:
                saved = set_user_quota(str(data.get("provider") or ""),
                                       data.get("tokens7d") or 0)
            except (ValueError, TypeError) as err:
                return self._json(400, {"error": str(err)})
            usage_provider_limits(force=True)
            return self._json(200, {"ok": True, "quota": saved})

        if self.path == "/usage/subscription":
            # El usuario declara lo que paga al mes por proveedor (para ROI)
            # y/o la moneda de despliegue con su tipo de cambio.
            try:
                saved = set_user_sub(str(data.get("provider") or ""),
                                     data.get("monthly"), data.get("currency"),
                                     data.get("display"))
            except (ValueError, TypeError) as err:
                return self._json(400, {"error": str(err)})
            return self._json(200, {"ok": True, "subs": saved})

        if self.path == "/usage/alert-rule":
            # Reglas por objetivo: sesion / proyecto / proveedor, presupuesto
            # de tokens en 24h. action: set | delete
            action = str(data.get("action") or "set")[:16]
            if action == "delete":
                cc_usage.delete_alert_rule(USAGE_DB, str(data.get("id") or "")[:340])
            else:
                rid = cc_usage.set_alert_rule(
                    USAGE_DB,
                    str(data.get("scope") or "")[:16],
                    str(data.get("target") or "")[:300],
                    str(data.get("label") or "")[:120],
                    data.get("threshold"))
                if not rid:
                    return self._json(400, {"error": "Regla invalida"})
            rules = cc_usage.rule_current_values(
                USAGE_DB, cc_usage.list_alert_rules(USAGE_DB), usage_live_panes(),
                limits=usage_provider_limits()["limits"])
            return self._json(200, {"ok": True, "alert_rules": rules})

        if self.path == "/usage/settings":
            settings = cc_usage.write_usage_settings(USAGE_DB, data.get("settings") or data)
            panes = usage_live_panes()
            env = usage_runtime_env()
            prov = usage_provider_limits()
            state = cc_usage.build_usage_state(USAGE_DB, panes, settings=env,
                                               limits=prov["limits"])
            state["credential_health"] = usage_credential_health(env)
            state["credential_health"].update(prov["health"])
            state["alerts"] = cc_usage.list_alerts(USAGE_DB)
            state["alert_thresholds"] = list(alert_thresholds())
            return self._json(200, {"ok": True, "settings": settings, "state": state})

        if self.path == "/ssh-connect":
            sess, connected, note = ssh_connect(data.get("host", ""))
            if sess is None:
                return self._json(400, {"error": note})
            return self._json(200, {"ok": True, "session": sess,
                                    "connected": connected, "note": note})

        if self.path == "/ssh-new-tab":
            sess, connected, note = ssh_open_new_tab(data.get("host", ""))
            if sess is None:
                return self._json(400, {"error": note})
            return self._json(200, {"ok": True, "session": sess, "label": data.get("host", ""),
                                    "connected": connected, "note": note})

        if self.path == "/ssh-key-setup":
            sess, err = ssh_key_setup(data.get("host", ""))
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True, "session": sess})

        if self.path == "/snippets":
            name = str(data.get("name", ""))
            body = str(data.get("body", ""))
            tags = data.get("tags") or []
            err = snippet_validate(name, body, tags)
            if err:
                return self._json(400, {"error": err})
            items = read_snippets()
            item = snippet_new(name, body, tags)
            items.insert(0, item)
            write_snippets(items)
            return self._json(200, {"item": item})

        if self.path == "/snippets/update":
            id_ = str(data.get("id", ""))
            if not SNIPPET_ID_RE.match(id_):
                return self._json(400, {"error": "id invalido"})
            name = str(data.get("name", ""))
            body = str(data.get("body", ""))
            tags = data.get("tags") or []
            err = snippet_validate(name, body, tags)
            if err:
                return self._json(400, {"error": err})
            items = read_snippets()
            new_items, updated = snippet_update(items, id_, name, body, tags)
            if updated is None:
                return self._json(404, {"error": "snippet no encontrado"})
            write_snippets(new_items)
            return self._json(200, {"item": updated})

        if self.path == "/snippets/delete":
            id_ = str(data.get("id", ""))
            if not SNIPPET_ID_RE.match(id_):
                return self._json(400, {"error": "id invalido"})
            items = read_snippets()
            new_items, removed = snippet_delete(items, id_)
            if not removed:
                return self._json(404, {"error": "snippet no encontrado"})
            write_snippets(new_items)
            return self._json(200, {"ok": True})

        if self.path == "/session-new":
            # Wizard "+": nueva sesion con proyecto + agente + cuenta.
            # Si el repo YA tiene un agente activo, nace en worktree (auto).
            cwd = os.path.expanduser(str(data.get("cwd", "")))
            requested_agent = str(data.get("agent", "shell"))[:24]
            alias = str(data.get("harnessAccount") or data.get("account") or "main")[:64]
            motor_alias = str(data.get("motorAccount") or "main")[:64]
            route = None
            selected = {"model": "", "effort": "", "harnessAccount": alias, "motorAccount": motor_alias}
            if not cwd.startswith("/"):
                return self._json(400, {"error": "carpeta invalida"})
            if not os.path.isdir(cwd):
                return self._json(409, {"error": "Esa carpeta no existe todavía.",
                                        "code": "cwd_missing", "cwd": cwd})
            # Un routeId presente pero vacío = el wizard tenía una combinación
            # NO disponible: jamás degradar en silencio a una shell sin agente.
            if "routeId" in data and not data.get("routeId"):
                return self._json(409, {"error": "Esa combinación no está disponible; elige un setup habilitado.",
                                        "code": "route_unavailable"})
            if requested_agent == "shell" and not data.get("routeId"):
                agent = "shell"
            else:
                try:
                    route, selected = resolve_route_selection(data, "new_session")
                except provider_registry.ProviderRegistryError as e:
                    return self._json(409, {"error": str(e), "code": str(e)})
                agent = str(route["harness"])
                alias = selected["harnessAccount"]
                motor_alias = selected["motorAccount"]
            try:
                alias = account_registry.validate_alias(alias) if agent != "shell" else alias
                motor_alias = account_registry.validate_alias(motor_alias) if agent != "shell" else motor_alias
            except account_registry.AccountError as e:
                return self._json(400, {"error": str(e), "code": "account_invalid"})
            wt = False
            final_cwd = cwd
            if read_conf().get("AUTO_WORKTREE", "1") != "0" and agent != "shell" and _cwd_has_live_agent(cwd):
                path, err = make_worktree(cwd)
                if path:
                    final_cwd, wt = path, True
            n = int(time.time()) % 100000
            new_sess = f"term-r{n}"
            while tmux("has-session", "-t", "=" + new_sess).returncode == 0:
                n += 1
                new_sess = f"term-r{n}"
            r = tmux("new-session", "-d", "-s", new_sess, "-c", final_cwd)
            if r.returncode != 0:
                return self._json(500, {"error": (r.stderr or "tmux fallo").strip()})
            proj = os.path.basename(cwd.rstrip("/"))
            label = proj + (" ⎇" if wt else "")
            register_app_tab(new_sess, label, kind="project", cwd=final_cwd)
            cmd = ""
            account_prefix = ""
            harness_has_accounts = bool((((load_provider_registry().get("harnesses") or {}).get(agent) or {})
                                         .get("capabilities") or {}).get("accounts"))
            if agent != "shell" and harness_has_accounts:
                try:
                    account_env = account_registry.account_environment(load_provider_registry(), agent, alias)
                    account_prefix = " ".join(f"{key}={shlex.quote(value)}" for key, value in account_env.items()) + " "
                except account_registry.AccountError as e:
                    tmux("kill-session", "-t", "=" + new_sess)
                    return self._json(409, {"error": str(e), "code": "account_invalid"})
            flags = load_agent_roles().get("dangerFlags") or {}
            if agent == "claude":
                motor = route["motor"] if route else "claude"
                cmd = account_prefix + "claude"
                if motor != "claude":
                    pc = load_proxy_cfg()
                    locked = motor_lock_env(motor, selected.get("model") or "")
                    lock_prefix = " ".join(f"{key}={shlex.quote(value)}" for key, value in locked.items())
                    cmd = account_prefix + f"ANTHROPIC_BASE_URL=http://127.0.0.1:{int(pc.get('port') or 18765)} " + (lock_prefix + " " if lock_prefix else "") + "claude"
                if selected.get("model"):
                    cmd += " --model " + shlex.quote(selected["model"])
                if selected.get("effort"):
                    cmd += " --effort " + shlex.quote(selected["effort"])
                if data.get("danger") and flags.get("claude"):
                    cmd += " " + flags["claude"]
            elif agent == "codex":
                cmd = account_prefix + "codex"
                if selected.get("model"):
                    cmd += " -m " + shlex.quote(selected["model"])
                if selected.get("effort"):
                    cmd += " -c " + shlex.quote(f'model_reasoning_effort="{selected["effort"]}"')
                if data.get("danger") and flags.get("codex"):
                    cmd += " " + flags["codex"]
            elif agent == "grok":
                home = str(account_registry.account_home(load_provider_registry(), "grok", alias))
                cmd = account_prefix + "grok"
                grok_model = str(selected.get("model") or "")
                grok_effort = str(selected.get("effort") or "")
                if grok_model:
                    catalog = {m["id"]: m for m in grok_state.models(home)}
                    if grok_model not in catalog:
                        tmux("kill-session", "-t", "=" + new_sess)
                        return self._json(400, {"error": f"modelo Grok no disponible: {grok_model}"})
                    if grok_effort and grok_effort not in (catalog[grok_model].get("efforts") or []):
                        tmux("kill-session", "-t", "=" + new_sess)
                        return self._json(400, {"error": f"esfuerzo no válido para {grok_model}"})
                    cmd += " --model " + shlex.quote(grok_model)
                    if grok_effort:
                        cmd += " --effort " + shlex.quote(grok_effort)
                if data.get("danger") and flags.get("grok"):
                    cmd += " " + flags["grok"]
            elif agent == "acp":
                # ComandOS como cliente ACP: el motor corre con SU suscripcion
                # (cuenta del motor), sin gateway ni API keys.
                cmd = _acp_launch_cmd(route["motor"] if route else "claude", selected.get("model") or "",
                                      selected.get("effort") or "", motor_alias, danger=bool(data.get("danger")))
            elif agent in ("opencode", "agy"):
                cmd = _harness_launch_cmd(agent, selected.get("model") or "", selected.get("effort") or "", alias)
                if data.get("danger") and flags.get(agent):
                    cmd += " " + flags[agent]
            if cmd:
                pane_new = tmux("display-message", "-p", "-t", "=" + new_sess + ":", "#{pane_id}").stdout.strip()
                if route:
                    record_runtime_config(new_sess, pane_new, route["harness"], route["motor"],
                                          selected.get("model", ""), selected.get("effort", ""),
                                          alias, motor_alias, route["id"], "session-new")
                def _send(sess=new_sess, c=cmd):
                    time.sleep(1.5)
                    tmux("send-keys", "-t", "=" + sess + ":", c, "Enter")
                threading.Thread(target=_send, daemon=True).start()
            return self._json(200, {"ok": True, "session": new_sess,
                                    "cwd": final_cwd, "worktree": wt, "label": label,
                                    "routeId": route.get("id") if route else "shell",
                                    "model": selected.get("model"), "effort": selected.get("effort"),
                                    "harnessAccount": alias, "motorAccount": motor_alias})

        if self.path == "/open-with-account":
            # Nueva sesion claude EN el cwd con la cuenta elegida
            # (CLAUDE_CONFIG_DIR por convencion de ~/.claude-accounts).
            cwd = str(data.get("cwd", ""))
            alias = str(data.get("account", "main"))[:40]
            if not cwd.startswith("/") or not os.path.isdir(cwd):
                return self._json(400, {"error": "cwd invalido"})
            if not re.match(r"^[A-Za-z0-9._-]+$", alias):
                return self._json(400, {"error": "alias invalido"})
            if alias != "main" and not os.path.isdir(
                    os.path.expanduser(f"~/.claude-accounts/{alias}")):
                return self._json(404, {"error": f"cuenta '{alias}' no existe"})
            n = int(time.time() * 10) % 1000000
            new_sess = f"term-r{n}"
            while tmux("has-session", "-t", "=" + new_sess).returncode == 0:
                n += 1
                new_sess = f"term-r{n}"
            r = tmux("new-session", "-d", "-s", new_sess, "-c", cwd)
            if r.returncode != 0:
                return self._json(500, {"error": (r.stderr or "tmux fallo").strip()})
            proj = os.path.basename(cwd.rstrip("/"))
            register_app_tab(new_sess, f"{proj} · {alias}", kind="project", cwd=cwd)
            cmd = "claude"
            if alias != "main":
                cmd = (f"CLAUDE_CONFIG_DIR=$HOME/.claude-accounts/{alias} " + cmd)
            if data.get("danger"):
                flag = (load_agent_roles().get("dangerFlags") or {}).get("claude") or ""
                if flag:
                    cmd += " " + flag
            def _send(sess=new_sess, c=cmd):
                time.sleep(1.5)
                tmux("send-keys", "-t", "=" + sess + ":", c, "Enter")
            threading.Thread(target=_send, daemon=True).start()
            return self._json(200, {"ok": True, "session": new_sess, "cmd": cmd})

        if self.path == "/tab-new":
            # Boton + del remoto: terminal scratch nueva, visible en AMBOS lados
            label = str(data.get("label") or "terminal")[:80]
            n = int(time.time()) % 100000
            new_sess = f"term-r{n}"
            while tmux("has-session", "-t", "=" + new_sess).returncode == 0:
                n += 1
                new_sess = f"term-r{n}"
            r = tmux("new-session", "-d", "-s", new_sess, "-c", os.path.expanduser("~"))
            if r.returncode != 0:
                return self._json(500, {"error": (r.stderr or "tmux fallo").strip()})
            register_app_tab(new_sess, label, kind="scratch",
                             cwd=os.path.expanduser("~"))
            return self._json(200, {"session": new_sess, "label": label})

        if self.path == "/account/add":
            provider = str(data.get("provider") or "claude")
            if provider not in ("claude", "codex", "grok"):
                return self._json(400, {"error": "provider de cuenta no soportado"})
            alias = str(data.get("alias") or "").strip()[:64]
            try:
                alias = account_registry.validate_alias(alias)
                if alias == "main":
                    raise account_registry.AccountError("usa iniciar sesion para la cuenta main")
                d = str(account_registry.account_home(load_provider_registry(), provider, alias))
            except account_registry.AccountError as e:
                return self._json(400, {"error": str(e)})
            os.makedirs(d, exist_ok=True)
            # los hooks de Claude viven en settings por cuenta; Grok hereda los
            # hooks Claude y agrega errores/cancelaciones mediante cc-agents.
            try:
                if provider != "claude":
                    raise RuntimeError("Claude settings only")
                with open(os.path.expanduser("~/.claude/settings.json")) as f:
                    hooks = json.load(f).get("hooks") or {}
                sp = os.path.join(d, "settings.json")
                try:
                    with open(sp) as f:
                        st = json.load(f)
                except Exception:
                    st = {}
                changed = False
                if hooks and not st.get("hooks"):
                    st["hooks"] = hooks
                    changed = True
                # los avisos van por los popups con tema de ComandOS, no los nativos de GNOME
                if st.get("preferredNotifChannel") != "notifications_disabled":
                    st["preferredNotifChannel"] = "notifications_disabled"
                    changed = True
                if changed:
                    with open(sp, "w") as f:
                        json.dump(st, f, indent=2, ensure_ascii=False)
            except Exception:
                pass
            cwd = str(data.get("cwd") or os.path.expanduser("~"))
            if not os.path.isdir(cwd):
                cwd = os.path.expanduser("~")
            n = int(time.time() * 10) % 1000000
            new_sess = f"term-r{n}"
            while tmux("has-session", "-t", "=" + new_sess).returncode == 0:
                n += 1
                new_sess = f"term-r{n}"
            r = tmux("new-session", "-d", "-s", new_sess, "-c", cwd)
            if r.returncode != 0:
                return self._json(500, {"error": (r.stderr or "tmux fallo").strip()})
            register_app_tab(new_sess, f"login {provider} · {alias}", kind="project", cwd=cwd)
            login_commands = {"claude": "claude /login", "codex": "codex login", "grok": "grok login"}
            env_prefix = " ".join(
                f"{key}={shlex.quote(value)}"
                for key, value in account_registry.account_environment(load_provider_registry(), provider, alias).items()
            )
            cmd = env_prefix + " " + login_commands[provider]
            def _send(sess=new_sess, c=cmd):
                time.sleep(1.5)
                tmux("send-keys", "-t", "=" + sess + ":", c, "Enter")
            threading.Thread(target=_send, daemon=True).start()
            return self._json(200, {"ok": True, "session": new_sess, "alias": alias, "provider": provider})

        sess = data.get("session", "")
        if not SESSION_RE.match(sess):
            return self._json(400, {"error": "Nombre de sesion invalido"})

        if self.path == "/tmux-mouse":
            enabled = bool(data.get("enabled", True))
            err = set_tmux_mouse(sess, enabled)
            if err:
                code = 404 if err.startswith("No hay sesion") else 500
                return self._json(code, {"error": err})
            return self._json(200, {"ok": True, "mouse": "on" if enabled else "off"})

        if self.path == "/tmux-scroll":
            err = tmux_scroll(sess, data.get("delta"), data.get("col"), data.get("row"))
            if err:
                code = 404 if err.startswith("No hay sesion") else 400
                return self._json(code, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/tab-register":
            # El remoto abrio una tab: reflejarla en el escritorio
            if not SESSION_RE.match(sess or ""):
                return self._json(400, {"error": "session invalida"})
            if tmux("has-session", "-t", "=" + sess).returncode != 0:
                return self._json(404, {"error": f"'{sess}' no existe"})
            register_app_tab(
                sess, str(data.get("label") or sess)[:80],
                kind=str(data.get("kind") or ""),
                host=str(data.get("host") or ""),
                cwd=str(data.get("cwd") or ""))
            return self._json(200, {"ok": True})

        if self.path == "/tab-metadata":
            item = write_tab_metadata(
                sess, str(data.get("kind") or ""),
                host=str(data.get("host") or ""),
                cwd=str(data.get("cwd") or ""))
            if item is None:
                return self._json(400, {"error": "metadata de pestana invalida"})
            return self._json(200, {"ok": True, "metadata": item})

        if self.path == "/tab-metadata-remove":
            remove_tab_metadata(sess)
            return self._json(200, {"ok": True})

        if self.path == "/tab-close":
            # Cierra la PESTANA en todas las superficies (la sesion tmux sigue
            # viva): la saca del espejo app-tabs.json (si no, el poll /tabs la
            # resucitaba en remoto) y pide cerrar su tab GTK. Las tabs normales
            # entran a Recientes; las e2e efimeras se descartan sin historial.
            ephemeral = data.get("ephemeral") is True
            err = close_app_tab(sess, ephemeral=ephemeral)
            if err:
                return self._json(400, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/recover-tab":
            label = str(data.get("label") or sess)[:80]
            cwd = str(data.get("cwd") or "")
            agent = str(data.get("agent") or state_agent(sess))[:16]
            if agent not in agent_set():
                agent = "claude"
            if not cwd or not os.path.isdir(cwd):
                cwd = find_project_dir(session_name(label)) or find_project_dir(sess) or ""
            if not cwd:
                return self._json(400, {"error": f"No encontre cwd para recuperar '{label}'"})
            if tmux("has-session", "-t", "=" + sess).returncode != 0:
                r = tmux_new_session(sess, cwd, agent)
                if r.returncode != 0:
                    return self._json(500, {"error": r.stderr.strip() or "No se pudo recuperar la sesion"})
            write_app_tab(sess, label)
            write_tab_metadata(sess, "project", cwd=cwd)
            remember_tab(sess, label, cwd, agent, reason="recovered")
            return self._json(200, {"ok": True, "session": sess, "label": label, "cwd": cwd})

        # Donde corre el claude del proyecto MANDA: aunque exista una sesion
        # homonima (zombie sin claude), las teclas y el foco van a la sesion y
        # pane reales. Tambien evita que cc-next/popups dupliquen sesiones.
        resolved = resolve_project_session(sess)
        if resolved:
            sess = resolved[0]
        target = "=" + sess          # target-session (has-session, switch-client)
        pane = "=" + sess + ":"      # target-pane; tmux 3.2a exige el ':' final
        # Pane exacto opcional (claude corriendo en un pane concreto). Si ese
        # pane ya murio, cae al de la sesion. tmux 3.2a devuelve rc=0 con
        # targets muertos: hay que comparar stdout.
        want = str(data.get("pane", "") or (resolved[1] if resolved else ""))
        if PANE_RE.match(want) and \
                tmux("display-message", "-p", "-t", want, "#{pane_id}").stdout.strip() == want:
            pane = want

        if self.path == "/account/switch":
            # Misma conversacion, otra cuenta: copiar el transcript al config-dir de la
            # cuenta destino, salir de claude y reanudar con --resume <sid> en el mismo pane.
            alias = str(data.get("alias") or "main")[:40]
            if not re.match(r"^[A-Za-z0-9._-]+$", alias):
                return self._json(400, {"error": "alias invalido"})
            acc = next((a for a in claude_accounts() if a["alias"] == alias), None)
            if not acc:
                return self._json(404, {"error": f"cuenta '{alias}' no existe"})
            if not acc["loggedIn"]:
                return self._json(409, {"error": f"la cuenta '{alias}' aun no tiene login"})
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesion tmux '{sess}'"})
            info = _claude_info_for(sess, str(data.get("pane") or ""))
            if not info:
                return self._json(409, {"error": "No encuentro un claude vivo en esa sesion"})
            queued = bool(claude_pane_busy(pane))
            sid, pid = info["sid"], info.get("pid")
            src = _transcript_path(sid)
            if not src:
                return self._json(409, {"error": "No encuentro el transcript de la sesion"})
            src_dir = os.path.dirname(src)
            src_cfg = os.path.dirname(os.path.dirname(src_dir))
            if os.path.realpath(src_cfg) == os.path.realpath(acc["dir"]):
                return self._json(400, {"error": f"esa sesion ya usa la cuenta '{alias}'"})
            dst_dir = os.path.join(acc["dir"], "projects", os.path.basename(src_dir))
            try:
                import shutil
                os.makedirs(dst_dir, exist_ok=True)
                shutil.copy2(src, os.path.join(dst_dir, os.path.basename(src)))
                extra = os.path.join(src_dir, sid)
                if os.path.isdir(extra) and not os.path.isdir(os.path.join(dst_dir, sid)):
                    shutil.copytree(extra, os.path.join(dst_dir, sid))
            except Exception as e:
                return self._json(500, {"error": f"no pude copiar el transcript: {e}"})
            # La carpeta ya es de confianza en la cuenta origen: heredar ese "si" para que
            # --resume no se quede parado en "Do you trust this folder?".
            try:
                cwd_r = tmux("display-message", "-p", "-t", pane, "#{pane_current_path}").stdout.strip()
                with open(os.path.join(src_cfg, ".claude.json")) as f:
                    sp = (json.load(f).get("projects") or {}).get(cwd_r) or {}
                if sp.get("hasTrustDialogAccepted"):
                    dj = os.path.join(acc["dir"], ".claude.json")
                    try:
                        with open(dj) as f:
                            dd = json.load(f)
                    except Exception:
                        dd = {}
                    dd.setdefault("projects", {}).setdefault(cwd_r, {})["hasTrustDialogAccepted"] = True
                    tmp = dj + ".tmp"
                    with open(tmp, "w") as f:
                        json.dump(dd, f, indent=2)
                    os.replace(tmp, dj)
            except Exception:
                pass
            argv = _proc_cmdline(pid) if pid else []
            flags = _resume_flags(argv)
            env = _read_environ(pid) if pid else {}
            base_url = env.get(b"ANTHROPIC_BASE_URL", b"").decode("utf-8", "replace")
            prefix = "" if alias == "main" else f"CLAUDE_CONFIG_DIR=$HOME/.claude-accounts/{alias} "
            if base_url:
                prefix += f"ANTHROPIC_BASE_URL={shlex.quote(base_url)} "
            cmd = prefix + "claude --resume " + shlex.quote(sid) + "".join(" " + shlex.quote(f) for f in flags)
            if data.get("interrupt") and claude_pane_busy(pane):
                tmux("send-keys", "-t", pane, "Escape")
                time.sleep(1.2)
            _claude_restart_resume(pane, pid, cmd, queued=queued, sess=sess, gen=motor_gen_bump(sess))
            return self._json(202 if queued else 200, {"ok": True, "queued": queued, "command": cmd, "sid": sid})

        if self.path == "/model/switch-cancel":
            opkey = f"{sess}|{pane}" if PANE_RE.match(pane) else sess
            motor_gen_bump(opkey)     # invalida cualquier cambio de motor/cuenta en cola
            return self._json(200, {"ok": True, "operationKey": opkey, "note": "cambios en cola cancelados"})

        if self.path == "/harness/switch":
            # Cambiar el HARNESS (el CLI) de un pane vivo, con handoff de contexto.
            to = str(data.get("toHarness") or data.get("to") or "")[:16]
            model = str(data.get("model") or "")[:120]
            effort = str(data.get("effort") or "")[:16]
            account = str(data.get("account") or data.get("harnessAccount") or "main")[:64]
            registry_now = load_provider_registry()
            switchable = {h for h, spec in (registry_now.get("harnesses") or {}).items()
                          if spec.get("launchDriver") in ("claude", "codex", "grok", "acp", "opencode", "agy")}
            if to not in switchable:
                return self._json(400, {"error": f"harness desconocido: {to}"})
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesión tmux '{sess}'"})
            info = agent_info_for_pane(pane) or {}
            frm = str(info.get("agent") or state_agent(sess) or "")
            if not frm:
                return self._json(409, {"error": "no detecto el harness actual del pane"})
            if frm == to:
                return self._json(409, {"error": f"el pane ya corre {to}; para cambiar el modelo usa el selector de motor"})
            # ACP: el motor destino es el que pidan o, por defecto, el mismo
            # cerebro que corria en el pane (claude -> acp:claude), asi el
            # cambio de TUI no cambia de modelo a escondidas.
            acp_agents = registry_now.get("acpAgents") or {}
            motor = str(data.get("motor") or (frm if frm in acp_agents else "claude"))[:16] if to == "acp" else to
            dest_id = f"{to}:{motor}"
            dest = next((c for c in capability_matrix() if c.get("id") == dest_id), None) or {}
            if not dest.get("selectable", False):
                return self._json(409, {"error": (dest.get("reason") or {}).get("message") or f"{dest_id} no está disponible"})
            # la cuenta (del harness, o del MOTOR si el harness es acp) debe tener login
            acct_provider = motor if to == "acp" else to
            if ((registry_now.get("harnesses") or {}).get(acct_provider) or {}).get("capabilities", {}).get("accounts"):
                try:
                    accts = account_registry.list_accounts(registry_now, acct_provider)
                    if not any(a.get("alias") == account and a.get("selectable") for a in accts):
                        account = _pick_motor_account(acct_provider, account)
                        if not any(a.get("alias") == account and a.get("selectable") for a in accts):
                            return self._json(409, {"error": f"{acct_provider} no tiene ninguna cuenta con login. Inicia sesión primero."})
                except Exception:
                    pass
            else:
                account = "main"
            cwd = info.get("cwd") or ""
            if not cwd:
                r = tmux("display-message", "-p", "-t", pane, "#{pane_current_path}")
                cwd = r.stdout.strip()
            opkey = f"{sess}|{pane}" if PANE_RE.match(pane) else sess
            gen = motor_gen_bump(opkey)
            queued = bool((claude_pane_busy(pane) if frm == "claude" else False)) and not bool(data.get("interrupt"))
            payload = {"key": opkey, "sess": sess, "pane": pane, "from": frm, "to": to,
                       "cwd": cwd, "pid": info.get("pid"), "model": model, "effort": effort,
                       "account": account, "gen": gen, "interrupt": bool(data.get("interrupt")),
                       "motor": motor, "danger": bool(data.get("danger"))}
            harness_switch_apply(payload)
            return self._json(200, {"ok": True, "operationKey": opkey, "from": frm, "to": to,
                                    "queued": queued,
                                    "note": (f"Cambio de harness {frm} → {to}. La conversación de {frm} se cierra; "
                                             f"{to} arranca en el mismo pane con un handoff del contexto visible "
                                             f"(objetivo, últimos pasos y git). La memoria interna de {frm} NO se transfiere.")})

        if self.path == "/model/switch":
            provider = str(data.get("provider") or data.get("agent") or state_agent(sess))[:32]
            preset = str(data.get("preset") or "diario")[:32]
            model = str(data.get("model") or "")[:120]
            effort = str(data.get("effort") or "")[:16]
            route = None
            current_motor = ""
            effort_only = False   # cambio de solo esfuerzo: no re-teclear /model
            if data.get("routeId"):
                info = agent_info_for_pane(pane)
                current_harness = str((info or {}).get("agent") or state_agent(sess) or "")
                current_item = next((i for i in read_states_cached() if i.get("session") == sess and i.get("pane") == pane), {})
                current_motor = provider_registry.engine_for_model(load_provider_registry(), str(current_item.get("model") or "")) or current_harness
                requested = provider_registry.route_for(load_provider_registry(), str(data.get("routeId"))) or {}
                scope = "session_model" if requested.get("motor") == current_motor else "session_motor"
                selection_data = dict(data)
                selection_data.setdefault("harnessAccount", current_item.get("account") or "main")
                # Cuenta del MOTOR: si el usuario NO la eligió, resolverla contra
                # el motor DESTINO (no heredar la del harness cuando el motor
                # cambia). Preferencia: mismo motor -> su cuenta actual; motor ==
                # harness (nativo) -> cuenta del harness; cruzado -> 'main' (la que
                # soporta el gateway). SIEMPRE cae a una cuenta con login real, así
                # cambiar de motor no revienta con motor_account_login_required.
                if not data.get("motorAccount"):
                    requested_motor = requested.get("motor")
                    if requested_motor == current_motor:
                        pref = current_item.get("motorAccount") or "main"
                    elif requested_motor == current_harness:
                        pref = current_item.get("account") or "main"
                    else:
                        pref = "main"
                    selection_data["motorAccount"] = _pick_motor_account(requested_motor, pref)
                # Cambio de SOLO esfuerzo (no mandan modelo, mismo motor): usar el
                # modelo que YA corre el pane, NO el default del registro. Sin esto
                # resolve_route_selection rellenaba model="" con models[0] (Fable
                # 5.1) y cambiar el effort de Fable 5 [1m] saltaba a otro modelo
                # de 200k reventando el contexto — el "no jala usar Fable 5 normal".
                if not selection_data.get("model") and scope == "session_model" and current_item.get("model"):
                    selection_data["model"] = current_item.get("model")
                try:
                    route, selected = resolve_route_selection(selection_data, scope, current_harness=current_harness)
                except provider_registry.ProviderRegistryError as e:
                    # Mensaje HUMANO en vez del código crudo: el usuario debe saber
                    # QUÉ cuenta y motor, y qué hacer.
                    _mot = requested.get("motor") or "?"
                    _acct = selection_data.get("motorAccount") or "main"
                    _human = {
                        "motor_account_login_required":
                            f"El motor {_mot} no tiene login en la cuenta «{_acct}». Elige otra en la fila «cuenta» del selector, o inicia sesión con «+ cuenta».",
                        "motor_account_gateway_not_ready":
                            f"Por ahora el gateway solo usa la cuenta «main» del motor {_mot}; elige main para ese motor.",
                        "harness_account_login_required":
                            f"La cuenta «{selection_data.get('harnessAccount') or 'main'}» de este harness necesita login.",
                    }.get(str(e))
                    return self._json(409, {"error": _human or str(e), "code": str(e)})
                provider = str(route.get("driver") or current_harness)
                model, effort = selected["model"], selected["effort"]
                # Si el modelo resuelto es el MISMO que ya corre el pane, es un
                # cambio de SOLO esfuerzo: NO tecleamos /model (sería redundante y,
                # vía alias de familia, podría saltar de versión) pero SÍ
                # conservamos `model` real para registrarlo (vaciarlo dejaba la
                # config en model='' y la card mostraba un modelo viejo/erróneo).
                if model and current_item.get("model") and \
                        provider_registry._model_key(model) == provider_registry._model_key(current_item.get("model")):
                    effort_only = True
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesion tmux '{sess}'"})
            if provider == "grok":
                info = agent_info_for_pane(pane)
                if not info or info.get("agent") != "grok":
                    return self._json(409, {"error": "ese pane no contiene Grok"})
                env = _read_environ(info.get("pid"))
                home = env.get(b"GROK_HOME", b"").decode("utf-8", "replace") or os.path.expanduser("~/.grok")
                catalog = {m["id"]: m for m in (grok_state.models(home) or (load_provider_registry()["harnesses"]["grok"].get("models") or []))}
                current = grok_metadata_for_pid(info.get("pid"))
                requested_model = model or current.get("model") or ""
                if requested_model not in catalog:
                    return self._json(400, {"error": f"modelo Grok no disponible: {requested_model}"})
                allowed = catalog[requested_model].get("efforts") or []
                if effort and effort not in allowed:
                    return self._json(400, {"error": f"{requested_model} no admite esfuerzo {effort}; usa {', '.join(allowed)}"})
                opkey = f"{sess}|{pane}"
                gen = motor_gen_bump(opkey)
                queued = grok_pane_busy(sess, pane) and not bool(data.get("interrupt"))
                payload = {"key": opkey, "pane": pane, "cmds": [], "provider": "grok",
                           "sess": sess, "model": model, "effort": effort, "route_id": "grok:grok",
                           "harness": "grok", "motor": "grok",
                           "harness_account": (selected.get("harnessAccount") if route else account_for_pid(info.get("pid"), "grok").get("account", "unknown")),
                           "motor_account": (selected.get("motorAccount") if route else account_for_pid(info.get("pid"), "grok").get("account", "unknown")), "gen": gen,
                           "interrupt": bool(data.get("interrupt")), "ts": time.time()}
                motor_queue_put(opkey, payload)
                threading.Thread(target=motor_apply, args=(payload,), daemon=True).start()
                return self._json(202 if queued else 200,
                                  {"ok": True, "queued": queued, "operationKey": opkey,
                                   "model": requested_model, "effort": effort or current.get("effort")})
            if provider == "codex" and model in CODEX_MODEL_DIGITS:
                # El picker de codex es de DOS pasos numerados (modelo →
                # reasoning): un digito selecciona y avanza solo.
                seq = (
                    (("Escape",), 0.35), (("C-u",), 0.25),
                    (("-l", "--", "/model"), 0.5), (("Enter",), 1.2),
                    (("-l", "--", CODEX_MODEL_DIGITS[model]), 0.9),
                    (("-l", "--", CODEX_EFFORT_DIGITS.get(effort, "2")), 0.4),
                    (("C-u",), 0),
                )
                for keys, pause in seq:
                    r = tmux("send-keys", "-t", pane, *keys)
                    if r.returncode != 0:
                        return self._json(500, {"error": r.stderr.strip() or "tmux fallo"})
                    if pause:
                        time.sleep(pause)
                chosen_effort = effort or "medium"
                opkey = f"{sess}|{pane}"
                motor_stage(opkey, "aplicando modelo en Codex CLI")
                codex_account = (selected.get("harnessAccount") if route else (next((i.get("account") for i in read_states_cached()
                                       if i.get("session") == sess and i.get("pane") == pane), None) or "main"))
                codex_motor_account = selected.get("motorAccount") if route else codex_account
                threading.Thread(target=confirm_codex_native,
                                 args=(opkey, sess, pane, model, chosen_effort,
                                       route.get("id") if route else "codex:codex", codex_account, codex_motor_account), daemon=True).start()
                return self._json(202, {"ok": True, "operationKey": opkey,
                                        "command": f"/model → {model} {chosen_effort}",
                                        "model": model, "effort": chosen_effort})
            if provider == "opencode":
                # OpenCode: su picker /models busca por NOMBRE mostrado. La
                # secuencia limpia estado (Escape+C-u) y teclea la busqueda.
                model_provider = model.split("/", 1)[0] if "/" in model else ""
                query = cc_usage.opencode_picker_query(
                    str(data.get("model_name") or model.rsplit("/", 1)[-1]),
                    model_provider)
                for keys, pause in (
                    (("Escape",), 0.35), (("C-u",), 0.25),
                    (("-l", "--", "/models"), 0.5), (("Enter",), 1.0),
                    (("-l", "--", query), 0.8), (("Enter",), 0),
                ):
                    r = tmux("send-keys", "-t", pane, *keys)
                    if r.returncode != 0:
                        return self._json(500, {"error": r.stderr.strip() or "tmux fallo"})
                    if pause:
                        time.sleep(pause)
                return self._json(200, {"ok": True, "command": f"/models → {query}"})
            EFFORTS = ("low", "medium", "high", "xhigh", "max")
            if effort and effort not in EFFORTS:
                return self._json(400, {"error": f"effort invalido: {effort}"})
            cmds = []
            if (model and not effort_only) or not effort:
                cmds.append(cc_usage.model_switch_text(provider, preset, model))
            if effort and provider == "claude":
                cmds.append(f"/effort {effort}")   # Claude Code lo manda como output_config.effort; el proxy lo traduce a reasoning de Codex
            # `/model X` y `/effort X` en Claude Code tambien se GUARDAN como default de
            # sesiones nuevas. El cambio es de ESTA sesion: restaurar los defaults.
            saved = None
            if provider == "claude":
                try:
                    with open(os.path.expanduser("~/.claude/settings.json")) as f:
                        st0 = json.load(f)
                    saved = {k: st0.get(k) for k in ("model", "effortLevel", "modelSettings")}
                except Exception:
                    saved = None
            queued = bool(provider == "claude" and claude_pane_busy(pane))
            interrupt = bool(data.get("interrupt"))
            opkey = f"{sess}|{pane}" if PANE_RE.match(pane) else sess
            gen = motor_gen_bump(opkey)
            ctx_warning = context_shrink_warning(sess, pane, model) if model else ""
            target_motor = route.get("motor") if route else (provider_registry.engine_for_model(load_provider_registry(), model) or "claude")
            if provider == "claude" and model:
                info = _claude_info_for(sess, str(data.get("pane") or ""))
                pid = info.get("pid") if info else None
                env = _read_environ(pid) if pid else {}
                cross_motor = bool(route and current_motor and target_motor != current_motor)
                needs_proxy = target_motor in ("codex", "grok") and pid and not _proxied(pid, env)
                lock_missing = target_motor in ("codex", "grok") and any(env.get(key.encode(), b"").decode("utf-8", "replace") != model for key in motor_lock_env(target_motor, model))
                if pid and (cross_motor or needs_proxy or lock_missing):
                    if target_motor in ("codex", "grok") and not proxy_alive():
                        return self._json(409, {"error": "El gateway local no responde; abre Analytics → Guardia para repararlo."})
                    cfg_dir = env.get(b"CLAUDE_CONFIG_DIR", b"").decode("utf-8", "replace") or os.path.expanduser("~/.claude")
                    launch_env = {"CLAUDE_CONFIG_DIR": cfg_dir}
                    if target_motor in ("codex", "grok"):
                        port = int(load_proxy_cfg().get("port") or 18765)
                        launch_env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
                        launch_env.update(motor_lock_env(target_motor, model))
                    prefix = " ".join(f"{key}={shlex.quote(str(value))}" for key, value in launch_env.items()) + " "
                    cleaned, skip = [], False
                    raw = _resume_flags(_proc_cmdline(pid))
                    for i, f in enumerate(raw):
                        if f in ("--model", "--effort"):
                            skip = True
                            continue
                        if skip:
                            skip = False
                            continue
                        cleaned.append(f)
                    cmd = (prefix + "claude --resume " + shlex.quote(info["sid"]) + " --model " + shlex.quote(model)
                           + (" --effort " + shlex.quote(effort) if effort else "")
                           + "".join(" " + shlex.quote(f) for f in cleaned))
                    config = {"session":sess,"harness":"claude","motor":target_motor,"model":model,"effort":effort or "",
                              "harness_account":selected.get("harnessAccount") if route else account_for_pid(pid,"claude").get("account","unknown"),
                              "motor_account":selected.get("motorAccount") if route else "unknown",
                              "route_id":route.get("id") if route else f"claude:{target_motor}"}
                    restart_payload = {"kind":"restart","key":opkey,"sess":sess,"pane":pane,"restart_cmd":cmd,
                                       "after_cmds":[],"queued":queued,"gen":gen,"ts":time.time(),"config":config}
                    motor_queue_put(opkey, restart_payload)
                    motor_stage(opkey, "preparando continuidad y bloqueo de motor", "prepare", model=model, effort=effort)
                    if data.get("interrupt") and claude_pane_busy(pane):
                        tmux("send-keys", "-t", pane, "Escape")
                        time.sleep(1.2)
                    _claude_restart_resume(pane, pid, cmd, queued=queued, sess=opkey, gen=gen, config=config)
                    return self._json(202 if queued else 200, {"ok": True, "queued": queued, "restart": True, "operationKey": opkey,
                                            "model":model,"effort":effort or None,"contextWarning":ctx_warning or None,
                                            "note":"La conversación se conserva y todos los subagentes quedan fijados al motor elegido."})

            payload = {"key": opkey, "pane": pane, "cmds": cmds, "provider": provider, "saved": saved,
                       "sess": sess, "effort": effort, "model": model, "gen": gen, "interrupt": interrupt,
                       "route_id": route.get("id") if route else f"claude:{provider_registry.engine_for_model(load_provider_registry(), model) or 'claude'}",
                       "harness": "claude", "motor": route.get("motor") if route else (provider_registry.engine_for_model(load_provider_registry(), model) or "claude"),
                       "harness_account": (selected.get("harnessAccount") if route else (next((i.get("account") for i in read_states_cached() if i.get("session")==sess and i.get("pane")==pane), None) or "unknown")),
                       "motor_account": (selected.get("motorAccount") if route else "unknown"), "ts": time.time()}
            motor_queue_put(opkey, payload)   # persistente: sobrevive reinicios de cc-dash
            threading.Thread(target=motor_apply, args=(payload,), daemon=True).start()
            if queued:
                return self._json(202, {"ok": True, "queued": True, "operationKey": opkey, "command": " · ".join(cmds), "effort": effort or None,
                                        "contextWarning": ctx_warning or None,
                                        "note": "La sesion esta a mitad de turno: el cambio se aplica solo al terminar"})
            return self._json(200, {"ok": True, "operationKey": opkey, "command": " · ".join(cmds), "effort": effort or None,
                                    "contextWarning": ctx_warning or None})

        if self.path == "/send":
            text = str(data.get("text", ""))[:4000]
            if not text.strip():
                return self._json(400, {"error": "Texto vacio"})
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesion tmux '{sess}'. Levantala primero."})
            r = tmux("send-keys", "-t", pane, "-l", "--", text)
            if r.returncode != 0:
                return self._json(500, {"error": r.stderr.strip() or "tmux fallo"})
            tmux("send-keys", "-t", pane, "Enter")
            return self._json(200, {"ok": True})

        if self.path == "/paste":
            text = str(data.get("text", ""))
            if not text.strip():
                return self._json(400, {"error": "Texto vacio"})
            if len(text) > 20000:
                return self._json(400, {"error": "body demasiado largo (max 20000)"})
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesion tmux '{sess}'. Levantala primero."})
            err = snippet_paste_to_pane(pane, text, tmux_stdin)
            if err:
                return self._json(500, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/key":
            key = data.get("key", "")
            if key not in ALLOWED_KEYS:
                return self._json(400, {"error": "Tecla no permitida"})
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesion tmux '{sess}'"})
            r = tmux("send-keys", "-t", pane, key)
            if r.returncode != 0:
                return self._json(500, {"error": r.stderr.strip() or "tmux fallo"})
            return self._json(200, {"ok": True})

        if self.path == "/export":
            fmt = data.get("format", "txt")
            if fmt not in ("txt", "pdf"):
                return self._json(400, {"error": "format debe ser txt o pdf"})
            item = next((i for i in read_states() if i["session"] == sess
                         and (i.get("detail") or i.get("last"))), None)
            if not item:
                return self._json(404, {"error": "Esa sesion no tiene respuesta guardada"})
            item = dict(item, detail=item.get("detail") or item.get("last"))
            path, err = export_response(item, fmt)
            if err:
                return self._json(500, {"error": err})
            _open_url(path, env=gui_env())
            return self._json(200, {"ok": True, "path": path})

        if self.path == "/kill":
            # Matar DE VERDAD una sesion (el boton ✕ del tablero). Nunca las
            # internas de la app.
            if sess in HIDDEN_SESSIONS:
                return self._json(400, {"error": "Esa sesion es interna de la app"})
            if tmux("has-session", "-t", target).returncode != 0:
                return self._json(404, {"error": f"No hay sesion tmux '{sess}'"})
            r = tmux("kill-session", "-t", target)
            if r.returncode != 0:
                return self._json(500, {"error": r.stderr.strip() or "tmux fallo"})
            return self._json(200, {"ok": True})

        if self.path == "/focus":
            if tmux("has-session", "-t", target).returncode == 0:
                select_claude_window(sess)
            err = focus_session(sess)
            if err:
                return self._json(404, {"error": err})
            return self._json(200, {"ok": True})

        if self.path == "/ensure":
            # Garantiza sesion viva (revive si hace falta) y ventana pedida, SIN
            # mover clientes ni ventanas de nadie. Lo usa la app para sus tabs.
            cwd = data.get("cwd", "")
            win = data.get("win", "claude")
            if tmux("has-session", "-t", target).returncode != 0:
                if not cwd or not os.path.isdir(cwd):
                    cwd = find_project_dir(sess) or ""
                if not cwd:
                    return self._json(400, {"error": f"No encontre el directorio de '{sess}' en ~/codebase"})
                r = tmux_new_session(sess, cwd, data.get("agent") or state_agent(sess))
                if r.returncode != 0:
                    return self._json(500, {"error": r.stderr.strip() or "No se pudo crear la sesion"})
            if cwd and os.path.isdir(cwd):
                write_tab_metadata(sess, "project", cwd=cwd)
            elif not read_tab_metadata().get(sess):
                inferred = tab_metadata_for_session(sess)
                write_tab_metadata(
                    sess, inferred["kind"], host=inferred.get("host", ""),
                    cwd=inferred.get("cwd", ""))
            if win == "shell":
                ensure_shell_window(sess, cwd)
            return self._json(200, {"ok": True, "session": sess})

        if self.path == "/new":
            # Nueva sesion que SIEMPRE funciona: si el nombre es un proyecto de
            # ~/codebase abre su Claude; si no, una terminal en blanco en HOME.
            proj = find_project_dir(sess)
            if proj:
                if tmux("has-session", "-t", target).returncode != 0:
                    r = tmux_new_session(sess, proj, data.get("agent") or state_agent(sess))
                    if r.returncode != 0:
                        return self._json(500, {"error": r.stderr.strip() or "No se pudo crear"})
                write_tab_metadata(sess, "project", cwd=proj)
                return self._json(200, {"ok": True, "kind": "project", "session": sess})
            if tmux("has-session", "-t", target).returncode != 0:
                r = subprocess.run(
                    scope_cmd(["tmux", "new-session", "-d", "-s", sess,
                               "-c", os.path.expanduser("~")]),
                    capture_output=True, text=True, timeout=15)
                if r.returncode != 0:
                    return self._json(500, {"error": r.stderr.strip() or "No se pudo crear"})
            write_tab_metadata(sess, "shell", cwd=os.path.expanduser("~"))
            return self._json(200, {"ok": True, "kind": "shell", "session": sess})

        if self.path == "/shell":
            # Consola manual del proyecto: ventana 'shell' de la misma sesion
            cwd = data.get("cwd", "")
            if tmux("has-session", "-t", target).returncode != 0:
                if not cwd or not os.path.isdir(cwd):
                    cwd = find_project_dir(sess) or ""
                if not cwd:
                    return self._json(400, {"error": f"No encontre el directorio de '{sess}' en ~/codebase"})
                r = tmux_new_session(sess, cwd, data.get("agent") or state_agent(sess))
                if r.returncode != 0:
                    return self._json(500, {"error": r.stderr.strip() or "No se pudo crear la sesion"})
            ensure_shell_window(sess, cwd)
            tmux("select-window", "-t", "=" + sess + ":shell")
            focus_session(sess, win="shell")
            return self._json(200, {"ok": True})

        if self.path == "/up":
            # Si la sesion ya vive (o se resolvio a la pestana real), solo enfocar
            if tmux("has-session", "-t", target).returncode != 0:
                cwd = data.get("cwd", "")
                if not cwd or not os.path.isdir(cwd):
                    cwd = find_project_dir(sess) or ""
                if not cwd:
                    return self._json(400, {"error": f"No encontre el directorio de '{sess}' en ~/codebase"})
                r = tmux_new_session(sess, cwd, data.get("agent") or state_agent(sess))
                if r.returncode != 0:
                    return self._json(500, {"error": r.stderr.strip() or "No se pudo crear la sesion"})
            # abrir/traer la ventana del terminal de inmediato
            focus_session(sess)
            return self._json(200, {"ok": True})

        return self._json(404, {"error": "Ruta desconocida"})


def main():
    motor_queue_resume()
    args = [a for a in sys.argv[1:]]
    open_browser = "--no-open" not in args
    ports = [int(a) for a in args if a.isdigit()] or [4777]
    port = ports[0]
    socketserver.TCPServer.allow_reuse_address = True
    with socketserver.ThreadingTCPServer(("127.0.0.1", port), Handler) as srv:
        url = f"http://127.0.0.1:{port}"
        print(f"Centro Claude corriendo en {url}  (Ctrl+C para salir)")
        restore_requested_webterm()
        if open_browser:
            try:
                webbrowser.open(url)
            except Exception:
                pass
        try:
            srv.serve_forever()
        except KeyboardInterrupt:
            print("\nAdios")


if __name__ == "__main__":
    main()
