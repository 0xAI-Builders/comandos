            "configured": bool(env.get("ANTHROPIC_ADMIN_KEY")),
            "status": "configured" if env.get("ANTHROPIC_ADMIN_KEY") else "missing",
        },
    }


_local_usage_refreshing = False


def refresh_local_usage(force=False):
    """Reimporta turnos locales (jsonl de Claude, sqlite de Codex/OpenCode).
    Es CARO (~3s: camina cientos de archivos), asi que corre en un HILO y
    NUNCA bloquea /usage/state. La UI ve los datos del ciclo anterior hasta
    que el hilo termina (a lo sumo ~60s de rezago, imperceptible)."""
    global LOCAL_USAGE_REFRESH_AT, _local_usage_refreshing
    now = int(time.time())
    if not force and (now - LOCAL_USAGE_REFRESH_AT < 60 or _local_usage_refreshing):
        return {}
    if not force:
        _local_usage_refreshing = True
        LOCAL_USAGE_REFRESH_AT = now
        def _bg():
            global _local_usage_refreshing
            try:
                _do_refresh_local_usage()
            finally:
                _local_usage_refreshing = False
        threading.Thread(target=_bg, daemon=True).start()
        return {}
    LOCAL_USAGE_REFRESH_AT = now
    return _do_refresh_local_usage()


# Memo de build_usage_state: procesa decenas de miles de turnos (~1.5s). Su
# salida solo cambia cuando (a) el import de turnos corre (cada 60s) o (b)
# cambian los panes vivos. Reusamos el resultado mientras la firma no cambie,
# asi la mayoria de los polls devuelven al instante. Los limites del plan
# (que si cambian aparte) se adjuntan DESPUES: son baratos.
_usage_state_cache = {"key": None, "state": None}


def cached_usage_state(panes, env, limits):
    pane_sig = tuple(sorted(
        (p.get("tmux_session"), p.get("tmux_pane"), p.get("pane_pwd"), p.get("agent"))
        for p in panes))
    key = (LOCAL_USAGE_REFRESH_AT, pane_sig)
    if _usage_state_cache["key"] != key:
        _usage_state_cache["state"] = cc_usage.build_usage_state(
            USAGE_DB, panes, settings=env)
        _usage_state_cache["key"] = key
    state = dict(_usage_state_cache["state"])   # copia superficial: no mutar el memo
    state["limits"] = list(limits or [])
    return state


def _pane_models_for_live_state(live_panes, state):
    """Keep cached model enrichment, but never reconcile historical panes."""
    live_ids = {
        pane.get("tmux_pane") for pane in live_panes
        if (pane.get("tmux_pane") or "").startswith("%")
    }
    return [
        pane for pane in (state.get("panes") or [])
        if pane.get("tmux_pane") in live_ids
    ]


def _do_refresh_local_usage():
    now = int(time.time())
    env = usage_runtime_env()
    # Poda: turnos fuera de la ventana de retencion (14d) — sin esto la tabla
    # crece sin fin (import es insert-or-replace, nunca borra) y ademas los
    # totales "en 14 dias" quedaban inflados con datos viejos.
    max_age = int(env.get("COMANDOS_USAGE_LOCAL_DAYS") or 14)
    try:
        cc_usage.prune_old_turns(USAGE_DB, max_age_days=max_age, now=now)
    except Exception:
        pass
    max_claude_files = int(env.get("COMANDOS_USAGE_CLAUDE_MAX_FILES") or 120)
    counts = {
        "codex_local": cc_usage.record_local_codex_threads(
            USAGE_DB,
            env.get("COMANDOS_CODEX_STATE_DB") or os.path.expanduser("~/.codex/state_5.sqlite"),
            now=now,
            max_age_days=max_age,
        ),
        "claude_local": cc_usage.record_local_claude_jsonl(
            USAGE_DB,
            env.get("COMANDOS_CLAUDE_PROJECTS_DIR") or os.path.expanduser("~/.claude/projects"),
            now=now,
            max_age_days=max_age,
            max_files=max_claude_files,
        ),
        "opencode_local": cc_usage.record_local_opencode_db(
            USAGE_DB,
            env.get("COMANDOS_OPENCODE_DB") or os.path.expanduser("~/.local/share/opencode/opencode.db"),
            now=now,
            max_age_days=max_age,
        ),
    }
    return counts


# Limites exactos del plan (porcentaje 5h/semana): OAuth local de Claude Code
# y snapshots de rate limits de los rollouts de Codex. La parte con red corre
# en un hilo aparte para que /usage/state responda siempre al instante.
LIMITS_TTL = 60
_limits_lock = threading.Lock()
_limits_cache = {"at": 0, "limits": [], "health": {}}
_limits_refreshing = False


def usage_alert_send(message, title=None, kind="waiting", project=None):
    """Entrega una alerta de uso por los MISMOS canales que las notificaciones
    normales: el popup PROPIO de ComandOS (cc-notifyd; jamas el popup plano
    de GNOME) y/o Telegram, segun lo que este prendido."""
    conf = read_conf()
    if conf.get("DESKTOP_NOTIFY", "1") == "1":
        try:
            payload = json.dumps({
                "title": title or "Límite de uso", "body": message, "session": "",
                "kind": kind, "project": project or "Uso", "options": "",
                "full": message,
            }).encode()
            urllib.request.urlopen(urllib.request.Request(
                "http://127.0.0.1:4778/notify", data=payload,
                headers={"Content-Type": "application/json"}), timeout=2)
        except Exception:
            pass
    if conf.get("TELEGRAM_ENABLED") == "1":
        tg = cc_usage.load_usage_config([os.path.join(HOOKS, "telegram.env")])
        token = tg.get("CC_TELEGRAM_BOT_TOKEN") or tg.get("TELEGRAM_BOT_TOKEN")
        chat = tg.get("TELEGRAM_CHAT_ID")
        if token and chat:
            try:
                body = urllib.parse.urlencode({
                    "chat_id": chat, "parse_mode": "HTML",
                    "text": f"<b>ComandOS — Límite de uso</b>\n{message}",
                }).encode()
                urllib.request.urlopen(urllib.request.Request(
                    f"https://api.telegram.org/bot{token}/sendMessage",
                    data=body), timeout=5)
            except Exception:
                pass


def alert_thresholds():
    return cc_usage.parse_alert_thresholds(
        usage_runtime_env().get("COMANDOS_ALERT_THRESHOLDS"))


def _check_limit_alerts(limits):
    for alert in cc_usage.limit_threshold_alerts(limits, thresholds=alert_thresholds()):
        try:
            if cc_usage.record_alert_once(USAGE_DB, alert):
                usage_alert_send(alert["message"])
        except Exception:
            pass


def _claude_account_creds():
    """[(alias, creds_path)]: main (~/.claude) + cada ~/.claude-accounts/<alias>.
    Descubrimiento por convencion de directorios — nada hardcodeado."""
    out = [("main", os.path.expanduser("~/.claude/.credentials.json"))]
    base = os.path.expanduser("~/.claude-accounts")
    try:
        for name in sorted(os.listdir(base)):
            path = os.path.join(base, name, ".credentials.json")
            if os.path.isfile(path):
                out.append((name, path))
    except OSError:
        pass
    return out


def claude_accounts():
    """[{alias, dir, email, loggedIn}] — main (~/.claude) + ~/.claude-accounts/<alias>
    (tambien las recien creadas sin login, para que se vean como 'pendiente')."""
    out = [{"alias": "main", "dir": os.path.expanduser("~/.claude")}]
    base = os.path.expanduser("~/.claude-accounts")
    try:
        for name in sorted(os.listdir(base)):
            d = os.path.join(base, name)
            if name.startswith(("-", ".")) or not os.path.isdir(d):
                continue
            out.append({"alias": name, "dir": d})
    except OSError:
        pass
    for a in out:
        a["loggedIn"] = os.path.isfile(os.path.join(a["dir"], ".credentials.json"))
        a["email"] = account_email_for_dir(a["dir"], "claude") if a["loggedIn"] else ""
    return out


def _proc_cmdline(pid):
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            return [x.decode("utf-8", "replace") for x in f.read().split(b"\0") if x]
    except Exception:
        return []


def _refresh_provider_limits():
    global _limits_refreshing
    try:
        codex_rows = cc_usage.read_codex_rate_limits()
        claude_rows, healths = [], {}
        for alias, path in _claude_account_creds():
            rows, health = cc_usage.fetch_claude_oauth_limits(creds_path=path)
            email = account_email_for_dir(os.path.dirname(path), "claude")
            for r in rows:
                r["account"] = alias
                if email:
                    r["accountEmail"] = email
                if alias != "main":
                    r["id"] = f"{alias}:{r.get('id', '')}"
            if not rows and health.get("status") == "error":
                # Fetch fallido (p.ej. 429): conservar el ultimo dato bueno DE
                # ESA cuenta. captured_at delata su edad y la UI la muestra.
                with _limits_lock:
                    rows = [r for r in _limits_cache["limits"]
                            if r.get("provider") == "claude"
                            and (r.get("account") or "main") == alias]
                health["stale"] = bool(rows)
            key = "claude_oauth" if alias == "main" else f"claude_oauth:{alias}"
            health["account"] = alias
            healths[key] = health
            claude_rows += rows
        _check_limit_alerts(claude_rows + codex_rows)
        with _limits_lock:
            _limits_cache["at"] = int(time.time())
            _limits_cache["limits"] = claude_rows + codex_rows
            _limits_cache["health"] = healths
    finally:
        with _limits_lock:
            _limits_refreshing = False


def usage_provider_limits(force=False):
    global _limits_refreshing
    if force:
        with _limits_lock:
            _limits_refreshing = True
        _refresh_provider_limits()
    else:
        with _limits_lock:
            health = _limits_cache["health"].get("claude_oauth") or {}
            ttl = LIMITS_TTL * 3 if health.get("status") == "error" else LIMITS_TTL
            stale = time.time() - _limits_cache["at"] > ttl
            start = stale and not _limits_refreshing
            if start:
                _limits_refreshing = True
        if start:
            threading.Thread(target=_refresh_provider_limits, daemon=True).start()
    with _limits_lock:
        return {"limits": list(_limits_cache["limits"]),
                "health": dict(_limits_cache["health"])}


