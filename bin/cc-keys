#!/usr/bin/env bash
# Instala tu llave publica en todos los servidores de ~/.ssh/config que todavia
# pidan password. Tecleas cada password UNA ultima vez y nunca mas.
#
# Uso:  cc-keys            (usa ~/.ssh/id_ed25519.pub)
#       cc-keys otra.pub   (otra llave)
set -uo pipefail
KEY="${1:-$HOME/.ssh/id_ed25519.pub}"
[ -f "$KEY" ] || { echo "No existe la llave $KEY"; exit 1; }

hosts=$(awk 'tolower($1)=="host" && $2 !~ /[*?]/ {print $2}' "$HOME/.ssh/config" 2>/dev/null)
[ -n "$hosts" ] || { echo "No hay servidores en ~/.ssh/config"; exit 1; }

echo "Llave: $KEY"
echo ""
pend=0
for h in $hosts; do
  if ssh -o BatchMode=yes -o ConnectTimeout=6 "$h" true 2>/dev/null; then
    echo "  OK     $h (ya entra con llave, sin password)"
  else
    echo ""
    echo ">> $h pide password. Tecleala UNA ultima vez:"
    if ssh-copy-id -o ConnectTimeout=8 -i "$KEY" "$h"; then
      echo "  LISTO  $h — no vuelve a pedir password"
    else
      echo "  FALLO  $h (password incorrecta o sin acceso); reintenta con: ssh-copy-id $h"
      pend=$((pend+1))
    fi
  fi
done
echo ""
[ "$pend" -eq 0 ] && echo "Todos los servidores entran con llave. Se acabaron los passwords." \
                  || echo "$pend servidor(es) quedaron pendientes."
