#!/usr/bin/env bash
# cc-mobile — expone el tablero de ComandOS a tu CELULAR de forma SEGURA.
#
# Seguridad por capas:
#   1) Tailscale (WireGuard): peers autorizados por tu politica de tailnet,
#      con cifrado extremo a extremo.
#   2) Tailscale Serve: TLS automatico (https) y NUNCA sale a la internet
#      publica — solo a tu tailnet. (Funnel/publico: JAMAS, a proposito.)
#   3) Token de acceso: protege el dashboard/API remoto de cc-dash.
#   4) ttyd depende de la política de acceso de Tailscale; no agrega otro login.
#   5) cc-dash y ttyd escuchan SOLO en 127.0.0.1; Serve hace de puente.
#
# Uso:
#   cc-mobile           conecta y muestra el QR para emparejar el celular
#   cc-mobile off       deja de exponer el tablero y la terminal
#   cc-mobile status    estado actual
set -uo pipefail
HOOKS="$HOME/.claude/hooks"
PORT="${CC_PORT:-4777}"
TOKEN_FILE="$HOOKS/dash-token"

die(){ printf '\033[31m✗\033[0m %s\n' "$1" >&2; exit 1; }
ok(){ printf '\033[32m✓\033[0m %s\n' "$1"; }

command -v tailscale >/dev/null || die "Tailscale no esta instalado. Instalalo desde https://tailscale.com/download y vuelve a correr cc-mobile."

case "${1:-on}" in
  off)
    off_failed=0
    tailscale serve --https=443 off 2>/dev/null || off_failed=1
    tailscale serve --https=8443 off 2>/dev/null || off_failed=1
    serve_status=$(tailscale serve status 2>/dev/null)
    status_rc=$?
    if printf '%s\n' "$serve_status" | \
        grep -Eq 'http://127\.0\.0\.1:(4777|4779|4780)(/|[[:space:]]|$)'; then
      die "No pude deshabilitar toda la exposicion remota de ComandOS. Revisa: tailscale serve status"
    fi
    if [ "$off_failed" -ne 0 ] && [ "$status_rc" -ne 0 ]; then
      die "No pude deshabilitar ni verificar toda la exposicion remota. Revisa: tailscale serve status"
    fi
    ok "Tablero y terminal ya NO estan expuestos. Tu celular no puede alcanzarlos."
    exit 0 ;;
  status)
    echo "Tailscale:"; tailscale status 2>&1 | head -3
    echo; echo "Serve:"; tailscale serve status 2>&1 | head -16
    exit 0 ;;
esac

# 1) Tailscale conectado?
if ! tailscale status >/dev/null 2>&1; then
  echo "Tailscale no ha iniciado sesion. Corre esto una vez (abre tu navegador):"
  echo "    sudo tailscale up"
  die "Inicia sesion en Tailscale y vuelve a correr cc-mobile."
fi

# 2) cc-dash vivo?
curl -s -m 2 "http://127.0.0.1:$PORT/prefs" >/dev/null 2>&1 \
  || die "cc-dash no responde en el puerto $PORT. Arrancalo (systemctl --user start cc-dash)."

# 3) Token de acceso (lo crea cc-dash; si no existe aun, lo generamos igual)
if [ ! -s "$TOKEN_FILE" ]; then
  umask 077; (command -v openssl >/dev/null && openssl rand -base64 24 | tr '+/' '-_' | tr -d '=\n' \
    || head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '=\n') > "$TOKEN_FILE"
fi
chmod 600 "$TOKEN_FILE"
TOKEN=$(cat "$TOKEN_FILE")

# 4) Terminal web REAL (interactiva) de las sesiones, si ttyd esta instalado
WEBTERM_PORT="${CC_WEBTERM_PORT:-4779}"
WEBTERM_PATH_PORT="${CC_WEBTERM_PATH_PORT:-4780}"
if command -v ttyd >/dev/null 2>&1; then
  cc-webterm >/dev/null 2>&1 || true
fi

# 5) Tailscale Serve: https del tailnet -> localhost (TLS automatico).
#    Ruta / = tablero; ruta /term = terminal web (misma sesion, en vivo).
serve_path() { # $1=ruta $2=puerto
  tailscale serve --bg --https=443 --set-path="$1" "http://127.0.0.1:$2" >/dev/null 2>&1 \
    || tailscale serve --bg --set-path="$1" "http://127.0.0.1:$2" >/dev/null 2>&1 \
    || tailscale serve --https=443 "$1" "http://127.0.0.1:$2" >/dev/null 2>&1
}
serve_url() { # $1=ruta $2=url
  tailscale serve --bg --https=443 --set-path="$1" "$2" >/dev/null 2>&1 \
    || tailscale serve --bg --set-path="$1" "$2" >/dev/null 2>&1 \
    || tailscale serve --https=443 "$1" "$2" >/dev/null 2>&1
}
serve_path / "$PORT" || die "No pude configurar Tailscale Serve. Revisa: tailscale serve status"
# Terminal web same-origin para el dashboard remoto: https://host/term.
# El backend ttyd escucha con base path /term, asi sus assets/websocket resuelven bien.
if curl -s -m 2 "http://127.0.0.1:$WEBTERM_PATH_PORT/term/token" >/dev/null 2>&1; then
  # Tailscale Serve quita el prefijo externo /term; por eso el target tambien
  # incluye /term, para que ttyd reciba la ruta que espera.
  serve_url /term "http://127.0.0.1:$WEBTERM_PATH_PORT/term" || true
fi
# Fallback historico: terminal web en su PROPIO puerto https (8443, raiz).
if pgrep -f "ttyd.*cc-webterm-attach" >/dev/null 2>&1; then
  tailscale serve --bg --https=8443 "http://127.0.0.1:$WEBTERM_PORT" >/dev/null 2>&1 \
    || tailscale serve --https=8443 "http://127.0.0.1:$WEBTERM_PORT" >/dev/null 2>&1 || true
fi

# URL del tailnet (dns name del nodo)
HOST=$(tailscale status --json 2>/dev/null | grep -oE '"DNSName":\s*"[^"]+"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/' | sed 's/\.$//')
[ -n "$HOST" ] || HOST=$(tailscale status --self --json 2>/dev/null | grep -oE '[a-z0-9-]+\.[a-z0-9-]+\.ts\.net' | head -1)
[ -n "$HOST" ] || die "No pude leer tu nombre de tailnet. Revisa: tailscale status"

URL="https://$HOST/?token=$TOKEN"

echo
ok "Tablero expuesto a TU tailnet (cifrado, privado, con TLS)."
if pgrep -f "ttyd.*cc-webterm-attach" >/dev/null 2>&1; then
  ok "Terminal web REAL activo: https://$HOST/term (fallback: https://$HOST:8443)"
else
  echo "  (Terminal web interactiva: instala 'ttyd' y corre cc-webterm para tenerla)"
fi
echo
echo "  Abre esto en tu celular (o escanea el QR):"
echo -e "  \033[36m$URL\033[0m"
echo
# QR en la terminal si hay qrencode; si no, un enlace claro
if command -v qrencode >/dev/null 2>&1; then
  qrencode -t ANSIUTF8 "$URL"
else
  echo "  (Instala 'qrencode' para ver un QR aqui: sudo apt install qrencode)"
fi
echo
echo "  En el celular: abrelo en Safari/Chrome -> menu -> 'Agregar a inicio'"
echo "  para instalarlo como app. El token queda guardado; no lo compartas."
echo
echo "  Para dejar de exponerlo:  cc-mobile off"
