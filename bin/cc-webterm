#!/usr/bin/env bash
# cc-webterm — terminal REAL (interactiva) de tus sesiones, en el navegador.
# Motor: ttyd (xterm.js + PTY + WebSocket). Se attachea a tus sesiones tmux,
# asi que es LA MISMA terminal que ves en la app — compartida y en vivo.
#
# Seguridad:
#   - Escucha SOLO en 127.0.0.1 (nunca directo a la red).
#   - El token del dashboard/API no autentica ttyd. cc-mobile lo expone por
#     HTTPS en /term, limitado por la politica de acceso del tailnet.
#
# Uso:
#   cc-webterm            arranca el terminal web (127.0.0.1:4779)
#   cc-webterm off        lo detiene
#   cc-webterm status     estado
set -uo pipefail
HOOKS="$HOME/.claude/hooks"
PORT="${CC_WEBTERM_PORT:-4779}"
PATH_PORT="${CC_WEBTERM_PATH_PORT:-4780}"
PIDF="$HOOKS/cc-webterm.pid"
SELF_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

die(){ printf '\033[31m✗\033[0m %s\n' "$1" >&2; exit 1; }
ok(){ printf '\033[32m✓\033[0m %s\n' "$1"; }

stop() {
  systemctl --user stop cc-webterm.service >/dev/null 2>&1 || true
  systemctl --user stop cc-webterm-path.service >/dev/null 2>&1 || true
  [ -f "$PIDF" ] && kill "$(cat "$PIDF")" 2>/dev/null
  pkill -f "ttyd.*cc-webterm-attach" 2>/dev/null || true
  rm -f "$PIDF"
}

case "${1:-on}" in
  off) stop; ok "Terminal web detenido."; exit 0 ;;
  status)
    if pgrep -f "ttyd.*cc-webterm-attach" >/dev/null; then
      ok "Terminal web corriendo en 127.0.0.1:$PORT (:8443) y 127.0.0.1:$PATH_PORT (/term)"
    else echo "Terminal web apagado."; fi
    exit 0 ;;
esac

if ! command -v ttyd >/dev/null 2>&1; then
  echo "Falta 'ttyd' (el motor del terminal web). Instalalo:"
  echo "  Linux (Debian/Ubuntu):  sudo apt install ttyd"
  echo "  Linux (Fedora):         sudo dnf install ttyd"
  echo "  macOS:                  brew install ttyd"
  echo "  Windows:                usa WSL y el comando de Ubuntu"
  die "Instala ttyd y vuelve a correr cc-webterm."
fi

stop; sleep 0.3
# -i 127.0.0.1  solo loopback (tailscale serve hace de puente hacia el tailnet)
# -W            writable (interactivo); --url-arg deja elegir sesion por ?arg=
# Dos entradas:
#   - raiz en $PORT: fallback en https://host:8443
#   - base-path /term en $PATH_PORT: iframe same-origin para la PWA (permite
#     estilizar scrollbars sin romper el terminal actual).
# SIN basic-auth: para que la terminal se embeba en el tablero (iframe) sin
# pedir contrasena en cada panel. La frontera de seguridad es el TAILNET
# (peers autorizados por tu politica, cifrado WireGuard), igual que SSH sobre
# Tailscale.
# -t ...        tema oscuro + fuente comoda en el celular
# Compatibilidad de versiones: ttyd 1.7+ es READ-ONLY por defecto y necesita
# -W/--writable; ttyd 1.6.x es escribible por defecto y NO tiene -W. Detectamos.
WFLAG=""
ttyd --help 2>&1 | grep -q -- "--writable" && WFLAG="-W"
# ttyd en su PROPIA unidad (systemd-run en Linux, como cc-dash): sobrevive a
# que cierres la terminal o reinicies tu sesion. Fallback setsid (macOS).
TTYD_COMMON=(-i 127.0.0.1 $WFLAG --url-arg
  -t 'theme={"background":"#0A0D13","foreground":"#EAF0FB","cursor":"#FFAE1A","selectionBackground":"#2E3852"}'
  -t fontSize=14
  -t 'fontFamily=JetBrainsMono Nerd Font Mono, JetBrainsMono Nerd Font, JetBrains Mono, DejaVu Sans Mono, monospace'
  -t rendererType=canvas
  -t scrollback=10000 -t cursorBlink=true -t disableLeaveAlert=true -t disableResizeOverlay=true
  "$SELF_DIR/cc-webterm-attach")
# Pagina PROPIA como index del ttyd de /term: mismo protocolo, pero con
# fixes de teclado movil (backspace GBoard) y assets/fuente bundleados via
# cc-dash. Si este ttyd no soporta --index, cae a su UI embebida.
INDEX_HTML="$SELF_DIR/../dash/term.html"
IFLAG=()
if ttyd --help 2>&1 | grep -q -- "--index" && [ -f "$INDEX_HTML" ]; then
  IFLAG=(-I "$INDEX_HTML")
fi
TTYD_ARGS=(ttyd -p "$PORT" "${TTYD_COMMON[@]}")
TTYD_PATH_ARGS=(ttyd -p "$PATH_PORT" -b /term "${IFLAG[@]}" "${TTYD_COMMON[@]}")
if command -v systemd-run >/dev/null 2>&1; then
  systemctl --user reset-failed cc-webterm.service >/dev/null 2>&1 || true
  systemctl --user reset-failed cc-webterm-path.service >/dev/null 2>&1 || true
  systemd-run --user --collect --quiet --unit=cc-webterm "${TTYD_ARGS[@]}" >/dev/null 2>&1
  systemd-run --user --collect --quiet --unit=cc-webterm-path "${TTYD_PATH_ARGS[@]}" >/dev/null 2>&1
else
  setsid "${TTYD_ARGS[@]}" </dev/null >/dev/null 2>&1 &
  echo $! > "$PIDF"
  setsid "${TTYD_PATH_ARGS[@]}" </dev/null >/dev/null 2>&1 &
fi
sleep 0.4
if curl -s -m 2 "http://127.0.0.1:$PORT/token" >/dev/null 2>&1 && \
   curl -s -m 2 "http://127.0.0.1:$PATH_PORT/term/token" >/dev/null 2>&1; then
  ok "Terminal web listo en 127.0.0.1:$PORT (:8443) y 127.0.0.1:$PATH_PORT (/term)."
  echo "  Exponlo al celular con:  cc-mobile   (lo enruta por https del tailnet)"
  echo "  (Solo tu tailnet lo alcanza — como SSH sobre Tailscale)"
else
  die "ttyd no arranco. Revisa: ttyd --version"
fi
