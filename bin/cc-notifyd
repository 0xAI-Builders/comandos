#!/usr/bin/env python3
"""Popups accionables de Claude Code con diseno propio (sin GNOME notifications).

Ventanas flotantes arriba a la derecha con el design system del Centro Claude.
No roban el foco al aparecer; click en el input para escribir.

Anatomia del popup:
  - Etiqueta de estado (NECESITA RESPUESTA ambar / TERMINO verde)
  - NOMBRE DEL PROYECTO en grande
  - Preview de lo que Claude dijo/pregunta
  - Input de texto: escribe y Enter -> llega al Claude de esa sesion tmux
  - Botones [1][2][3] SOLO si es un prompt de permiso/pregunta numerada;
    [Enter][Esc] en esperas; [Abrir] siempre (tmux + ventana al frente)
  - Click en el nombre del proyecto = Abrir

Recibe eventos de cc-notify.sh:  POST 127.0.0.1:4778/notify
Corre como servicio:             systemctl --user status cc-notifyd
"""
import json, os, re, subprocess, threading, urllib.request
import http.server, socketserver
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

PORT = 4778
WIDTH = 470
MARGIN = 14
TOP = 48
ALLOWED_KEYS = {"Enter", "Escape", "1", "2", "3"}
SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")


def _ui_lang():
    v = "auto"
    try:
        with open(os.path.expanduser("~/.claude/hooks/cc-notify.conf")) as f:
            for line in f:
                line = line.strip()
                if line.startswith("CC_LANG="):
                    v = line.split("=", 1)[1].strip().strip('"\'')
    except Exception:
        pass
    if v in ("es", "en"):
        return v
    return "es" if os.environ.get("LANG", "").lower().startswith("es") else "en"


UI_LANG = _ui_lang()
TR = {  # (es, en)
    "waiting_tag": ("espera tu respuesta", "waiting for your answer"),
    "done_tag": ("listo", "done"),
    "see_all": ("… Ver TODO", "… View ALL"),
    "see_less": ("… Ver menos", "… View less"),
    "copy": ("Copiar", "Copy"),
    "copied": ("Copiado ✓", "Copied ✓"),
    "reply_wait": ("Responde aqui y Enter...", "Reply here and press Enter..."),
    "reply_next": ("Siguiente instruccion...", "Next instruction..."),
    "open": ("Abrir", "Open"),
    "mute_tip": ("Silenciar / activar el sonido de las notificaciones",
                 "Mute / unmute notification sounds"),
}


def tr(k):
    return TR[k][0 if UI_LANG == "es" else 1]
PERM_RE = re.compile(r"permi|pregunta|question|asking", re.IGNORECASE)

CSS = b"""
window.ccpop { background-color: rgba(0,0,0,0); }
.card { background-color: #121722; border: 1px solid #222A3A; border-radius: 12px; }
.card.waiting { border-color: #6b4c12; }
.edge { border-radius: 11px 0px 0px 11px; background-color: #2EE59D; }
.edge.waiting { background-color: #FFAE1A; }
.tag { color: #FFAE1A; font-family: 'JetBrainsMono Nerd Font', monospace; font-size: 9.5px; font-weight: 700; }
.tag.done { color: #2EE59D; }
.proj { color: #EAF0FB; font-family: 'JetBrainsMono Nerd Font', monospace; font-weight: 700; font-size: 14px; }
.body { color: #D6DEED; font-size: 13.5px; }
.body selection { background-color: #8B7CFF; color: #0A0D13; }
.vermas { color: #7AA5FF; font-size: 11.5px; padding: 0; background: none; border: none;
  font-family: 'JetBrainsMono Nerd Font', monospace; }
.vermas:hover { color: #EAF0FB; }
.entry {
  background-color: #0A0D13; color: #EAF0FB; border: 1px solid #222A3A;
  border-radius: 7px; padding: 6px 10px; font-family: 'JetBrainsMono Nerd Font', monospace;
  font-size: 12px; caret-color: #7AA5FF;
}
.entry:focus { border-color: #7AA5FF; }
.btn {
  background-color: #0A0D13; color: #9AA6BF; border: 1px solid #222A3A;
  border-radius: 6px; padding: 3px 10px; font-family: 'JetBrainsMono Nerd Font', monospace;
  font-size: 11.5px; min-height: 24px;
}
.btn:hover { color: #EAF0FB; border-color: #5E6980; background-color: #161C29; }
.btn.primary { color: #FFAE1A; border-color: #6b4c12; }
.btn.primary:hover { border-color: #FFAE1A; }
.btn.open { color: #7AA5FF; }
.close { background: none; border: none; color: #5E6980; padding: 0px 4px; font-size: 13px; }
.close:hover { color: #EAF0FB; }
"""

popups = []
by_session = {}


def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=5)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def alive(sess):
    return SESSION_RE.match(sess) and tmux("has-session", "-t", f"={sess}").returncode == 0


def dash(path, payload):
    """cc-dash sabe resolver donde vive el claude de un proyecto (aunque este
    en una pestana term-* de la app) — por eso las teclas van via el, no
    directo a tmux. Lanza excepcion si cc-dash no responde."""
    req = urllib.request.Request(
        "http://127.0.0.1:4777" + path, data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=5)


def dash_get(path, timeout=1.5):
    with urllib.request.urlopen("http://127.0.0.1:4777" + path, timeout=timeout) as r:
        return json.loads(r.read().decode())


def _fmt_table(rows):
    """Tabla markdown -> lineas <tt> alineadas por columna (Pango no tiene tablas)."""
    parsed = []
    for r in rows:
        cells = [re.sub(r"\*\*(.+?)\*\*", r"\1", c.strip()).replace("`", "")
                 for c in r.strip().strip("|").split("|")]
        if all(re.match(r"^[\s\-:]*$", c) for c in cells):
            continue   # la fila separadora |---|---|
        parsed.append(cells)
    if not parsed:
        return []
    ncol = max(len(p) for p in parsed)
    widths = [max((len(p[i]) if i < len(p) else 0) for p in parsed) for i in range(ncol)]
    out = []
    for p in parsed:
        line = "  ".join((p[i] if i < len(p) else "").ljust(widths[i])
                         for i in range(ncol)).rstrip()
        out.append("<tt>" + GLib.markup_escape_text(line) + "</tt>")
    return out


def md_to_pango(text):
    """Markdown basico -> markup Pango legible: negritas, codigo, headers,
    bullets, links (solo el texto) y tablas alineadas. Lo demas va escapado."""
    out, in_code, tbl = [], False, []

    def flush_tbl():
        if tbl:
            out.extend(_fmt_table(tbl))
            tbl.clear()

    for line in text.splitlines():
        if line.strip().startswith("```"):
            flush_tbl()
            in_code = not in_code
            continue
        if not in_code and re.match(r"^\s*\|.*\|\s*$", line):
            tbl.append(line)
            continue
        esc = GLib.markup_escape_text(line)
        if in_code:
            out.append(f"<tt>{esc}</tt>")
            continue
        flush_tbl()
        esc = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", esc)
        esc = re.sub(r"(^|[\s(])\*([^*\n]+)\*(?=$|[\s).,;:!?])", r"\1<i>\2</i>", esc)
        esc = re.sub(r"`([^`]+)`", r"<tt>\1</tt>", esc)
        esc = re.sub(r"\[([^\]]+)\]\([^)\s]+\)", r"<u>\1</u>", esc)
        m = re.match(r"^#{1,6} (.*)", esc)
        if m:
            esc = f"<b>{m.group(1)}</b>"
        esc = re.sub(r"^(\s*)[-*] ", "\\1• ", esc)
        out.append(esc)
    flush_tbl()
    return "\n".join(out)


def build_full_widget(full):
    """Texto completo como widgets mixtos: parrafos con wrap + tablas SIN
    wrap (scroll horizontal propio) para que las columnas nunca se rompan."""
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)

    def add_text(lines):
        chunk = "\n".join(lines)
        if not chunk.strip():
            return
        l = Gtk.Label(xalign=0, yalign=0)
        try:
            l.set_markup(md_to_pango(chunk))
        except Exception:
            l.set_text(chunk)
        l.get_style_context().add_class("body")
        l.set_line_wrap(True)
        l.set_max_width_chars(54)
        l.set_selectable(True)
        l.set_can_focus(False)
        v.pack_start(l, False, False, 0)

    def add_table(rows):
        lines = _fmt_table(rows)
        if not lines:
            return
        l = Gtk.Label(xalign=0, yalign=0)
        try:
            l.set_markup("\n".join(lines))
        except Exception:
            l.set_text("\n".join(rows))
        l.get_style_context().add_class("body")
        l.set_selectable(True)
        l.set_can_focus(False)
        hs = Gtk.ScrolledWindow()
        hs.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        hs.add(l)
        v.pack_start(hs, False, False, 0)

    buf, tbl, in_code = [], [], False
    for line in full.splitlines():
        if line.strip().startswith("```"):
            in_code = not in_code
            buf.append(line)
            continue
        if not in_code and re.match(r"^\s*\|.*\|\s*$", line):
            if buf:
                add_text(buf)
                buf = []
            tbl.append(line)
            continue
        if tbl:
            add_table(tbl)
            tbl = []
        buf.append(line)
    if buf:
        add_text(buf)
    if tbl:
        add_table(tbl)
    return v


def send_key(sess, key):
    if key not in ALLOWED_KEYS or not SESSION_RE.match(sess):
        return
    try:
        dash("/key", {"session": sess, "key": key})
    except Exception:
        if alive(sess):
            tmux("send-keys", "-t", f"={sess}:", key)


def choose(sess, digit):
    """Elige la opcion N de un prompt numerado: digito y Enter de confirmacion."""
    send_key(sess, digit)
    GLib.timeout_add(250, lambda: (send_key(sess, "Enter"), False)[1])


def send_text(sess, text):
    text = text.strip()
    if not text or not SESSION_RE.match(sess):
        return
    try:
        dash("/send", {"session": sess, "text": text})
    except Exception:
        if alive(sess):
            tmux("send-keys", "-t", f"={sess}:", "-l", "--", text)
            tmux("send-keys", "-t", f"={sess}:", "Enter")


def open_session(sess):
    if not SESSION_RE.match(sess):
        return
    # Delegar en cc-dash: enfoca la pestana correcta de la app (o cambia el
    # cliente tmux / abre una terminal si la app no esta abierta).
    try:
        dash("/focus", {"session": sess})
        return
    except Exception:
        pass
    tmux("switch-client", "-t", f"={sess}")
    try:
        subprocess.run(["wmctrl", "-a", sess], capture_output=True, timeout=2)
    except Exception:
        pass


def reposition():
    disp = Gdk.Display.get_default()
    mon = disp.get_primary_monitor() or disp.get_monitor(0)
    geo = mon.get_geometry()
    y = geo.y + TOP
    for w in popups:
        w.move(geo.x + geo.width - WIDTH - MARGIN, y)
        y += w.get_allocated_height() + 10
    return False


def close_popup(win):
    if win in popups:
        popups.remove(win)
    for s, w in list(by_session.items()):
        if w is win:
            by_session.pop(s, None)
    win.destroy()
    reposition()


def make_popup(title, body, session, kind, project, options_str="", full=""):
    labels = [o.strip() for o in (options_str or "").split("\x1f") if o.strip()][:4]
    full = (full or "").strip()
    old = by_session.get(session)
    if old:
        close_popup(old)

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.get_style_context().add_class("ccpop")
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_focus_on_map(False)      # no roba el foco al aparecer
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
    win.set_default_size(WIDTH, -1)
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)
    win.set_app_paintable(True)

    card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    card.get_style_context().add_class("card")
    edge = Gtk.Box(); edge.set_size_request(6, -1)
    edge.get_style_context().add_class("edge")
    if kind == "waiting":
        card.get_style_context().add_class("waiting")
        edge.get_style_context().add_class("waiting")
    card.pack_start(edge, False, False, 0)

    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
    content.set_margin_top(10); content.set_margin_bottom(11)
    content.set_margin_start(13); content.set_margin_end(11)

    # Linea de contexto COMPACTA: ● proyecto · estado    [🔊][×]
    # (el texto es el protagonista; el contexto es una sola linea discreta)
    header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    d = Gtk.Label()
    d.set_markup('<span size="10000" foreground="%s">●</span>'
                 % ("#FFAE1A" if kind == "waiting" else "#2EE59D"))
    header.pack_start(d, False, False, 0)
    pl = Gtk.Label(label=project or session, xalign=0)
    pl.get_style_context().add_class("proj")
    pl.set_ellipsize(3)  # END
    pev = Gtk.EventBox()
    pev.add(pl)
    pev.connect("button-press-event", lambda *_: (open_session(session), close_popup(win)))
    header.pack_start(pev, False, False, 0)
    tag = Gtk.Label(label=tr("waiting_tag") if kind == "waiting" else tr("done_tag"))
    tag.get_style_context().add_class("tag")
    if kind == "done":
        tag.get_style_context().add_class("done")
    header.pack_start(tag, False, False, 0)
    close = Gtk.Button(label="×")
    close.get_style_context().add_class("close")
    close.set_relief(Gtk.ReliefStyle.NONE)
    close.connect("clicked", lambda *_: close_popup(win))
    header.pack_end(close, False, False, 0)
    # Silenciar el chime desde el popup mismo (donde molesta): toggle de
    # SOUND_ENABLED via cc-dash; el volumen esta en la barra del tablero
    mute = Gtk.Button(label="🔊")
    mute.get_style_context().add_class("close")
    mute.set_relief(Gtk.ReliefStyle.NONE)
    mute.set_tooltip_text(tr("mute_tip"))

    def sync_mute():
        try:
            on = dash_get("/conf").get("SOUND_ENABLED", "1") != "0"
            mute.set_label("🔊" if on else "🔇")
        except Exception:
            pass

    def toggle_mute(_b):
        on = mute.get_label() == "🔊"
        try:
            dash("/conf-set", {"key": "SOUND_ENABLED", "value": "0" if on else "1"})
            mute.set_label("🔇" if on else "🔊")
        except Exception:
            pass

    mute.connect("clicked", toggle_mute)
    header.pack_end(mute, False, False, 0)
    GLib.idle_add(lambda: (sync_mute(), False)[1])
    content.pack_start(header, False, False, 0)

    # Preview colapsado RENDERIZADO (markdown y tablas alineadas desde el
    # primer vistazo, sin tener que dar 'Ver TODO')
    bl = None
    head_txt = ""
    src = (full or body or "").strip()
    if src:
        head, chars, shown = [], 0, 0
        for ln in src.splitlines():
            head.append(ln)
            chars += len(ln)
            if ln.strip():
                shown += 1
            if shown >= 8 or chars > 520:
                break
        head_txt = "\n".join(head)
        bl = build_full_widget(head_txt)
        content.pack_start(bl, False, False, 0)

    # Fila de herramientas del texto: Copiar (respuesta completa al clipboard)
    # y "Ver TODO" cuando hay mas texto
    tools = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    if src:
        cp = Gtk.Button(label=tr("copy"))
        cp.get_style_context().add_class("vermas")
        cp.set_relief(Gtk.ReliefStyle.NONE)

        def do_copy(_b):
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(full or src, -1)
            cp.set_label(tr("copied"))
            GLib.timeout_add_seconds(2, lambda: (cp.set_label(tr("copy")), False)[1])

        cp.connect("clicked", do_copy)
        tools.pack_start(cp, False, False, 0)

    # "Ver TODO": el texto COMPLETO, expandible aqui mismo, con scroll.
    # Nunca respondas a ciegas por un preview cortado.
    win._expanded = False
    sw = None
    if full and full.strip() and full.strip() != head_txt.strip():
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_min_content_height(140)
        try:
            sw.set_max_content_height(520)
            sw.set_propagate_natural_height(True)
        except Exception:
            sw.set_size_request(-1, 380)   # GTK < 3.22
        sw.add(build_full_widget(full[:16000]))
        sw.set_no_show_all(True)
        # "… Ver TODO" pegado al texto, como un link discreto
        vt = Gtk.Button(label=tr("see_all"))
        vt.get_style_context().add_class("vermas")
        vt.set_relief(Gtk.ReliefStyle.NONE)
        vt.set_halign(Gtk.Align.START)

        def toggle(_b):
            win._expanded = not win._expanded
            if win._expanded:
                sw.set_no_show_all(False)
                sw.show_all()
                if bl:
                    bl.hide()
                vt.set_label(tr("see_less"))
            else:
                sw.hide()
                if bl:
                    bl.show()
                vt.set_label(tr("see_all"))
                win.resize(WIDTH, 1)
            reposition()
            GLib.timeout_add(80, reposition)

        vt.connect("clicked", toggle)
        tools.pack_start(vt, False, False, 0)
    if tools.get_children():
        content.pack_start(tools, False, False, 0)
    if sw is not None:
        content.pack_start(sw, True, True, 0)

    def mk_btn(label, cb, cls=None):
        b = Gtk.Button(label=label)
        b.get_style_context().add_class("btn")
        if cls:
            b.get_style_context().add_class(cls)
        b.connect("clicked", lambda *_: (cb(), close_popup(win)))
        return b

    long_opts = any(len(l) > 14 for l in labels)
    if labels and long_opts:
        # Opciones largas (pregunta): una por renglon, ancho completo
        for i, lab in enumerate(labels):
            b = mk_btn(f"{lab[:60]}", lambda i=i: choose(session, str(i + 1)), "primary")
            b.get_child().set_xalign(0)
            content.pack_start(b, False, False, 0)

    btns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    if labels and not long_opts:
        for i, lab in enumerate(labels):
            btns.pack_start(mk_btn(lab[:16], lambda i=i: choose(session, str(i + 1)), "primary"),
                            False, False, 0)
    if kind == "waiting":
        if not labels:
            btns.pack_start(mk_btn("Enter", lambda: send_key(session, "Enter"), "primary"),
                            False, False, 0)
        btns.pack_start(mk_btn("Esc", lambda: send_key(session, "Escape")), False, False, 0)
    if btns.get_children():
        content.pack_start(btns, False, False, 0)

    # Fila final: input que se estira + Abrir (una sola linea de accion)
    entry = Gtk.Entry()
    entry.get_style_context().add_class("entry")
    entry.set_placeholder_text(
        tr("reply_wait") if kind == "waiting" else tr("reply_next"))

    def on_activate(e):
        send_text(session, e.get_text())
        close_popup(win)

    entry.connect("activate", on_activate)
    row_send = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    row_send.pack_start(entry, True, True, 0)
    row_send.pack_end(mk_btn(tr("open"), lambda: open_session(session), "open"), False, False, 0)
    content.pack_start(row_send, False, False, 1)

    card.pack_start(content, True, True, 0)
    win.add(card)
    win.show_all()
    popups.append(win)
    by_session[session] = win
    reposition()
    GLib.timeout_add(80, reposition)

    if kind != "waiting":
        def auto():
            # no cerrar si el usuario escribe en el input o esta LEYENDO el texto
            if win in popups and not entry.has_focus() and not win._expanded:
                close_popup(win)
                return False
            return win in popups
        GLib.timeout_add_seconds(12, auto)
    return False


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_POST(self):
        # Solo loopback y sin Origin cross-site: cc-notify.sh (curl, sin Origin)
        # pasa; un sitio web con fetch cross-origin (CSRF de popups) se rechaza.
        ip = self.client_address[0] if self.client_address else ""
        if ip not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
            self.send_response(403); self.end_headers(); return
        origin = self.headers.get("Origin", "")
        if origin and not re.match(r"^https?://(localhost|127\.0\.0\.1)(:\d+)?$", origin):
            self.send_response(403); self.end_headers(); return
        if self.path != "/notify":
            self.send_response(404); self.end_headers(); return
        try:
            n = int(self.headers.get("Content-Length", 0))
            if n > 200_000:
                self.send_response(413); self.end_headers(); return
            d = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            self.send_response(400); self.end_headers(); return
        if len(popups) >= 8:   # tope anti screen-spam / DoS de popups
            self.send_response(200)
            self.send_header("Content-Length", "0"); self.end_headers(); return
        GLib.idle_add(make_popup,
                      str(d.get("title", "Claude Code"))[:200],
                      str(d.get("body", ""))[:400],
                      str(d.get("session", "")),
                      str(d.get("kind", "done")),
                      str(d.get("project", ""))[:80],
                      str(d.get("options", ""))[:600],
                      str(d.get("full", ""))[:60000])
        out = b'{"ok": true}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    socketserver.TCPServer.allow_reuse_address = True
    srv = socketserver.ThreadingTCPServer(("127.0.0.1", PORT), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    print(f"cc-notifyd listo en 127.0.0.1:{PORT} (popups propios v3)")
    Gtk.main()


if __name__ == "__main__":
    main()
