popups = []
by_session = {}
POS_FILE = os.path.expanduser("~/.claude/hooks/notifyd-pos.json")


def _anchor_load():
    try:
        with open(POS_FILE) as f:
            d = json.load(f)
        return int(d["x"]), int(d["y"])
    except Exception:
        return None


def _anchor_save(x, y):
    try:
        tmp = POS_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"x": int(x), "y": int(y)}, f)
        os.replace(tmp, POS_FILE)
    except Exception:
        pass


ANCHOR = _anchor_load()


def tmux(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=5)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def alive(sess):
    return SESSION_RE.match(sess) and tmux("has-session", "-t", f"={sess}").returncode == 0


def dash(path, payload):
    """cc-dash sabe resolver donde vive el claude de un proyecto (aunque este
    en una pestana term-* de la app) — por eso las teclas van via el, no
    directo a tmux. Lanza excepcion si cc-dash no responde."""
    req = urllib.request.Request(
        "http://127.0.0.1:4777" + path, data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    urllib.request.urlopen(req, timeout=5)


def dash_get(path, timeout=1.5):
    with urllib.request.urlopen("http://127.0.0.1:4777" + path, timeout=timeout) as r:
        return json.loads(r.read().decode())


def _fmt_table(rows):
    """Tabla markdown -> lineas <tt> alineadas por columna (Pango no tiene tablas)."""
    parsed = []
    for r in rows:
        cells = [re.sub(r"\*\*(.+?)\*\*", r"\1", c.strip()).replace("`", "")
                 for c in r.strip().strip("|").split("|")]
        if all(re.match(r"^[\s\-:]*$", c) for c in cells):
            continue   # la fila separadora |---|---|
        parsed.append(cells)
    if not parsed:
        return []
    ncol = max(len(p) for p in parsed)
    widths = [max((len(p[i]) if i < len(p) else 0) for p in parsed) for i in range(ncol)]
    out = []
    for p in parsed:
        line = "  ".join((p[i] if i < len(p) else "").ljust(widths[i])
                         for i in range(ncol)).rstrip()
        out.append("<tt>" + GLib.markup_escape_text(line) + "</tt>")
    return out


def md_to_pango(text):
    """Markdown basico -> markup Pango legible: negritas, codigo, headers,
    bullets, links (solo el texto) y tablas alineadas. Lo demas va escapado."""
    out, in_code, tbl = [], False, []

    def flush_tbl():
        if tbl:
            out.extend(_fmt_table(tbl))
            tbl.clear()

    for line in text.splitlines():
        if line.strip().startswith("```"):
            flush_tbl()
            in_code = not in_code
            continue
        if not in_code and re.match(r"^\s*\|.*\|\s*$", line):
            tbl.append(line)
            continue
        esc = GLib.markup_escape_text(line)
        if in_code:
            out.append(f"<tt>{esc}</tt>")
            continue
        flush_tbl()
        esc = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", esc)
        esc = re.sub(r"(^|[\s(])\*([^*\n]+)\*(?=$|[\s).,;:!?])", r"\1<i>\2</i>", esc)
        esc = re.sub(r"`([^`]+)`", r"<tt>\1</tt>", esc)
        esc = re.sub(r"\[([^\]]+)\]\([^)\s]+\)", r"<u>\1</u>", esc)
        m = re.match(r"^#{1,6} (.*)", esc)
        if m:
            esc = f"<b>{m.group(1)}</b>"
        esc = re.sub(r"^(\s*)[-*] ", "\\1• ", esc)
        out.append(esc)
    flush_tbl()
    return "\n".join(out)


def build_full_widget(full):
    """Texto completo como widgets mixtos: parrafos con wrap + tablas SIN
    wrap (scroll horizontal propio) para que las columnas nunca se rompan."""
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)

    def add_text(lines):
        chunk = "\n".join(lines)
        if not chunk.strip():
            return
        l = Gtk.Label(xalign=0, yalign=0)
        try:
            l.set_markup(md_to_pango(chunk))
        except Exception:
            l.set_text(chunk)
        l.get_style_context().add_class("body")
        l.set_line_wrap(True)
        l.set_max_width_chars(54)
        l.set_selectable(True)
        l.set_can_focus(False)
        v.pack_start(l, False, False, 0)

    def add_table(rows):
        lines = _fmt_table(rows)
        if not lines:
            return
        l = Gtk.Label(xalign=0, yalign=0)
        try:
            l.set_markup("\n".join(lines))
        except Exception:
            l.set_text("\n".join(rows))
        l.get_style_context().add_class("body")
        l.set_selectable(True)
        l.set_can_focus(False)
        hs = Gtk.ScrolledWindow()
        hs.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        hs.add(l)
        v.pack_start(hs, False, False, 0)

    buf, tbl, in_code = [], [], False
    for line in full.splitlines():
        if line.strip().startswith("```"):
            in_code = not in_code
            buf.append(line)
            continue
        if not in_code and re.match(r"^\s*\|.*\|\s*$", line):
            if buf:
                add_text(buf)
                buf = []
            tbl.append(line)
            continue
        if tbl:
            add_table(tbl)
            tbl = []
        buf.append(line)
    if buf:
        add_text(buf)
    if tbl:
        add_table(tbl)
    return v


def send_key(sess, key):
    if key not in ALLOWED_KEYS or not SESSION_RE.match(sess):
        return
    try:
        dash("/key", {"session": sess, "key": key})
    except Exception:
        if alive(sess):
            tmux("send-keys", "-t", f"={sess}:", key)


def choose(sess, digit):
    """Elige la opcion N de un prompt numerado: digito y Enter de confirmacion."""
    send_key(sess, digit)
    GLib.timeout_add(250, lambda: (send_key(sess, "Enter"), False)[1])


def send_text(sess, text):
    text = text.strip()
    if not text or not SESSION_RE.match(sess):
        return
    try:
        dash("/send", {"session": sess, "text": text})
    except Exception:
        if alive(sess):
            tmux("send-keys", "-t", f"={sess}:", "-l", "--", text)
            tmux("send-keys", "-t", f"={sess}:", "Enter")


def open_session(sess):
    if not SESSION_RE.match(sess):
        return
    # Delegar en cc-dash: enfoca la pestana correcta de la app (o cambia el
    # cliente tmux / abre una terminal si la app no esta abierta).
    try:
        dash("/focus", {"session": sess})
        return
    except Exception:
        pass
    tmux("switch-client", "-t", f"={sess}")
    try:
        subprocess.run(["wmctrl", "-a", sess], capture_output=True, timeout=2)
    except Exception:
        pass


_NPOS_CACHE = {"at": 0.0, "val": "free"}


def _notif_pos():
    now = time.time()
    if now - _NPOS_CACHE["at"] > 5:
        _NPOS_CACHE["at"] = now
        try:
            _NPOS_CACHE["val"] = dash_get("/prefs").get("notif_pos") or "free"
        except Exception:
            pass
    return _NPOS_CACHE["val"]


def reposition():
    disp = Gdk.Display.get_default()
    mon = disp.get_primary_monitor() or disp.get_monitor(0)
    geo = mon.get_geometry()
    mode = _notif_pos()
    up = False
    if mode in ("tl", "tr", "bl", "br"):
        x = geo.x + MARGIN if mode.endswith("l") else geo.x + geo.width - WIDTH - MARGIN
        if mode.startswith("t"):
            y = geo.y + TOP
        else:
            up = True
            y = geo.y + geo.height - MARGIN   # borde inferior EXACTO; el loop resta cada altura
    elif ANCHOR:
        # "Libre": la pila nace donde el usuario dejo el ultimo arrastre.
        x = max(geo.x, min(ANCHOR[0], geo.x + geo.width - WIDTH - 4))
        y = max(geo.y, min(ANCHOR[1], geo.y + geo.height - 120))
    else:
        x = geo.x + geo.width - WIDTH - MARGIN
        y = geo.y + TOP
    for w in popups:
        h = w.get_allocated_height()
        if up:
            y -= h
        w._want = (x, y)
        w.move(x, y)
        y = (y - 10) if up else (y + h + 10)
    return False


def _on_configure(win, ev):
    """Si la ventana quedo donde NO la pusimos, fue un arrastre del usuario:
    esa posicion (menos su offset en la pila) es la nueva ancla, y se recuerda."""
    global ANCHOR
    want = getattr(win, "_want", None)
    if not want:
        return False
    if getattr(win, "_dragging", None):
        return False
    if time.time() - getattr(win, "_drag_ts", 0) > 6:
        # Movimiento del WM (mapa inicial, restack), no del usuario: re-asentar
        # nuestra posicion (mutter recoloca las NOTIFICATION al mapear).
        if (abs(ev.x - want[0]) > 2 or abs(ev.y - want[1]) > 2) and getattr(win, "_fix", 0) < 5:
            win._fix = getattr(win, "_fix", 0) + 1
            GLib.timeout_add(60, reposition)
        return False
    if abs(ev.x - want[0]) <= 2 and abs(ev.y - want[1]) <= 2:
        return False
    try:
        idx = popups.index(win)
    except ValueError:
        return False
    off = 0
    for w in popups[:idx]:
        off += w.get_allocated_height() + 10
    ANCHOR = (int(ev.x), int(ev.y) - off)
    _anchor_save(*ANCHOR)
    GLib.timeout_add(60, reposition)
    return False


def close_popup(win):
    if win in popups:
        popups.remove(win)
    for s, w in list(by_session.items()):
        if w is win:
            by_session.pop(s, None)
    win.destroy()
    reposition()


CSS_PROVIDER = None


def apply_theme_css():
    global CSS_PROVIDER
    if CSS_PROVIDER is None:
        CSS_PROVIDER = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), CSS_PROVIDER, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    try:
        CSS_PROVIDER.load_from_data(build_css(theme_tokens()))
    except Exception:
        pass


def make_popup(title, body, session, kind, project, options_str="", full="", expanded=False):
    apply_theme_css()
    labels = [o.strip() for o in (options_str or "").split("\x1f") if o.strip()][:4]
    full = (full or "").strip()
    old = by_session.get(session)
    if old:
        close_popup(old)

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.get_style_context().add_class("ccpop")
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_focus_on_map(False)      # no roba el foco al aparecer
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
    win.set_default_size(WIDTH, -1)
    visual = win.get_screen().get_rgba_visual()
    if visual:
        win.set_visual(visual)
    win.set_app_paintable(True)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    card.get_style_context().add_class("card")

    # Franja de cabecera tintada por estado: la meta-info vive ARRIBA, separada
    # del texto — jerarquia clara y color de estado imposible de confundir.
    hd = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
    hd.get_style_context().add_class("hd")
    if kind == "waiting":
        hd.get_style_context().add_class("waiting")
    hdi = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
    hdi.set_margin_top(9); hdi.set_margin_bottom(3)
    hdi.set_margin_start(10); hdi.set_margin_end(30)
    ar = Gtk.Label(label="›")
    ar.get_style_context().add_class("close")
    ar_ev = Gtk.EventBox()
    ar_ev.add(ar)
    ar_ev.set_tooltip_text("Expandir / colapsar" if UI_LANG == "es" else "Expand / collapse")
    ar_ev.connect("enter-notify-event", lambda *_: (ar.get_style_context().add_class("hover"), False)[1])
    ar_ev.connect("leave-notify-event", lambda *_: (ar.get_style_context().remove_class("hover"), False)[1])
    hdi.pack_start(ar_ev, False, False, 0)
    tk = theme_tokens() if callable(globals().get("theme_tokens")) else {}
    kd = _icon_image("bell" if kind == "waiting" else "check", 15,
                     (tk.get("waiting") or "#F5B14C") if kind == "waiting"
                     else (tk.get("done") or "#34D399"))
    kd.get_style_context().add_class("kbadge")
    if kind == "waiting":
        kd.get_style_context().add_class("waiting")
    kd.set_tooltip_text(tr("waiting_tag") if kind == "waiting" else tr("done_tag"))
    hdi.pack_start(kd, False, False, 0)
    pl2 = Gtk.Label(label=project or session, xalign=0)
    pl2.get_style_context().add_class("proj")
    pl2.set_ellipsize(3)  # END
    pev2 = Gtk.EventBox()
    pev2.add(pl2)
    pev2.connect("button-press-event", lambda *_: (open_session(session), close_popup(win)))
    pev2.set_tooltip_text("Abrir la sesion" if UI_LANG == "es" else "Open the session")
    hdi.pack_start(pev2, False, False, 0)
    spacer = Gtk.Box()          # sin ventana X: el click pasa al toggle de la tarjeta
    spacer.set_hexpand(True)
    hdi.pack_start(spacer, True, True, 0)
    # el nombre NO se expande (su click abre la sesion — debe ser solo el texto)
    hdv = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
    hdv.pack_start(hdi, False, False, 0)
    first_line = next((l.strip() for l in (full or body or "").splitlines() if l.strip()), "")
    inprev = Gtk.Label(label=first_line, xalign=0)
    inprev.get_style_context().add_class("inprev")
    inprev.set_ellipsize(3)  # END
    inprev.set_margin_start(48)
    inprev.set_margin_end(30)
    inprev.set_margin_bottom(10)
    hdv.pack_start(inprev, False, False, 0)
    hd.pack_start(hdv, True, True, 0)

    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    content.set_no_show_all(True)
    content.set_margin_top(4); content.set_margin_bottom(12)
    content.set_margin_start(14); content.set_margin_end(13)


    # Preview colapsado RENDERIZADO (markdown y tablas alineadas desde el
    # primer vistazo, sin tener que dar 'Ver TODO')
    bl = None
    head_txt = ""
    src = (full or body or "").strip()
    if src:
        head, chars, shown = [], 0, 0
        for ln in src.splitlines():
            head.append(ln)
            chars += len(ln)
            if ln.strip():
                shown += 1
            if shown >= 8 or chars > 520:
                break
        head_txt = "\n".join(head)
        bl = build_full_widget(head_txt)
        content.pack_start(bl, False, False, 0)

    # Fila de herramientas del texto: Copiar (respuesta completa al clipboard)
    # y "Ver TODO" cuando hay mas texto
    tools = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    if src:
        cp = Gtk.Button(label=tr("copy"))
        cp.get_style_context().add_class("vermas")
        cp.set_relief(Gtk.ReliefStyle.NONE)

        def do_copy(_b):
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(full or src, -1)
            cp.set_label(tr("copied"))
            GLib.timeout_add_seconds(2, lambda: (cp.set_label(tr("copy")), False)[1])

        cp.connect("clicked", do_copy)
        tools.pack_start(cp, False, False, 0)

    # "Ver TODO": el texto COMPLETO, expandible aqui mismo, con scroll.
    # Nunca respondas a ciegas por un preview cortado.
    win._expanded = False
    sw = None
    if full and full.strip() and full.strip() != head_txt.strip():
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sw.set_min_content_height(140)
        try:
            sw.set_max_content_height(520)
            sw.set_propagate_natural_height(True)
        except Exception:
            sw.set_size_request(-1, 380)   # GTK < 3.22
        sw.add(build_full_widget(full[:16000]))
        sw.set_no_show_all(True)
        # "… Ver TODO" pegado al texto, como un link discreto
        vt = Gtk.Button(label=tr("see_all"))
        vt.get_style_context().add_class("vermas")
        vt.set_relief(Gtk.ReliefStyle.NONE)
        vt.set_halign(Gtk.Align.START)

        def toggle(_b):
            win._expanded = not win._expanded
            if win._expanded:
                sw.set_no_show_all(False)
                sw.show_all()
                if bl:
                    bl.hide()
                vt.set_label(tr("see_less"))
            else:
                sw.hide()
                if bl:
                    bl.show()
                vt.set_label(tr("see_all"))
                win.resize(WIDTH, 1)
            reposition()
            GLib.timeout_add(80, reposition)

        vt.connect("clicked", toggle)
        tools.pack_start(vt, False, False, 0)
    ob = Gtk.Button(label=tr("open"))
    ob.get_style_context().add_class("btn"); ob.get_style_context().add_class("primary")
    # Estilo clavado AL WIDGET (prioridad USER): las ventanas de aviso viven sin
    # foco y el estado :backdrop de GTK desaturaba el boton primario.
    try:
        tt = theme_tokens()
        _pv = Gtk.CssProvider()
        _pv.load_from_data((
            "button, button:backdrop { background-image: none; background-color: %s; "
            "color: %s; border: 1px solid %s; border-radius: 8px; font-weight: 800; "
            "padding: 2px 11px; min-height: 22px; font-family: 'JetBrainsMono Nerd Font', monospace; font-size: 10.5px; } "
            "button label, button:backdrop label { color: %s; } "
            "button:hover { background-color: %s; }"
            % (tt['brand'], tt['bg'], tt['brand'], tt['bg'], tt.get('text', '#fff'))).encode())
        ob.get_style_context().add_provider(_pv, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        ch = ob.get_child()
        if ch is not None:
            ch.get_style_context().add_provider(_pv, Gtk.STYLE_PROVIDER_PRIORITY_USER)
    except Exception:
        pass
    ob.connect("clicked", lambda *_: (open_session(session), close_popup(win)))
    tools.pack_end(ob, False, False, 0)
    content.pack_start(tools, False, False, 0)
    if sw is not None:
        content.pack_start(sw, False, False, 0)

    # El popup es un AVISO PURO (apoyo cognitivo visual): sin inputs ni
    # botones de opciones — responder se hace en la terminal, con contexto.
    # Click corto en zona no-interactiva = saltar a la sesion; ARRASTRE = moverlo
    # (y recordar el ancla). begin_move_drag no sirve: mutter lo ignora en
    # ventanas NOTIFICATION, asi que el drag es manual con el grab implicito de X.
    win._dragging = None

    def _press(_w, ev):
        if ev.button != 1:
            return False
        wx, wy = win.get_position()
        win._dragging = {"dx": ev.x_root - wx, "dy": ev.y_root - wy,
                         "x0": ev.x_root, "y0": ev.y_root, "moved": False}
        return True

    def _motion(_w, ev):
        d = win._dragging
        if not d:
            return False
        # ARRASTRAR = boton FISICAMENTE presionado. Si el release se lo comio
        # otro widget (p.ej. el titulo al hacer toggle), el estado quedaba
        # colgado y la tarjeta seguia al mouse sin boton.
        if not (ev.state & Gdk.ModifierType.BUTTON1_MASK):
            win._dragging = None
            return False
        if not d["moved"]:
            # Umbral GENEROSO: un click con temblor de mano NO es un arrastre
            # (con 5px cualquier click sucio movia la tarjeta y robaba el toggle)
            if abs(ev.x_root - d["x0"]) < 12 and abs(ev.y_root - d["y0"]) < 12:
                return False
            # sin brinco: el arrastre continua desde DONDE esta la ventana ahora
            wx0, wy0 = win.get_position()
            d["dx"], d["dy"] = ev.x_root - wx0, ev.y_root - wy0
        d["moved"] = True
        win._drag_ts = time.time()
        nx, ny = int(ev.x_root - d["dx"]), int(ev.y_root - d["dy"])
        win._want = (nx, ny)          # que el re-asiento anti-WM no pelee el arrastre
        win.move(nx, ny)
        return True

    def _release(_w, ev):
        global ANCHOR
        d = win._dragging
        win._dragging = None
        if not d:
            return False
        if not d["moved"]:
            win._toggle()
            return True
        # nueva ancla = donde quedo ESTA ventana, menos su offset en la pila
        try:
            idx = popups.index(win)
        except ValueError:
            idx = 0
        off = 0
        for w in popups[:idx]:
            off += w.get_allocated_height() + 10
        x, y = win.get_position()
        ANCHOR = (int(x), int(y) - off)
        _anchor_save(*ANCHOR)
        _NPOS_CACHE.update(at=time.time() + 30, val="free")
        def _tofree():
            try:
                dash("/prefs-set", {"notif_pos": "free"})
            except Exception:
                pass
        threading.Thread(target=_tofree, daemon=True).start()
        GLib.timeout_add(60, reposition)
        return True

    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON1_MOTION_MASK |
                   Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
    win.connect("button-press-event", _press)
    win.connect("motion-notify-event", _motion)
    win.connect("button-release-event", _release)
    win.connect("configure-event", _on_configure)

    def _keys(_w, ev):
        name = Gdk.keyval_name(ev.keyval) or ""
        if name == "Escape":
            close_popup(win)
            return True
        if name in ("Return", "KP_Enter", "space"):
            win._toggle()
            return True
        return False
    win.connect("key-press-event", _keys)

    # Titulo = EventBox (ventana X propia: click confiable); detalle = Gtk.Revealer
    # (animacion prehecha). El Expander se fue: su modelo de input daba clicks muertos.
    title_ev = Gtk.EventBox()
    title_ev.add(hd)
    rev = Gtk.Revealer()
    rev.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
    rev.set_transition_duration(150)
    rev.add(content)
    win._detail = bool(expanded)

    def _set_open(open_):
        win._detail = bool(open_)
        ar.set_text("⌄" if open_ else "›")
        inprev.set_visible(not open_)
        if open_:
            content.set_no_show_all(False)
            content.show_all()
            if sw is not None and not win._expanded:
                sw.hide()
        rev.set_reveal_child(bool(open_))

        def _later():
            win.resize(WIDTH, 1)
            reposition()
            return False
        for ms in (80, 240, 480):
            GLib.timeout_add(ms, _later)

    def _toggle(*_):
        _set_open(not win._detail)
        return True
    title_ev.connect("button-release-event", _toggle)
    ar_ev.connect("button-release-event", _toggle)   # hitbox propio; no depende del titulo
    win._toggle = _toggle
    card.pack_start(title_ev, False, False, 0)
    card.pack_start(rev, True, True, 0)
    if win._detail:
        _set_open(True)

    # ✕ FLOTANTE (Gtk.Overlay): recibe el click antes que el Expander — cerrar
    # siempre funciona, y el label queda limpio.
    cl2 = Gtk.Button(label=chr(215))
    cl2.get_style_context().add_class("close")
    cl2.set_relief(Gtk.ReliefStyle.NONE)
    cl2.set_halign(Gtk.Align.END)
    cl2.set_valign(Gtk.Align.START)
    cl2.set_margin_top(5)
    cl2.set_margin_end(7)
    cl2.connect("clicked", lambda *_: close_popup(win))
    cl2.set_tooltip_text("Cerrar (Esc)" if UI_LANG == "es" else "Close (Esc)")
    ovl = Gtk.Overlay()
    ovl.add(card)
    ovl.add_overlay(cl2)
    win.add(ovl)
    win.set_opacity(0.0)
    win.show_all()
    if not win._detail:
        content.hide()   # no_show_all lo protege; el Revealer arranca cerrado

    def _fade(step=[0]):
        step[0] += 1
        win.set_opacity(min(0.98, step[0] / 6.0))
        return step[0] < 6
    GLib.timeout_add(25, _fade)
    for ms in (40, 220, 450):
        GLib.timeout_add(ms, lambda: (None if win._expanded else win.resize(WIDTH, 1), False)[1])   # altura natural, sin aire muerto
    if expanded and sw is not None:
        win._expanded = True
        sw.set_no_show_all(False); sw.show_all()
        if bl: bl.hide()
    popups.append(win)
    by_session[session] = win
    reposition()
    GLib.timeout_add(80, reposition)

    if kind != "waiting":
        def auto():
            # no cerrar mientras el usuario esta LEYENDO el texto expandido
            if win in popups and not win._expanded:
                close_popup(win)
                return False
            return win in popups
        GLib.timeout_add_seconds(10, auto)
    return False


NATIVE_KEEP = []   # referencias vivas: libnotify pierde las acciones si el objeto se recolecta


def native_notify(title, body, session, kind, project, options_str="", full=""):
    """Aviso NATIVO del escritorio (GNOME: historial en la bandeja, No Molestar,
    acciones). El texto completo queda a un click ("Ver todo" -> popup propio)."""
    if not (HAVE_NOTIFY and _conf_value("NATIVE_NOTIFY", "0") == "1"):   # nativas SOLO si se piden (NATIVE_NOTIFY=1)
        return make_popup(title, body, session, kind, project, options_str, full)
    src = (full or body or "").strip()
    # vista previa: solo prosa (tablas y bloques de codigo van en "Ver todo")
    prose, in_code = [], False
    for ln in src.splitlines():
        if ln.strip().startswith("```"):
            in_code = not in_code; continue
        if in_code or re.match(r"^\s*\|.*\|\s*$", ln) or not ln.strip():
            continue
        prose.append(re.sub(r"[*_`#>]+", "", ln).strip())
        if len(prose) >= 4:
            break
    lines = prose or [ln for ln in src.splitlines() if ln.strip()][:4]
    short = "\n".join(lines)[:360]
    if len(src) > len(short):
        short = short.rstrip() + " …"
    tag = tr("waiting_tag") if kind == "waiting" else tr("done_tag")
    summary = f"{project or session} · {tag}"
    icon = os.path.expanduser("~/.claude/hooks/dash/icon-192.png")
    if not os.path.exists(icon):
        icon = "dialog-information"
    n = Notify.Notification.new(summary, GLib.markup_escape_text(short), icon)
    n.set_app_name("ComandOS")
    n.set_urgency(Notify.Urgency.CRITICAL if kind == "waiting" else Notify.Urgency.NORMAL)
    n.set_hint("suppress-sound", GLib.Variant("b", True))   # el chime lo pone cc-notify.sh
    n.set_hint("desktop-entry", GLib.Variant("s", "comandos"))
    n.add_action("open", tr("open"), lambda *_: open_session(session))
    n.add_action("full", tr("see_all").replace("… ", ""),
                 lambda *_: GLib.idle_add(make_popup, title, body, session, kind, project, options_str, full, True))
    n.connect("closed", lambda nn: NATIVE_KEEP.remove(nn) if nn in NATIVE_KEEP else None)
    NATIVE_KEEP.append(n)
    try:
        n.show()
    except Exception:
        return make_popup(title, body, session, kind, project, options_str, full)
    return False


class Handler(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def do_POST(self):
        # Solo loopback y sin Origin cross-site: cc-notify.sh (curl, sin Origin)
        # pasa; un sitio web con fetch cross-origin (CSRF de popups) se rechaza.
        ip = self.client_address[0] if self.client_address else ""
        if ip not in ("127.0.0.1", "::1", "::ffff:127.0.0.1"):
            self.send_response(403); self.end_headers(); return
        origin = self.headers.get("Origin", "")
        if origin and not re.match(r"^https?://(localhost|127\.0\.0\.1)(:\d+)?$", origin):
            self.send_response(403); self.end_headers(); return
        if self.path != "/notify":
            self.send_response(404); self.end_headers(); return
        try:
            n = int(self.headers.get("Content-Length", 0))
            if n > 200_000:
                self.send_response(413); self.end_headers(); return
            d = json.loads(self.rfile.read(n) or b"{}")
        except Exception:
            self.send_response(400); self.end_headers(); return
        # Foco (pomodoro): tú decides cuándo te interrumpen. Si hay un bloque
        # activo y el aviso NO es de la sesión enfocada, se guarda en la cola
        # (sin popup ni sonido) y el tablero lo muestra al llegar el descanso.
        try:
            with open(os.path.expanduser("~/.claude/hooks/focus.json")) as f:
                focus = json.load(f)
            active = float(focus.get("until") or 0) > time.time()
        except Exception:
            focus, active = None, False
        if active and str(d.get("session", "")) != str(focus.get("session", "")) \
                and str(d.get("project", "")) != str(focus.get("project", "")):
            try:
                with open(os.path.expanduser("~/.claude/hooks/focus-queue.jsonl"), "a") as f:
                    f.write(json.dumps({"ts": time.time(), "title": str(d.get("title", ""))[:200],
                                        "body": str(d.get("body", ""))[:400], "full": str(d.get("full", ""))[:60000],
                                        "session": str(d.get("session", "")), "kind": str(d.get("kind", "done")),
                                        "project": str(d.get("project", ""))[:80]}, ensure_ascii=False) + "\n")
            except OSError:
                pass
            out = b'{"ok": true, "queued": true}'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            self.wfile.write(out)
            return
        # Popups flotantes: SOLO si se piden (POPUPS=1). Por defecto los avisos
        # viven dentro del tablero (pila superior derecha + campana).
        if _conf_value("POPUPS", "0") != "1":
            out = b'{"ok": true, "popup": false}'
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(out)))
            self.end_headers()
            self.wfile.write(out)
            return
        if len(popups) >= 8:   # tope anti screen-spam / DoS de popups
            self.send_response(200)
            self.send_header("Content-Length", "0"); self.end_headers(); return
        GLib.idle_add(native_notify,
                      str(d.get("title", "Claude Code"))[:200],
                      str(d.get("body", ""))[:400],
                      str(d.get("session", "")),
                      str(d.get("kind", "done")),
                      str(d.get("project", ""))[:80],
                      str(d.get("options", ""))[:600],
                      str(d.get("full", ""))[:60000])
        out = b'{"ok": true}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)


def main():
    apply_theme_css()
    if HAVE_NOTIFY:
        try:
            Notify.init("ComandOS")
        except Exception:
            pass
    socketserver.TCPServer.allow_reuse_address = True
    srv = socketserver.ThreadingTCPServer(("127.0.0.1", PORT), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    print(f"cc-notifyd listo en 127.0.0.1:{PORT} (popups propios v3)")
    Gtk.main()


if __name__ == "__main__":
    main()
