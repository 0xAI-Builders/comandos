#!/usr/bin/env python3
"""Popups accionables de Claude Code con diseno propio (sin GNOME notifications).

Ventanas flotantes arriba a la derecha con el design system del Centro Claude.
No roban el foco al aparecer; click en el input para escribir.

Anatomia del popup:
  - Etiqueta de estado (NECESITA RESPUESTA ambar / TERMINO verde)
  - NOMBRE DEL PROYECTO en grande
  - Preview de lo que Claude dijo/pregunta
  - Input de texto: escribe y Enter -> llega al Claude de esa sesion tmux
  - Botones [1][2][3] SOLO si es un prompt de permiso/pregunta numerada;
    [Enter][Esc] en esperas; [Abrir] siempre (tmux + ventana al frente)
  - Click en el nombre del proyecto = Abrir

Recibe eventos de cc-notify.sh:  POST 127.0.0.1:4778/notify
Corre como servicio:             systemctl --user status cc-notifyd
"""
import json, os, re, subprocess, threading, time, urllib.request
import http.server, socketserver
import gi
gi.require_version("Gtk", "3.0")
try:
    gi.require_version("Notify", "0.7")
    from gi.repository import Notify
    HAVE_NOTIFY = True
except Exception:
    Notify, HAVE_NOTIFY = None, False
from gi.repository import Gtk, Gdk, GLib, GdkPixbuf

PORT = 4778
WIDTH = 320
MARGIN = 14
TOP = 48
ALLOWED_KEYS = {"Enter", "Escape", "1", "2", "3"}
SESSION_RE = re.compile(r"^[A-Za-z0-9._-]{1,80}$")


def _ui_lang():
    v = "auto"
    try:
        with open(os.path.expanduser("~/.claude/hooks/cc-notify.conf")) as f:
            for line in f:
                line = line.strip()
                if line.startswith("CC_LANG="):
                    v = line.split("=", 1)[1].strip().strip('"\'')
    except Exception:
        pass
    if v in ("es", "en"):
        return v
    return "es" if os.environ.get("LANG", "").lower().startswith("es") else "en"


UI_LANG = _ui_lang()


def _conf_value(key, default):
    try:
        with open(os.path.expanduser("~/.claude/hooks/cc-notify.conf")) as f:
            for line in f:
                line = line.strip()
                if line.startswith(key + "="):
                    return line.split("=", 1)[1].strip().strip('"\'')
    except Exception:
        pass
    return default


REPO_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
THEMES_FILE = os.path.join(REPO_ROOT, "config", "themes.json")
_theme_cache = {"at": 0.0, "tokens": None}


def theme_tokens():
    """Tokens del tema ACTUAL del tablero (prefs de cc-dash + config/themes.json)."""
    now = time.time()
    if _theme_cache["tokens"] and now - _theme_cache["at"] < 30:
        return _theme_cache["tokens"]
    themes = {}
    try:
        with open(THEMES_FILE) as f:
            themes = json.load(f).get("themes") or {}
    except Exception:
        pass
    name = "noche"
    try:
        name = dash_get("/prefs").get("theme") or "noche"
    except Exception:
        pass
    base = {"bg": "#0A0D13", "panel": "#121722", "panel2": "#161C29", "line": "#222A3A", "line2": "#2E3852",
            "text": "#EAF0FB", "dim": "#9AA6BF", "faint": "#5E6980", "brand": "#8B7CFF",
            "waiting": "#FFAE1A", "done": "#2EE59D", "working": "#7AA5FF"}
    tokens = dict(base, **(themes.get(name) or themes.get("noche") or {}))
    tokens["name"] = name
    _theme_cache.update(at=now, tokens=tokens)
    return tokens


_NOTIF_ICONS = os.path.join(os.path.dirname(os.path.realpath(__file__)),
                            "..", "dash", "icons")


def _icon_image(name, size, color):
    """Icono Lucide (mismo set del tablero) tintado; nada de glifos '?'."""
    try:
        with open(os.path.join(_NOTIF_ICONS, f"{name}.svg"), "rb") as f:
            data = f.read().replace(b"currentColor", color.encode())
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(data); loader.close()
        return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
    except Exception:
        return Gtk.Label(label="•")


