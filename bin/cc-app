# Pomodoro · Notificaciones · Ajustes: viven AQUÍ, a la altura de min/max
# (es la barra siempre visible). Cada uno dispara su control del tablero.
def _dash_click(elem_id):
    def go(*_):
        try:
            # el tablero es el panel izquierdo del paned: si está plegado, se abre
            try:
                if paned.get_position() < 420:
                    paned.set_position(700)
            except Exception:
                pass
            wv.run_javascript(f"try{{document.getElementById('{elem_id}').click()}}catch(e){{}}", None, None, None)
        except Exception:
            pass
    return go

_POPOVERS = {}


def _panel_popover(btn, panel, width, height):
    """Popover nativo pegado al icono con el MISMO panel del tablero
    (index.html?panel=...): mismo tema y mismo código, pero junto al botón."""
    def go(*_):
        pop = _POPOVERS.get(panel)
        if pop is None:
            pop = Gtk.Popover.new(btn)
            pop.set_position(Gtk.PositionType.BOTTOM)
            pop.get_style_context().add_class("cc-popover")
            pv = WebKit2.WebView()
            pv.set_size_request(width, height)
            try:
                pv.set_background_color(Gdk.RGBA(0, 0, 0, 0))
            except Exception:
                pass
            pv.get_settings().set_property("enable-webaudio", True)
            pop.add(pv)
            pop._pv = pv
            _POPOVERS[panel] = pop
        if not getattr(pop, "_loaded", False):
            pop._pv.load_uri(f"{BASE_URL}/?panel={panel}&v={_DASH_V}")
            pop._loaded = True
        else:
            # NO recargar: el pomodoro en curso vive en esta página. Solo refrescar.
            pop._pv.run_javascript("try{typeof pomoRender==='function'&&pomoRender();typeof notifRender==='function'&&notifRender()}catch(e){}", None, None, None)
        pop.show_all()
        pop.popup()
    return go


