        ("Reply to a notification", "Send an instruction to that project"),
        ("/ls  /out  /run  /servers", "Status, screen, run, connect"),
    ]),
]
SHORTCUTS = SHORTCUTS_ES if ES else SHORTCUTS_EN


def show_help(*_):
    if getattr(show_help, "_win", None):
        show_help._win.present()
        return
    w = Gtk.Window(title="Atajos de ComandOS" if ES else "ComandOS shortcuts")
    w.set_transient_for(win)
    w.set_default_size(640, 720)
    w.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    w.get_style_context().add_class("helpwin")
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    outer.set_property("margin", 22)
    title = Gtk.Label(xalign=0)
    title.set_markup("<span size='16000' weight='bold'>" + ("Atajos de teclado" if ES else "Keyboard shortcuts") + "</span>")
    title.get_style_context().add_class("help-h")
    outer.pack_start(title, False, False, 0)
    for section, rows in SHORTCUTS:
        sl = Gtk.Label(xalign=0)
        sl.set_markup(f"<span weight='bold'>{section.upper()}</span>")
        sl.get_style_context().add_class("help-sec")
        sl.set_margin_top(16)
        outer.pack_start(sl, False, False, 0)
        grid = Gtk.Grid()
        grid.set_column_spacing(18); grid.set_row_spacing(7)
        grid.set_margin_top(6)
        for i, (keys, desc) in enumerate(rows):
            k = Gtk.Label(label=keys, xalign=0)
            k.get_style_context().add_class("help-key")
            d = Gtk.Label(label=desc, xalign=0)
            d.get_style_context().add_class("help-desc")
            grid.attach(k, 0, i, 1, 1)
            grid.attach(d, 1, i, 1, 1)
        outer.pack_start(grid, False, False, 0)
    hint = Gtk.Label(xalign=0)
    hint.set_markup("<span size='9000'>" + (
        "Ctrl-b es el 'prefix' de tmux: sueltas y luego tecleas la letra.  "
        "Esc o ? cierra esta ventana." if ES else
        "Ctrl-b is the tmux 'prefix': release it, then type the letter.  "
        "Esc or ? closes this window.") + "</span>")
    hint.get_style_context().add_class("help-hint")
    hint.set_margin_top(20)
    outer.pack_start(hint, False, False, 0)
    scroll.add(outer)
    w.add(scroll)

    def on_help_key(_w, ev):
        if ev.keyval in (Gdk.KEY_Escape, Gdk.KEY_question, Gdk.KEY_F1):
            w.destroy(); return True
        return False
    w.connect("key-press-event", on_help_key)
    w.connect("destroy", lambda *_: setattr(show_help, "_win", None))
    show_help._win = w
    w.show_all()


def on_key(w, e):
    ctrl = e.state & Gdk.ModifierType.CONTROL_MASK
    shift = e.state & Gdk.ModifierType.SHIFT_MASK
    # Ayuda: F1 siempre; '?' solo si el foco NO esta en una terminal
    fw0 = win.get_focus()
    if e.keyval == Gdk.KEY_F1:
        show_help(); return True
    if e.keyval == Gdk.KEY_question and not isinstance(fw0, Vte.Terminal):
        show_help(); return True
    # Clipboard natural cuando el foco esta en una terminal:
    #   Ctrl+V pega; Ctrl+C copia si hay seleccion (si no, interrumpe como siempre)
    fw = win.get_focus()
    # La seleccion con mouse deja el pane en copy-mode (highlight visible).
    # El PRIMER keypress real despues de soltar lo saca: el teclado nunca se
    # atora y la tecla llega a la shell como si nada.
    MODS = (Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
            Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Super_L, Gdk.KEY_Super_R)
    if isinstance(fw, Vte.Terminal) and getattr(fw, "_sel_flag", False) \
            and e.keyval not in MODS:
        fw._sel_flag = False
        exit_copy_mode(fw)
    if ctrl and isinstance(fw, Vte.Terminal):
        if e.keyval in (Gdk.KEY_v, Gdk.KEY_V):
            exit_copy_mode(fw)     # si habia highlight de tmux, salir antes de pegar
            fw.paste_clipboard()
            return True
        if e.keyval in (Gdk.KEY_c, Gdk.KEY_C) and fw.get_has_selection():
            fw.copy_clipboard_format(Vte.Format.TEXT)
            fw.unselect_all()
            return True
    if e.keyval == Gdk.KEY_F12:
        nb.set_visible(not nb.get_visible())
        if nb.get_visible() and cur_term():
            cur_term().grab_focus()
        return True
    if e.keyval == Gdk.KEY_F5:
        wv.load_uri(URL)
        return True
    t = cur_term()
    if t and ctrl and shift and e.keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
        t.set_font_scale(min(2.5, t.get_font_scale() + 0.1)); return True
    if t and ctrl and shift and e.keyval in (Gdk.KEY_minus, Gdk.KEY_underscore, Gdk.KEY_KP_Subtract):
        t.set_font_scale(max(0.5, t.get_font_scale() - 0.1)); return True
    if t and ctrl and shift and e.keyval in (Gdk.KEY_0, Gdk.KEY_parenright):
        t.set_font_scale(1.0); return True
    if ctrl and not shift and e.keyval in (Gdk.KEY_k, Gdk.KEY_K):
        open_switcher(); return True
    if ctrl and not shift and e.keyval in (Gdk.KEY_t, Gdk.KEY_T):
        new_local_tab(); return True
    if ctrl and shift and e.keyval in (Gdk.KEY_w, Gdk.KEY_W):
        page = nb.get_nth_page(nb.get_current_page())
        if page is not None and getattr(page, "_key", None):
            close_tab(page._key)
        return True
    if ctrl and not shift and e.keyval in (Gdk.KEY_q, Gdk.KEY_Q):
        Gtk.main_quit(); return True
    return False


# Super+N y los popups piden foco via cc-dash: escribe app-focus.json y aqui
# enfocamos (o abrimos) la pestana de esa sesion, sin mover clientes de nadie
FOCUS_FILE = os.path.expanduser("~/.claude/hooks/app-focus.json")


def on_focus_request(_mon, _f, _other, event):
    if event != Gio.FileMonitorEvent.CHANGES_DONE_HINT:
        return
    try:
        with open(FOCUS_FILE) as fh:
            d = json.load(fh)
        sess, winname = d.get("session", ""), d.get("win", "claude")
        label = d.get("label", None)
    except Exception:
        return
    if sess and sess not in ("local", "hub", "control"):
        open_tab(sess, winname, label=label if isinstance(label, str) and label else None)
        win.present()


_focus_mon = Gio.File.new_for_path(FOCUS_FILE).monitor_file(Gio.FileMonitorFlags.NONE, None)
_focus_mon.connect("changed", on_focus_request)

win.connect("key-press-event", on_key)
win.connect("destroy", Gtk.main_quit)
win.show_all()
hub._term.grab_focus()
GLib.timeout_add(600, restore_tabs)
threading.Thread(target=poll_state_loop, daemon=True).start()
Gtk.main()
