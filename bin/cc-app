def theme_css(t):
    s = APP_CSS
    for k, v in (("@BAR@", t["bar"]), ("@BG@", t["bg"]), ("@TEXT@", t["text"]),
                 ("@DIM@", t["dim"]), ("@FAINT@", t["faint"]), ("@BRAND@", t["brand"]),
                 ("@LINE@", t["line"]), ("@LINE2@", t["line2"])):
        s = s.replace(k, v)
    return s


def fetch_pref_theme():
    try:
        with urllib.request.urlopen("http://127.0.0.1:4777/prefs", timeout=2) as r:
            return json.loads(r.read().decode()).get("theme", "noche")
    except Exception:
        return "noche"


THEME = THEMES.get(fetch_pref_theme(), THEMES["noche"])


def rgba(h):
    c = Gdk.RGBA()
    c.parse(h)
    return c


def tmuxc(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=5)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def http_post(path, payload, timeout=15):
    req = urllib.request.Request(
        "http://127.0.0.1:4777" + path,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode()), None
    except urllib.error.HTTPError as e:
        try:
            return None, json.loads(e.read().decode()).get("error", str(e))
        except Exception:
            return None, str(e)
    except Exception as e:
        return None, str(e)


def http_ensure(sess, win_name="claude"):
    http_post("/ensure", {"session": sess, "win": win_name})


URL_RE = r"https?://[^\s'\"<>\]\)]+"


def normalize_wrapped_url_text(text):
    """Join visual terminal wraps that split a URL across rows."""
    pat = r"https?://(?:[^\s'\"<>\]\)]+|[ \t]*\r?\n[ \t]*[^\s'\"<>\]\)]+)+"
    return re.sub(pat, lambda m: re.sub(r"[ \t]*\r?\n[ \t]*", "", m.group(0)), text or "")


def url_from_wrapped_text(text, fragment="", row=None, col=None):
    pat = r"https?://(?:[^\s'\"<>\]\)]+|[ \t]*\r?\n[ \t]*[^\s'\"<>\]\)]+)+"
    point = None
    if row is not None and col is not None:
        lines = (text or "").splitlines(True)
        if 0 <= row < len(lines):
            point = sum(len(lines[i]) for i in range(row)) + min(max(col, 0), len(lines[row]))
    frag = normalize_wrapped_url_text(fragment or "").strip()
    matches = list(re.finditer(pat, text or ""))
    for m in matches:
        url = re.sub(r"[ \t]*\r?\n[ \t]*", "", m.group(0))
        if frag and (frag in url or url in frag):
            return url
        if point is not None and m.start() <= point < m.end():
            return url
    if not frag and point is None and len(matches) == 1:
        return re.sub(r"[ \t]*\r?\n[ \t]*", "", matches[0].group(0))
    return frag


def cell_at_event(term, event):
    cw = max(1, int(term.get_char_width() or 1))
    ch = max(1, int(term.get_char_height() or 1))
    x = max(0, int(event.x) - int(term.get_margin_start()))
    y = max(0, int(event.y) - int(term.get_margin_top()))
    col = min(max(0, x // cw), max(0, int(term.get_column_count() or 1) - 1))
    top = 0
    adj = term.get_vadjustment()
    if adj:
        top = int((adj.get_value() or 0) // ch) if term.get_scroll_unit_is_pixels() else int(adj.get_value() or 0)
    return top + (y // ch), col


def url_at_event(term, event, match=""):
    try:
        row, col = cell_at_event(term, event)
        cols = max(1, int(term.get_column_count() or 1))
        start = max(0, row - 2)
        text, _attrs = term.get_text_range(start, 0, row + 3, cols, None, None)
        url = url_from_wrapped_text(text or "", match or "", row - start, col)
        if url:
            return url
    except Exception:
        pass
    return normalize_wrapped_url_text(match or "")


def ssh_host_from_session(sess):
    if not isinstance(sess, str):
        return None
    if sess.startswith("ssh-"):
        return sess[4:] or None
    if sess.startswith("sshtab-"):
        host, sep, idx = sess[len("sshtab-"):].rpartition("-")
        if sep and idx.isdigit() and host:
            return host
    return None


def make_term(argv_sh):
    term = Vte.Terminal()
    term.set_font(Pango.FontDescription(FONT))
    term.set_colors(rgba(THEME["fg"]), rgba(THEME["bg"]), [rgba(p) for p in THEME["pal"]])
    term.set_color_cursor(rgba(THEME["cursor"]))
    term.set_scrollback_lines(10000)
    term.set_audible_bell(False)
    term.connect("button-press-event", on_term_button)
    term.connect("button-release-event", on_term_release)
    # Seleccionar = copiar al clipboard del sistema (portapapeles compartido)
    term.connect("selection-changed", lambda t: t.get_has_selection()
                 and t.copy_clipboard_format(Vte.Format.TEXT))
    # URLs clickeables: click simple (sin arrastre) o Ctrl+click, con manita
    try:
        rx = Vte.Regex.new_for_match(URL_RE, -1, 0x00000400)  # PCRE2_MULTILINE
        tag = term.match_add_regex(rx, 0)
        try:
            term.match_set_cursor_name(tag, "pointer")
        except Exception:
            pass
    except Exception:
        pass
    # Padding comodo alrededor del texto
    term.set_margin_start(10); term.set_margin_end(4)
    term.set_margin_top(8); term.set_margin_bottom(6)

    def spawn(*_):
        try:
            res = term.spawn_sync(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"),
                                  ["/bin/sh", "-c", argv_sh], [],
                                  GLib.SpawnFlags.DEFAULT, None, None, None)
            # tty del hijo: nos dice que cliente tmux es esta pestana
            pid = res[1] if isinstance(res, (tuple, list)) and len(res) > 1 else None
            if pid:
                try:
                    term._tty = os.readlink(f"/proc/{pid}/fd/0")
                except Exception:
                    pass
        except Exception as e:
            print(f"terminal fallo: {e}")
        return False

    term._respawn = True
    term.connect("child-exited", lambda *_: term._respawn and GLib.timeout_add(800, spawn))
    spawn()
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.get_style_context().add_class("termwrap")
    sb = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL,
                       adjustment=term.get_vadjustment())
    box.pack_start(term, True, True, 0)
    box.pack_start(sb, False, False, 0)
    box._term = term
    return box


def feed(term, seq):
    try:
        term.feed_child(seq)
    except TypeError:
        term.feed_child(seq.decode("latin1"), len(seq))


def new_session_dialog(*_):
    dlg = Gtk.Dialog(title="Nueva sesion" if ES else "New session", transient_for=win)
    dlg.add_buttons("Cancelar" if ES else "Cancel", Gtk.ResponseType.CANCEL,
                    "Abrir" if ES else "Open", Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_property("margin", 14); box.set_spacing(8)
    lbl = Gtk.Label(label=("Proyecto de ~/codebase (abre su Claude),\no cualquier nombre (terminal en blanco):" if ES else
                           "A ~/codebase project (opens its Claude),\nor any name (blank terminal):"), xalign=0)
    box.add(lbl)
    entry = Gtk.Entry()
    entry.set_placeholder_text("nombre..." if ES else "name...")
    entry.set_activates_default(True)
    dlg.set_default_response(Gtk.ResponseType.OK)
    box.add(entry)
    err = Gtk.Label(xalign=0); err.get_style_context().add_class("dim-error")
    box.add(err)
    dlg.show_all()
    while dlg.run() == Gtk.ResponseType.OK:
        name = entry.get_text().strip().replace(".", "-").replace(":", "-")
        if not name:
            continue
        res, e = http_post("/new", {"session": name})
        if e:
            err.set_text("⚠ " + e)   # ahora el error se VE, no falla en silencio
            continue
        # el server pudo resolver a la sesion real (claude en pestana term-*)
        open_tab((res or {}).get("session") or name, "claude")
        break
    dlg.destroy()


def term_session(term):
    """Sesion tmux que muestra esta pestana (por el tty de su cliente)."""
    tty = getattr(term, "_tty", None)
    if not tty:
        return None
    r = tmuxc("list-clients", "-F", "#{client_tty}|#{client_session}")
    for l in r.stdout.splitlines():
        t, _, s = l.partition("|")
        if t == tty:
            return s
    return None


def pane_at(term, event):
    """(pane_id, total_panes) del pane bajo el cursor del mouse."""
    sess = term_session(term)
    if not sess:
        return None, 0
    col = int((event.x - 10) // max(1, term.get_char_width()))
    row = int((event.y - 8) // max(1, term.get_char_height()))
    r = tmuxc("list-panes", "-t", "=" + sess + ":",
              "-F", "#{pane_id}|#{pane_left}|#{pane_top}|#{pane_right}|#{pane_bottom}")
    panes = [l.split("|") for l in r.stdout.splitlines() if l and l.count("|") == 4]
    for pid, l, t, rr, b in panes:
        if int(l) <= col <= int(rr) and int(t) <= row <= int(b):
            return pid, len(panes)
    return None, len(panes)


def notify_popup(title, body):
    """Feedback visible via el demonio de popups (se autocierra en 12s)."""
    try:
        req = urllib.request.Request(
            "http://127.0.0.1:4778/notify",
            data=json.dumps({"title": title, "body": body, "kind": "done",
                             "project": title, "session": "local"}).encode(),
            headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=3)
    except Exception:
        pass


def export_claude_reply(term, fmt):
    """Guarda la ultima respuesta de Claude de esta sesion como .txt o PDF
    (lo genera cc-dash en ~/Descargas, lo abre, y AVISA donde quedo)."""
    sess = term_session(term)
    if not sess:
        return
    res, err = http_post("/export", {"session": sess, "format": fmt}, timeout=45)
    if err:
        notify_popup("No se pudo guardar" if ES else "Could not save", err)
    else:
        notify_popup("Respuesta guardada" if ES else "Reply saved", (res or {}).get("path", ""))


def copy_claude_reply(term):
    """Copia al clipboard la ULTIMA respuesta de Claude de esta sesion (el
    texto completo que guardan los hooks), sin andar seleccionando a mano."""
    sess = term_session(term)
    if not sess:
        return
    try:
        with urllib.request.urlopen("http://127.0.0.1:4777/state", timeout=3) as r:
            items = json.loads(r.read().decode())
    except Exception:
        return
    for it in items:
        if it.get("session") == sess and (it.get("detail") or it.get("last")):
            txt = it.get("detail") or it["last"]
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(txt, -1)
            notify_popup("Respuesta copiada" if ES else "Reply copied",
                         (f"{len(txt)} caracteres al portapapeles ({it.get('project')})" if ES else
                          f"{len(txt)} characters copied ({it.get('project')})"))
            return
    notify_popup("Sin respuesta guardada" if ES else "No reply captured",
                 "Esta sesion aun no tiene una respuesta capturada por los hooks" if ES else
                 "This session has no hook-captured reply yet")


def exit_copy_mode(term):
    """Si el pane activo esta en modo copia (highlight de tmux), salir para que
    el paste entre como TEXTO y no como teclas del modo copia."""
    sess = term_session(term)
    if sess:
        r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_in_mode}")
        if r.stdout.strip() == "1":
            tmuxc("send-keys", "-t", f"={sess}:", "-X", "cancel")


def open_url(url):
    subprocess.Popen(["xdg-open", url], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def on_term_release(term, event):
    """Al soltar el mouse: 1) si fue un CLICK limpio sobre una URL, abrirla;
    2) marcar que pudo quedar seleccion tmux (el primer keypress la limpia)."""
    press = getattr(term, "_url_press", None)
    term._url_press = None
    term._sel_flag = True
    if press and event.button == 1:
        x, y, url = press
        if url and abs(event.x - x) < 5 and abs(event.y - y) < 5 \
                and not term.get_has_selection():
            open_url(url)
    return False


def on_term_button(term, event):
    # Ctrl+click en una URL: abrirla directo
    if event.button == 1 and (event.state & Gdk.ModifierType.CONTROL_MASK):
        try:
            match, _tag = term.match_check_event(event)
            url = url_at_event(term, event, match or "")
            if url:
                open_url(url)
                return True
        except Exception:
            pass
        return False
    # Click simple: recordar si cayo sobre una URL; se abre al SOLTAR solo si
    # no hubo arrastre (para no interferir con seleccionar texto)
    if event.button == 1:
        try:
            match, _tag = term.match_check_event(event)
            url = url_at_event(term, event, match or "")
        except Exception:
            url = None
        term._url_press = (event.x, event.y, url) if url else None
        return False
    if event.button != 3:
        return False
    box = term.get_parent()
    menu = Gtk.Menu()

    def item(label, cb, sensitive=True):
        it = Gtk.MenuItem(label=label)
        it.connect("activate", lambda *_: cb())
        it.set_sensitive(sensitive)
        menu.append(it)

    key = getattr(box, "_key", None)
    cur_sess = term_session(term)          # sesion realmente mostrada (hub incluido)
    pane_id, npanes = pane_at(term, event)  # pane bajo el cursor
    ssh_host = ssh_host_from_session(cur_sess)
    is_ssh = bool(ssh_host)

    def split(flags, cmd=None):
        target = pane_id or (("=" + cur_sess + ":") if cur_sess else None)
        if not target:
            return
        args = ["split-window"] + flags + ["-t", target]
        if cmd:
            args.append(cmd)
        else:
            r = tmuxc("display-message", "-p", "-t", target, "#{pane_current_path}")
            cwd = r.stdout.strip()
            if cwd:
                args += ["-c", cwd]
        tmuxc(*args)

    # Hay DOS tipos de seleccion: la de la terminal (VTE, con Shift+arrastrar)
    # y la de tmux (arrastrar normal, es la que persiste). Copiar cubre ambas.
    in_copy = False
    if pane_id:
        rm = tmuxc("display-message", "-p", "-t", pane_id, "#{pane_in_mode}")
        in_copy = rm.stdout.strip() == "1"

    def do_copy():
        if term.get_has_selection():
            term.copy_clipboard_format(Vte.Format.TEXT)
        elif in_copy and pane_id:
            tmuxc("send-keys", "-t", pane_id, "-X", "copy-pipe-no-clear",
                  "xclip -in -selection clipboard 2>/dev/null")

    item(("Copiar                   Ctrl+C" if ES else "Copy                     Ctrl+C"), do_copy,
         sensitive=term.get_has_selection() or in_copy)
    item(("Pegar                    Ctrl+V" if ES else "Paste                    Ctrl+V"),
         lambda: (exit_copy_mode(term), term.paste_clipboard()))
    item("Copiar respuesta de Claude" if ES else "Copy Claude's reply", lambda: copy_claude_reply(term))
    item("Guardar respuesta como .txt" if ES else "Save reply as .txt", lambda: export_claude_reply(term, "txt"))
    item("Guardar respuesta como PDF" if ES else "Save reply as PDF", lambda: export_claude_reply(term, "pdf"))
    menu.append(Gtk.SeparatorMenuItem())
    if is_ssh:
        host = ssh_host
        sshcmd = f"ssh {host}"
        item("Split derecha    (otra conexion al server)" if ES else "Split right    (new connection to server)", lambda: split(["-h"], sshcmd))
        item("Split izquierda  (otra conexion al server)" if ES else "Split left     (new connection to server)", lambda: split(["-h", "-b"], sshcmd))
        item("Split abajo      (otra conexion al server)" if ES else "Split down     (new connection to server)", lambda: split(["-v"], sshcmd))
        item("Split arriba     (otra conexion al server)" if ES else "Split up       (new connection to server)", lambda: split(["-v", "-b"], sshcmd))
        item("Split local (tu maquina, derecha)" if ES else "Local split (your machine, right)", lambda: split(["-h"]))
    else:
        item("Split derecha" if ES else "Split right", lambda: split(["-h"]))
        item("Split izquierda" if ES else "Split left", lambda: split(["-h", "-b"]))
        item("Split abajo" if ES else "Split down", lambda: split(["-v"]))
        item("Split arriba" if ES else "Split up", lambda: split(["-v", "-b"]))
    item("Alternar ventana 1/2     Ctrl-b l" if ES else "Toggle window 1/2        Ctrl-b l", lambda: feed(term, b"\x02l"))
    item("Cerrar ESTE split" if ES else "Close THIS split",
         lambda: tmuxc("kill-pane", "-t", pane_id),
         sensitive=bool(pane_id) and npanes > 1)
    menu.append(Gtk.SeparatorMenuItem())
    item("Nueva terminal aqui       Ctrl+T" if ES else "New terminal here         Ctrl+T", new_local_tab)
    item("Abrir proyecto..." if ES else "Open project...", new_session_dialog)
    sub = Gtk.Menu()
    r = tmuxc("list-sessions", "-F", "#{session_name}")
    for s in (r.stdout.split() if r.returncode == 0 else []):
        si = Gtk.MenuItem(label=s)
        si.connect("activate", lambda _w, s=s: open_tab(s, "claude"))
        sub.append(si)
    mi = Gtk.MenuItem(label="Abrir sesion existente" if ES else "Open existing session")
    mi.set_submenu(sub)
    menu.append(mi)
    menu.append(Gtk.SeparatorMenuItem())
    key = getattr(box, "_key", None)
    item("Renombrar pestana..." if ES else "Rename tab...", lambda: rename_tab(key), sensitive=key is not None)
    item("Cerrar pestana" if ES else "Close tab", lambda: close_tab(key), sensitive=key is not None)
    menu.show_all()
    menu.popup_at_pointer(event)
    term._menu = menu
    return True


win = Gtk.Window(title="ComandOS")
win.set_default_size(1600, 880)
win.set_icon_name("centro-claude")

nb = Gtk.Notebook()
nb.set_scrollable(True)
tabs = {}   # clave ("sess" o "sess:shell") -> box
TABS_FILE = os.path.expanduser("~/.claude/hooks/app-tabs.json")
TAB_HISTORY_FILE = os.path.expanduser("~/.claude/hooks/app-tabs-history.json")


def save_tabs():
    try:
        with open(TABS_FILE, "w") as f:
            json.dump({k: getattr(b, "_label", None) for k, b in tabs.items()}, f)
    except Exception:
        pass


def saved_tab_label(key):
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict) and isinstance(data.get(key), str) and data.get(key):
            return data[key]
    except Exception:
        pass
    return None


def archive_tab(key, reason="closed"):
    if not key:
        return
    box = tabs.get(key)
    label = getattr(box, "_label", key) if box is not None else key
    it = STATE_ITEMS.get(key, {})
    cwd = it.get("cwd", "")
    agent = it.get("agent", "")
    if not cwd:
        r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_path}")
        if r.returncode == 0:
            cwd = r.stdout.strip()
    if not agent:
        r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_command}")
        cmd = r.stdout.strip() if r.returncode == 0 else ""
        agent = "codex" if cmd == "node" else cmd if cmd in {"claude", "opencode", "gemini", "agy", "aider"} else "claude"
    item = {"session": key, "label": label, "cwd": cwd, "agent": agent,
            "reason": reason, "ts": int(time.time())}
    try:
        with open(TAB_HISTORY_FILE) as f:
            hist = json.load(f)
        if not isinstance(hist, list):
            hist = []
    except Exception:
        hist = []
    hist = [h for h in hist if not isinstance(h, dict) or h.get("session") != key]
    tmp = TAB_HISTORY_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump([item] + hist[:79], f)
    os.replace(tmp, TAB_HISTORY_FILE)


def restore_tabs():
    """Al abrir la app, reabre las pestanas de la vez pasada (con su nombre);
    si una sesion murio (p.ej. reinicio), la revive (claude --continue /
    reconexion ssh)."""
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
    except Exception:
        return False
    if isinstance(data, list):    # formato viejo: lista de claves sin etiqueta
        data = {k: None for k in data if isinstance(k, str)}
    if not isinstance(data, dict):
        return False
    for key, label in data.items():
        if not isinstance(key, str) or not key:
            continue
        # claves viejas "sesion:ventana" colapsan a la sesion (una pestana por sesion)
        sess = key.partition(":")[0]
        if sess in tabs:
            continue
        try:
            if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                              capture_output=True, timeout=5).returncode != 0:
                ssh_host = ssh_host_from_session(sess)
                if sess.startswith("term-"):
                    # terminal scratch: recrear shell simple en HOME
                    subprocess.run(
                        ["systemd-run", "--user", "--scope", "--collect", "--quiet",
                         "tmux", "new-session", "-d", "-s", sess, "-c", os.path.expanduser("~")],
                        capture_output=True, timeout=12)
                elif ssh_host and sess.startswith("ssh-"):
                    http_post("/ssh-connect", {"host": ssh_host}, timeout=20)
                elif ssh_host:
                    res, e = http_post("/ssh-new-tab", {"host": ssh_host}, timeout=20)
                    if e:
                        raise RuntimeError(e)
                    if isinstance(res, dict) and res.get("session"):
                        sess = res["session"]
                        label = res.get("label") or label
                else:
                    http_post("/new", {"session": sess})
            open_tab(sess, "claude", label=label if isinstance(label, str) and label else None)
        except Exception as e:
            print(f"no pude restaurar {key}: {e}")
    return False


# Punto de estado por pestana: el color se procesa ANTES de leer el nombre
# (ambar: espera tu respuesta / azul: trabajando / verde: listo)
DOT_COLORS = {"waiting": "#FFAE1A", "working": "#7AA5FF",
              "done": "#2EE59D", "dead": "#FF6B6B"}
DOT_IDLE = "#39445C"
STATE_CACHE = {}   # session -> status (lo alimenta el poller de /state)
STATE_ITEMS = {}   # session -> item completo de /state para el switcher


def tab_label(text, key=None, closable=True):
    hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    dot = Gtk.Label()
    dot.set_markup(f'<span size="8500" foreground="{DOT_IDLE}">●</span>')
    hb.pack_start(dot, False, False, 0)
    lbl = Gtk.Label(label=text)
    hb.pack_start(lbl, False, False, 0)
    hb._dot = dot
    hb._text = lbl
    if closable:
        b = Gtk.Button(label="×")
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.connect("clicked", lambda *_: close_tab(key))
        hb.pack_start(b, False, False, 0)
    hb.show_all()
    return hb


def update_dots(states, items=None):
    STATE_CACHE.clear()
    STATE_CACHE.update(states)
    if items is not None:
        STATE_ITEMS.clear()
        STATE_ITEMS.update({it.get("session"): it for it in items if it.get("session")})
    for key, box in tabs.items():
        hb = nb.get_tab_label(box)
        dot = getattr(hb, "_dot", None)
        if dot is None:
            continue
        c = DOT_COLORS.get(states.get(key, ""), DOT_IDLE)
        dot.set_markup(f'<span size="8500" foreground="{c}">●</span>')
    return False


def poll_state_loop():
    while True:
        try:
            with urllib.request.urlopen("http://127.0.0.1:4777/state", timeout=3) as r:
                items = json.loads(r.read().decode())
            states = {it["session"]: it.get("status", "idle")
                      for it in items if it.get("session")}
            GLib.idle_add(update_dots, states, items)
        except Exception:
            pass
        time.sleep(3)


def close_tab(key):
    archive_tab(key, reason="closed")
    box = tabs.pop(key, None)
    if box is not None:
        box._term._respawn = False
        nb.remove_page(nb.page_num(box))
    save_tabs()
    # Scratch (term-*) con puro shell ocioso: cerrar la pestana MATA la sesion
    # (adios sesiones fantasma). Si algo corre adentro (vite, claude, ssh...),
    # la sesion sobrevive como siempre.
    if key and key.startswith("term-"):
        r = tmuxc("list-panes", "-s", "-t", "=" + key, "-F", "#{pane_current_command}")
        cmds = set(r.stdout.split())
        if r.returncode == 0 and cmds and cmds <= {"zsh", "bash", "sh", "fish"}:
            tmuxc("kill-session", "-t", "=" + key)


def current_cwd():
    """Directorio del pane activo de la pestana actual (para 'nueva terminal aqui')."""
    page = nb.get_nth_page(nb.get_current_page())
    term = getattr(page, "_term", None)
    if term:
        sess = term_session(term)
        if sess:
            r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_current_path}")
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
    return os.path.expanduser("~")


TERM_N = [0]


def new_local_tab(*_):
    """Nueva pestana de terminal en el MISMO directorio donde esta el cursor."""
    cwd = current_cwd()
    TERM_N[0] += 1
    sess = f"term-{os.getpid() % 10000}-{TERM_N[0]}"
    subprocess.run(
        ["systemd-run", "--user", "--scope", "--collect", "--quiet",
         "tmux", "new-session", "-d", "-s", sess, "-c", cwd],
        capture_output=True, timeout=12)
    open_tab(sess, "claude", label=os.path.basename(cwd) or "term")


WIN_RE = re.compile(r"^[A-Za-z0-9_-]{1,32}$")


def select_win(sess, winname):
    """Selecciona la ventana pedida. Si 'claude' ya no se llama asi (claude
    murio o relanzado y tmux renombro la ventana), busca donde corre claude
    de verdad; si en ninguna, la primera ventana — nunca el shell perdido."""
    if tmuxc("select-window", "-t", f"={sess}:{winname}").returncode == 0:
        return
    if winname != "claude":
        return
    r = tmuxc("list-panes", "-s", "-t", "=" + sess,
              "-F", "#{window_index}|#{pane_current_command}")
    for l in r.stdout.splitlines():
        idx, _, cmd = l.partition("|")
        if cmd == "claude":
            tmuxc("select-window", "-t", f"={sess}:{idx}")
            return
    tmuxc("select-window", "-t", f"={sess}:^")


def open_tab(sess, winname, label=None):
    """Abre (o enfoca) LA pestana de una sesion tmux; winname elige que ventana
    (claude/shell/ssh) se muestra."""
    if not WIN_RE.match(winname or ""):
        winname = "claude"
    key = sess
    if ssh_host_from_session(sess):
        tmuxc("set-option", "-t", sess, "mouse", "off")
    if key in tabs:
        select_win(sess, winname)
        nb.set_current_page(nb.page_num(tabs[key]))
        tabs[key]._term.grab_focus()
        return
    select_win(sess, winname)
    cmd = (f"tmux attach -t '={sess}' || {{ echo '[sesion terminada — cierra esta pestana con la x]'; exec cat; }}")
    box = make_term(cmd)
    box._key = key
    box._label = label or saved_tab_label(sess) or sess
    idx = nb.append_page(box, tab_label(box._label, key))
    box.show_all()
    nb.set_current_page(idx)
    box._term.grab_focus()
    tabs[key] = box
    save_tabs()


def set_tab_label(box, text):
    box._label = text
    hb = nb.get_tab_label(box)
    if hb is not None and getattr(hb, "_text", None) is not None:
        hb._text.set_text(text)
    save_tabs()


def fuzzy_score(q, s):
    """None si no matchea; menor = mejor (subsecuencia con saltos penalizados)."""
    q, s = q.lower(), s.lower()
    score, pos = 0, 0
    for ch in q:
        i = s.find(ch, pos)
        if i < 0:
            return None
        score += i - pos
        pos = i + 1
    return score + len(s) * 0.01


SW_ORDER = {"waiting": 0, "done": 1, "working": 2}
SW_HINT = ({"waiting": "espera TU respuesta", "working": "trabajando", "done": "listo"} if ES else
           {"waiting": "waiting for YOU", "working": "working", "done": "done"})


def open_switcher(*_):
    """Ctrl+K: saltar a cualquier pestana/sesion escribiendo 2-3 letras.
    Las que ESPERAN tu respuesta salen arriba; Enter va a la primera."""
    if getattr(open_switcher, "_win", None):
        open_switcher._win.present()
        return
    w = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    w.set_transient_for(win)
    w.set_modal(True)
    w.set_decorated(False)
    w.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    w.set_default_size(560, -1)
    w.get_style_context().add_class("switcher")
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    v.set_property("margin", 12)
    entry = Gtk.Entry()
    entry.set_placeholder_text("Salta a...  (parte del nombre, Enter va a la primera)" if ES else
                                "Jump to...  (type part of a name, Enter opens the first)")
    v.pack_start(entry, False, False, 0)
    lb = Gtk.ListBox()
    lb.set_activate_on_single_click(True)
    v.pack_start(lb, True, True, 0)
    w.add(v)
    rows = []

    def candidates():
        out, seen = [], set()
        for key, box in tabs.items():
            out.append((getattr(box, "_label", key), key, True))
            seen.add(key)
        for s, it in STATE_ITEMS.items():
            if s in seen or s == "local" or it.get("alive") is False or it.get("zombie"):
                continue
            orphan_term = s.startswith("term-") and not it.get("tabbed") and \
                not it.get("agent") and it.get("status", "idle") == "idle"
            if orphan_term:
                continue
            out.append((it.get("project") or s, s, False))
        return out

    def refill(*_):
        for ch in lb.get_children():
            lb.remove(ch)
        rows.clear()
        q = entry.get_text().strip()
        scored = []
        for label, key, is_open in candidates():
            sc = fuzzy_score(q, f"{label} {key}") if q else 0
            if sc is None:
                continue
            st = STATE_CACHE.get(key, "")
            scored.append((SW_ORDER.get(st, 3), sc, label.lower(), label, key, st, is_open))
        scored.sort()
        for _, _, _, label, key, st, is_open in scored[:12]:
            r = Gtk.ListBoxRow()
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            h.set_property("margin", 7)
            d = Gtk.Label()
            d.set_markup(f'<span size="9000" foreground="{DOT_COLORS.get(st, DOT_IDLE)}">●</span>')
            h.pack_start(d, False, False, 0)
            h.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            hint = SW_HINT.get(st, "") + ("" if is_open else ("   [abrir]" if ES else "   [open]"))
            m = Gtk.Label(label=hint.strip(), xalign=1)
            m.get_style_context().add_class("sw-meta")
            h.pack_end(m, False, False, 0)
            r.add(h)
            lb.add(r)
            rows.append((r, key))
        lb.show_all()
        if rows:
            lb.select_row(rows[0][0])

    def go(row):
        for r, key in rows:
            if r is row:
                w.destroy()
                open_tab(key, "claude")
                return

    def move_sel(delta):
        sel = lb.get_selected_row()
        idx = next((i for i, (r, _) in enumerate(rows) if r is sel), 0)
        idx = max(0, min(len(rows) - 1, idx + delta))
        if rows:
            lb.select_row(rows[idx][0])

    def on_sw_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            w.destroy()
            return True
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            sel = lb.get_selected_row()
            if sel:
                go(sel)
            return True
        if ev.keyval == Gdk.KEY_Down:
            move_sel(1)
            return True
        if ev.keyval == Gdk.KEY_Up:
            move_sel(-1)
            return True
        return False

    lb.connect("row-activated", lambda _l, row: go(row))
    entry.connect("changed", refill)
    w.connect("key-press-event", on_sw_key)
    w.connect("destroy", lambda *_: setattr(open_switcher, "_win", None))
    open_switcher._win = w
    refill()
    w.show_all()
    entry.grab_focus()


def rename_tab(key):
    box = tabs.get(key)
    if box is None:
        return
    dlg = Gtk.Dialog(title="Renombrar pestana" if ES else "Rename tab", transient_for=win)
    dlg.add_buttons("Cancelar" if ES else "Cancel", Gtk.ResponseType.CANCEL,
                    "Renombrar" if ES else "Rename", Gtk.ResponseType.OK)
    area = dlg.get_content_area()
    area.set_property("margin", 14); area.set_spacing(8)
    area.add(Gtk.Label(label="Nombre de la pestana:" if ES else "Tab name:", xalign=0))
    entry = Gtk.Entry()
    entry.set_text(getattr(box, "_label", key))
    entry.set_activates_default(True)
    area.add(entry)
    dlg.set_default_response(Gtk.ResponseType.OK)
    dlg.show_all()
    entry.grab_focus()
    if dlg.run() == Gtk.ResponseType.OK:
        name = entry.get_text().strip()
        if name:
            set_tab_label(box, name)
    dlg.destroy()


# Estilo propio de la app (pestanas, scrollbars, separadores), tematizable
_prov = Gtk.CssProvider()
_prov.load_from_data(theme_css(THEME).encode())
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), _prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def apply_theme(name):
    """Cambia el tema EN CALIENTE: chrome GTK + colores de TODAS las
    terminales abiertas (lo dispara el boton de tema del tablero)."""
    global THEME
    THEME = THEMES.get(name, THEMES["noche"])
    _prov.load_from_data(theme_css(THEME).encode())
    for i in range(nb.get_n_pages()):
        t = getattr(nb.get_nth_page(i), "_term", None)
        if t:
            t.set_colors(rgba(THEME["fg"]), rgba(THEME["bg"]),
                         [rgba(p) for p in THEME["pal"]])
            t.set_color_cursor(rgba(THEME["cursor"]))

# Pestana "local": tu terminal de control (scratch en HOME). Es el cliente que
# mueven Super+N y los popups. No aparece como tarjeta en el tablero.
hub = make_term("tmux new-session -A -s local -c ~")
nb.append_page(hub, tab_label("⌂ local", closable=False))

