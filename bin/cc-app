def theme_css(t):
    s = APP_CSS
    for k, v in (("@BAR@", t["bar"]), ("@BG@", t["bg"]), ("@TEXT@", t["text"]),
                 ("@DIM@", t["dim"]), ("@FAINT@", t["faint"]), ("@BRAND@", t["brand"]),
                 ("@LINE@", t["line"]), ("@LINE2@", t["line2"])):
        s = s.replace(k, v)
    return s


def fetch_prefs():
    """Lee TODAS las prefs de cc-dash. Blocking pero con timeout corto — solo
    se usa al arrancar. Fallback a defaults si cc-dash aún no responde."""
    try:
        with urllib.request.urlopen("http://127.0.0.1:4777/prefs", timeout=2) as r:
            return json.loads(r.read().decode())
    except Exception:
        return {}


def fetch_pref_theme():
    return (fetch_prefs().get("theme") or "noche")


PREFS = fetch_prefs()
THEME = THEMES.get(PREFS.get("theme", "noche"), THEMES["noche"])

