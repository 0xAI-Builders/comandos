    b" color:#FFFFFF;background:alpha(#E82D3C, 0.65);"
    b"}"
    # ---- Dialogos genericos (.cc-dialog) — MessageDialog + Gtk.Dialog ----
    # Todo lo que muestre new_session_dialog, rename_tab, close_tab confirm.
    # Sin esto salen con Adwaita default (fondo claro, boton "Yes/No" gris).
    b".cc-dialog,.cc-dialog window,.cc-dialog messagedialog,"
    b".cc-dialog .background,.cc-dialog .dialog-vbox{"
    b" background:" + THEME["bg"].encode() + b";"
    b" color:" + THEME["text"].encode() + b";"
    b"}"
    b".cc-dialog,.cc-dialog decoration{"
    b" border:1px solid " + THEME["line"].encode() + b";"
    b" border-radius:10px;"
    b" box-shadow:0 20px 60px rgba(0,0,0,.45);"
    b"}"
    b".cc-dialog box,.cc-dialog .horizontal,.cc-dialog .vertical,"
    b".cc-dialog .dialog-action-box,.cc-dialog .action-area,"
    b".cc-dialog headerbar,.cc-dialog scrolledwindow,.cc-dialog viewport{"
    b" background:transparent;color:" + THEME["text"].encode() + b";"
    b"}"
    b".cc-dialog label{color:" + THEME["text"].encode() + b";}"
    b".cc-dialog label.dim-error{color:" + THEME["cursor"].encode() + b";font-size:11px;}"
    b".cc-dialog entry{"
    b" background:" + THEME["bar"].encode() + b";"
    b" color:" + THEME["text"].encode() + b";"
    b" border:1px solid " + THEME["line"].encode() + b";"
    b" border-radius:6px;padding:6px 10px;"
    b" caret-color:" + THEME["brand"].encode() + b";"
    b"}"
    b".cc-dialog entry:focus{border-color:" + THEME["brand"].encode() + b";outline:none;box-shadow:none;}"
    b".cc-dialog entry selection{background:" + THEME["line"].encode() + b";color:" + THEME["text"].encode() + b";}"
    b".cc-dialog button{"
    b" background:" + THEME["bar"].encode() + b";background-image:none;"
    b" color:" + THEME["text"].encode() + b";"
    b" border:1px solid " + THEME["line"].encode() + b";"
    b" border-radius:6px;padding:7px 18px;box-shadow:none;text-shadow:none;"
    b" font-family:'JetBrainsMono Nerd Font Mono',monospace;font-size:12px;"
    b" margin:0 8px;"
    b"}"
    b".cc-dialog button:hover{border-color:" + THEME["brand"].encode() + b";}"
    b".cc-dialog button:focus{outline:none;box-shadow:none;border-color:" + THEME["brand"].encode() + b";}"
    b".cc-dialog button.suggested-action{"
    b" background:" + THEME["brand"].encode() + b";"
    b" color:" + THEME["bg"].encode() + b";"
    b" border-color:" + THEME["brand"].encode() + b";"
    b"}"
    # `.default` es CSS class en GTK3 (no pseudo-class). Sutil border-color
    # para senalar el default sin repintar todo con brand ("No" en naranja
    # confunde visualmente).
    b".cc-dialog button.default{"
    b" border-color:" + THEME["brand"].encode() + b";"
    b"}"
    # MessageDialog: iconito y textos primarios/secundarios
    b".cc-dialog .message-area,.cc-dialog .dialog-vbox > box{"
    b" background:transparent;padding:14px 18px;"
    b"}"
    # Spacing entre botones va como margin lateral de cada boton (arriba).
    # GTK3 CSS no soporta `border-spacing` en GtkBox, y `-GtkBox-spacing` es
    # deprecated. margin:0 8px por boton = 16px de gap efectivo entre pares.
    b".cc-dialog .dialog-action-box,.cc-dialog .action-area{"
    b" border-top:1px solid " + THEME["line"].encode() + b";"
    b" padding:10px 12px;"
    b"}"
    b".cc-dialog image{color:" + THEME["dim"].encode() + b";-gtk-icon-transform:scale(0.85);}"
)

_HB_CSS.load_from_data(_build_hb_css())
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), _HB_CSS, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

# Visual RGBA — habilita transparencia del fondo de VTE. Si el compositor no
# soporta, VTE cae elegantemente a fondo opaco (nada rompe).
if TERM_OPACITY < 1.0:
    scr = win.get_screen()
    vis = scr.get_rgba_visual() if scr else None
    if vis is not None:
        win.set_visual(vis)

nb = Gtk.Notebook()
nb.set_scrollable(True)
tabs = {}   # clave ("sess" o "sess:shell") -> box
TABS_FILE = os.path.expanduser("~/.claude/hooks/app-tabs.json")
TAB_HISTORY_FILE = os.path.expanduser("~/.claude/hooks/app-tabs-history.json")


def notebook_pages():
    for i in range(nb.get_n_pages()):
        yield nb.get_nth_page(i)


def current_tab_order():
    out = []
    for page in notebook_pages():
        key = getattr(page, "_key", None)
        if key in tabs:
            out.append(key)
    return out


def ordered_tab_labels(page_keys, labels):
    out = {}
    for key in page_keys:
        if isinstance(key, str) and key in labels:
            out[key] = labels[key]
    for key, label in labels.items():
        if key not in out:
            out[key] = label
    return out


def save_tabs():
    try:
        labels = {k: getattr(b, "_label", None) for k, b in tabs.items()}
        with open(TABS_FILE, "w") as f:
            json.dump(ordered_tab_labels(current_tab_order(), labels), f)
    except Exception:
        pass


def on_tab_reordered(_nb, _child, _page_num):
    save_tabs()


def saved_tab_label(key):
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
        if isinstance(data, dict) and isinstance(data.get(key), str) and data.get(key):
            return data[key]
    except Exception:
        pass
    return None


def archive_tab(key, reason="closed"):
    if not key:
        return
    box = tabs.get(key)
    label = getattr(box, "_label", key) if box is not None else key
    it = STATE_ITEMS.get(key, {})
    cwd = it.get("cwd", "")
    agent = it.get("agent", "")
    if not cwd:
        r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_path}")
        if r.returncode == 0:
            cwd = r.stdout.strip()
    if not agent:
        r = tmuxc("display-message", "-p", "-t", "=" + key + ":", "#{pane_current_command}")
        cmd = r.stdout.strip() if r.returncode == 0 else ""
        agent = "codex" if cmd == "node" else "acp" if cmd == "cc-acp" else cmd if cmd in {"claude", "grok", "opencode", "gemini", "agy", "aider", "acp"} else "claude"
    item = {"session": key, "label": label, "cwd": cwd, "agent": agent,
            "reason": reason, "ts": int(time.time())}
    try:
        with open(TAB_HISTORY_FILE) as f:
            hist = json.load(f)
        if not isinstance(hist, list):
            hist = []
    except Exception:
        hist = []
    hist = [h for h in hist if not isinstance(h, dict) or h.get("session") != key]
    tmp = TAB_HISTORY_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump([item] + hist[:79], f)
    os.replace(tmp, TAB_HISTORY_FILE)



# ---- Snapshot de resurreccion: para que un reinicio de la compu no pierda nada.
# Cada ~30s se guarda, por pestana term-*, su cwd + agente + session-id EXACTO
# (claude: ~/.claude/sessions/<pid>.json trae pid/sessionId/pane tmux;
#  codex: el binario mantiene abierto su rollout-*.jsonl -> uuid del nombre).
# restore_tabs() usa esto para revivir cada tab en su directorio y retomar la
# conversacion precisa con `claude --resume <id>` / `codex resume <id>`.
SNAPSHOT_FILE = os.path.expanduser("~/.claude/hooks/app-tabs-snapshot.json")
CLAUDE_SESS_DIR = os.path.expanduser("~/.claude/sessions")
CLAUDE_PROJ_DIR = os.path.expanduser("~/.claude/projects")
CODEX_SESS_DIR = os.path.expanduser("~/.codex/sessions")
GROK_HOME_DEFAULT = os.path.expanduser("~/.grok")
_ROLLOUT_RE = re.compile(
    r"rollout-.*-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$")
_RESUME_SKIP_FLAGS = {"--resume", "--continue", "-r", "-c", "--last"}
# Flags que llevan valor: hay que conservar el PAR flag+valor. Guardar solo el
# flag produce comandos rotos tipo `claude --model --effort` (claude toma
# "--effort" como nombre de modelo y toda la sesion revive inservible).
_VALUE_FLAGS = {"--model", "--effort", "--permission-mode", "--add-dir",
                "--settings", "--session-id", "--agents", "--mcp-config"}


def _which_cli(name):
    """shutil.which + bins de usuario. Lanzada desde el escritorio, la app
    hereda un PATH sin ~/.bun/bin (codex) o ~/.local/bin: la deteccion de CLIs
    instalados no puede depender del entorno (mismo criterio que lib/providers)."""
    hit = shutil.which(name)
    if hit:
        return hit
    for directory in ("~/.local/bin", "~/.bun/bin", "~/.cargo/bin",
                      "~/.npm-global/bin", "~/bin", "/usr/local/bin"):
        candidate = os.path.join(os.path.expanduser(directory), name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def _sane_flags(raw):
    """Normaliza una lista de args a flags relanzables: conserva flag+valor de
    los _VALUE_FLAGS, descarta value-flags huerfanos (snapshots viejos rotos) y
    omite los flags de reanudacion junto con su id."""
    out, i = [], 0
    raw = [a for a in raw if isinstance(a, str)]
    while i < len(raw):
        arg = raw[i]
        if not arg.startswith("-"):
            i += 1
            continue
        if arg in _RESUME_SKIP_FLAGS:
            i += 1
            if arg in ("--resume", "-r") and i < len(raw) and not raw[i].startswith("-"):
                i += 1  # saltar el session-id del resume viejo
            continue
        if arg in _VALUE_FLAGS:
            if i + 1 < len(raw) and not raw[i + 1].startswith("-"):
                out.extend((arg, raw[i + 1]))
                i += 2
            else:
                i += 1  # value-flag sin valor: descartarlo, no propagar el bug
            continue
        out.append(arg)
        i += 1
    return out


def _pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except Exception:
        return False


def _proc_flags(pid):
    """Flags (con su valor cuando lo llevan) con que corre el agente, para
    relanzarlo igual (p.ej. --model X --effort high --dangerously-skip-permissions)."""
    try:
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            argv = [a.decode("utf-8", "replace") for a in f.read().split(b"\0") if a]
    except Exception:
        return []
    return _sane_flags(argv[1:])


def _claude_by_tmux_session():
    """{sesion tmux: {id,pid,config_dir}} de TODOS los config-dirs Claude."""
    out = {}
    dirs = [CLAUDE_SESS_DIR] + glob.glob(os.path.expanduser("~/.claude-accounts/*/sessions"))
    files = []
    for directory in dirs:
        try:
            files.extend((directory, n) for n in os.listdir(directory) if n.endswith(".json"))
        except Exception:
            continue
    for directory, n in files:
        try:
            with open(os.path.join(directory, n)) as f:
                d = json.load(f)
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        pid, tm, sid = d.get("pid"), d.get("tmux") or "", d.get("sessionId")
        if not (isinstance(pid, int) and isinstance(tm, str) and isinstance(sid, str) and sid):
            continue
        sess = tm.partition(":")[0]
        if not sess or not _pid_alive(pid):
            continue
        prev = out.get(sess)
        if prev and prev.get("startedAt", 0) >= (d.get("startedAt") or 0):
            continue
        out[sess] = {"id": sid, "pid": pid, "startedAt": d.get("startedAt") or 0,
                     "config_dir": os.path.dirname(directory)}
    return out


def _ppid_map():
    kids = {}
    try:
        pids = [n for n in os.listdir("/proc") if n.isdigit()]
    except Exception:
        return kids
    for n in pids:
        try:
            with open(f"/proc/{n}/stat") as f:
                st = f.read()
            ppid = int(st.rsplit(")", 1)[1].split()[1])
            kids.setdefault(ppid, []).append(int(n))
        except Exception:
            continue
    return kids


def _codex_info_for_session(sess, kids):
    """Busca en los descendientes del pane un proceso con su rollout de codex
    abierto -> {id, flags}. None si no hay codex en esa sesion."""
    r = tmuxc("list-panes", "-s", "-t", "=" + sess + ":", "-F", "#{pane_pid}")
    if r.returncode != 0:
        return None
    stack = [int(x) for x in r.stdout.split() if x.isdigit()]
    seen = set()
    while stack:
        p = stack.pop()
        if p in seen:
            continue
        seen.add(p)
        stack.extend(kids.get(p, []))
    for p in seen:
        try:
            fds = os.listdir(f"/proc/{p}/fd")
        except Exception:
            continue
        for fd in fds:
            try:
                t = os.readlink(f"/proc/{p}/fd/{fd}")
            except Exception:
                continue
            m = _ROLLOUT_RE.search(t)
            if m:
                return {"id": m.group(1), "flags": _proc_flags(p)}
    return None


_SNAPSHOT_LOCK = threading.Lock()


def snapshot_tabs():
    """Corre en hilo. Persiste el estado de resurreccion de las tabs term-*."""
    if not _SNAPSHOT_LOCK.acquire(blocking=False):
        return
    try:
        keys = [k for k in list(tabs.keys())
                if isinstance(k, str) and k.startswith("term-")]
        cl = _claude_by_tmux_session()
        kids = None
        data = {}
        for k in keys:
            it = STATE_ITEMS.get(k, {}) or {}
            cwd = it.get("cwd") or ""
            if not cwd:
                r = tmuxc("display-message", "-p", "-t", "=" + k + ":",
                          "#{pane_current_path}")
                cwd = r.stdout.strip() if r.returncode == 0 else ""
            ent = {"cwd": cwd, "agent": it.get("agent") or "", "ts": int(time.time())}
            if k in cl:
                ent["agent"] = "claude"
                ent["resume_id"] = cl[k]["id"]
                ent["flags"] = _proc_flags(cl[k]["pid"])
                ent["claude_config_dir"] = cl[k].get("config_dir") or os.path.expanduser("~/.claude")
            else:
                if kids is None:
                    kids = _ppid_map()
                info = _codex_info_for_session(k, kids)
                if info:
                    ent["agent"] = "codex"
                    ent["resume_id"] = info["id"]
                    ent["flags"] = info["flags"]
                else:
                    rcmd = tmuxc("display-message", "-p", "-t", "=" + k + ":", "#{pane_current_command}")
                    pane_cmd = rcmd.stdout.strip() if rcmd.returncode == 0 else ""
                    if pane_cmd == "cc-acp":
                        ent["agent"] = "acp"
                if ent["agent"] == "codex":
                    pass
                elif ent["agent"] == "grok":
                    sid = it.get("agentSessionId") or ""
                    if isinstance(sid, str) and re.fullmatch(r"[0-9a-f-]{36}", sid):
                        ent["resume_id"] = sid
                    alias = it.get("account") or "main"
                    ent["account"] = alias
                    ent["grok_home"] = (GROK_HOME_DEFAULT if alias == "main" else
                                         os.path.expanduser(f"~/.grok-accounts/{alias}"))
                elif ent["agent"] == "acp":
                    # pane cliente ACP: cc-acp publica agente/modelo/cuenta y el
                    # sessionId en acp-panes.json por pane tmux
                    r = tmuxc("display-message", "-p", "-t", "=" + k + ":", "#{pane_id}")
                    pane_id = r.stdout.strip() if r.returncode == 0 else ""
                    try:
                        with open(os.path.expanduser("~/.claude/hooks/acp-panes.json")) as f:
                            acp_state = (json.load(f) or {}).get(pane_id) or {}
                    except Exception:
                        acp_state = {}
                    if acp_state.get("agent"):
                        ent["acp"] = {key: acp_state.get(key, "") for key in ("agent", "model", "effort", "account", "sessionId")}
                elif ent["agent"] in {"claude", "codex"}:
                    pass  # agente reportado pero sin id: quedara el fallback
                else:
                    ent["agent"] = ""  # shell puro: no relanzar nada
            data[k] = ent
        tmp = SNAPSHOT_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(data, f)
        os.replace(tmp, SNAPSHOT_FILE)
    except Exception:
        pass
    finally:
        _SNAPSHOT_LOCK.release()


def load_tab_snapshot():
    try:
        with open(SNAPSHOT_FILE) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}


def resume_command(snap):
    """Comando para retomar el agente de una tab muerta; None = solo shell."""
    if not isinstance(snap, dict):
        return None
    agent = snap.get("agent") or ""
    # _sane_flags conserva pares --flag valor y tira value-flags huerfanos:
    # un snapshot viejo con ["--model","--effort"] jamas debe volver a generar
    # `claude --resume id --model --effort` (modelo invalido, sesion rota).
    flags = _sane_flags(snap.get("flags") if isinstance(snap.get("flags"), list) else [])
    fl = ("" if not flags else " " + " ".join(shlex.quote(f) for f in flags))
    sid = snap.get("resume_id") or ""
    sid = sid if isinstance(sid, str) and re.fullmatch(r"[0-9a-f-]{36}", sid) else ""
    if agent == "claude" and _which_cli("claude"):
        cfg = os.path.realpath(os.path.expanduser(snap.get("claude_config_dir") or "~/.claude"))
        projects = os.path.join(cfg, "projects")
        prefix = "" if cfg == os.path.realpath(os.path.expanduser("~/.claude")) else f"CLAUDE_CONFIG_DIR={shlex.quote(cfg)} "
        if sid and glob.glob(os.path.join(projects, "*", sid + ".jsonl")):
            return prefix + "claude --resume " + sid + fl
        return prefix + "claude --continue" + fl
    if agent == "codex" and _which_cli("codex"):
        if sid and glob.glob(os.path.join(CODEX_SESS_DIR, "*", "*", "*",
                                          "rollout-*" + sid + ".jsonl")):
            return "codex resume " + sid + fl
        return "codex resume --last" + fl
    if agent == "acp" and _which_cli("cc-acp"):
        st = snap.get("acp") if isinstance(snap.get("acp"), dict) else {}
        cmd = "cc-acp --agent " + shlex.quote(str(st.get("agent") or "claude"))
        for flag, key in (("--model", "model"), ("--effort", "effort"), ("--account", "account"), ("--resume", "sessionId")):
            value = str(st.get(key) or "")
            if value and not (key == "account" and value == "main"):
                cmd += f" {flag} " + shlex.quote(value)
        return cmd + fl
    if agent == "grok" and _which_cli("grok"):
        home = snap.get("grok_home") or GROK_HOME_DEFAULT
        home = os.path.realpath(os.path.expanduser(home))
        prefix = "" if home == os.path.realpath(GROK_HOME_DEFAULT) else f"GROK_HOME={shlex.quote(home)} "
        if sid and glob.glob(os.path.join(home, "sessions", "**", sid, "summary.json"), recursive=True):
            return prefix + "grok --resume " + sid + fl
        return prefix + "grok --continue" + fl
    return None


def _send_resume(sess, cmd):
    try:
        if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                          capture_output=True, timeout=5).returncode == 0:
            tmuxc("send-keys", "-t", "=" + sess + ":", cmd, "Enter")
    except Exception:
        pass
    return False


def restore_tabs():
    """Al abrir la app, reabre las pestanas de la vez pasada (con su nombre);
    si una sesion murio (p.ej. reinicio), la revive (claude --continue /
    reconexion ssh)."""
    try:
        with open(TABS_FILE) as f:
            data = json.load(f)
    except Exception:
        return False
    if isinstance(data, list):    # formato viejo: lista de claves sin etiqueta
        data = {k: None for k in data if isinstance(k, str)}
    if not isinstance(data, dict):
        return False
    snaps = load_tab_snapshot()
    for key, label in data.items():
        if not isinstance(key, str) or not key:
            continue
        # Pestana experimental xterm.js — no es sesion tmux, no revive nada,
        # solo remonta la WebView contra cc-webterm.
        if key.startswith("xterm-"):
            if key in tabs:
                continue
            try:
                open_xterm_tab(key[len("xterm-"):] or "local")
            except Exception as e:
                print(f"no pude restaurar {key}: {e}")
            continue
        # claves viejas "sesion:ventana" colapsan a la sesion (una pestana por sesion)
        sess = key.partition(":")[0]
        if sess in tabs:
            continue
        try:
            if subprocess.run(["tmux", "has-session", "-t", "=" + sess],
                              capture_output=True, timeout=5).returncode != 0:
                ssh_host = ssh_host_from_session(sess)
                if sess.startswith("term-"):
                    # terminal scratch: revivir en SU cwd y retomar el agente
                    # exacto (claude --resume <id> / codex resume <id>) que
                    # corria antes del apagado, segun el snapshot periodico.
                    snap = snaps.get(sess) if isinstance(snaps, dict) else None
                    snap = snap if isinstance(snap, dict) else {}
                    cwd = snap.get("cwd") or ""
                    if not (isinstance(cwd, str) and os.path.isdir(cwd)):
                        cwd = os.path.expanduser("~")
                    subprocess.run(
                        ["systemd-run", "--user", "--scope", "--collect", "--quiet",
                         "tmux", "new-session", "-d", "-s", sess, "-c", cwd],
                        capture_output=True, timeout=12)
                    cmd = resume_command(snap)
                    if cmd:
                        GLib.timeout_add(1500, _send_resume, sess, cmd)
                elif ssh_host and sess.startswith("ssh-"):
                    http_post("/ssh-connect", {"host": ssh_host}, timeout=20)
                elif ssh_host:
                    res, e = http_post("/ssh-new-tab", {"host": ssh_host}, timeout=20)
                    if e:
                        raise RuntimeError(e)
                    if isinstance(res, dict) and res.get("session"):
                        sess = res["session"]
                        label = res.get("label") or label
                else:
                    http_post("/new", {"session": sess})
            open_tab(sess, "claude", label=label if isinstance(label, str) and label else None)
        except Exception as e:
            print(f"no pude restaurar {key}: {e}")
    return False


# Punto de estado por pestana: el color se procesa ANTES de leer el nombre
# (ambar: espera tu respuesta / azul: trabajando / verde: listo)
# Semaforo refinado: tonos suaves y armonicos, mismos en tabs y cards GTK
# Semaforo "aurora": tonos apagados y elegantes que no pelean con Bruno
DOT_COLORS = {"waiting": "#D08770", "working": "#81A1C1",
              "done": "#A3BE8C", "dead": "#BF616A"}
DOT_IDLE = "#4B5568"
STATE_CACHE = {}   # session -> status (lo alimenta el poller de /state)
STATE_ITEMS = {}   # session -> item completo de /state para el switcher


_TAB_RENAME_CSS = None
def _apply_tab_rename_css(entry):
    """Estilo oscuro compacto para el Entry inline de renombre de pestaña.
    Provee color/bg del tema noche + border sutil. Aplicado por widget para no
    afectar Entries de otros lados de la app."""
    global _TAB_RENAME_CSS
    if _TAB_RENAME_CSS is None:
        _TAB_RENAME_CSS = Gtk.CssProvider()
        _TAB_RENAME_CSS.load_from_data((
            b"entry.tab-rename{"
            b" background:" + THEME["bg"].encode() + b";"
            b" color:" + THEME["text"].encode() + b";"
            b" border:1px solid " + THEME["brand"].encode() + b";"
            b" border-radius:4px;"
            b" padding:1px 6px;"
            b" min-height:20px;"
            b" font-family:'JetBrainsMono Nerd Font Mono',monospace;"
            b" font-size:11px;"
            b" caret-color:" + THEME["cursor"].encode() + b";"
            b"}"
            b"entry.tab-rename selection{"
            b" background:" + THEME["line2"].encode() + b";"
            b"}"
        ))
    entry.get_style_context().add_provider(
        _TAB_RENAME_CSS, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def tab_label(text, key=None, closable=True):
    hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    dot = Gtk.Label()
    dot.set_markup(f'<span size="8500" foreground="{DOT_IDLE}">●</span>')
    hb.pack_start(dot, False, False, 0)
    lbl = Gtk.Label(label=text)
    # EventBox permite recibir clicks (Label no los captura por default).
    # Doble-click = renombrar inline; sin bloquear el single-click que
    # GtkNotebook usa para cambiar de pestaña.
    lbl_box = Gtk.EventBox()
    lbl_box.set_visible_window(False)
    lbl_box.add(lbl)
    hb.pack_start(lbl_box, False, False, 0)
    micon = Gtk.Image()
    hb.pack_start(micon, False, False, 0)
    model_lbl = Gtk.Label(label="")
    model_lbl.get_style_context().add_class("tab-model")
    hb.pack_start(model_lbl, False, False, 0)
    hb._dot = dot
    hb._text = lbl
    hb._micon = micon
    hb._model = model_lbl
    hb._text_box = lbl_box

    def begin_rename(*_):
        if getattr(hb, "_editing", False) or key is None:
            return
        box = tabs.get(key)
        if box is None:
            return
        hb._editing = True
        cur = lbl.get_text()
        entry = Gtk.Entry()
        entry.set_text(cur)
        # Ancho ajustado al contenido — no "brinca" la barra de pestañas.
        n = max(6, min(28, len(cur) + 1))
        entry.set_width_chars(n)
        entry.set_max_width_chars(n)
        entry.set_has_frame(False)
        entry.set_alignment(0.0)
        entry.get_style_context().add_class("tab-rename")
        _apply_tab_rename_css(entry)
        lbl_box.hide()
        hb.pack_start(entry, False, False, 0)
        hb.reorder_child(entry, 1)
        entry.show()
        entry.grab_focus()
        entry.select_region(0, -1)

        def finish(save):
            if not getattr(hb, "_editing", False):
                return
            hb._editing = False
            val = entry.get_text().strip()
            try:
                hb.remove(entry)
            except Exception:
                pass
            entry.destroy()
            lbl_box.show()
            if save and val and val != cur:
                set_tab_label(box, val)

        def on_key(_w, ev):
            if ev.keyval == Gdk.KEY_Return:
                finish(True); return True
            if ev.keyval == Gdk.KEY_Escape:
                finish(False); return True
            return False

        entry.connect("activate", lambda *_: finish(True))
        entry.connect("focus-out-event", lambda *_: (finish(True), False)[1])
        entry.connect("key-press-event", on_key)

    def on_click(_w, ev):
        if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1:
            begin_rename()
            return True
        return False

    lbl_box.connect("button-press-event", on_click)

    if closable:
        b = Gtk.Button()
        pb = GdkPixbuf.Pixbuf.new_from_file_at_size(
            os.path.join(_ICONS_DIR, "close.svg"), 12, 12)
        b.set_image(Gtk.Image.new_from_pixbuf(pb))
        b.set_always_show_image(True)
        b.set_relief(Gtk.ReliefStyle.NONE)
        b.get_style_context().add_class("tabclose")
        b.connect("clicked", lambda *_: close_tab(key))
        hb.pack_start(b, False, False, 0)
    hb.show_all()
    return hb


def update_dots(states, items=None):
    STATE_CACHE.clear()
    STATE_CACHE.update(states)
    try:
        if items is not None:
            # el badge cuenta lo IMPORTANTE (mismo conteo v2 del tablero,
            # respetando la limpieza compartida), no sesiones en espera
            try:
                with urllib.request.urlopen("http://127.0.0.1:4777/notifs/count", timeout=2) as _r:
                    nc = json.loads(_r.read().decode()).get("count", 0)
            except Exception:
                nc = 0
            set_notif_badge(int(nc))
    except Exception:
        pass
    if items is not None:
        STATE_ITEMS.clear()
        STATE_ITEMS.update({it.get("session"): it for it in items if it.get("session")})
    for key, box in tabs.items():
        hb = nb.get_tab_label(box)
        dot = getattr(hb, "_dot", None)
        if dot is None:
            continue
        c = DOT_COLORS.get(states.get(key, ""), DOT_IDLE)
        dot.set_markup(f'<span size="8500" foreground="{c}">●</span>')
    return False


def apply_terminal_prefs(p=None):
    """Re-aplica las prefs de terminal EN VIVO a TODAS las terminales
    abiertas (fuente, cursor, padding, opacidad). Con p=None re-aplica las
    globals actuales (util tras un cambio de tema, que resetea colores sin
    la opacidad). make_term usa estas mismas globals: las tabs nuevas nacen
    ya con los valores nuevos."""
    global _PF_FAMILY, _PF_SIZE, FONT_FAMILY, FONT_SIZE, FONT
    global TERM_PADDING, TERM_OPACITY, _CURSOR_SHAPE, _CURSOR_BLINK
    if p is not None:
        _PF_FAMILY = (p.get("font_family") or "").strip() or "JetBrainsMono Nerd Font Mono"
        _PF_SIZE = int(p.get("font_size") or FONT_SIZE)
        FONT_FAMILY = f"{_PF_FAMILY},JetBrainsMono Nerd Font,JetBrains Mono,DejaVu Sans Mono,Monospace"
        FONT_SIZE = _PF_SIZE
        FONT = f"{FONT_FAMILY} {FONT_SIZE}"
        TERM_PADDING = max(0, min(40, int(p.get("terminal_padding", 8))))
        TERM_OPACITY = max(30, min(100, int(p.get("terminal_opacity", 100)))) / 100.0
        _CURSOR_SHAPE = (p.get("cursor_shape") or "block")
        _CURSOR_BLINK = bool(p.get("cursor_blink", True))
    for page in notebook_pages():
        term = getattr(page, "_term", None)
        if term is None:
            continue
        try:
            term.set_font(Pango.FontDescription(FONT))
            term.set_colors(rgba(THEME["fg"]), _bg_rgba(), [rgba(c) for c in THEME["pal"]])
            term.set_color_cursor(rgba(THEME["cursor"]))
            term.set_cursor_shape(_CURSOR_SHAPE_MAP.get(_CURSOR_SHAPE, Vte.CursorShape.BLOCK))
            term.set_cursor_blink_mode(
                Vte.CursorBlinkMode.ON if _CURSOR_BLINK else Vte.CursorBlinkMode.OFF)
            term.set_margin_start(TERM_PADDING + 2)
            term.set_margin_end(max(0, TERM_PADDING - 4))
            term.set_margin_top(TERM_PADDING)
            term.set_margin_bottom(max(0, TERM_PADDING - 2))
        except Exception:
            pass
    return False


# Prefs que, al cambiar en Ajustes (desde la app, Chrome O el celular),
# deben reflejarse EN TIEMPO REAL en las terminales abiertas.
_LIVE_PREF_KEYS = ("font_family", "font_size", "cursor_shape", "cursor_blink",
                   "terminal_padding", "terminal_opacity", "theme")


def poll_state_loop():
    last_prefs = None
    while True:
        try:
            with urllib.request.urlopen("http://127.0.0.1:4777/state", timeout=3) as r:
                items = json.loads(r.read().decode())
            states = {it["session"]: it.get("status", "idle")
                      for it in items if it.get("session")}
            GLib.idle_add(update_dots, states, items)
        except Exception:
            pass
        # Watcher de prefs: Ajustes cambiado en CUALQUIER superficie se aplica
        # aqui en <=3s a todas las terminales (fuente/cursor/padding/opacidad
        # y tema). Antes solo se leian al arrancar la app.
        try:
            with urllib.request.urlopen("http://127.0.0.1:4777/prefs", timeout=3) as r:
                p = json.loads(r.read().decode())
            snap = {k: p.get(k) for k in _LIVE_PREF_KEYS}
            if last_prefs is None:
                last_prefs = snap
            elif snap != last_prefs:
                theme_changed = snap.get("theme") != last_prefs.get("theme")
                last_prefs = snap
                if theme_changed and snap.get("theme"):
                    GLib.idle_add(apply_theme, snap["theme"])
                # tras el tema tambien: recolorea con la OPACIDAD correcta
                GLib.idle_add(apply_terminal_prefs, p)
        except Exception:
            pass
        time.sleep(3)


def _confirm_must_answer(primary, secondary, yes_label, no_label):
    """Confirm dialog bloqueante — solo cierra con Yes o No. Embebido en
    modal_overlay con dismissable=False: backdrop y ESC son no-op. GLib.MainLoop
    interno para retornar sincronicamente."""
    result = {"value": False, "finished": False}
    loop = GLib.MainLoop()

    # Panel como Frame widget (no toplevel).
    panel = Gtk.Frame()
    panel.set_size_request(480, -1)
    panel.set_halign(Gtk.Align.CENTER); panel.set_valign(Gtk.Align.CENTER)
    panel.get_style_context().add_class("cc-snip-dialog")  # mismo look que snippets

    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    panel.add(root)

    body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    body.set_margin_top(20); body.set_margin_bottom(16)
    body.set_margin_start(22); body.set_margin_end(22)
    icon = Gtk.Image.new_from_icon_name("dialog-question-symbolic", Gtk.IconSize.DIALOG)
    body.pack_start(icon, False, False, 0)
    txt = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    l1 = Gtk.Label(label=primary, xalign=0); l1.set_line_wrap(True)
    l1.get_style_context().add_class("primary")
    l2 = Gtk.Label(label=secondary, xalign=0); l2.set_line_wrap(True)
    l2.get_style_context().add_class("dim-label")
    txt.pack_start(l1, False, False, 0)
    txt.pack_start(l2, False, False, 0)
    body.pack_start(txt, True, True, 0)
    root.pack_start(body, True, True, 0)

    actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    actions.set_margin_top(6); actions.set_margin_bottom(14)
    actions.set_margin_start(16); actions.set_margin_end(16)
    actions.set_homogeneous(True)
    no_btn = Gtk.Button(label=no_label)
    yes_btn = Gtk.Button(label=yes_label)
    actions.pack_start(no_btn, True, True, 0)
    actions.pack_start(yes_btn, True, True, 0)
    root.pack_start(actions, False, False, 0)

    close_ref = [None]
    def _finish(value):
        if result["finished"]:
            return
        result["value"] = value
        result["finished"] = True
        if close_ref[0]:
            close_ref[0]()
        try: loop.quit()
        except Exception: pass

    no_btn.connect("clicked", lambda *_: _finish(False))
    yes_btn.connect("clicked", lambda *_: _finish(True))

    # Y/N keyboard shortcuts (must-answer no permite ESC).
    def on_key(ev):
        if ev.keyval in (Gdk.KEY_y, Gdk.KEY_Y, Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            _finish(True); return True
        if ev.keyval in (Gdk.KEY_n, Gdk.KEY_N):
            _finish(False); return True
        return False

    close_ref[0] = show_modal_panel(panel, on_key=on_key, dismissable=False)
    yes_btn.grab_focus()
    loop.run()
    return bool(result["value"])


def close_tab(key, confirm=True):
    # Confirmar SIEMPRE (salvo cierres ya confirmados en el tablero remoto).
    # La sesion tmux sigue viva y queda en "Recientes (cerradas)" del tablero.
    box = tabs.get(key)
    label = getattr(box, "_label", key) if box is not None else key
    # NO usamos Gtk.MessageDialog + d.run() — en WSLg el compositor destruia
    # la ventana con click afuera (bypassing modal+deletable+delete-event) y
    # d.run() retornaba NONE dejando la logica en estado indefinido.
    # Alternativa: Gtk.Window custom + GLib.MainLoop propio + boton YES/NO.
    # Al no ser Gtk.Dialog, no hay response signal ni handling default del WM.
    snip_log(f"close_tab confirm for key={key} label={label} confirm={confirm}")
    resp = True if not confirm else _confirm_must_answer(
        primary=(f"¿Cerrar la pestaña «{label}»?" if ES else f"Close tab “{label}”?"),
        secondary=("La sesión tmux sigue viva; puedes recuperarla en Recientes del tablero."
                   if ES else
                   "The tmux session stays alive; recover it from the dashboard's Recents."),
        yes_label=("Sí" if ES else "Yes"),
        no_label=("No" if ES else "No"),
    )
    snip_log(f"close_tab confirm resp={resp}")
    if not resp:
        return
    archive_tab(key, reason="closed")
    box = tabs.pop(key, None)
    if box is not None:
        if getattr(box, "_term", None) is not None:
            box._term._respawn = False
        nb.remove_page(nb.page_num(box))
    save_tabs()
    # Scratch (term-*) con puro shell ocioso: cerrar la pestana MATA la sesion
    # (adios sesiones fantasma). Si algo corre adentro (vite, claude, ssh...),
    # la sesion sobrevive como siempre.
    if key and key.startswith("term-"):
        r = tmuxc("list-panes", "-s", "-t", "=" + key, "-F", "#{pane_current_command}")
        cmds = set(r.stdout.split())
        if r.returncode == 0 and cmds and cmds <= {"zsh", "bash", "sh", "fish"}:
            tmuxc("kill-session", "-t", "=" + key)


def current_cwd():
    """Directorio del pane activo de la pestana actual (para 'nueva terminal aqui')."""
    page = nb.get_nth_page(nb.get_current_page())
    term = getattr(page, "_term", None)
    if term:
        sess = term_session(term)
        if sess:
            r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_current_path}")
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip()
    return os.path.expanduser("~")


TERM_N = [0]


def new_local_tab(*_):
    """Nueva pestana de terminal en el MISMO directorio donde esta el cursor."""
    cwd = current_cwd()
    TERM_N[0] += 1
    sess = f"term-{os.getpid() % 10000}-{TERM_N[0]}"
    subprocess.run(
        ["systemd-run", "--user", "--scope", "--collect", "--quiet",
         "tmux", "new-session", "-d", "-s", sess, "-c", cwd],
        capture_output=True, timeout=12)
    open_tab(sess, "claude", label=os.path.basename(cwd) or "term")


def _ensure_cc_webterm():
    """Arranca cc-webterm si no responde en 127.0.0.1:4779. Idempotente."""
    try:
        urllib.request.urlopen("http://127.0.0.1:4779/token", timeout=0.4)
        return
    except Exception:
        pass
    bin_path = shutil.which("cc-webterm") or os.path.join(CC_REPO, "bin", "cc-webterm")
    subprocess.Popen([bin_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_xterm_tab(sess="local"):
    """Pestana EXPERIMENTAL con xterm.js dentro de WebKit2WebView, que shape las
    ligaduras de JetBrainsMono (VTE no las shape). Reusa cc-webterm (ttyd en
    127.0.0.1:4779) como backend PTY vía WebSocket."""
    if not WIN_RE.match(sess or ""):
        sess = "local"
    key = f"xterm-{sess}"
    if key in tabs:
        nb.set_current_page(nb.page_num(tabs[key]))
        return
    _ensure_cc_webterm()
    theme_name = next((k for k, v in THEMES.items() if v is THEME), "noche")
    token = ""
    try:
        with urllib.request.urlopen(BASE_URL + "/webterm-token", timeout=2) as response:
            token = json.loads(response.read().decode()).get("token") or ""
    except Exception:
        pass
    uri = (f"file://{TERM_HTML}?auth={quote(token, safe='')}&"
           f"arg={quote(sess, safe='')}&theme={quote(theme_name, safe='')}")

    wv = WebKit2.WebView()
    st = wv.get_settings()
    # file:// necesita permiso explícito para leer TTF y .js del mismo repo.
    try: st.set_property("allow-file-access-from-file-urls", True)
    except Exception: pass
    try: st.set_property("allow-universal-access-from-file-urls", True)
    except Exception: pass
    st.set_property("enable-write-console-messages-to-stdout", True)
    wv.load_uri(uri)

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.pack_start(wv, True, True, 0)
    box._term = None          # no es VTE — los handlers que lo usan lo ignoran
    box._webview = wv
    box._key = key
    box._label = f"xterm · {sess}"
    idx = nb.append_page(box, tab_label(box._label, key))
    nb.set_tab_reorderable(box, True)
    box.show_all()
    nb.set_current_page(idx)
    tabs[key] = box
    save_tabs()


WIN_RE = re.compile(r"^[A-Za-z0-9_-]{1,32}$")


def select_win(sess, winname):
    """Selecciona la ventana pedida. Si 'claude' ya no se llama asi (claude
    murio o relanzado y tmux renombro la ventana), busca donde corre claude
    de verdad; si en ninguna, la primera ventana — nunca el shell perdido."""
    if tmuxc("select-window", "-t", f"={sess}:{winname}").returncode == 0:
        return
    if winname != "claude":
        return
    r = tmuxc("list-panes", "-s", "-t", "=" + sess,
              "-F", "#{window_index}|#{pane_current_command}")
    for l in r.stdout.splitlines():
        idx, _, cmd = l.partition("|")
        if cmd == "claude":
            tmuxc("select-window", "-t", f"={sess}:{idx}")
            return
    tmuxc("select-window", "-t", f"={sess}:^")


def open_tab(sess, winname, label=None):
    """Abre (o enfoca) LA pestana de una sesion tmux; winname elige que ventana
    (claude/shell/ssh) se muestra."""
    if not WIN_RE.match(winname or ""):
        winname = "claude"
    key = sess
    if ssh_host_from_session(sess):
        tmuxc("set-option", "-t", sess, "mouse", "off")
    if key in tabs:
        select_win(sess, winname)
        nb.set_current_page(nb.page_num(tabs[key]))
        tabs[key]._term.grab_focus()
        return
    select_win(sess, winname)
    cmd = (f"tmux attach -t '={sess}' || {{ echo '[sesion terminada — cierra esta pestana con la x]'; exec cat; }}")
    box = make_term(cmd)
    box._key = key
    box._term._session_hint = sess
    _attach_model_bar(box, sess)
    box._label = label or saved_tab_label(sess) or sess
    idx = nb.append_page(box, tab_label(box._label, key))
    nb.set_tab_reorderable(box, True)
    box.show_all()
    nb.set_current_page(idx)
    box._term.grab_focus()
    tabs[key] = box
    save_tabs()


def set_tab_label(box, text):
    box._label = text
    hb = nb.get_tab_label(box)
    if hb is not None and getattr(hb, "_text", None) is not None:
        hb._text.set_text(text)
    save_tabs()


def fuzzy_score(q, s):
    """None si no matchea; menor = mejor (subsecuencia con saltos penalizados)."""
    q, s = q.lower(), s.lower()
    score, pos = 0, 0
    for ch in q:
        i = s.find(ch, pos)
        if i < 0:
            return None
        score += i - pos
        pos = i + 1
    return score + len(s) * 0.01


SW_ORDER = {"waiting": 0, "done": 1, "working": 2}
SW_HINT = ({"waiting": "espera TU respuesta", "working": "trabajando", "done": "listo"} if ES else
           {"waiting": "waiting for YOU", "working": "working", "done": "done"})


def close_on_click_outside(w):
    """Cierra un popup al hacer click fuera / Alt+Tab / ESC.
    En WSLg ni focus-out ni el bubbling de button-press son confiables cuando
    hay `transient_for + modal=False`. La forma robusta es un POINTER GRAB
    (Gdk.Seat.grab): mientras el popup vive, TODOS los clicks del display
    llegan primero a `w` — chequeamos si el punto cae dentro del bbox del
    popup y, si no, cerramos y propagamos el click a la app."""
    w._armed = False
    w._seat = None

    def _arm():
        w._armed = True
        try:
            seat = w.get_display().get_default_seat()
            gdkwin = w.get_window()
            if gdkwin is not None:
                seat.grab(gdkwin,
                          Gdk.SeatCapabilities.POINTER,
                          True, None, None, None)
                w._seat = seat
        except Exception:
            pass
        return False

    def _release_grab():
        try:
            if w._seat is not None:
                w._seat.ungrab()
                w._seat = None
        except Exception:
            pass

    def _kill():
        _release_grab()
        w.destroy()
        return False

    def _dismiss():
        if not getattr(w, "_armed", False):
            return
        w._armed = False
        _release_grab()
        # DESTROY sync — hide+idle nunca completaba porque WSLg emitía un
        # enter-notify sobre la ventana hidden y la reactivaba antes de que
        # el idle callback disparara.
        try:
            w.destroy()
        except Exception:
            pass

    def on_press(_w, ev):
        if not getattr(w, "_armed", False):
            return False
        wx, wy = w.get_position()
        ww, wh = w.get_size()
        px, py = int(ev.x_root), int(ev.y_root)
        inside = wx <= px < wx + ww and wy <= py < wy + wh
        if inside:
            return False   # dejar que el widget hijo maneje el click
        _dismiss()
        return True

    def on_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            _dismiss()
            return True
        return False

    def _tick():
        # Polling — la única señal confiable en WSLg de "perdió foco".
        # Cuando is_active() == False después de estar armado, cerramos.
        if not getattr(w, "_armed", False):
            return False   # stop
        try:
            if not w.is_active():
                _dismiss()
                return False
        except Exception:
            return False
        return True

    w.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    w.connect("button-press-event", on_press)
    w.connect("key-press-event", on_key)
    w.connect("destroy", lambda *_: _release_grab())
    GLib.timeout_add(200, _arm)
    GLib.timeout_add(300, _tick)   # empieza a poll después de armado


def open_switcher(*_):
    """Ctrl+K: saltar a cualquier pestana/sesion escribiendo 2-3 letras.
    Las que ESPERAN tu respuesta salen arriba; Enter va a la primera.
    Panel embebido en modal_overlay."""
    # Panel como Frame widget (no toplevel).
    w = Gtk.Frame()
    w.set_size_request(560, -1)
    w.set_halign(Gtk.Align.CENTER); w.set_valign(Gtk.Align.CENTER)
    w.get_style_context().add_class("switcher")
    close_ref = [None]
    def _close():
        if close_ref[0]:
            close_ref[0]()
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    v.set_property("margin", 12)
    entry = Gtk.Entry()
    entry.set_placeholder_text("Salta a...  (parte del nombre, Enter va a la primera)" if ES else
                                "Jump to...  (type part of a name, Enter opens the first)")
    v.pack_start(entry, False, False, 0)
    lb = Gtk.ListBox()
    lb.set_activate_on_single_click(True)
    v.pack_start(lb, True, True, 0)
    w.add(v)
    rows = []

    def candidates():
        out, seen = [], set()
        for page in notebook_pages():
            key = getattr(page, "_key", None)
            if key in tabs:
                out.append((tab_page_label(page), key, True))
                seen.add(key)
        for s, it in STATE_ITEMS.items():
            if s in seen or s == "local" or it.get("alive") is False or it.get("zombie"):
                continue
            orphan_term = s.startswith("term-") and not it.get("tabbed") and \
                not it.get("agent") and it.get("status", "idle") == "idle"
            if orphan_term:
                continue
            out.append((it.get("project") or s, s, False))
        return out

    def refill(*_):
        for ch in lb.get_children():
            lb.remove(ch)
        rows.clear()
        q = entry.get_text().strip()
        scored = []
        for label, key, is_open in candidates():
            sc = fuzzy_score(q, f"{label} {key}") if q else 0
            if sc is None:
                continue
            st = STATE_CACHE.get(key, "")
            scored.append((SW_ORDER.get(st, 3), sc, label.lower(), label, key, st, is_open))
        scored.sort()
        for _, _, _, label, key, st, is_open in scored[:12]:
            r = Gtk.ListBoxRow()
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            h.set_property("margin", 7)
            d = Gtk.Label()
            d.set_markup(f'<span size="9000" foreground="{DOT_COLORS.get(st, DOT_IDLE)}">●</span>')
            h.pack_start(d, False, False, 0)
            h.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
            hint = SW_HINT.get(st, "") + ("" if is_open else ("   [abrir]" if ES else "   [open]"))
            m = Gtk.Label(label=hint.strip(), xalign=1)
            m.get_style_context().add_class("sw-meta")
            h.pack_end(m, False, False, 0)
            r.add(h)
            lb.add(r)
            rows.append((r, key, is_open))
        lb.show_all()
        if rows:
            lb.select_row(rows[0][0])

    def go(row):
        for r, key, _is_open in rows:
            if r is row:
                _close()
                open_tab(key, "claude")
                return

    def close_selected():
        sel = lb.get_selected_row()
        for r, key, is_open in rows:
            if r is sel and is_open and key in tabs:
                close_tab(key)
                refill()
                return True
        return True

    def move_sel(delta):
        sel = lb.get_selected_row()
        idx = next((i for i, (r, _key, _is_open) in enumerate(rows) if r is sel), 0)
        idx = max(0, min(len(rows) - 1, idx + delta))
        if rows:
            lb.select_row(rows[idx][0])

    # on_key handler para el switcher — retorna True si consume la tecla.
    # ESC ya lo maneja show_modal_panel; los demas son navegacion propia.
    def on_sw_key(ev):
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            sel = lb.get_selected_row()
            if sel:
                go(sel)
            return True
        if ev.keyval == Gdk.KEY_Down:
            move_sel(1); return True
        if ev.keyval == Gdk.KEY_Up:
            move_sel(-1); return True
        if ev.keyval in (Gdk.KEY_Delete, Gdk.KEY_BackSpace) and entry.get_text() == "":
            return close_selected()
        if ev.state & Gdk.ModifierType.CONTROL_MASK and ev.keyval in (Gdk.KEY_w, Gdk.KEY_W):
            return close_selected()
        # Cuando el usuario tipea texto normal, redirigimos al entry si no
        # tiene foco todavia (por si el key llega al win antes que al entry).
        return False

    lb.connect("row-activated", lambda _l, row: go(row))
    entry.connect("changed", refill)
    refill()
    close_ref[0] = show_modal_panel(w, on_key=on_sw_key)
    entry.grab_focus()


def tab_page_label(page):
    if getattr(page, "_label", None):
        return page._label
    hb = nb.get_tab_label(page)
    txt = getattr(hb, "_text", None)
    if txt is not None:
        return txt.get_text()
    return getattr(page, "_key", "tab") or "tab"


def open_tabs_overview(*_):
    w = Gtk.Frame()
    w.set_size_request(500, 480)
    w.set_halign(Gtk.Align.CENTER); w.set_valign(Gtk.Align.CENTER)
    w.get_style_context().add_class("switcher")
    close_ref = [None]
    def _close():
        if close_ref[0]:
            close_ref[0]()
    v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
    v.set_property("margin", 12)
    title = Gtk.Label(label="Tabs abiertas" if ES else "Open tabs", xalign=0)
    title.get_style_context().add_class("help-sec")
    v.pack_start(title, False, False, 0)
    sc = Gtk.ScrolledWindow()
    sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    sc.set_min_content_height(320)
    lb = Gtk.ListBox()
    lb.set_activate_on_single_click(True)
    sc.add(lb)
    v.pack_start(sc, True, True, 0)
    w.add(v)
    rows = []

    def focus_page(page):
        _close()
        idx = nb.page_num(page)
        if idx >= 0:
            nb.set_current_page(nb.page_num(page))
            term = getattr(page, "_term", None)
            if term:
                term.grab_focus()

    def refill():
        for ch in lb.get_children():
            lb.remove(ch)
        rows.clear()
        for page in notebook_pages():
            key = getattr(page, "_key", None)
            label = tab_page_label(page)
            st = STATE_CACHE.get(key, "") if key else ""
            row = Gtk.ListBoxRow()
            h = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            h.set_property("margin", 8)
            dot = Gtk.Label()
            dot.set_markup(f'<span size="9500" foreground="{DOT_COLORS.get(st, DOT_IDLE)}">●</span>')
            h.pack_start(dot, False, False, 0)
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            texts.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
            meta = Gtk.Label(label=(key or "local"), xalign=0)
            meta.get_style_context().add_class("sw-meta")
            texts.pack_start(meta, False, False, 0)
            h.pack_start(texts, True, True, 0)
            if key:
                close = Gtk.Button(label="×")
                close.set_relief(Gtk.ReliefStyle.NONE)
                close.get_style_context().add_class("tabplus")

                def on_close(_b, key=key):
                    close_tab(key)
                    refill()

                close.connect("clicked", on_close)
                h.pack_end(close, False, False, 0)
            row.add(h)
            lb.add(row)
            rows.append((row, page))
        lb.show_all()

    def go(_lb, row):
        for r, page in rows:
            if r is row:
                focus_page(page)
                return

    lb.connect("row-activated", go)
    refill()
    close_ref[0] = show_modal_panel(w)


def rename_tab(key):
    box = tabs.get(key)
    if box is None:
        return
    dlg = Gtk.Dialog(title="Renombrar pestana" if ES else "Rename tab", transient_for=win)
    dlg.set_decorated(False)
    dlg.get_style_context().add_class("cc-dialog")
    dlg.add_buttons("Cancelar" if ES else "Cancel", Gtk.ResponseType.CANCEL,
                    "Renombrar" if ES else "Rename", Gtk.ResponseType.OK)
    area = dlg.get_content_area()
    area.set_property("margin", 14); area.set_spacing(8)
    area.add(Gtk.Label(label="Nombre de la pestana:" if ES else "Tab name:", xalign=0))
    entry = Gtk.Entry()
    entry.set_text(getattr(box, "_label", key))
    entry.set_activates_default(True)
    area.add(entry)
    dlg.set_default_response(Gtk.ResponseType.OK)
    dlg.show_all()
    entry.grab_focus()
    if dlg.run() == Gtk.ResponseType.OK:
        name = entry.get_text().strip()
        if name:
            set_tab_label(box, name)
    dlg.destroy()


# Estilo propio de la app (pestanas, scrollbars, separadores), tematizable
_prov = Gtk.CssProvider()
_prov.load_from_data(theme_css(THEME).encode())
Gtk.StyleContext.add_provider_for_screen(
    Gdk.Screen.get_default(), _prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def apply_theme(name):
    """Cambia el tema EN CALIENTE: chrome GTK + colores de TODAS las
    terminales abiertas (lo dispara el boton de tema del tablero)."""
    global THEME
    THEME = THEMES.get(name, THEMES["noche"])
    try:
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", name != "dia")
    except Exception:
        pass
    _prov.load_from_data(theme_css(THEME).encode())
    # Regenerar el CSS de headerbar, menús, paned separator, notebook border
    # con los colores del NUEVO tema — sin esto queda "oscuro" en modo día.
    try:
        _HB_CSS.load_from_data(_build_hb_css())
        _PANED_CSS.load_from_data((
            b"paned.cc-paned > separator,paned.cc-paned separator{"
            b" background:transparent;background-image:none;"
            b" background-color:transparent;"
            b" border:0;box-shadow:none;"
            b" min-width:0;min-height:0;margin:0;padding:0;"
            b"}"
            b"notebook.cc-notebook,notebook.cc-notebook > header,"
            b"notebook.cc-notebook > stack,notebook.cc-notebook > stack > *,"
            b"notebook.cc-notebook scrolledwindow,notebook.cc-notebook frame,"
            b"notebook.cc-notebook viewport{"
            b" border-top:0;border-right:0;border-bottom:0;"
            b" box-shadow:none;outline:none;"
            b"}"
            b"notebook.cc-notebook{"
            b" border-left:1px solid " + THEME["line"].encode() + b";"
            b" border-radius:0;"
            b"}"
        ))
    except Exception as e:
        print(f"apply_theme CSS reload err: {e}")
    for button, icon_name, icon_size in list(globals().get("_THEMED_ICON_BUTTONS", [])):
        try:
            button.set_image(_themed_icon_image(icon_name, icon_size))
        except Exception:
            pass
    for i in range(nb.get_n_pages()):
        t = getattr(nb.get_nth_page(i), "_term", None)
        if t:
            t.set_colors(rgba(THEME["fg"]), rgba(THEME["bg"]),
                         [rgba(p) for p in THEME["pal"]])
            t.set_color_cursor(rgba(THEME["cursor"]))
    # Tmux status bar — respetá el tema también. Sin esto la barra inferior
    # se veía oscura en modo día.
    _apply_tmux_theme()


def _apply_tmux_theme():
    bg    = THEME["bar"]
    fg    = THEME["dim"]
    brand = THEME["brand"]
    text  = THEME["text"]
    line  = THEME["line"]
    for opts in (
        ("status-style",                 f"bg={bg},fg={fg}"),
        ("window-status-style",          f"bg={bg},fg={fg}"),
        ("window-status-current-style",  f"bg={bg},fg={text},bold"),
        ("window-status-activity-style", f"bg={bg},fg={THEME['cursor']},bold"),
        # Conserva el condicional default de tmux: copy-mode se señala en
        # AMARILLO (senal que el usuario usa); fuera de copy-mode, color de marca.
        ("pane-active-border-style",     f"#{{?pane_in_mode,fg=yellow,fg={brand}}}"),
        ("pane-border-style",            f"fg={line}"),
        ("message-style",                f"bg={brand},fg={bg}"),
        # Riel reservado VACIO: el texto @ccmodel detras de la pildora GTK
        # (titulos $$$ / modelo) no se pinta. La pildora es el unico chrome.
        ("pane-border-status",           "top"),
        ("pane-border-format",           " "),
    ):
        tmuxc("set-option", "-g", opts[0], opts[1])

# Pestana "local": tu terminal de control (scratch en HOME). Es el cliente que
# mueven Super+N y los popups. No aparece como tarjeta en el tablero.
hub = make_term("tmux new-session -A -s local -c ~")
# Aplica el tema al tmux status ya en el arranque (idempotente).
GLib.timeout_add(500, lambda: (_apply_tmux_theme(), False)[1])
hub._key = "local"   # la pestana ⌂ opera la sesion tmux "local": sin esto, al pararte
# aqui el tablero seguia "pinneando" la sesion de la pestana anterior (p.ej. Signara)
nb.append_page(hub, tab_label("⌂ local", closable=False))
nb.set_tab_reorderable(hub, False)
nb.connect("page-reordered", on_tab_reordered)

# La pestana ACTIVA de la app: el tablero la usa para que el Centro de Control sea siempre
# el operador de la sesion en la que estas parado.
ACTIVE_TAB_FILE = os.path.expanduser("~/.claude/hooks/app-tab-active.json")
APP_TAB_MODELS_FILE = os.path.expanduser("~/.claude/hooks/app-tab-models.json")


def _report_active_tab(*_):
    page = nb.get_nth_page(nb.get_current_page()) if nb.get_n_pages() else None
    key = getattr(page, "_key", None)
    if not isinstance(key, str):
        return
    try:
        tmp = ACTIVE_TAB_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"session": key.partition(":")[0], "ts": time.time()}, f)
        os.replace(tmp, ACTIVE_TAB_FILE)
    except Exception:
        pass


_tab_models_mtime = 0.0

# ---- Pildoras de modelo POR PANE: ancladas a la linea de titulo de cada
# pane tmux (geometria real de list-panes), con boton de motor. El usuario
# marco ese renglon exacto como el lugar de la info y las acciones.
_PV_HEX = {"claude": "#A78BFA", "codex": "#2DD4BF", "grok": "#FB923C",
           "opencode": "#F0ABFC", "gemini": "#93C5FD", "acp": "#67E8F9",
           "agy": "#93C5FD"}
_STATE_UI = {
    "verified":  ("#4ADE80", "✓"),
    "changing":  ("#FBBF24", "⟳"),
    "detecting": ("#9CA3AF", "◌"),
}


def _dash_js(code):
    try:
        try:
            if paned.get_position() < 420:
                paned.set_position(700)
        except Exception:
            pass
        wv.run_javascript(f"try{{{code}}}catch(e){{}}", None, None, None)
    except Exception:
        pass


def open_ai_session_here(sess, pane):
    """Click derecho en una terminal NORMAL: mismo wizard que el +, pero
    arranca el CLI en ESTE pane (no crea otra pestaña)."""
    cwd = ""
    target = pane or (("=" + sess + ":") if sess else "")
    if target:
        r = tmuxc("display-message", "-p", "-t", target, "#{pane_current_path}")
        cwd = (r.stdout or "").strip()
    if not sess:
        notify_popup("Sin sesión tmux" if ES else "No tmux session",
                     "No pude ver en qué terminal estás" if ES else "Could not see this terminal")
        return
    _dash_js(
        f"nsOpenForPane({json.dumps(sess)},{json.dumps(pane or '')},{json.dumps(cwd)})"
    )


def _esc(t):
    return GLib.markup_escape_text(str(t or ""))


_PV_ICON = {"claude": "anthropic", "codex": "openai", "grok": "grok",
            "acp": "layers", "opencode": "layers", "agy": "gemini"}


def _svg_image(name, size, color):
    """Logo SVG tintado con un color puntual (no el dim del tema)."""
    svg_path = os.path.join(_ICONS_DIR, f"{name}.svg")
    try:
        with open(svg_path, "rb") as f:
            data = f.read().replace(b"currentColor", color.encode())
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(data); loader.close()
        return Gtk.Image.new_from_pixbuf(loader.get_pixbuf())
    except Exception:
        return Gtk.Label(label="⬤")


def _attach_model_bar(box, sess):
    """Envuelve la VTE en un Gtk.Overlay para flotar pildoras sobre la linea
    de titulo de cada pane. No cambia el layout term+scrollbar (aprendido:
    meter una barra al box horizontal recortaba la terminal)."""
    term = getattr(box, "_term", None)
    if term is None:
        return
    ov = Gtk.Overlay()
    pos = 0
    for i, ch in enumerate(box.get_children()):
        if ch is term:
            pos = i
            break
    box.remove(term)
    ov.add(term)
    box.pack_start(ov, True, True, 0)
    box.reorder_child(ov, pos)
    box._pill_overlay = ov
    box._pill_sess = sess
    box._pill_sig = ""
    box._pills = []
    term.connect("size-allocate", lambda *_a, b=box: setattr(b, "_pill_sig", ""))
    box.show_all()


def _pane_geometry(sess):
    try:
        out = subprocess.run(
            ["tmux", "list-panes", "-t", f"={sess}", "-F",
             "#{pane_id} #{pane_left} #{pane_top} #{pane_width}"],
            capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return {}
    geo = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 4 and parts[0].startswith("%"):
            geo[parts[0]] = (int(parts[1]), int(parts[2]), int(parts[3]))
    return geo


def _pane_pill(sess, p):
    """Pildora MINIMALISTA: logo(s) de marca + modelo + glifo de certeza +
    engrane. Sin texto redundante: el logo ES la identidad; el tooltip
    carga todo el detalle (harness→motor, cuentas, pane, estado)."""
    harness, motor = p.get("harness") or "?", p.get("motor") or "?"
    state = p.get("state") or "detecting"
    scol, sglyph = _STATE_UI.get(state, _STATE_UI["detecting"])
    fg = THEME.get("fg", "#ECECEC")
    dim = "#8A8F98"
    pill = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    pill.get_style_context().add_class("pane-pill")
    pill.get_style_context().add_class(f"pp-{motor if motor in _PV_HEX else 'x'}")
    pill.set_valign(Gtk.Align.START)
    if motor != harness and harness in _PV_ICON:
        pill.pack_start(_svg_image(_PV_ICON[harness], 12, dim), False, False, 0)
    pill.pack_start(_svg_image(_PV_ICON.get(motor, "layers"), 15, fg), False, False, 0)
    lab = Gtk.Label()
    if state == "changing":
        lab.set_markup(f'<span foreground="{fg}" weight="bold">{_esc("→ " + (p.get("target") or "…"))}</span>')
    elif state == "verified":
        lab.set_markup(f'<span foreground="{fg}" weight="bold">{_esc(p.get("model"))}</span>'
                       + (f'<span foreground="{dim}"> {_esc(p.get("effort"))}</span>' if p.get("effort") else ""))
    else:
        lab.set_markup(f'<span foreground="{dim}">…</span>')
    pill.pack_start(lab, False, False, 0)
    # UNICO acento de color en toda la pildora: el estado. Verde=confia,
    # ambar=espera, gris=aun no se sabe. Cero carga cognitiva extra.
    st = Gtk.Label()
    st.set_markup(f'<span foreground="{scol}" weight="bold">{sglyph}</span>')
    pill.pack_start(st, False, False, 0)
    accts = ""
    ha, ma = p.get("hAcct") or "", p.get("mAcct") or ""
    if ha and ha != "unknown":
        accts = ha + ("" if not ma or ma in ("unknown", ha) else "→" + ma)
    pill.set_tooltip_text(f"{harness} → {motor} · {p.get('model') or '?'}"
                          + (f" · {p.get('effort')}" if p.get("effort") else "")
                          + (f" · {p.get('tierSym')}" if p.get("tierSym") else "")
                          + (f" · cuenta {accts}" if accts else "")
                          + (f" · pane {p.get('pane')}" if p.get("pane") else "")
                          + {"verified": " · verificado en el proceso vivo",
                             "changing": " · cambio de motor en curso",
                             "detecting": " · detectando, aun sin confirmar"}.get(state, ""))
    b = Gtk.Button()
    b.add(_svg_image("settings", 12, dim))
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.get_style_context().add_class("pill-btn")
    b.set_tooltip_text("Cambiar motor / modelo / cuenta de ESTE pane" if ES else "Switch this pane's motor/model/account")
    b.connect("clicked", lambda *_, s=sess, pn=(p.get("pane") or ""): _dash_js(f"openMotorFor({json.dumps(s)},{json.dumps(pn)})"))
    pill.pack_start(b, False, False, 0)
    return pill


def _place_pills(box, panes):
    ov = getattr(box, "_pill_overlay", None)
    term = getattr(box, "_term", None)
    if ov is None or term is None:
        return
    for w in getattr(box, "_pills", []):
        try: ov.remove(w)
        except Exception: pass
    box._pills = []
    if not panes:
        return
    geo = _pane_geometry(getattr(box, "_pill_sess", ""))
    try:
        cw = term.get_char_width(); chh = term.get_char_height()
    except Exception:
        return
    if cw < 4 or chh < 6:
        box._pill_sig = ""      # fuente aun no lista: reintenta al siguiente tick
        return
    m_l = term.get_margin_start(); m_t = term.get_margin_top()
    for p in panes[:6]:
        g = geo.get(p.get("pane") or "")
        if not g:
            continue
        left, top, width = g
        pill = _pane_pill(getattr(box, "_pill_sess", ""), p)
        # anclada al INICIO de cada pane, SOBRE el renglon de titulo tmux
        # que va vacio (riel reservado): no tapa contenido y la posicion es
        # determinista sin medir anchos de widget
        pill.set_halign(Gtk.Align.START)
        pill.set_valign(Gtk.Align.START)
        # Sobre el renglón de borde tmux (vacío). Sin -3: ese offset metía la
        # pildora en la statusline del TUI (Grok/Claude) y el titulo se veía detrás.
        pill.set_margin_top(max(0, m_t + max(0, top) * chh))
        pill.set_margin_start(max(0, int(m_l + left * cw + cw)))
        ov.add_overlay(pill)
        pill.show_all()
        box._pills.append(pill)


def _refresh_tab_models():
    global _tab_models_mtime
    force = False
    try:
        mtime = os.path.getmtime(APP_TAB_MODELS_FILE)
        force = mtime != _tab_models_mtime
        _tab_models_mtime = mtime
        with open(APP_TAB_MODELS_FILE) as f:
            models = json.load(f)
    except Exception:
        return True
    pages = list(tabs.items())
    if hub not in tabs.values():
        pages.append(("local", hub))
    current = nb.get_nth_page(nb.get_current_page())
    for key, box in pages:
        session = str(key).partition(":")[0]
        info = models.get(session) if isinstance(models, dict) else None
        hb = nb.get_tab_label(box)
        label = getattr(hb, "_model", None)
        # la pestana ⌂ local NO lleva sufijo de modelo (infla el tab strip);
        # SEMANTICA: logo del proveedor + modelo corto (no "Claude · fable")
        micon = getattr(hb, "_micon", None)
        if label is not None and box is not hub:
            panes = (info or {}).get("panes") if isinstance(info, dict) else None
            first = next((p for p in (panes or []) if p.get("model")), None)
            if first:
                extra = len([p for p in panes if p.get("model")]) - 1
                label.set_text(f"{first['model']}{f' +{extra}' if extra > 0 else ''}")
                if micon is not None:
                    try:
                        img = _svg_image(_PV_ICON.get(first.get("motor"), "layers"), 11,
                                         THEME.get("dim", "#9AA6BF"))
                        micon.set_from_pixbuf(img.get_pixbuf())
                        micon.show()
                    except Exception:
                        micon.hide()
            else:
                label.set_text("")
                if micon is not None: micon.hide()
        elif micon is not None:
            micon.hide()
        if getattr(box, "_pill_overlay", None) is None or box is not current:
            continue
        panes = (info or {}).get("panes") if isinstance(info, dict) else None
        try:
            metrics = f"{box._term.get_char_width()}x{box._term.get_char_height()}w{getattr(box, '_pill_overlay', None) and box._pill_overlay.get_allocated_width()}"
        except Exception:
            metrics = ""
        sig = json.dumps(panes or [], sort_keys=True) + "|" + json.dumps(sorted(_pane_geometry(session).items())) + "|" + metrics
        if force or sig != getattr(box, "_pill_sig", ""):
            box._pill_sig = sig
            _place_pills(box, panes or [])
    return True


nb.connect("switch-page", lambda *_: GLib.idle_add(_report_active_tab))
_attach_model_bar(hub, "local")
GLib.timeout_add_seconds(2, _refresh_tab_models)

# Navegación de tabs sin Alt: Ctrl+Tab alterna las DOS últimas (ping-pong MRU),
# Ctrl+PgUp/PgDn ciclan. Ninguna llega al terminal (VTE no genera secuencia
# para Ctrl+Tab) ni choca con tmux/readline/Claude Code.
_MRU_PAGES = []


def _track_mru(_nb, page, _idx):
    try:
        if page in _MRU_PAGES:
            _MRU_PAGES.remove(page)
        _MRU_PAGES.append(page)
        del _MRU_PAGES[:-2]
    except Exception:
        pass


nb.connect("switch-page", _track_mru)


def _mru_toggle():
    if len(_MRU_PAGES) >= 2:
        num = nb.page_num(_MRU_PAGES[-2])
        if num >= 0:
            nb.set_current_page(num)
            return True
    return False


def _cycle_tab(step):
    n = nb.get_n_pages()
    if n:
        nb.set_current_page((nb.get_current_page() + step) % n)

# Barra de pestanas: boton "+" (nueva terminal) y "?" (atajos)
def _themed_icon_image(name, size=16):
    svg_path = os.path.join(_ICONS_DIR, f"{name}.svg")
    if os.path.isfile(svg_path):
        try:
            with open(svg_path, "rb") as f:
                data = f.read().replace(b"currentColor", THEME.get("dim", "#9AA6BF").encode())
            loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
            loader.set_size(size, size)
            loader.write(data); loader.close()
            pixbuf = loader.get_pixbuf()
        except Exception:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(svg_path, size, size)
        return Gtk.Image.new_from_pixbuf(pixbuf)
    return Gtk.Image.new_from_icon_name(name, Gtk.IconSize.SMALL_TOOLBAR)


def _icon_btn(name, tooltip, on_click, size=16):
    """Botón chico con SVG Lucide de dash/icons/. Es LA MISMA familia que usa
    el dashboard HTML — así la app tiene un solo set de iconos consistente
    (antes mezclabamos Adwaita en GTK + Lucide en HTML, se veían distintos)."""
    b = Gtk.Button()
    b.set_image(_themed_icon_image(name, size))
    _THEMED_ICON_BUTTONS.append((b, name, size))
    b.set_always_show_image(True)
    b.get_style_context().add_class("tabplus")
    b.set_relief(Gtk.ReliefStyle.NONE)
    b.set_tooltip_text(tooltip)
    b.connect("clicked", on_click)
    return b


