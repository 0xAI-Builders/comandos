# Solo el "+" (nueva sesión). Copiar/pestañas/buscar/snippets/ayuda siguen
# disponibles por atajos y menús, pero NO en la barra (el usuario no los usa).
# ---- Modo MOSAICO (Ctrl+G): TODAS las sesiones en un grid de terminales
# VIVAS y operables. tmux window-size=latest evita encoger las pestañas
# grandes: cada ventana se dimensiona al cliente activo mas reciente.
_MOSAIC = {"on": False, "box": None, "terms": []}


def _tween(widget, apply_fn, v_from, v_to, ms=150, done=None):
    """Interpolacion suave ease-out-cubic ligada al reloj de frames de GTK.
    apply_fn(t) recibe el valor interpolado 0..1 ya aplicado a v_from->v_to."""
    start = [None]

    def _tick(w, clock):
        now = clock.get_frame_time()
        if start[0] is None:
            start[0] = now
        t = min(1.0, (now - start[0]) / (ms * 1000.0))
        e = 1 - (1 - t) ** 3
        apply_fn(v_from + (v_to - v_from) * e)
        if t >= 1.0:
            if done:
                done()
            return False
        return True
    widget.add_tick_callback(_tick)


def _mosaic_sessions():
    try:
        r = subprocess.run(["tmux", "ls", "-F", "#S"], capture_output=True,
                           text=True, timeout=3)
        names = [n for n in r.stdout.splitlines() if n]
    except Exception:
        names = []
    labels = {}
    try:
        with open(TABS_FILE) as f:
            labels = json.load(f) or {}
    except Exception:
        pass
    out = [(labels.get(n) or n, n) for n in names]
    out.sort(key=lambda x: (x[1] != "local", str(x[0]).lower()))
    return out[:12]


def _mosaic_close():
    if not _MOSAIC["on"]:
        return
    for t in _MOSAIC["terms"]:
        try:
            t._respawn = False
        except Exception:
            pass
    box = _MOSAIC["box"]
    _MOSAIC.update(on=False, box=None, terms=[], cells=[])
    try:
        paned.remove(box)
        box.destroy()
    except Exception:
        pass
    nb.show()
    paned.pack2(nb, True, False)
    try:
        paned.set_position(int(_MOSAIC.get("paned_pos") or 0) or paned.get_position() or 700)
    except Exception:
        pass
    if cur_term():
        cur_term().grab_focus()


def _mosaic_open():
    if _MOSAIC["on"]:
        return
    sessions = _mosaic_sessions()
    if not sessions:
        return
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    head.get_style_context().add_class("mosaic-head")
    ttl = Gtk.Label(xalign=0)
    ttl.set_markup(f'<span weight="bold">⊞ {"Mosaico" if ES else "Mosaic"}</span>'
                   f'<span foreground="#8A8F98"> · {len(sessions)} '
                   f'{"sesiones — click en una celda para teclear ahí" if ES else "sessions — click a cell to type there"}</span>')
    head.pack_start(ttl, True, True, 8)
    x = _icon_btn("close", "Cerrar mosaico (Ctrl+G)" if ES else "Close mosaic (Ctrl+G)",
                  lambda *_: _mosaic_close(), size=14)
    head.pack_end(x, False, False, 4)

    def _side_toggle(*_):
        if paned.get_position() < 60:
            paned.set_position(int(_MOSAIC.get("paned_pos") or 620))
        else:
            paned.set_position(0)
    sb = _icon_btn("layers", "Mostrar/ocultar el tablero lateral" if ES else "Show/hide the side dashboard",
                   _side_toggle, size=14)
    head.pack_end(sb, False, False, 0)
    outer.pack_start(head, False, False, 0)
    grid = Gtk.Grid()
    grid.set_row_spacing(4)
    grid.set_column_spacing(4)
    n = len(sessions)
    cols = 2 if n <= 4 else 3 if n <= 9 else 4
    rows_n = max(1, -(-n // cols))
    base, extra = divmod(n, rows_n)
    row_sizes = [base + (1 if r < extra else 0) for r in range(rows_n)]
    UNITS = 12
    slots = []
    for r, size in enumerate(row_sizes):
        span = UNITS // max(1, size)
        used = 0
        for j in range(size):
            w = span if j < size - 1 else UNITS - used
            slots.append((r, used, w))
            used += w
    _MOSAIC["cells"] = []
    cells = []
    # 1) el grid abre AL INSTANTE con placeholders; nada de congelar la UI
    for i, (label, sess) in enumerate(sessions):
        cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        cell.get_style_context().add_class("mosaic-cell")
        trow = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        trow.get_style_context().add_class("mosaic-cell-title")
        cl = Gtk.Label(xalign=0)
        cl.set_markup(f'<span size="small" weight="bold" foreground="#C9CDD4"> {GLib.markup_escape_text(str(label))}</span>')
        clev = Gtk.EventBox(); clev.add(cl)
        clev.set_tooltip_text("Click: enfocar esta sesión en grande" if ES else "Click: focus this session big")
        clev.connect("button-press-event", lambda *_a, ss=sess, ll=label: (_mosaic_zoom(ss, ll), True)[1])
        trow.pack_start(clev, True, True, 0)
        zb = _icon_btn("maximize", "Enfocar en grande (con sus splits)" if ES else "Focus big (with its splits)",
                       lambda *_a, ss=sess, ll=label: _mosaic_zoom(ss, ll), size=12)
        trow.pack_end(zb, False, False, 1)
        cell.pack_start(trow, False, False, 1)
        ph = Gtk.Label(label="· · ·")
        ph.get_style_context().add_class("mosaic-ph")
        cell.pack_start(ph, True, True, 0)
        cell._mos_ph = ph
        r, cx, wspan = slots[i]
        cell.set_hexpand(True); cell.set_vexpand(True)
        grid.attach(cell, cx, r, wspan, 1)
        _MOSAIC["cells"].append(cell)
        cells.append((cell, label, sess))
    outer.pack_start(grid, True, True, 0)
    paned.remove(nb)
    nb.hide()
    paned.pack2(outer, True, False)
    outer.show_all()
    _MOSAIC["paned_pos"] = paned.get_position()
    paned.set_position(0)
    _MOSAIC.update(on=True, box=outer)

    # 2) conectar terminales de forma PROGRESIVA (una por tick de ~40ms):
    #    la vista responde de inmediato y las celdas van encendiendo
    def _fill(i=0):
        if not _MOSAIC["on"] or _MOSAIC["box"] is not outer or i >= len(cells):
            return False
        cell, label, sess = cells[i]
        try:
            tbox = _mosaic_term(f"tmux attach -t '={sess}'")
            tbox._term._session_hint = sess

            def _cell_focus_in(_t, _e, c=cell):
                for other in _MOSAIC.get("cells", []):
                    if other is not c and getattr(other, "_mos_grown", False):
                        _shrink_cell(other)
                    other.get_style_context().remove_class("focused")
                if getattr(c, "_mos_base", None) is None:
                    a = c.get_allocation()
                    if a.width > 50:
                        c._mos_base = (a.width, a.height)
                base = getattr(c, "_mos_base", None)
                if base and not getattr(c, "_mos_grown", False):
                    c._mos_grown = True
                    bw, bh = base
                    _tween(c, lambda v, cc=c, bw=bw, bh=bh:
                           cc.set_size_request(int(bw + (bw * 0.12) * v),
                                               int(bh + (bh * 0.12) * v)),
                           0.0, 1.0, ms=160)
                c.get_style_context().add_class("focused")
                return False

            def _cell_focus_out(_t, _e, c=cell):
                _shrink_cell(c)
                c.get_style_context().remove_class("focused")
                return False

            def _cell_press(_t, ev, c=cell, ss=sess, ll=label):
                if ev.type == Gdk.EventType._2BUTTON_PRESS and ev.button == 1:
                    _mosaic_zoom(ss, ll)
                    return True
                c.get_style_context().add_class("tap")
                GLib.timeout_add(160, lambda cc=c: (cc.get_style_context().remove_class("tap"), False)[1])
                return False

            tbox._term.connect("focus-in-event", _cell_focus_in)
            tbox._term.connect("focus-out-event", _cell_focus_out)
            tbox._term.connect("button-press-event", _cell_press)
            _MOSAIC["terms"].append(tbox._term)
            ph = getattr(cell, "_mos_ph", None)
            if ph is not None:
                cell.remove(ph)
                cell._mos_ph = None
            cell.pack_start(tbox, True, True, 0)
            tbox.show_all()
        except Exception:
            pass
        GLib.timeout_add(25, _fill, i + 1)
        return False
    GLib.timeout_add(10, _fill, 0)


def _mosaic_term(cmd):
    """VTE minima para celdas: spawn ASINCRONO (no bloquea la UI), sin
    regexes de links, scrollback corto, sin scrollbar. El peso completo
    vive en las pestañas y en el modal de enfoque, no aqui."""
    term = Vte.Terminal()
    term.set_font(Pango.FontDescription(FONT))
    term.set_colors(rgba(THEME["fg"]), _bg_rgba(), [rgba(p) for p in THEME["pal"]])
    term.set_scrollback_lines(400)
    term.set_audible_bell(False)
    term.set_cursor_blink_mode(Vte.CursorBlinkMode.OFF)
    try:
        term.spawn_async(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"),
                         ["/bin/sh", "-lc", cmd], None,
                         GLib.SpawnFlags.DEFAULT, None, None, -1, None, None)
    except TypeError:
        term.spawn_async(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"),
                         ["/bin/sh", "-lc", cmd], None,
                         GLib.SpawnFlags.DEFAULT, None, None, -1, None, None, None)
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.pack_start(term, True, True, 0)
    box._term = term
    term._respawn = False
    return box


def _shrink_cell(c):
    base = getattr(c, "_mos_base", None)
    if not getattr(c, "_mos_grown", False):
        c.set_size_request(-1, -1)
        return
    c._mos_grown = False
    if base:
        bw, bh = base
        _tween(c, lambda v, cc=c, bw=bw, bh=bh:
               cc.set_size_request(int(bw + (bw * 0.12) * v),
                                   int(bh + (bh * 0.12) * v)),
               1.0, 0.0, ms=140,
               done=lambda cc=c: cc.set_size_request(-1, -1))
    else:
        c.set_size_request(-1, -1)


def _mosaic_zoom(sess, label):
    """Enfocar UNA sesion en un modal casi-fullscreen: operar rapido con
    todos sus splits, Esc o ✕ para volver al mosaico."""
    dlg = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    dlg.set_transient_for(win)
    dlg.set_modal(True)
    dlg.set_decorated(False)
    w, h = win.get_size()
    dlg.set_default_size(max(600, w - 90), max(400, h - 70))
    dlg.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    box.get_style_context().add_class("mosaic-zoom")
    head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    head.get_style_context().add_class("mosaic-head")
    tl = Gtk.Label(xalign=0)
    tl.set_markup(f'<span weight="bold"> ⛶ {GLib.markup_escape_text(str(label))}</span>'
                  f'<span foreground="#8A8F98" size="small">  · Esc {"para volver al mosaico" if ES else "back to mosaic"}</span>')
    head.pack_start(tl, True, True, 8)

    def _zoom_out(*_):
        if getattr(dlg, "_closing", False):
            return
        dlg._closing = True
        _tween(dlg, lambda v: dlg.set_opacity(v), 1.0, 0.0, ms=120,
               done=dlg.destroy)
    xb = _icon_btn("close", "Volver al mosaico (Esc)" if ES else "Back to mosaic (Esc)",
                   lambda *_: _zoom_out(), size=14)
    head.pack_end(xb, False, False, 4)
    box.pack_start(head, False, False, 0)
    tbox = make_term(f"tmux attach -t '={sess}'")
    tbox._term._session_hint = sess
    box.pack_start(tbox, True, True, 0)
    dlg.add(box)

    def _zoom_key(_w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            _zoom_out()
            return True
        return False
    dlg.connect("key-press-event", _zoom_key)
    dlg.connect("destroy", lambda *_: setattr(tbox._term, "_respawn", False))
    dlg.set_opacity(0.0)
    dlg.show_all()
    _tween(dlg, lambda v: dlg.set_opacity(v), 0.0, 1.0, ms=150)
    tbox._term.grab_focus()


def _mosaic_toggle(*_):
    _mosaic_close() if _MOSAIC["on"] else _mosaic_open()


# SIGUSR2 alterna el mosaico (verificacion headless y automatizaciones):
#   kill -USR2 $(pgrep -f cc-app)
try:
    import signal as _signal
    _signal.signal(_signal.SIGUSR2,
                   lambda *_a: GLib.idle_add(_mosaic_toggle))
    # NUNCA usar SIGUSR1 aqui: JavaScriptCore (WebKit) lo usa para GC y
    # pisarle el handler desestabiliza/mata el proceso. Para debug remoto
    # del webview usamos una señal de tiempo real (WebKit no las toca):
    #   kill -RTMIN+2 <pid>  abre el panel de notifs y loguea NFDBG a stdout.
    _signal.signal(_signal.SIGRTMIN + 2,
                   lambda *_a: GLib.idle_add(lambda: _dash_js(
                       'document.getElementById("btn-notif").click();'
                       'setTimeout(()=>console.log("NFDBG cards=",'
                       'document.querySelectorAll("#notif-panel .nf2").length,'
                       '"panel=",(getComputedStyle(document.getElementById("notif-panel")||document.body).display),'
                       '"badge=",document.getElementById("notif-badge").textContent,'
                       '"webBtns=",document.querySelectorAll(".nf2-web").length), 2500)')))

    #   kill -RTMIN+3 <pid>  ejecuta el JS de $XDG_RUNTIME_DIR/comandos-dbg.js
    #   en el webview del dashboard (debug local; dir 0700 del usuario, nunca
    #   /tmp compartido donde otro uid podria plantar el archivo).
    _DBG_JS = os.path.join(os.environ.get("XDG_RUNTIME_DIR")
                           or f"/tmp/comandos-{os.getuid()}", "comandos-dbg.js")

    def _dbg_js_file(*_a):
        try:
            if os.stat(_DBG_JS).st_uid != os.getuid():
                return
            with open(_DBG_JS) as fh:
                code = fh.read()
        except OSError:
            return
        try:
            print("NFGTK paned_pos=", paned.get_position(),
                  "wv_alloc=", wv.get_allocated_width(), "x", wv.get_allocated_height(),
                  "zoom=", wv.get_zoom_level(), flush=True)
        except Exception:
            pass
        GLib.idle_add(lambda: _dash_js(code))
    _signal.signal(_signal.SIGRTMIN + 3, _dbg_js_file)
except Exception:
    pass



_mosaic_btn = _icon_btn("grid",
                        "Mosaico: TODAS las sesiones en una pantalla (Ctrl+G)" if ES
                        else "Mosaic: ALL sessions on one screen (Ctrl+G)",
                        _mosaic_toggle, size=17)
_headerbar.pack_end(_mosaic_btn)
_headerbar.pack_end(_plus)


def _cycle_page(delta):
    n = nb.get_n_pages()
    if n:
        nb.set_current_page((nb.get_current_page() + delta) % n)


_tab_prev = _icon_btn("chevron-left",
                      "Pestaña anterior (Ctrl+PgUp)" if ES else "Previous tab (Ctrl+PgUp)",
                      lambda *_: _cycle_page(-1), size=20)
_tab_next = _icon_btn("chevron-right",
                      "Pestaña siguiente (Ctrl+PgDn)" if ES else "Next tab (Ctrl+PgDn)",
                      lambda *_: _cycle_page(1), size=20)
for _b in (_tab_prev, _tab_next):
    _b.get_style_context().add_class("tabnav")
    _b.show_all()
# FLANQUEANDO el tab strip (donde el pulgar ya los busca), no escondidos
# en el headerbar: action widgets del notebook, izquierda y derecha.
nb.set_action_widget(_tab_prev, Gtk.PackType.START)
nb.set_action_widget(_tab_next, Gtk.PackType.END)
_headerbar.show_all()

# Puente tablero -> app: las tarjetas piden abrir pestanas aqui
ucm = WebKit2.UserContentManager()


_WEBMODAL = {"win": None, "wv": None, "title": None}


def open_web_modal(url, label=""):
    """Navegador MODAL ultraligero: UN solo WebView cacheado que se reutiliza
    para todos los links (cero procesos web nuevos por click). Esc lo oculta
    sin destruirlo — reabrir es instantaneo."""
    if _WEBMODAL["win"] is None:
        dlg = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        dlg.set_transient_for(win)
        dlg.set_modal(True)
        dlg.set_decorated(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.get_style_context().add_class("mosaic-zoom")
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        head.get_style_context().add_class("mosaic-head")
        tl = Gtk.Label(xalign=0)
        tl.set_ellipsize(Pango.EllipsizeMode.END)
        head.pack_start(tl, True, True, 8)
        xb = _icon_btn("close", "Cerrar (Esc)" if ES else "Close (Esc)",
                       lambda *_: dlg.hide(), size=14)
        head.pack_end(xb, False, False, 4)
        box.pack_start(head, False, False, 0)
        wv2 = WebKit2.WebView()
        box.pack_start(wv2, True, True, 0)
        dlg.add(box)
        dlg.connect("key-press-event",
                    lambda _w, ev: (dlg.hide(), True)[1] if ev.keyval == Gdk.KEY_Escape else False)
        dlg.connect("delete-event", lambda *_: (dlg.hide(), True)[1])
        _WEBMODAL.update(win=dlg, wv=wv2, title=tl)
    w, h = win.get_size()
    _WEBMODAL["win"].set_default_size(max(640, w - 120), max(420, h - 90))
    _WEBMODAL["win"].set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
    _WEBMODAL["title"].set_markup(
        f'<span weight="bold"> 🌐 {GLib.markup_escape_text((label or url)[:80])}</span>'
        f'<span foreground="#8A8F98" size="small">  · Esc {"cierra" if ES else "closes"}</span>')
    _WEBMODAL["wv"].load_uri(url)
    _WEBMODAL["win"].show_all()
    return False


def open_web_tab(url, label=""):
    """Navegador DENTRO de ComandOS: una pestaña WebKit para leer noticias
    sin salir de la app. Cerrable como cualquier pestaña."""
    key = f"web:{url[:120]}"
    if key in tabs:
        nb.set_current_page(nb.page_num(tabs[key]))
        return False
    wv2 = WebKit2.WebView()
    wv2.load_uri(url)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.pack_start(wv2, True, True, 0)
    box._term = None
    box._webview = wv2
    box._key = key
    box._label = ("🌐 " + (label or url.split("/")[2]))[:40]
    idx = nb.append_page(box, tab_label(box._label, key))
    nb.set_tab_reorderable(box, True)
    box.show_all()
    nb.set_current_page(idx)
    tabs[key] = box
    return False


def on_msg(mgr, res):
    try:
        d = json.loads(res.get_js_value().to_string())
        if d.get("theme"):
            apply_theme(d["theme"])
            return
        if d.get("openUrlModal"):
            u = str(d.get("openUrlModal"))[:2000]
            if u.startswith("http://") or u.startswith("https://"):
                GLib.idle_add(open_web_modal, u, str(d.get("label") or "")[:80])
            return
        if d.get("openUrl"):
            u = str(d.get("openUrl"))[:2000]
            if u.startswith("http://") or u.startswith("https://"):
                GLib.idle_add(open_web_tab, u, str(d.get("label") or "")[:60])
            return
        if d.get("type") == "rename":
            sess = d.get("session", "")
            label = d.get("label", "")
            box = tabs.get(sess)
            if box is not None and isinstance(label, str) and label.strip():
                set_tab_label(box, label.strip())
            return
        label = d.get("label", None)
        open_tab(d.get("session", ""), d.get("win", "claude"),
                 label=label if isinstance(label, str) and label else None)
    except Exception as e:
        print(f"mensaje invalido del tablero: {e}")


ucm.register_script_message_handler("centro")
ucm.connect("script-message-received::centro", on_msg)

wv = WebKit2.WebView.new_with_user_content_manager(ucm)
try:
    # errores JS del tablero al stdout/log del app: sin esto los bugs del
    # webview (motor WebKitGTK != Chrome) son invisibles
    wv.get_settings().set_property("enable-write-console-messages-to-stdout", True)
except Exception:
    pass
wv.get_settings().set_property("enable-developer-extras", True)
wv.get_settings().set_property("enable-webaudio", True)


def on_perm(view, request):
    # Sin esto, WebKit niega Notification.requestPermission y el switch
    # de "Notificaciones del navegador" fallaba siempre dentro de la app
    if isinstance(request, WebKit2.NotificationPermissionRequest):
        request.allow()
        return True
    return False


wv.connect("permission-request", on_perm)
wv.load_uri(URL)
wv.connect("load-failed", lambda v, e, u, err:
           (GLib.timeout_add_seconds(2, lambda: (wv.load_uri(URL), False)[1]), True)[1])

