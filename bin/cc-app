def rgba(h):
    c = Gdk.RGBA()
    c.parse(h)
    return c


def tmuxc(*args):
    try:
        return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=5)
    except Exception:
        return subprocess.CompletedProcess(args, 1, "", "")


def http_post(path, payload, timeout=15):
    req = urllib.request.Request(
        "http://127.0.0.1:4777" + path,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode()), None
    except urllib.error.HTTPError as e:
        try:
            return None, json.loads(e.read().decode()).get("error", str(e))
        except Exception:
            return None, str(e)
    except Exception as e:
        return None, str(e)


def http_ensure(sess, win_name="claude"):
    http_post("/ensure", {"session": sess, "win": win_name})


# ---------- snippets store (spejo del cc-dash) ----------
SNIPPETS_FILE = os.path.expanduser("~/.claude/hooks/snippets.json")


def snip_load():
    try:
        with open(SNIPPETS_FILE) as f:
            data = json.load(f)
        return data if isinstance(data, list) else []
    except FileNotFoundError:
        return []
    except Exception:
        return []


def snip_save(items):
    tmp = SNIPPETS_FILE + ".tmp"
    os.makedirs(os.path.dirname(SNIPPETS_FILE), exist_ok=True)
    with open(tmp, "w") as f:
        json.dump(items, f)
    os.replace(tmp, SNIPPETS_FILE)


SNIP_LOG_FILE = "/tmp/cc-app-snip.log"


def _snip_env_snapshot():
    """Escribe estado del display server al inicio para el debug."""
    try:
        if not os.path.exists(SNIP_LOG_FILE):
            return
        with open(SNIP_LOG_FILE, "a") as f:
            f.write("=" * 60 + "\n")
            f.write(f"cc-app startup {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
            for k in ("DISPLAY", "WAYLAND_DISPLAY", "XDG_SESSION_TYPE",
                     "GDK_BACKEND", "XDG_CURRENT_DESKTOP", "WSL_DISTRO_NAME",
                     "PULSE_SERVER"):
                f.write(f"  {k}={os.environ.get(k, '<unset>')}\n")
            f.write("=" * 60 + "\n")
    except Exception:
        pass


_snip_env_snapshot()


def snip_log(msg):
    """Log opt-in del SnippetsDialog para diagnostico. Escribe a
    /tmp/cc-app-snip.log si el archivo existe; touch para activar, borrar
    para desactivar. Silencioso por default en uso normal."""
    try:
        if not os.path.exists(SNIP_LOG_FILE):
            return
        with open(SNIP_LOG_FILE, "a") as f:
            ts = time.strftime("%H:%M:%S") + f".{int((time.time()%1)*1000):03d}"
            f.write(f"[{ts}] {msg}\n")
    except Exception:
        pass


def snip_paste(sess, text):
    """Pega `text` en la sesion tmux `sess` usando bracketed paste. NUNCA ejecuta.

    Secuencia: load-buffer (via stdin) -> paste-buffer -p -> delete-buffer.
    El shell moderno buffea el texto y espera al usuario para ejecutar."""
    # has-session usa `=<sess>` (session-target). paste-buffer usa `=<sess>:`
    # (pane-target: sesion + ventana/pane activos) — tmux 3.2a exige el `:`
    # final si no aparece un window index, como en cc-dash.
    session_target = "=" + sess
    pane_target = "=" + sess + ":"
    r = subprocess.run(["tmux", "has-session", "-t", session_target],
                       capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        return f"No hay sesion tmux '{sess}'"
    r = subprocess.run(["tmux", "load-buffer", "-b", "comandos-snip", "-"],
                       input=text, capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        subprocess.run(["tmux", "delete-buffer", "-b", "comandos-snip"],
                       capture_output=True, text=True, timeout=5)
        return r.stderr.strip() or "load-buffer fallo"
    err = None
    r = subprocess.run(["tmux", "paste-buffer", "-p", "-b", "comandos-snip", "-t", pane_target],
                       capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        err = r.stderr.strip() or "paste-buffer fallo"
    subprocess.run(["tmux", "delete-buffer", "-b", "comandos-snip"],
                   capture_output=True, text=True, timeout=5)
    return err


URL_RE = r"https?://[^\s'\"<>\]\)]+"


def normalize_wrapped_url_text(text):
    """Join visual terminal wraps that split a URL across rows."""
    pat = r"https?://(?:[^\s'\"<>\]\)]+|[ \t]*\r?\n[ \t]*[^\s'\"<>\]\)]+)+"
    return re.sub(pat, lambda m: re.sub(r"[ \t]*\r?\n[ \t]*", "", m.group(0)), text or "")


def url_from_wrapped_text(text, fragment="", row=None, col=None):
    pat = r"https?://(?:[^\s'\"<>\]\)]+|[ \t]*\r?\n[ \t]*[^\s'\"<>\]\)]+)+"
    point = None
    if row is not None and col is not None:
        lines = (text or "").splitlines(True)
        if 0 <= row < len(lines):
            point = sum(len(lines[i]) for i in range(row)) + min(max(col, 0), len(lines[row]))
    frag = normalize_wrapped_url_text(fragment or "").strip()
    matches = list(re.finditer(pat, text or ""))
    for m in matches:
        url = re.sub(r"[ \t]*\r?\n[ \t]*", "", m.group(0))
        if frag and (frag in url or url in frag):
            return url
        if point is not None and m.start() <= point < m.end():
            return url
    if not frag and point is None and len(matches) == 1:
        return re.sub(r"[ \t]*\r?\n[ \t]*", "", matches[0].group(0))
    return frag


def cell_at_event(term, event):
    cw = max(1, int(term.get_char_width() or 1))
    ch = max(1, int(term.get_char_height() or 1))
    x = max(0, int(event.x) - int(term.get_margin_start()))
    y = max(0, int(event.y) - int(term.get_margin_top()))
    col = min(max(0, x // cw), max(0, int(term.get_column_count() or 1) - 1))
    top = 0
    adj = term.get_vadjustment()
    if adj:
        top = int((adj.get_value() or 0) // ch) if term.get_scroll_unit_is_pixels() else int(adj.get_value() or 0)
    return top + (y // ch), col


def url_at_event(term, event, match=""):
    try:
        row, col = cell_at_event(term, event)
        cols = max(1, int(term.get_column_count() or 1))
        start = max(0, row - 2)
        text, _attrs = term.get_text_range(start, 0, row + 3, cols, None, None)
        url = url_from_wrapped_text(text or "", match or "", row - start, col)
        if url:
            return url
    except Exception:
        pass
    return normalize_wrapped_url_text(match or "")


def ssh_host_from_session(sess):
    if not isinstance(sess, str):
        return None
    if sess.startswith("ssh-"):
        return sess[4:] or None
    if sess.startswith("sshtab-"):
        host, sep, idx = sess[len("sshtab-"):].rpartition("-")
        if sep and idx.isdigit() and host:
            return host
    return None


_CURSOR_SHAPE_MAP = {
    "block":     Vte.CursorShape.BLOCK,
    "ibeam":     Vte.CursorShape.IBEAM,
    "underline": Vte.CursorShape.UNDERLINE,
}


def _bg_rgba():
    """Background del theme actual con la opacidad configurada. Requiere que
    la ventana tenga visual RGBA (se setea en el bootstrap con set_visual)."""
    c = Gdk.RGBA()
    c.parse(THEME["bg"])
    c.alpha = TERM_OPACITY
    return c


def make_term(argv_sh):
    term = Vte.Terminal()
    term.set_font(Pango.FontDescription(FONT))
    term.set_colors(rgba(THEME["fg"]), _bg_rgba(), [rgba(p) for p in THEME["pal"]])
    term.set_color_cursor(rgba(THEME["cursor"]))
    term.set_cursor_shape(_CURSOR_SHAPE_MAP.get(_CURSOR_SHAPE, Vte.CursorShape.BLOCK))
    term.set_cursor_blink_mode(
        Vte.CursorBlinkMode.ON if _CURSOR_BLINK else Vte.CursorBlinkMode.OFF)
    term.set_scrollback_lines(10000)
    term.set_audible_bell(False)
    term.connect("button-press-event", on_term_button)
    term.connect("button-release-event", on_term_release)
    # Seleccionar = copiar al clipboard del sistema (portapapeles compartido)
    term.connect("selection-changed", lambda t: copy_vte_selection(t))
    # URLs clickeables: click simple (sin arrastre) o Ctrl+click, con manita
    try:
        rx = Vte.Regex.new_for_match(URL_RE, -1, 0x00000400)  # PCRE2_MULTILINE
        tag = term.match_add_regex(rx, 0)
        try:
            term.match_set_cursor_name(tag, "pointer")
        except Exception:
            pass
    except Exception:
        pass
    # Padding alrededor del texto (configurable en Ajustes > Terminal).
    term.set_margin_start(TERM_PADDING + 2); term.set_margin_end(max(0, TERM_PADDING - 4))
    term.set_margin_top(TERM_PADDING); term.set_margin_bottom(max(0, TERM_PADDING - 2))

    # Drag & drop: soltar archivos/carpetas desde Files o el escritorio pega
    # sus RUTAS (shell-quoted) en el prompt — como GNOME Terminal. Nunca
    # ejecuta nada: el texto queda esperando tu Enter.
    _tl = Gtk.TargetList.new([])
    _tl.add_uri_targets(0)
    _tl.add_text_targets(1)
    term.drag_dest_set(Gtk.DestDefaults.ALL, [], Gdk.DragAction.COPY)
    term.drag_dest_set_target_list(_tl)

    def _on_drop(widget, ctx, _x, _y, data, _info, t):
        try:
            uris = data.get_uris()
            if uris:
                paths = []
                for u in uris:
                    pu = urlparse(u)
                    paths.append(shlex.quote(unquote(pu.path)) if pu.scheme == "file"
                                 else shlex.quote(u))
                widget.feed_child((" ".join(paths) + " ").encode())
            else:
                txt = data.get_text()
                if txt:
                    widget.feed_child(txt.encode())
        except Exception:
            pass
        ctx.finish(True, False, t)
        return True
    term.connect("drag-data-received", _on_drop)

    def spawn(*_):
        try:
            res = term.spawn_sync(Vte.PtyFlags.DEFAULT, os.path.expanduser("~"),
                                  ["/bin/sh", "-c", argv_sh], [],
                                  GLib.SpawnFlags.DEFAULT, None, None, None)
            # tty del hijo: nos dice que cliente tmux es esta pestana
            pid = res[1] if isinstance(res, (tuple, list)) and len(res) > 1 else None
            if pid:
                try:
                    term._tty = os.readlink(f"/proc/{pid}/fd/0")
                except Exception:
                    pass
        except Exception as e:
            print(f"terminal fallo: {e}")
        return False

    term._respawn = True
    term.connect("child-exited", lambda *_: term._respawn and GLib.timeout_add(800, spawn))
    spawn()
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.get_style_context().add_class("termwrap")
    sb = Gtk.Scrollbar(orientation=Gtk.Orientation.VERTICAL,
                       adjustment=term.get_vadjustment())
    box.pack_start(term, True, True, 0)
    box.pack_start(sb, False, False, 0)
    box._term = term
    return box


def feed(term, seq):
    try:
        term.feed_child(seq)
    except TypeError:
        term.feed_child(seq.decode("latin1"), len(seq))


def new_session_dialog(*_):
    dlg = Gtk.Dialog(title="Nueva sesion" if ES else "New session", transient_for=win)
    dlg.set_decorated(False)   # sin min/max/close del WM; los botones están adentro
    dlg.get_style_context().add_class("cc-dialog")
    dlg.add_buttons("Cancelar" if ES else "Cancel", Gtk.ResponseType.CANCEL,
                    "Abrir" if ES else "Open", Gtk.ResponseType.OK)
    box = dlg.get_content_area()
    box.set_property("margin", 14); box.set_spacing(8)
    lbl = Gtk.Label(label=("Proyecto de ~/codebase (abre su Claude),\no cualquier nombre (terminal en blanco):" if ES else
                           "A ~/codebase project (opens its Claude),\nor any name (blank terminal):"), xalign=0)
    box.add(lbl)
    entry = Gtk.Entry()
    entry.set_placeholder_text("nombre..." if ES else "name...")
    entry.set_activates_default(True)
    dlg.set_default_response(Gtk.ResponseType.OK)
    box.add(entry)
    err = Gtk.Label(xalign=0); err.get_style_context().add_class("dim-error")
    box.add(err)
    dlg.show_all()
    while dlg.run() == Gtk.ResponseType.OK:
        name = entry.get_text().strip().replace(".", "-").replace(":", "-")
        if not name:
            continue
        res, e = http_post("/new", {"session": name})
        if e:
            err.set_text("⚠ " + e)   # ahora el error se VE, no falla en silencio
            continue
        # el server pudo resolver a la sesion real (claude en pestana term-*)
        open_tab((res or {}).get("session") or name, "claude")
        break
    dlg.destroy()


def term_session(term):
    """Sesion tmux que muestra esta pestana (por el tty de su cliente)."""
    tty = getattr(term, "_tty", None)
    if not tty:
        return None
    r = tmuxc("list-clients", "-F", "#{client_tty}|#{client_session}")
    for l in r.stdout.splitlines():
        t, _, s = l.partition("|")
        if t == tty:
            return s
    return None


def pane_at(term, event):
    """(pane_id, total_panes) del pane bajo el cursor del mouse."""
    sess = term_session(term)
    if not sess:
        return None, 0
    col = int((event.x - 10) // max(1, term.get_char_width()))
    row = int((event.y - 8) // max(1, term.get_char_height()))
    r = tmuxc("list-panes", "-t", "=" + sess + ":",
              "-F", "#{pane_id}|#{pane_left}|#{pane_top}|#{pane_right}|#{pane_bottom}")
    panes = [l.split("|") for l in r.stdout.splitlines() if l and l.count("|") == 4]
    for pid, l, t, rr, b in panes:
        if int(l) <= col <= int(rr) and int(t) <= row <= int(b):
            return pid, len(panes)
    return None, len(panes)


def copy_mode_pane(sess, preferred=None):
    """Pane que esta en copy-mode, priorizando el pane bajo el cursor."""
    if preferred:
        r = tmuxc("display-message", "-p", "-t", preferred, "#{pane_in_mode}")
        if r.stdout.strip() == "1":
            return preferred
    if not sess:
        return None
    r = tmuxc("list-panes", "-t", "=" + sess + ":", "-F", "#{pane_id}|#{pane_in_mode}")
    if r.returncode != 0:
        return None
    for line in r.stdout.splitlines():
        pane, _, mode = line.partition("|")
        if pane and mode == "1":
            return pane
    return None


def select_pane_at_event(term, event):
    pane_id, _npanes = pane_at(term, event)
    if pane_id:
        tmuxc("select-pane", "-t", pane_id)
        return pane_id
    return None


def copy_text_to_clipboard(text):
    if not text:
        return False
    cb = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
    cb.set_text(text, -1)
    try:
        cb.store()
    except Exception:
        pass
    return True


def copy_vte_selection(term):
    if not term.get_has_selection():
        return False
    term.copy_clipboard_format(Vte.Format.TEXT)
    term._last_selection_copy = time.monotonic()
    try:
        Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).store()
    except Exception:
        pass
    return True


def copy_tmux_selection_to_clipboard(pane):
    if not pane:
        return False
    r = tmuxc("send-keys", "-t", pane, "-X", "copy-selection-no-clear")
    if r.returncode != 0:
        r = tmuxc("send-keys", "-t", pane, "-X", "copy-selection")
    if r.returncode != 0:
        return False
    r = tmuxc("save-buffer", "-")
    if r.returncode != 0:
        return False
    return copy_text_to_clipboard(r.stdout)


def notify_popup(title, body):
    """Feedback visible via el demonio de popups (se autocierra en 12s)."""
    try:
        req = urllib.request.Request(
            "http://127.0.0.1:4778/notify",
            data=json.dumps({"title": title, "body": body, "kind": "done",
                             "project": title, "session": "local"}).encode(),
            headers={"Content-Type": "application/json"})
        urllib.request.urlopen(req, timeout=3)
    except Exception:
        pass


def export_claude_reply(term, fmt):
    """Guarda la ultima respuesta de Claude de esta sesion como .txt o PDF
    (lo genera cc-dash en ~/Descargas, lo abre, y AVISA donde quedo)."""
    sess = term_session(term)
    if not sess:
        return
    res, err = http_post("/export", {"session": sess, "format": fmt}, timeout=45)
    if err:
        notify_popup("No se pudo guardar" if ES else "Could not save", err)
    else:
        notify_popup("Respuesta guardada" if ES else "Reply saved", (res or {}).get("path", ""))


def copy_claude_reply(term):
    """Copia al clipboard la ULTIMA respuesta de Claude de esta sesion (el
    texto completo que guardan los hooks), sin andar seleccionando a mano."""
    sess = term_session(term)
    if not sess:
        return
    try:
        with urllib.request.urlopen("http://127.0.0.1:4777/state", timeout=3) as r:
            items = json.loads(r.read().decode())
    except Exception:
        return
    for it in items:
        if it.get("session") == sess and (it.get("detail") or it.get("last")):
            txt = it.get("detail") or it["last"]
            Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD).set_text(txt, -1)
            notify_popup("Respuesta copiada" if ES else "Reply copied",
                         (f"{len(txt)} caracteres al portapapeles ({it.get('project')})" if ES else
                          f"{len(txt)} characters copied ({it.get('project')})"))
            return
    notify_popup("Sin respuesta guardada" if ES else "No reply captured",
                 "Esta sesion aun no tiene una respuesta capturada por los hooks" if ES else
                 "This session has no hook-captured reply yet")


def exit_copy_mode(term):
    """Si el pane activo esta en modo copia (highlight de tmux), salir para que
    el paste entre como TEXTO y no como teclas del modo copia."""
    sess = term_session(term)
    if sess:
        r = tmuxc("display-message", "-p", "-t", f"={sess}:", "#{pane_in_mode}")
        if r.stdout.strip() == "1":
            tmuxc("send-keys", "-t", f"={sess}:", "-X", "cancel")


def open_url(url):
    """Abre una URL en el navegador default del usuario.
    En WSL prefiere `wslview` (rutea al navegador de Windows via wslu);
    en macOS usa `open`; en Linux nativo usa `xdg-open`."""
    is_wsl = False
    try:
        with open("/proc/sys/kernel/osrelease") as f:
            is_wsl = "microsoft" in f.read().lower()
    except Exception:
        pass
    if sys.platform == "darwin":
        opener = "open"
    elif is_wsl and shutil.which("wslview"):
        opener = "wslview"
    else:
        opener = "xdg-open"
    try:
        subprocess.Popen([opener, url], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def on_term_release(term, event):
    """Al soltar el mouse: 1) si fue un CLICK limpio sobre una URL, abrirla;
    2) marcar que pudo quedar seleccion tmux (el primer keypress la limpia)."""
    press = getattr(term, "_url_press", None)
    term._url_press = None
    term._sel_flag = True
    if term.get_has_selection():
        copy_vte_selection(term)
    if press and event.button == 1:
        x, y, url = press
        if url and abs(event.x - x) < 5 and abs(event.y - y) < 5 \
                and not term.get_has_selection():
            open_url(url)
    return False


def on_term_button(term, event):
    # Ctrl+click en una URL: abrirla directo
    if event.button == 1 and (event.state & Gdk.ModifierType.CONTROL_MASK):
        try:
            match, _tag = term.match_check_event(event)
            url = url_at_event(term, event, match or "")
            if url:
                open_url(url)
                return True
        except Exception:
            pass
        return False
    # Click simple: recordar si cayo sobre una URL; se abre al SOLTAR solo si
    # no hubo arrastre (para no interferir con seleccionar texto)
    if event.button == 1:
        select_pane_at_event(term, event)
        try:
            match, _tag = term.match_check_event(event)
            url = url_at_event(term, event, match or "")
        except Exception:
            url = None
        term._url_press = (event.x, event.y, url) if url else None
        return False
    if event.button != 3:
        return False
    box = term.get_parent()
    menu = Gtk.Menu()

    def item(label, cb, sensitive=True):
        it = Gtk.MenuItem(label=label)
        it.connect("activate", lambda *_: cb())
        it.set_sensitive(sensitive)
        menu.append(it)

    key = getattr(box, "_key", None)
    cur_sess = term_session(term)          # sesion realmente mostrada (hub incluido)
    pane_id, npanes = pane_at(term, event)  # pane bajo el cursor
    if pane_id:
        tmuxc("select-pane", "-t", pane_id)
    ssh_host = ssh_host_from_session(cur_sess)
    is_ssh = bool(ssh_host)

    def split(flags, cmd=None):
        target = pane_id or (("=" + cur_sess + ":") if cur_sess else None)
        if not target:
            return
        args = ["split-window"] + flags + ["-t", target]
        if cmd:
            args.append(cmd)
        else:
            r = tmuxc("display-message", "-p", "-t", target, "#{pane_current_path}")
            cwd = r.stdout.strip()
            if cwd:
                args += ["-c", cwd]
        tmuxc(*args)

    # Hay DOS tipos de seleccion: la de la terminal (VTE, con Shift+arrastrar)
    # y la de tmux (arrastrar normal, es la que persiste). Copiar cubre ambas.
    copy_pane = copy_mode_pane(cur_sess, pane_id)

    def do_copy():
        if copy_vte_selection(term):
            return
        target = copy_mode_pane(term_session(term), pane_id) or copy_pane
        if target and copy_tmux_selection_to_clipboard(target):
            return
        if time.monotonic() - getattr(term, "_last_selection_copy", 0) < 15:
            notify_popup("Seleccion copiada" if ES else "Selection copied",
                         "Ya estaba en el portapapeles" if ES else "Already on the clipboard")
            return
        notify_popup("No se pudo copiar" if ES else "Could not copy",
                     "No encontre una seleccion activa" if ES else "No active selection found")

    item(("Copiar                   Ctrl+C" if ES else "Copy                     Ctrl+C"), do_copy,
         sensitive=True)
    item(("Pegar                    Ctrl+V" if ES else "Paste                    Ctrl+V"),
         lambda: (exit_copy_mode(term), term.paste_clipboard()))
    item("Copiar respuesta de Claude" if ES else "Copy Claude's reply", lambda: copy_claude_reply(term))
    item("Guardar respuesta como .txt" if ES else "Save reply as .txt", lambda: export_claude_reply(term, "txt"))
    item("Guardar respuesta como PDF" if ES else "Save reply as PDF", lambda: export_claude_reply(term, "pdf"))
    menu.append(Gtk.SeparatorMenuItem())
    if is_ssh:
        host = ssh_host
        sshcmd = f"ssh {host}"
        item("Split derecha    (otra conexion al server)" if ES else "Split right    (new connection to server)", lambda: split(["-h"], sshcmd))
        item("Split izquierda  (otra conexion al server)" if ES else "Split left     (new connection to server)", lambda: split(["-h", "-b"], sshcmd))
        item("Split abajo      (otra conexion al server)" if ES else "Split down     (new connection to server)", lambda: split(["-v"], sshcmd))
        item("Split arriba     (otra conexion al server)" if ES else "Split up       (new connection to server)", lambda: split(["-v", "-b"], sshcmd))
        item("Split local (tu maquina, derecha)" if ES else "Local split (your machine, right)", lambda: split(["-h"]))
    else:
        item("Split derecha" if ES else "Split right", lambda: split(["-h"]))
        item("Split izquierda" if ES else "Split left", lambda: split(["-h", "-b"]))
        item("Split abajo" if ES else "Split down", lambda: split(["-v"]))
        item("Split arriba" if ES else "Split up", lambda: split(["-v", "-b"]))
    item("Alternar ventana 1/2     Ctrl-b l" if ES else "Toggle window 1/2        Ctrl-b l", lambda: feed(term, b"\x02l"))
    item("Cerrar ESTE split" if ES else "Close THIS split",
         lambda: tmuxc("kill-pane", "-t", pane_id),
         sensitive=bool(pane_id) and npanes > 1)
    menu.append(Gtk.SeparatorMenuItem())
    item("Nueva terminal aqui       Ctrl+T" if ES else "New terminal here         Ctrl+T", new_local_tab)
    item("Terminal experimental (xterm.js)  Ctrl+Shift+T"
         if ES else "Experimental terminal (xterm.js)  Ctrl+Shift+T",
         lambda: open_xterm_tab("local"))
    item("Abrir proyecto..." if ES else "Open project...", new_session_dialog)
    sub = Gtk.Menu()
    r = tmuxc("list-sessions", "-F", "#{session_name}")
    for s in (r.stdout.split() if r.returncode == 0 else []):
        si = Gtk.MenuItem(label=s)
        si.connect("activate", lambda _w, s=s: open_tab(s, "claude"))
        sub.append(si)
    mi = Gtk.MenuItem(label="Abrir sesion existente" if ES else "Open existing session")
    mi.set_submenu(sub)
    menu.append(mi)
    menu.append(Gtk.SeparatorMenuItem())
    key = getattr(box, "_key", None)
    item("Renombrar pestana..." if ES else "Rename tab...", lambda: rename_tab(key), sensitive=key is not None)
    item("Cerrar pestana" if ES else "Close tab", lambda: close_tab(key), sensitive=key is not None)
    menu.show_all()
    menu.popup_at_pointer(event)
    term._menu = menu
    return True


win = Gtk.Window(title="ComandOS")
win.set_wmclass("comandos", "comandos")
win.set_default_size(1600, 880)
win.set_icon_name("centro-claude")

# HeaderBar custom — reemplaza el titlebar del WM. Los botones min/max/close
# los dibujamos NOSOTROS con el mismo helper de icon-button que el resto de
# los controles, así todo el header comparte tamaño/padding/hover (lo del WM
# se ve inconsistente porque usa un widget aparte, `titlebutton`).
_headerbar = Gtk.HeaderBar()
_headerbar.set_show_close_button(False)
_headerbar.get_style_context().add_class("cc-headerbar")
# Marca ComandOS a la izquierda del headerbar.
_hb_brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
_hb_dot = Gtk.Label()
_hb_dot.set_markup(f'<span size="10500" foreground="{THEME["brand"]}">●</span>')
_hb_brandlbl = Gtk.Label(label="COMANDOS")
_hb_brandlbl.get_style_context().add_class("cc-brand")
_hb_brand.pack_start(_hb_dot, False, False, 0)
_hb_brand.pack_start(_hb_brandlbl, False, False, 0)
_headerbar.pack_start(_hb_brand)
# set_decorated(False) = sin decoration del WM = Windows DWM no dibuja sombra
# externa. Trade-off: perdemos el drag del headerbar automático, así que lo
# cablamos a mano abajo (button-press → begin_move_drag).
win.set_decorated(False)
# Ya NO hacemos set_titlebar — el headerbar se agrega como widget del layout
# principal en el bootstrap del content (junto con `paned`).

# CSS del headerbar — mono tracked wordmark + fondo del theme para que empate
# con el resto de la app (evita el gradient default del theme del sistema).
_HB_CSS = Gtk.CssProvider()

