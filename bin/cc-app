# Layout root: headerbar arriba (envuelto en EventBox para drag) + paned.
# El EventBox necesita set_above_child(False) para que los botones sigan
# recibiendo sus clicks — el drag solo se dispara sobre el área vacía.
_hb_evbox = Gtk.EventBox()
_hb_evbox.set_above_child(False)
_hb_evbox.set_visible_window(False)
_hb_evbox.add(_headerbar)

def _hb_press(_w, ev):
    if ev.button != 1:
        return False
    if ev.type == Gdk.EventType._2BUTTON_PRESS:
        if win.is_maximized(): win.unmaximize()
        else: win.maximize()
        return True
    if ev.type == Gdk.EventType.BUTTON_PRESS:
        win.begin_move_drag(ev.button, int(ev.x_root), int(ev.y_root), ev.time)
        return True
    return False

_hb_evbox.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
_hb_evbox.connect("button-press-event", _hb_press)

_root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
_root.pack_start(_hb_evbox, False, False, 0)
_root.pack_start(paned, True, True, 0)

# Overlay wrapper — permite superponer modales encima del contenido principal.
# Todos los modales (snippets, switcher, tabs overview, help) usan este overlay
# via show_modal_panel(). Sin top-level Gtk.Window separados = sin pointer
# grabs, sin quirks del compositor Wayland/WSLg.
modal_overlay = Gtk.Overlay()
modal_overlay.add(_root)
win.add(modal_overlay)


def show_modal_panel(panel, on_key=None, on_close=None, dismissable=True):
    """Muestra `panel` como widget overlay con backdrop transparente. Retorna
    el callback de close. Solo un modal a la vez — si ya hay uno, lo cierra.

    - dismissable=True (default): click en backdrop cierra, ESC cierra.
    - dismissable=False (must-answer): backdrop y ESC NO cierran. Solo se
      cierra via el callback retornado.
    - on_key(ev): callback opcional, retorna True para consumir la tecla
      (aunque no sea dismissable, on_key sigue funcionando).
    - on_close(): callback opcional post-cleanup.
    """
    if getattr(show_modal_panel, "_current", None) is not None:
        show_modal_panel._current["close"]()

    # Todos los paneles reciben la class base para el look unificado
    # (bg, border, radius, shadow del tema).
    panel.get_style_context().add_class("cc-modal-panel")

    def _close():
        cur = getattr(show_modal_panel, "_current", None)
        if cur is None:
            return
        show_modal_panel._current = None
        try: modal_overlay.remove(cur["backdrop"])
        except Exception: pass
        try: modal_overlay.remove(cur["wrapper"])
        except Exception: pass
        try: win.disconnect(cur["key_handler"])
        except Exception: pass
        if cur["on_close"]:
            try: cur["on_close"]()
            except Exception: pass
        t = cur_term()
        if t is not None:
            try: t.grab_focus()
            except Exception: pass

    backdrop = Gtk.EventBox()
    backdrop.set_visible_window(True)
    backdrop.set_halign(Gtk.Align.FILL); backdrop.set_valign(Gtk.Align.FILL)
    backdrop.set_hexpand(True); backdrop.set_vexpand(True)
    backdrop.get_style_context().add_class("cc-modal-backdrop")
    backdrop.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    # Backdrop siempre "come" el click (impide que llegue al contenido detras)
    # pero solo cierra si el modal es dismissable.
    def _on_backdrop_press(*_):
        if dismissable:
            _close()
        return True
    backdrop.connect("button-press-event", _on_backdrop_press)

    def _key_handler(_w, ev):
        if on_key and on_key(ev):
            return True
        if dismissable and ev.keyval == Gdk.KEY_Escape:
            _close()
            return True
        return False
    kh = win.connect("key-press-event", _key_handler)

    # El panel va DENTRO de un EventBox con ventana propia. Clave: WebKit y
    # VTE tienen ventana NATIVA que se dibuja encima de los overlays no-nativos
    # y se comia el click "afuera" (por eso no cerraba). Con ventanas propias
    # elevamos el stacking X a mano: contenido < backdrop < panel. Asi el
    # backdrop capta los clicks de afuera (aunque sea sobre el webview) y el
    # panel + sus hijos (input, lista) reciben los suyos con NORMALIDAD — sin
    # grab de toolkit, que rompia la seleccion del ListBox y el foco del Entry.
    wrapper = Gtk.EventBox()
    wrapper.set_visible_window(True)
    wrapper.set_halign(panel.get_halign() if panel.get_halign() != Gtk.Align.FILL else Gtk.Align.CENTER)
    wrapper.set_valign(panel.get_valign() if panel.get_valign() != Gtk.Align.FILL else Gtk.Align.CENTER)
    wrapper.add(panel)

    modal_overlay.add_overlay(backdrop)
    modal_overlay.add_overlay(wrapper)
    modal_overlay.show_all()

    def _restack():
        try:
            bw = backdrop.get_window()
            ww = wrapper.get_window()
            if bw: bw.raise_()      # backdrop sobre el contenido nativo
            if ww: ww.raise_()      # panel sobre el backdrop (topmost)
        except Exception:
            pass
        return False
    _restack()
    GLib.idle_add(_restack)         # de nuevo tras el primer layout (WebKit realiza tarde)

    show_modal_panel._current = {
        "panel": panel, "wrapper": wrapper, "backdrop": backdrop, "key_handler": kh,
        "on_close": on_close, "close": _close,
    }
    return _close


def cur_term():
    page = nb.get_nth_page(nb.get_current_page())
    return getattr(page, "_term", None)


class SnippetsDialog(Gtk.Frame):
    """List + preview + Send/Edit/Delete/New. Panel embebido en el Gtk.Overlay
    de la main window — NO es un top-level Window separado.

    Esto elimina toda la complejidad Wayland/WSLg que traia el enfoque anterior:
    pointer grabs no confiables, coord lies del compositor, WSLg zombies,
    VTE/WebKit consumiendo eventos, focus routing weird. Como widget hijo del
    Overlay, el click-outside es trivial: un backdrop transparente hermano
    captura los clicks. Gtk se encarga de todo el routing correctamente."""

    def __init__(self, get_active_session, on_close):
        super().__init__()
        self.set_size_request(720, 520)
        self.set_halign(Gtk.Align.CENTER)
        self.set_valign(Gtk.Align.CENTER)
        self.get_style_context().add_class("cc-snip-dialog")
        self._get_session = get_active_session
        self._on_close_cb = on_close  # callback del owner para destruir el overlay
        self._items = snip_load()
        self._selected = None
        self._closing = False

        # Root box del contenido interno del panel.
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)

        # Header con título + botón X. La X es el escape hatch bulletproof
        # cuando cualquier otro mecanismo de cierre falla en WSLg raro.
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        hdr.set_margin_top(8); hdr.set_margin_bottom(6)
        hdr.set_margin_start(12); hdr.set_margin_end(6)
        hdr.get_style_context().add_class("cc-snip-hdr")
        title = Gtk.Label(label="SNIPPETS", xalign=0)
        title.get_style_context().add_class("cc-snip-title")
        hdr.pack_start(title, True, True, 0)
        close_btn = Gtk.Button()
        close_x = os.path.join(_ICONS_DIR, "close.svg")
        if os.path.isfile(close_x):
            close_btn.set_image(Gtk.Image.new_from_pixbuf(
                GdkPixbuf.Pixbuf.new_from_file_at_size(close_x, 14, 14)))
            close_btn.set_always_show_image(True)
        else:
            close_btn.set_label("×")
        close_btn.set_relief(Gtk.ReliefStyle.NONE)
        close_btn.get_style_context().add_class("cc-snip-close")
        close_btn.set_tooltip_text("Cerrar (ESC)" if ES else "Close (ESC)")
        close_btn.connect("clicked", lambda *_: self._close())
        hdr.pack_end(close_btn, False, False, 0)
        root.pack_start(hdr, False, False, 0)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.set_position(260)
        root.pack_start(paned, True, True, 0)

        # Barra de status ephemeral abajo — inline feedback de Send.
        self._status = Gtk.Label(label="", xalign=0)
        self._status.set_margin_top(4); self._status.set_margin_bottom(6)
        self._status.set_margin_start(12); self._status.set_margin_end(12)
        self._status.get_style_context().add_class("cc-snip-status")
        root.pack_start(self._status, False, False, 0)
        self._status_timer = None

        # Left column: search + list + new
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.set_margin_top(8); left.set_margin_bottom(8)
        left.set_margin_start(8); left.set_margin_end(8)
        self._q = Gtk.Entry()
        self._q.set_placeholder_text("buscar...")
        self._q.connect("changed", lambda *_: self._render_list())
        left.pack_start(self._q, False, False, 0)
        self._list = Gtk.ListBox()
        self._list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self._list.connect("row-selected", self._on_row)
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.add(self._list)
        left.pack_start(scroll, True, True, 0)
        new_btn = Gtk.Button(label="+ nuevo")
        new_btn.connect("clicked", lambda *_: self._edit(None))
        left.pack_start(new_btn, False, False, 0)
        paned.pack1(left, resize=False, shrink=False)

        # Right column: preview / editor
        self._right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self._right.set_margin_top(8); self._right.set_margin_bottom(8)
        self._right.set_margin_start(8); self._right.set_margin_end(8)
        paned.pack2(self._right, resize=True, shrink=False)

        self._render_list()
        self._render_preview()
        self.show_all()

    def _filter(self, items, q):
        q = (q or "").strip().lower()
        if not q:
            return sorted(items, key=lambda i: -int(i.get("updated_at") or 0))
        scored = []
        for it in items:
            name = (it.get("name") or "").lower()
            tags = " ".join(it.get("tags") or []).lower()
            body = (it.get("body") or "").lower()
            score = 3 if q in name else 2 if q in tags else 1 if q in body else 0
            if score:
                scored.append((score, int(it.get("updated_at") or 0), it))
        scored.sort(key=lambda x: (-x[0], -x[1]))
        return [x[2] for x in scored]

    def _render_list(self):
        for child in self._list.get_children():
            self._list.remove(child)
        for it in self._filter(self._items, self._q.get_text()):
            row = Gtk.ListBoxRow()
            row.snippet = it
            row_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            row_box.set_margin_top(4); row_box.set_margin_bottom(4)
            row_box.set_margin_start(6); row_box.set_margin_end(6)
            name = Gtk.Label(label=it["name"], xalign=0)
            row_box.pack_start(name, False, False, 0)
            if it.get("tags"):
                tags = Gtk.Label(label=" · ".join(it["tags"]), xalign=0)
                tags.get_style_context().add_class("dim-label")
                row_box.pack_start(tags, False, False, 0)
            row.add(row_box)
            self._list.add(row)
        self._list.show_all()

    def _on_row(self, _lb, row):
        self._selected = row.snippet if row is not None else None
        self._render_preview()

    def _clear_right(self):
        for child in self._right.get_children():
            self._right.remove(child)

    def _render_preview(self):
        self._clear_right()
        it = self._selected
        if not it:
            self._right.pack_start(Gtk.Label(label="Elegí un snippet o creá uno nuevo.", xalign=0),
                                   False, False, 0)
            self._right.show_all()
            return
        title = Gtk.Label(label=it["name"], xalign=0)
        title.get_style_context().add_class("title-4")
        self._right.pack_start(title, False, False, 0)
        if it.get("tags"):
            self._right.pack_start(Gtk.Label(label=" · ".join(it["tags"]), xalign=0),
                                   False, False, 0)
        tv = Gtk.TextView()
        tv.set_editable(False)
        tv.set_monospace(True)
        tv.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        tv.get_buffer().set_text(it["body"])
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.add(tv)
        self._right.pack_start(scroll, True, True, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        send = Gtk.Button(label="Send"); send.connect("clicked", lambda *_: self._send(it))
        edit = Gtk.Button(label="Edit"); edit.connect("clicked", lambda *_: self._edit(it))
        delete = Gtk.Button(label="Delete"); delete.connect("clicked", lambda *_: self._delete(it))
        for b in (send, edit, delete):
            actions.pack_start(b, False, False, 0)
        self._right.pack_start(actions, False, False, 0)
        self._right.show_all()

    def _edit(self, it):
        self._clear_right()
        name = Gtk.Entry()
        name.set_text(it["name"] if it else "")
        name.set_placeholder_text("nombre")
        tags = Gtk.Entry()
        tags.set_text(", ".join(it["tags"]) if it and it.get("tags") else "")
        tags.set_placeholder_text("tags coma-separados")
        body = Gtk.TextView()
        body.set_monospace(True)
        body.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        body.get_buffer().set_text(it["body"] if it else "")
        scroll = Gtk.ScrolledWindow()
        scroll.set_vexpand(True)
        scroll.add(body)

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        save = Gtk.Button(label="Save")
        cancel = Gtk.Button(label="Cancel")
        actions.pack_start(save, False, False, 0)
        actions.pack_start(cancel, False, False, 0)

        for w in (name, tags, scroll, actions):
            self._right.pack_start(w, w is scroll, w is scroll, 0)
        self._right.show_all()
        name.grab_focus()

        cancel.connect("clicked", lambda *_: self._render_preview())
        save.connect("clicked", lambda *_: self._save_from_editor(it, name, tags, body))

    def _save_from_editor(self, it, name_w, tags_w, body_w):
        name = name_w.get_text().strip()
        tags = [t.strip() for t in tags_w.get_text().split(",") if t.strip()]
        buf = body_w.get_buffer()
        body = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        if not name or not body.strip():
            return
        now = int(time.time())
        if it:
            for i, x in enumerate(self._items):
                if x.get("id") == it["id"]:
                    self._items[i] = {**x, "name": name, "body": body, "tags": tags, "updated_at": now}
                    self._selected = self._items[i]
                    break
        else:
            new_item = {"id": secrets.token_hex(8), "name": name, "body": body,
                        "tags": tags, "updated_at": now}
            self._items.insert(0, new_item)
            self._selected = new_item
        snip_save(self._items)
        self._render_list()
        self._render_preview()

    def _delete(self, it):
        self._items = [x for x in self._items if x.get("id") != it.get("id")]
        snip_save(self._items)
        self._selected = None
        self._render_list()
        self._render_preview()

    def _close(self, *_):
        """Cierre idempotente. Delega al callback del owner que remueve el
        panel + backdrop del Overlay. Sin GdkWindow tricks — es solo un widget."""
        if self._closing:
            return
        self._closing = True
        try:
            self._on_close_cb()
        except Exception:
            pass

    def _flash(self, msg, error=False):
        """Muestra `msg` en la barra inline del dialog por 2.5s."""
        self._status.set_text(msg)
        ctx = self._status.get_style_context()
        ctx.remove_class("cc-snip-status-err")
        ctx.remove_class("cc-snip-status-ok")
        ctx.add_class("cc-snip-status-err" if error else "cc-snip-status-ok")
        if self._status_timer:
            GLib.source_remove(self._status_timer)
        def _clear():
            self._status.set_text("")
            self._status_timer = None
            return False
        self._status_timer = GLib.timeout_add(2500, _clear)

    def _send(self, it):
        sess = self._get_session()
        if not sess:
            self._flash("No hay sesion tmux en la pestana activa" if ES
                        else "No tmux session in the active tab", error=True)
            return
        err = snip_paste(sess, it["body"])
        if err:
            self._flash(err, error=True)
        else:
            self._flash(f"Pegado en {sess}" if ES else f"Pasted into {sess}")


def _active_snippets_session():
    """Retorna la sesion tmux del tab activo, resolviendo por el tty del cliente
    tmux (misma logica que copy/export). Si el tab activo es el hub o no tiene
    session viva, devuelve cadena vacia."""
    try:
        term = cur_term()
        if not term:
            return ""
        return term_session(term) or ""
    except Exception:
        return ""


def open_snippets_dialog(*_):
    """Muestra el panel de snippets via show_modal_panel."""
    # Necesitamos cerrar el panel desde adentro (X button, save action).
    # Uso una lista mutable como closure para poder actualizar close_cb
    # despues de que show_modal_panel retorne.
    close_ref = [None]
    def _do_close():
        if close_ref[0]:
            close_ref[0]()
    panel = SnippetsDialog(_active_snippets_session, _do_close)
    close_ref[0] = show_modal_panel(panel)
    panel._q.grab_focus()


