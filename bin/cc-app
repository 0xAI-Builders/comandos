FONT = "JetBrainsMono Nerd Font 13"


def _ui_lang():
    """Idioma resuelto por cc-dash (CC_LANG en cc-notify.conf, o auto por $LANG)."""
    try:
        with urllib.request.urlopen("http://127.0.0.1:4777/conf", timeout=2) as r:
            l = json.loads(r.read().decode()).get("_lang")
            if l in ("es", "en"):
                return l
    except Exception:
        pass
    return "es" if os.environ.get("LANG", "").lower().startswith("es") else "en"


UI_LANG = _ui_lang()
ES = UI_LANG == "es"

GLib.set_prgname("comandos")
Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)

