  "flows": [
    {
      "id": "fable-planea-codex-construye",
      "label": "Fable planea · Codex construye",
      "desc": "El caro piensa el plan (modo plan), el barato lo implementa",
      "steps": [
        {
          "label": "plan",
          "cmd": "claude --model fable --permission-mode plan"
        },
        {
          "label": "build",
          "cmd": "codex -m gpt-5.4"
        }
      ]
    },
    {
      "id": "opus-planea-sonnet-construye",
      "label": "Opus planea · Sonnet construye",
      "desc": "Cascada 100% Claude",
      "steps": [
        {
          "label": "plan",
          "cmd": "claude --model opus --permission-mode plan"
        },
        {
          "label": "build",
          "cmd": "claude --model sonnet"
        }
      ]
    },
    {
      "id": "codex-construye-haiku-verifica",
      "label": "Codex construye · Haiku verifica",
      "desc": "Builder + verificador barato corriendo tests/lint",
      "steps": [
        {
          "label": "build",
          "cmd": "codex -m gpt-5.4"
        },
        {
          "label": "verify",
          "cmd": "claude --model haiku"
        }
      ]
    },
    {
      "id": "glm-solo",
      "label": "GLM construye (opencode)",
      "desc": "Ajusta el modelo al provider zai que tengas configurado",
      "steps": [
        {
          "label": "build",
          "cmd": "opencode --model zai-coding-plan/glm-4.6"
        }
      ]
    }
  ]
