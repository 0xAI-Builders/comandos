{
  "_doc": "Roles y flujos — EDITABLE, SIN nombres de modelo congelados: claude usa ALIAS oficiales (el CLI los resuelve siempre al modelo vigente); codex y opencode usan PATRONES regex que se resuelven contra el catalogo VIVO al momento de usarse (codex: el picker vigente; opencode/glm: `opencode models`). Si un patron no matchea nada, el rol se muestra como no-disponible (jamas se inventa un modelo). dangerFlags: flag por proveedor para lanzar sin aprobaciones.",
  "dangerFlags": {
    "claude": "--dangerously-skip-permissions",
    "codex": "--dangerously-bypass-approvals-and-sandbox",
    "opencode": ""
  },
  "roles": [
    {
      "id": "verificador",
      "label": "Verificador",
      "hat": "visor",
      "desc": "lint, tests, triage, renames — barato y rapido",
      "matches": [
        "haiku",
        "spark",
        "mini",
        "air",
        "flash",
        "nano"
      ],
      "byProvider": {
        "claude": {
          "alias": "haiku"
        },
        "codex": {
          "match": [
            "spark",
            "mini"
          ],
          "effort": "low"
        },
        "opencode": {
          "match": [
            "glm-4\\.5-air",
            "haiku",
            "mini",
            "flash"
          ]
        }
      }
    },
    {
      "id": "constructor",
      "label": "Constructor",
      "hat": "casco",
      "desc": "features normales, refactors acotados",
      "matches": [
        "sonnet",
        "gpt-5\\.4",
        "glm-4\\.6",
        "terra",
        "luna"
      ],
      "byProvider": {
        "claude": {
          "alias": "sonnet"
        },
        "codex": {
          "match": [
            "gpt-5\\.4$",
            "terra",
            "luna"
          ],
          "effort": "medium"
        },
        "opencode": {
          "match": [
            "glm-4\\.6",
            "sonnet"
          ]
        }
      }
    },
    {
      "id": "arquitecto",
      "label": "Arquitecto",
      "hat": "corona",
      "desc": "ambiguo + multi-archivo + irreversible — solo cuando lo vale",
      "matches": [
        "opus",
        "fable",
        "mythos",
        "gpt-5\\.5",
        "gpt-5\\.6",
        "sol"
      ],
      "byProvider": {
        "claude": {
          "alias": "opus"
        },
        "codex": {
          "match": [
            "sol$",
            "gpt-5\\.5",
            "gpt-5\\.6"
          ],
          "effort": "high"
        },
        "opencode": {
          "match": [
            "glm-4\\.6",
            "opus"
          ]
        }
      }
    }
  ]
}
