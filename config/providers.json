  "exclusions": [
    {
      "id": "codex:claude",
      "harness": "codex",
      "motor": "claude",
      "productState": "unsupported_protocol",
      "reasonCode": "unsupported_protocol",
      "message": "Codex CLI solo admite Responses; Claude subscription no expone ese protocolo."
    },
    {
      "id": "grok:claude",
      "harness": "grok",
      "motor": "claude",
      "productState": "subscription_incompatible",
      "reasonCode": "subscription_not_accepted",
      "message": "Grok Build requiere API key Anthropic; Claude Max no se puede reenviar."
    }
  ]
