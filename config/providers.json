      "motor": "claude",
      "transport": "anthropic-subscription",
      "authRequirements": [
        "harness:claude"
      ],
      "actionScopes": [
        "new_session",
        "session_motor",
        "session_model"
      ],
      "accountScopes": [
        "harness"
      ],
      "driver": "claude",
      "experimental": false
    },
    {
