# Copia a telegram.env y llena los valores para operar ComandOS desde Telegram.
#   cp telegram.env.example ~/.claude/hooks/telegram.env
#
# Crea un bot DEDICADO con @BotFather (2 min) y pega su token.
# El chat id lo obtienes mandandole /start al bot y mirando getUpdates,
# o con cualquier bot tipo @userinfobot.

# Token del bot dedicado de ComandOS (botones interactivos + comandos)
CC_TELEGRAM_BOT_TOKEN=

# Tu chat id (a donde llegan las notificaciones)
TELEGRAM_CHAT_ID=

# Identidad autorizada. RECOMENDADO: el ID numerico (inmutable). Lo ves
# mandandole /start a @userinfobot. Si lo pones, manda sobre el username.
TELEGRAM_ALLOWED_USER_ID=

# Alternativa (menos segura: el username es cambiable). Sin @.
TELEGRAM_ALLOWED_USER=tu_usuario

# Compatibilidad: si solo usas notificaciones de texto (sin botones), basta este:
TELEGRAM_BOT_TOKEN=
