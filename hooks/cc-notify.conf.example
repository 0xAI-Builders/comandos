# Configuracion editable de las notificaciones de Claude Code.
# Cambia lo que quieras y guarda; aplica al instante (el hook lo lee en cada evento).

# Sonidos (cualquier .oga/.wav; ve opciones en /usr/share/sounds/freedesktop/stereo/)
SOUND_DONE=/usr/share/sounds/freedesktop/stereo/complete.oga
SOUND_ATTENTION=/usr/share/sounds/freedesktop/stereo/window-attention.oga

# Volumen GLOBAL de voz y chime, 0-100 (editable desde Ajustes del tablero)
VOLUME=60

# Canales: 1 = activo, 0 = apagado
DESKTOP_NOTIFY=1
SOUND_ENABLED=1
TELEGRAM_ENABLED=1

# Que eventos notifican (1 = si): "termino" y/o "necesita atencion"
NOTIFY_ON_DONE=1
NOTIFY_ON_ATTENTION=1

# Terminal que abren los botones "Abrir terminal" / "Revivir" / popups
# (kitty | tilix | gnome-terminal). Si no existe, se auto-detecta en ese orden.
TERMINAL_CMD=kitty

# Voz local (piper, 100% offline): las notificaciones te HABLAN.
# "LifeOS necesita tu respuesta" / "Merauto terminó". 1 = habla, 0 = solo chime.
SPEAK_ATTENTION=1
SPEAK_DONE=1
# Voces disponibles en ~/.local/share/piper-voices/ (es_MX-ald-medium, es_ES-davefx-medium...)
PIPER_VOICE=es_MX-ald-medium

# Sonidos extra para notify.sh (niveles error/money)
SOUND_ERROR=/usr/share/sounds/freedesktop/stereo/dialog-error.oga
SOUND_MONEY=/usr/share/sounds/freedesktop/stereo/message.oga

# Idioma de la UI: auto (por $LANG del sistema), es, en
CC_LANG=auto

# Agentes (ccx y el tablero).
# AGENTS: lista de agentes que el tablero detecta/ofrece (default:
#   "claude codex opencode gemini agy aider"). Amplia con los tuyos.
# AGENT_DEFAULT: agente que usa `ccx` sin escribir -a (lo pisa la variable
#   de entorno CCX_AGENT, y el flag -a manda sobre todo).
# AGENT_LAUNCH_<NOMBRE>: comando con el que se LANZA un agente al crear o
#   revivir su sesion (ccx y el tablero). <NOMBRE> = agente en MAYUSCULAS
#   con '-' y '.' -> '_'. Sirve para wrappers propios (claude-mpm,
#   claude-personal) y para sobreescribir un builtin (AGENT_LAUNCH_CLAUDE=...).
# AGENTS="claude codex claude-mpm"
# AGENT_DEFAULT=claude-mpm
# AGENT_LAUNCH_CLAUDE_MPM='claude-mpm run --continue 2>/dev/null || claude-mpm run'

# Uso y limites locales de ComandOS.
# OPENAI_ADMIN_KEY / ANTHROPIC_ADMIN_KEY habilitan APIs admin de uso/costo si tu cuenta las tiene.
# Los limites de plan de Codex/Claude Code no siempre son expuestos por API; configura estos
# valores locales para ver porcentaje/restante sin inventar datos.
# OPENAI_ADMIN_KEY=
# ANTHROPIC_ADMIN_KEY=
COMANDOS_USAGE_LOCAL_DAYS=14
COMANDOS_USAGE_CLAUDE_MAX_FILES=120
# COMANDOS_CODEX_DAILY_TOKEN_LIMIT=
# COMANDOS_CODEX_WEEKLY_TOKEN_LIMIT=
# COMANDOS_CLAUDE_DAILY_TOKEN_LIMIT=
# COMANDOS_CLAUDE_WEEKLY_TOKEN_LIMIT=
# COMANDOS_DAILY_BUDGET_USD=

# Notificaciones nativas del escritorio (GNOME) en vez de los popups con tema: 1 para activar
NATIVE_NOTIFY=0

# Popups flotantes de cc-notifyd (ventanas propias): 1 para activarlos. Por defecto los avisos van dentro del tablero.
POPUPS=0
